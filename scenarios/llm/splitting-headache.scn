# Splitting Headache: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "mode 1: target player discards two cards" {
  battlefield A: 4 "Swamp"
  hand A: "Splitting Headache"
  hand B: "Grizzly Bears", "Hill Giant", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Splitting Headache" mode 1 targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 1
  assert graveyard A contains "Splitting Headache"
  assert hand A count 0
}

scenario "mode 2: reveal hand and discard the only card" {
  battlefield A: 4 "Swamp"
  hand A: "Splitting Headache"
  hand B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "Splitting Headache" mode 2 targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 0
  assert graveyard B contains "Serra Angel"
  assert graveyard A contains "Splitting Headache"
}

scenario "mode 2: only one card is discarded from a larger hand" {
  battlefield A: 4 "Swamp"
  hand A: "Splitting Headache"
  hand B: "Grizzly Bears", "Hill Giant", "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Splitting Headache" mode 2 targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 2
  assert graveyard A contains "Splitting Headache"
}

scenario "cannot be cast without enough mana" {
  battlefield A: 3 "Swamp"
  hand A: "Splitting Headache"
  hand B: "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Splitting Headache" mode 1 targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 2
  assert hand A contains "Splitting Headache"
}

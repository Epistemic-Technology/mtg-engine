# Krark-Clan Shaman: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "cannot activate without an artifact to sacrifice" {
  battlefield A: "Krark-Clan Shaman", "Grizzly Bears", "Mountain"
  battlefield B: "Hill Giant", "Serra Angel"
  illegal turn 1 A: activate "Krark-Clan Shaman"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Krark-Clan Shaman"
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert damage "Hill Giant" 0
}

scenario "lands and creatures are not artifacts for the cost" {
  battlefield A: "Krark-Clan Shaman", 3 "Mountain", "Wind Drake"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Krark-Clan Shaman"
  run_to turn 1 end
  assert battlefield B contains "Grizzly Bears"
  assert battlefield A contains 3 "Mountain"
  assert battlefield A contains "Wind Drake"
}

scenario "shaman is a 1/1 that dies to Shock" {
  battlefield A: "Mountain"
  battlefield B: "Krark-Clan Shaman"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting "Krark-Clan Shaman"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Krark-Clan Shaman"
}

scenario "shaman attacks for one" {
  battlefield A: "Krark-Clan Shaman"
  start turn 2 A
  turn 2 A: attack "Krark-Clan Shaman"
  run_to turn 2 postcombat_main
  assert life B 19
  assert power "Krark-Clan Shaman" 1
  assert toughness "Krark-Clan Shaman" 1
}

# Viashino Fangtail: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Fangtail pings a player" {
  battlefield A: "Viashino Fangtail"
  turn 1 A: activate "Viashino Fangtail" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert tapped "Viashino Fangtail"
}

scenario "Fangtail pings a creature" {
  battlefield A: "Viashino Fangtail"
  battlefield B: "Grizzly Bears"
  turn 1 A: activate "Viashino Fangtail" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert damage "Grizzly Bears" 1
  assert battlefield B contains "Grizzly Bears"
}

scenario "Fangtail ping plus Shock kills a 3-toughness creature" {
  battlefield A: "Viashino Fangtail", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Shock"
  turn 1 A: activate "Viashino Fangtail" targeting "Hill Giant"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

scenario "summoning sick Fangtail cannot tap to ping" {
  battlefield A: 4 "Mountain"
  hand A: "Viashino Fangtail"
  turn 1 A: cast "Viashino Fangtail"
  illegal turn 1 postcombat_main A: activate "Viashino Fangtail" targeting player B
  run_to turn 1 end
  assert battlefield A contains "Viashino Fangtail"
  assert life B 20
}

# Bloodhunter Bat: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Bloodhunter Bat drains target opponent on entering" {
  battlefield A: 4 "Swamp"
  hand A: "Bloodhunter Bat"
  start turn 1 A precombat_main
  turn 1 A: cast "Bloodhunter Bat"
  turn 1 A: trigger "Bloodhunter Bat" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Bloodhunter Bat"
  assert life B 18
  assert life A 22
}

scenario "Bloodhunter Bat targeting its controller nets zero" {
  battlefield A: 4 "Swamp"
  hand A: "Bloodhunter Bat"
  start turn 1 A precombat_main
  turn 1 A: cast "Bloodhunter Bat"
  turn 1 A: trigger "Bloodhunter Bat" targeting player A
  run_to turn 1 postcombat_main
  assert life A 20
  assert life B 20
}

scenario "Bloodhunter Bat flies over a ground blocker" {
  battlefield A: "Bloodhunter Bat"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Bloodhunter Bat"
  illegal turn 1 B: block "Bloodhunter Bat" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield A contains "Bloodhunter Bat"
  assert has "Bloodhunter Bat" flying
}

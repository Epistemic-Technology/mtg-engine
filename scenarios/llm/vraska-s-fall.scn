# Vraska's Fall: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "opponent sacrifices their only creature" {
  battlefield A: 3 "Swamp", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Vraska's Fall"
  start turn 1 A precombat_main
  turn 1 A: cast "Vraska's Fall"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield B lacks "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
  assert graveyard A contains "Vraska's Fall"
}

scenario "cast at instant speed on the opponent's turn" {
  battlefield A: 3 "Swamp"
  battlefield B: "Serra Angel"
  hand A: "Vraska's Fall"
  start turn 2 B precombat_main
  turn 2 A: cast "Vraska's Fall"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert life A 20
}

scenario "resolves even when the opponent has nothing to sacrifice" {
  battlefield A: 3 "Swamp", "Grizzly Bears"
  hand A: "Vraska's Fall"
  start turn 1 A precombat_main
  turn 1 A: cast "Vraska's Fall"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Vraska's Fall"
  assert battlefield A contains "Grizzly Bears"
  assert not game_over
}

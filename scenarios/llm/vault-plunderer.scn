# Vault Plunderer: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Vault Plunderer ETB targets opponent: draws and loses life" {
  battlefield A: 3 "Swamp"
  hand A: "Vault Plunderer"
  start turn 1 A precombat_main
  turn 1 A: cast "Vault Plunderer"
  turn 1 A: trigger "Vault Plunderer" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Vault Plunderer"
  assert life B 19
  assert hand B count 1
  assert life A 20
  assert hand A count 0
}

scenario "Vault Plunderer ETB targets self: you draw and lose life" {
  battlefield A: 3 "Swamp"
  hand A: "Vault Plunderer"
  start turn 1 A precombat_main
  turn 1 A: cast "Vault Plunderer"
  turn 1 A: trigger "Vault Plunderer" targeting player A
  run_to turn 1 postcombat_main
  assert life A 19
  assert hand A count 1
  assert life B 20
  assert hand B count 0
}

scenario "Vault Plunderer is a 3/1 that dies to Shock" {
  battlefield A: "Vault Plunderer"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 1 A precombat_main
  turn 1 A: wait
  turn 1 B: cast "Shock" targeting "Vault Plunderer"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Vault Plunderer"
}

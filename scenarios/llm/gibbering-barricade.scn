# Gibbering Barricade: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "sacrifice another creature to gain 1 life and draw a card" {
  battlefield A: "Gibbering Barricade", "Grizzly Bears", 3 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Gibbering Barricade" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 21
  assert hand A count 1
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Gibbering Barricade"
}

scenario "barricade may sacrifice itself to its own ability" {
  battlefield A: "Gibbering Barricade", 3 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Gibbering Barricade" sacrificing "Gibbering Barricade"
  run_to turn 1 postcombat_main
  assert life A 21
  assert hand A count 1
  assert graveyard A contains "Gibbering Barricade"
}

scenario "defender cannot attack" {
  battlefield A: "Gibbering Barricade"
  start turn 2 A
  illegal turn 2 A: attack "Gibbering Barricade"
  run_to turn 2 postcombat_main
  assert life B 20
}

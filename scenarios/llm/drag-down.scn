# Drag Down: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "three basic land types kill a 3/3" {
  battlefield A: "Swamp", "Island", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Drag Down"
  start turn 1 A precombat_main
  turn 1 A: cast "Drag Down" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Drag Down"
}

scenario "lands of one type count once" {
  battlefield A: 3 "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Drag Down"
  start turn 1 A precombat_main
  turn 1 A: cast "Drag Down" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert power "Hill Giant" 2
  assert toughness "Hill Giant" 2
}

scenario "full domain kills a 4/4" {
  battlefield A: "Swamp", "Island", "Mountain", "Forest", "Plains"
  battlefield B: "Serra Angel"
  hand A: "Drag Down"
  start turn 1 A precombat_main
  turn 1 A: cast "Drag Down" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
}

scenario "the shrink wears off at end of turn" {
  battlefield A: 3 "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Drag Down"
  start turn 1 A precombat_main
  turn 1 A: cast "Drag Down" targeting "Hill Giant"
  run_to turn 2 precombat_main
  assert power "Hill Giant" 3
  assert toughness "Hill Giant" 3
}

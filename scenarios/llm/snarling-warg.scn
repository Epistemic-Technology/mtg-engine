# Snarling Warg: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "no Goblin or Orc: Snarling Warg is 3/4" {
  battlefield A: "Snarling Warg", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Snarling Warg" 3
  assert toughness "Snarling Warg" 4
}

scenario "menace: a single creature can't block Snarling Warg" {
  battlefield A: "Grizzly Bears"
  battlefield B: "Snarling Warg"
  start turn 2 B
  turn 2 B: attack "Snarling Warg"
  illegal turn 2 A: block "Snarling Warg" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life A 17
  assert battlefield A contains "Grizzly Bears"
}

scenario "menace: two creatures can block Snarling Warg" {
  battlefield A: "Grizzly Bears", "Hill Giant"
  battlefield B: "Snarling Warg"
  start turn 2 B
  turn 2 B: attack "Snarling Warg"
  turn 2 A: block "Snarling Warg" with "Grizzly Bears"
  turn 2 A: block "Snarling Warg" with "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Snarling Warg"
}

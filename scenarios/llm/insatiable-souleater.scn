# Insatiable Souleater: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "paying green mana grants trample and excess damage tramples over" {
  battlefield A: "Insatiable Souleater", "Forest"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Insatiable Souleater"
  turn 1 A: attack "Insatiable Souleater"
  turn 1 B: block "Insatiable Souleater" with "Grizzly Bears"
  turn 1 combat_damage A: assign "Insatiable Souleater" to "Grizzly Bears" 2, player B 3
  run_to turn 1 postcombat_main
  assert life A 20
  assert tapped "Forest"
  assert life B 17
  assert graveyard B contains "Grizzly Bears"
  assert graveyard A contains "Insatiable Souleater"
}

scenario "without green mana the ability is paid with 2 life" {
  battlefield A: "Insatiable Souleater"
  start turn 1 A precombat_main
  turn 1 A: activate "Insatiable Souleater"
  run_to turn 1 begin_combat
  assert life A 18
  assert has "Insatiable Souleater" trample
}

scenario "without activation the blocked creature deals no damage to the player" {
  battlefield A: "Insatiable Souleater"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Insatiable Souleater"
  turn 1 B: block "Insatiable Souleater" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert life A 20
  assert graveyard B contains "Grizzly Bears"
  assert graveyard A contains "Insatiable Souleater"
}

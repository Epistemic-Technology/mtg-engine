# Kessig Flamebreather: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "noncreature spell triggers 1 damage to each opponent" {
  battlefield A: "Kessig Flamebreather", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
  assert life A 20
  assert graveyard A contains "Lightning Bolt"
}

scenario "creature spell does not trigger" {
  battlefield A: "Kessig Flamebreather", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert life B 20
}

scenario "pump spell on own creature still pings opponent" {
  battlefield A: "Kessig Flamebreather", "Forest"
  hand A: "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Giant Growth" targeting "Kessig Flamebreather"
  run_to turn 1 postcombat_main
  assert power "Kessig Flamebreather" 4
  assert life B 19
  assert life A 20
}

scenario "opponent's noncreature spell does not trigger" {
  battlefield B: "Kessig Flamebreather"
  battlefield A: "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert life A 20
}

# Falter: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Falter stops creatures without flying from blocking" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  hand A: "Falter"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Falter"
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 18
  assert graveyard A contains "Falter"
  assert battlefield A contains "Grizzly Bears"
}

scenario "Falter does not stop creatures with flying from blocking" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  hand A: "Falter"
  battlefield B: "Wind Drake"
  start turn 1 A precombat_main
  turn 1 A: cast "Falter"
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Wind Drake"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Wind Drake"
  assert graveyard A contains "Grizzly Bears"
}

scenario "Falter's effect ends at end of turn" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  hand A: "Falter"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Falter"
  turn 3 A: attack "Grizzly Bears"
  turn 3 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 3 postcombat_main
  assert life B 20
  assert graveyard A contains "Grizzly Bears"
  assert battlefield B contains "Hill Giant"
}

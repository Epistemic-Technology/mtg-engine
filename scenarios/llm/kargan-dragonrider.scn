# Kargan Dragonrider: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "no flying without a Dragon" {
  battlefield A: "Kargan Dragonrider", "Serra Angel"
  start turn 1 A precombat_main
  run_to turn 1 precombat_main
  assert has not "Kargan Dragonrider" flying
  assert has "Serra Angel" flying
}

scenario "without a Dragon it can be blocked by a ground creature" {
  battlefield A: "Kargan Dragonrider"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Kargan Dragonrider"
  turn 1 B: block "Kargan Dragonrider" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Kargan Dragonrider"
  assert graveyard B contains "Grizzly Bears"
}

scenario "unblocked it deals 2 damage" {
  battlefield A: "Kargan Dragonrider"
  start turn 1 A
  turn 1 A: attack "Kargan Dragonrider"
  run_to turn 1 postcombat_main
  assert life B 18
}

# Temur Runemark: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "cast Temur Runemark gives +2/+2" {
  battlefield A: "Grizzly Bears", 3 "Forest"
  hand A: "Temur Runemark"
  start turn 1 A precombat_main
  turn 1 A: cast "Temur Runemark" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Temur Runemark" to "Grizzly Bears"
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
  assert has not "Grizzly Bears" trample
}

scenario "trample with a blue permanent" {
  battlefield A: "Grizzly Bears", "Wind Drake", "Temur Runemark" on "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert has "Grizzly Bears" trample
  assert power "Grizzly Bears" 4
}

scenario "no trample with only lands and white creatures" {
  battlefield A: "Grizzly Bears", "Serra Angel", "Island", "Mountain", "Temur Runemark" on "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert has not "Grizzly Bears" trample
}

scenario "trample damage tramples over blocker" {
  battlefield A: "Grizzly Bears", "Wind Drake", "Temur Runemark" on "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Hill Giant"
  turn 1 combat_damage A: assign "Grizzly Bears" to "Hill Giant" 3, player B 1
  run_to turn 1 postcombat_main
  assert life B 19
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
}

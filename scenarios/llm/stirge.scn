# Stirge: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Blood Drain sacrifices, costs life, and draws" {
  battlefield A: "Stirge", 2 "Swamp"
  library A: "Island", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Stirge"
  run_to turn 1 postcombat_main
  assert life A 19
  assert graveyard A contains "Stirge"
  assert hand A contains "Island"
  assert hand A count 1
}

scenario "Stirge can't block" {
  battlefield A: "Stirge"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  illegal turn 2 A: block "Grizzly Bears" with "Stirge"
  run_to turn 2 postcombat_main
  assert life A 18
  assert battlefield A contains "Stirge"
}

scenario "Stirge flies over ground blockers" {
  battlefield A: "Stirge"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Stirge"
  illegal turn 1 B: block "Stirge" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 19
  assert battlefield A contains "Stirge"
}

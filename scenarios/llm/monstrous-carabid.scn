# Monstrous Carabid: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "cycling paid with black mana draws a card" {
  hand A: "Monstrous Carabid"
  battlefield A: "Swamp"
  library A: "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Monstrous Carabid"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Monstrous Carabid"
  assert hand A contains "Grizzly Bears"
  assert hand A count 1
  assert tapped "Swamp"
}

scenario "cycling paid with red mana draws a card" {
  hand A: "Monstrous Carabid"
  battlefield A: "Mountain"
  library A: "Hill Giant", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Monstrous Carabid"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Monstrous Carabid"
  assert hand A contains "Hill Giant"
  assert hand A count 1
  assert tapped "Mountain"
}

scenario "carabid attacks even when no attack is declared" {
  battlefield A: "Monstrous Carabid"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert life B 16
  assert tapped "Monstrous Carabid"
}

scenario "carabid is forced to attack into a blocker" {
  battlefield A: "Monstrous Carabid"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 B: block "Monstrous Carabid" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Hill Giant"
  assert damage "Monstrous Carabid" 3
}

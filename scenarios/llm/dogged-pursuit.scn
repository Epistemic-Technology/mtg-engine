# Dogged Pursuit: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "drains at the beginning of your end step" {
  battlefield A: "Dogged Pursuit"
  start turn 1 A precombat_main
  run_to turn 2 upkeep
  assert life B 19
  assert life A 21
}

scenario "does not trigger on opponent's end step" {
  battlefield A: "Dogged Pursuit"
  start turn 2 B precombat_main
  run_to turn 3 upkeep
  assert life B 20
  assert life A 20
}

scenario "triggers each of your turns" {
  battlefield A: "Dogged Pursuit"
  start turn 1 A precombat_main
  run_to turn 4 upkeep
  assert life B 18
  assert life A 22
}

# Totem-Guide Hartebeest: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Hartebeest enters and the search finds no Aura" {
  battlefield A: 5 "Plains"
  hand A: "Totem-Guide Hartebeest"
  library A: "Plains", "Island", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Totem-Guide Hartebeest"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Totem-Guide Hartebeest"
  assert hand A count 0
  assert stack count 0
}

scenario "declining the search still leaves the creature on the battlefield" {
  battlefield A: 5 "Plains"
  hand A: "Totem-Guide Hartebeest"
  start turn 1 A precombat_main
  turn 1 A: cast "Totem-Guide Hartebeest"
  turn 1 A: decline "Totem-Guide Hartebeest"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Totem-Guide Hartebeest"
  assert hand A count 0
}

scenario "a 2/5 body survives Lightning Bolt" {
  battlefield A: "Totem-Guide Hartebeest"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Totem-Guide Hartebeest"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Totem-Guide Hartebeest"
  assert damage "Totem-Guide Hartebeest" 3
  assert power "Totem-Guide Hartebeest" 2
  assert toughness "Totem-Guide Hartebeest" 5
}

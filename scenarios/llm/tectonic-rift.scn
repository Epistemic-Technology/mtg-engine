# Tectonic Rift: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Tectonic Rift destroys target land" {
  battlefield A: 4 "Mountain"
  battlefield B: "Forest", "Plains"
  hand A: "Tectonic Rift"
  start turn 1 A precombat_main
  turn 1 A: cast "Tectonic Rift" targeting B "Forest"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Forest"
  assert battlefield B contains "Plains"
  assert graveyard A contains "Tectonic Rift"
}

scenario "Tectonic Rift stops creatures without flying from blocking" {
  battlefield A: 4 "Mountain", "Hill Giant"
  battlefield B: "Plains", "Grizzly Bears"
  hand A: "Tectonic Rift"
  start turn 1 A precombat_main
  turn 1 A: cast "Tectonic Rift" targeting B "Plains"
  turn 1 A: attack "Hill Giant"
  illegal turn 1 B: block "Hill Giant" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 17
  assert battlefield B contains "Grizzly Bears"
  assert graveyard B contains "Plains"
}

scenario "Tectonic Rift lets creatures with flying block" {
  battlefield A: 4 "Mountain", "Hill Giant"
  battlefield B: "Plains", "Wind Drake"
  hand A: "Tectonic Rift"
  start turn 1 A precombat_main
  turn 1 A: cast "Tectonic Rift" targeting B "Plains"
  turn 1 A: attack "Hill Giant"
  turn 1 B: block "Hill Giant" with "Wind Drake"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Wind Drake"
  assert battlefield A contains "Hill Giant"
}

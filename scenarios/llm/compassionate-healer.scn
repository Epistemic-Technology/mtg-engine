# Compassionate Healer: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "attacking taps the healer: gain 1 life and scry 1" {
  battlefield A: "Compassionate Healer"
  start turn 1 A precombat_main
  turn 1 A: attack "Compassionate Healer"
  run_to turn 1 postcombat_main
  assert tapped "Compassionate Healer"
  assert life A 21
  assert life B 18
  assert library A count 40
}

scenario "no trigger while it stays untapped" {
  battlefield A: "Compassionate Healer"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert untapped "Compassionate Healer"
  assert life A 20
}

scenario "blocking does not tap it, so no life is gained" {
  battlefield A: "Compassionate Healer"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Compassionate Healer"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard A contains "Compassionate Healer"
  assert graveyard B contains "Grizzly Bears"
}

scenario "each attack triggers again" {
  battlefield A: "Compassionate Healer"
  start turn 1 A precombat_main
  turn 1 A: attack "Compassionate Healer"
  turn 3 A: attack "Compassionate Healer"
  run_to turn 3 postcombat_main
  assert life A 22
  assert life B 16
}

# Nexus Wardens: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "reach lets Nexus Wardens block a flier" {
  battlefield A: "Nexus Wardens"
  battlefield B: "Wind Drake"
  start turn 2 B
  turn 2 B: attack "Wind Drake"
  turn 2 A: block "Wind Drake" with "Nexus Wardens"
  run_to turn 2 postcombat_main
  assert life A 20
  assert damage "Nexus Wardens" 2
  assert battlefield A contains "Nexus Wardens"
}

scenario "a non-enchantment creature entering gains no life" {
  battlefield A: "Nexus Wardens", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert life A 20
}

scenario "Nexus Wardens entering does not trigger constellation" {
  battlefield A: 3 "Forest"
  hand A: "Nexus Wardens"
  start turn 1 A precombat_main
  turn 1 A: cast "Nexus Wardens"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Nexus Wardens"
  assert has "Nexus Wardens" reach
  assert life A 20
}

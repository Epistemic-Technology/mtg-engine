# Valakut Invoker: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Valakut Invoker deals 3 damage to a player for {8}" {
  battlefield A: "Valakut Invoker", 8 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Valakut Invoker" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert untapped "Valakut Invoker"
}

scenario "Valakut Invoker kills a 3-toughness creature" {
  battlefield A: "Valakut Invoker", 8 "Mountain"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Valakut Invoker" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert life B 20
}

scenario "Valakut Invoker cannot activate with only seven lands" {
  battlefield A: "Valakut Invoker", 7 "Mountain"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Valakut Invoker" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
}

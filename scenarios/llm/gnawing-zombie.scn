# Gnawing Zombie: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "sacrifice another creature to drain" {
  battlefield A: "Gnawing Zombie", "Grizzly Bears", 2 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Gnawing Zombie" sacrificing "Grizzly Bears" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert life A 21
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Gnawing Zombie"
  assert tapped oldest A "Swamp"
}

scenario "zombie can sacrifice itself" {
  battlefield A: "Gnawing Zombie", 2 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Gnawing Zombie" sacrificing "Gnawing Zombie" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert life A 21
  assert graveyard A contains "Gnawing Zombie"
}

scenario "can target yourself" {
  battlefield A: "Gnawing Zombie", "Grizzly Bears", 2 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Gnawing Zombie" sacrificing "Grizzly Bears" targeting player A
  run_to turn 1 postcombat_main
  assert life A 20
  assert life B 20
  assert graveyard A contains "Grizzly Bears"
}

scenario "cannot activate without enough mana" {
  battlefield A: "Gnawing Zombie", "Grizzly Bears", "Swamp"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Gnawing Zombie" sacrificing "Grizzly Bears" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
  assert battlefield A contains "Grizzly Bears"
}

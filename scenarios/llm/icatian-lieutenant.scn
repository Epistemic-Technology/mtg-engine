# Icatian Lieutenant: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "lieutenant pumps a soldier until end of turn" {
  battlefield A: "Icatian Lieutenant", 2 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Icatian Lieutenant" targeting "Icatian Lieutenant"
  run_to turn 1 postcombat_main
  assert power "Icatian Lieutenant" 2
  assert toughness "Icatian Lieutenant" 2
  assert tapped oldest "Plains"
  assert tapped newest "Plains"
  run_to turn 2 precombat_main
  assert power "Icatian Lieutenant" 1
}

scenario "pumped lieutenant attacks for 2" {
  battlefield A: "Icatian Lieutenant", 2 "Plains"
  start turn 3 A precombat_main
  turn 3 A: activate "Icatian Lieutenant" targeting "Icatian Lieutenant"
  turn 3 A: attack "Icatian Lieutenant"
  run_to turn 3 postcombat_main
  assert life B 18
}

scenario "pumped blocking lieutenant trades with a bear" {
  battlefield A: "Icatian Lieutenant", 2 "Plains"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Icatian Lieutenant"
  turn 2 declare_blockers A: activate "Icatian Lieutenant" targeting "Icatian Lieutenant"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert graveyard A contains "Icatian Lieutenant"
  assert life A 20
}

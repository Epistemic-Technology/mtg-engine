# Corrupt Court Official: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enters trigger makes target opponent discard their only card" {
  battlefield A: 2 "Swamp"
  hand A: "Corrupt Court Official"
  hand B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Corrupt Court Official"
  turn 1 A: trigger "Corrupt Court Official" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Corrupt Court Official"
  assert graveyard B contains "Hill Giant"
  assert hand B count 0
}

scenario "opponent with two cards discards exactly one" {
  battlefield A: 2 "Swamp"
  hand A: "Corrupt Court Official"
  hand B: "Hill Giant", "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Corrupt Court Official"
  turn 1 A: trigger "Corrupt Court Official" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 1
  assert hand A count 0
}

scenario "trigger with an empty opponent hand does nothing" {
  battlefield A: 2 "Swamp"
  hand A: "Corrupt Court Official"
  start turn 1 A precombat_main
  turn 1 A: cast "Corrupt Court Official"
  turn 1 A: trigger "Corrupt Court Official" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Corrupt Court Official"
  assert hand B count 0
  assert stack count 0
}

# Phalanx Vanguard: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "vigilance: attacks without tapping" {
  battlefield A: "Phalanx Vanguard"
  start turn 1 A precombat_main
  turn 1 A: attack "Phalanx Vanguard"
  run_to turn 1 postcombat_main
  assert life B 18
  assert untapped "Phalanx Vanguard"
}

scenario "a creature entering is not an artifact and gives no bonus" {
  battlefield A: "Phalanx Vanguard", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 begin_combat
  assert battlefield A contains "Grizzly Bears"
  assert power "Phalanx Vanguard" 2
  assert toughness "Phalanx Vanguard" 2
}

scenario "a land entering gives no bonus" {
  battlefield A: "Phalanx Vanguard"
  hand A: "Plains"
  start turn 1 A precombat_main
  turn 1 A: play "Plains"
  run_to turn 1 begin_combat
  assert battlefield A contains "Plains"
  assert power "Phalanx Vanguard" 2
}

# Wistful Thinking: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "opponent draws two then discards four" {
  battlefield A: 3 "Island"
  hand A: "Wistful Thinking"
  hand B: 5 "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Wistful Thinking" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 3
  assert graveyard A contains "Wistful Thinking"
  assert graveyard B contains "Forest"
}

scenario "targeting yourself with a small hand discards everything" {
  battlefield A: 3 "Island"
  hand A: "Wistful Thinking", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Wistful Thinking" targeting player A
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Wistful Thinking"
}

scenario "empty-handed target discards both drawn cards" {
  battlefield A: 3 "Island"
  hand A: "Wistful Thinking"
  library B: "Hill Giant", "Serra Angel", "Wind Drake"
  start turn 1 A precombat_main
  turn 1 A: cast "Wistful Thinking" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 0
  assert graveyard B contains "Hill Giant"
  assert graveyard B contains "Serra Angel"
  assert library B contains "Wind Drake"
}

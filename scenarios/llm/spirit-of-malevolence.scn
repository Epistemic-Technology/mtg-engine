# Spirit of Malevolence: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "dies to an opponent's burn: opponent loses 1, controller gains 1" {
  battlefield A: "Spirit of Malevolence"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 B: cast "Lightning Bolt" targeting "Spirit of Malevolence"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Spirit of Malevolence"
  assert life B 19
  assert life A 21
}

scenario "dies in combat trading with a blocker" {
  battlefield A: "Spirit of Malevolence"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Spirit of Malevolence"
  turn 1 B: block "Spirit of Malevolence" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Spirit of Malevolence"
  assert graveyard B contains "Grizzly Bears"
  assert life B 19
  assert life A 21
}

scenario "triggers when its controller destroys it" {
  battlefield A: "Spirit of Malevolence", 3 "Swamp"
  hand A: "Murder"
  start turn 1 A precombat_main
  turn 1 A: cast "Murder" targeting "Spirit of Malevolence"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Spirit of Malevolence"
  assert life B 19
  assert life A 21
}

scenario "no trigger while it lives" {
  battlefield A: "Spirit of Malevolence"
  start turn 1 A precombat_main
  turn 1 A: attack "Spirit of Malevolence"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Spirit of Malevolence"
  assert life B 18
  assert life A 20
}

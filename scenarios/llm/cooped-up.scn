# Cooped Up: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "cooped up creature can't attack" {
  battlefield A: 2 "Plains"
  hand A: "Cooped Up"
  battlefield B: "Grizzly Bears", "Hill Giant"
  turn 1 A: cast "Cooped Up" targeting "Grizzly Bears"
  illegal turn 2 B: attack "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert attached "Cooped Up" to "Grizzly Bears"
  assert life A 20
}

scenario "cooped up creature can't block" {
  battlefield B: "Grizzly Bears", "Wind Drake"
  battlefield A: "Hill Giant", "Cooped Up" on "Grizzly Bears"
  turn 1 A: attack "Hill Giant"
  illegal turn 1 B: block "Hill Giant" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 17
  assert battlefield B contains "Grizzly Bears"
}

scenario "activated ability exiles enchanted creature" {
  battlefield A: 5 "Plains"
  hand A: "Cooped Up"
  battlefield B: "Grizzly Bears"
  turn 1 A: cast "Cooped Up" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: activate "Cooped Up"
  run_to turn 1 postcombat_main
  assert exile B contains "Grizzly Bears"
  assert battlefield B lacks "Grizzly Bears"
  assert graveyard A contains "Cooped Up"
}

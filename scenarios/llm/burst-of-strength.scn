# Burst of Strength: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "counter and untap on a tapped creature" {
  battlefield A: "Grizzly Bears" tapped, "Forest"
  hand A: "Burst of Strength"
  start turn 1 A precombat_main
  turn 1 A: cast "Burst of Strength" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert untapped "Grizzly Bears"
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 3
  assert graveyard A contains "Burst of Strength"
}

scenario "can target an untapped creature" {
  battlefield A: "Forest"
  battlefield B: "Hill Giant"
  hand A: "Burst of Strength"
  start turn 1 A precombat_main
  turn 1 A: cast "Burst of Strength" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 1
  assert untapped "Hill Giant"
  assert power "Hill Giant" 4
}

scenario "untap an attacker mid-combat, counter adds damage" {
  battlefield A: "Grizzly Bears", "Forest"
  hand A: "Burst of Strength"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 declare_blockers A: cast "Burst of Strength" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 17
  assert untapped "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 1
}

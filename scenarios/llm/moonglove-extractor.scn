# Moonglove Extractor: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "attacking draws a card and loses 1 life" {
  battlefield A: "Moonglove Extractor"
  start turn 1 A
  turn 1 A: attack "Moonglove Extractor"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert life A 19
  assert life B 18
}

scenario "trigger resolves even when the attacker is blocked and dies" {
  battlefield A: "Moonglove Extractor"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Moonglove Extractor"
  turn 1 B: block "Moonglove Extractor" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert life A 19
  assert life B 20
  assert graveyard A contains "Moonglove Extractor"
  assert graveyard B contains "Grizzly Bears"
}

scenario "no trigger without attacking" {
  battlefield A: "Moonglove Extractor"
  start turn 1 A
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert life A 20
  assert life B 20
}

scenario "Lightning Bolt in response still lets the trigger resolve" {
  battlefield A: "Moonglove Extractor"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 1 A
  turn 1 A: attack "Moonglove Extractor"
  turn 1 declare_attackers B: cast "Lightning Bolt" targeting "Moonglove Extractor"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Moonglove Extractor"
  assert hand A count 1
  assert life A 19
  assert life B 20
}

# Kithkin Shielddare: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Shielddare pumps a blocking creature so it survives and kills the attacker" {
  battlefield A: "Kithkin Shielddare", "Grizzly Bears", "Plains"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Grizzly Bears"
  turn 2 declare_blockers A: activate "Kithkin Shielddare" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
  assert damage "Grizzly Bears" 3
  assert tapped "Kithkin Shielddare"
  assert life A 20
}

scenario "Shielddare pump wears off at end of turn" {
  battlefield A: "Kithkin Shielddare", "Grizzly Bears", "Plains"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Grizzly Bears"
  turn 2 declare_blockers A: activate "Kithkin Shielddare" targeting "Grizzly Bears"
  run_to turn 3 precombat_main
  assert battlefield A contains "Grizzly Bears"
  assert power "Grizzly Bears" 2
  assert toughness "Grizzly Bears" 2
}

scenario "Shielddare cannot target a creature that is not blocking" {
  battlefield A: "Kithkin Shielddare", "Grizzly Bears", "Plains"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Kithkin Shielddare" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert untapped "Kithkin Shielddare"
  assert power "Grizzly Bears" 2
}

scenario "Shielddare cannot target an attacking creature" {
  battlefield A: "Kithkin Shielddare", "Plains"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  illegal turn 2 declare_blockers A: activate "Kithkin Shielddare" targeting B "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 17
  assert power "Hill Giant" 3
  assert untapped "Kithkin Shielddare"
}

# Sunshower Druid: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Sunshower Druid puts a counter on another creature and gains 1 life" {
  battlefield A: "Forest", "Grizzly Bears"
  hand A: "Sunshower Druid"
  start turn 1 A precombat_main
  turn 1 A: cast "Sunshower Druid"
  turn 1 A: trigger "Sunshower Druid" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Sunshower Druid"
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 3
  assert life A 21
}

scenario "Sunshower Druid can target itself" {
  battlefield A: "Forest"
  hand A: "Sunshower Druid"
  start turn 1 A precombat_main
  turn 1 A: cast "Sunshower Druid"
  turn 1 A: trigger "Sunshower Druid" targeting "Sunshower Druid"
  run_to turn 1 postcombat_main
  assert counters "Sunshower Druid" +1/+1 1
  assert power "Sunshower Druid" 1
  assert toughness "Sunshower Druid" 3
  assert life A 21
}

scenario "Sunshower Druid can target an opponent's creature and you still gain life" {
  battlefield A: "Forest"
  battlefield B: "Hill Giant"
  hand A: "Sunshower Druid"
  start turn 1 A precombat_main
  turn 1 A: cast "Sunshower Druid"
  turn 1 A: trigger "Sunshower Druid" targeting B "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 1
  assert power "Hill Giant" 4
  assert life A 21
  assert life B 20
}

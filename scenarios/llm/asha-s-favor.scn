# Asha's Favor: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enchanted creature gains flying and vigilance" {
  battlefield A: 3 "Plains", "Grizzly Bears"
  hand A: "Asha's Favor"
  turn 1 A: cast "Asha's Favor" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Asha's Favor" to "Grizzly Bears"
  assert has "Grizzly Bears" flying
  assert has "Grizzly Bears" vigilance
}

scenario "vigilance keeps the attacker untapped and flying evades ground blockers" {
  battlefield A: "Grizzly Bears", "Asha's Favor" on "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 2 A
  turn 2 A: attack "Grizzly Bears"
  illegal turn 2 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 2 postcombat_main
  assert life B 18
  assert untapped "Grizzly Bears"
}

scenario "first strike and flying let the enchanted creature block and kill a flier unharmed" {
  battlefield A: "Grizzly Bears", "Asha's Favor" on "Grizzly Bears"
  battlefield B: "Wind Drake"
  start turn 2 B
  turn 2 B: attack "Wind Drake"
  turn 2 A: block "Wind Drake" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Wind Drake"
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert life A 20
}

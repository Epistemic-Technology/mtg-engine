# Gemhide Sliver: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Gemhide Sliver taps itself for red mana" {
  battlefield A: "Gemhide Sliver"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert tapped "Gemhide Sliver"
  assert graveyard A contains "Lightning Bolt"
}

scenario "two Slivers each tap for mana" {
  battlefield A: 2 "Gemhide Sliver"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert tapped oldest "Gemhide Sliver"
  assert tapped newest "Gemhide Sliver"
}

scenario "non-Slivers do not gain the mana ability" {
  battlefield A: "Gemhide Sliver" tapped, "Grizzly Bears"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
  assert hand A count 1
  assert untapped "Grizzly Bears"
}

# Unburied Earthcarver: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "sacrificing another creature puts a +1/+1 counter on Earthcarver" {
  battlefield A: "Unburied Earthcarver", "Grizzly Bears", 2 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Unburied Earthcarver" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Unburied Earthcarver" +1/+1 1
  assert power "Unburied Earthcarver" 3
  assert toughness "Unburied Earthcarver" 3
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A lacks "Grizzly Bears"
}

scenario "Earthcarver cannot sacrifice itself" {
  battlefield A: "Unburied Earthcarver", 2 "Swamp"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Unburied Earthcarver"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Unburied Earthcarver"
  assert power "Unburied Earthcarver" 2
}

scenario "ability needs two mana" {
  battlefield A: "Unburied Earthcarver", "Grizzly Bears", "Swamp"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Unburied Earthcarver" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert power "Unburied Earthcarver" 2
}

scenario "two activations give two counters" {
  battlefield A: "Unburied Earthcarver", "Grizzly Bears", "Hill Giant", 4 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Unburied Earthcarver" sacrificing "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: activate "Unburied Earthcarver" sacrificing "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Unburied Earthcarver" +1/+1 2
  assert power "Unburied Earthcarver" 4
  assert graveyard A contains "Hill Giant"
}

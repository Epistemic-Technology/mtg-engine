# Welder Automaton: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Welder Automaton pings each opponent for 1" {
  battlefield A: "Welder Automaton", 4 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Welder Automaton"
  run_to turn 1 postcombat_main
  assert life B 19
  assert life A 20
  assert tapped oldest A "Mountain"
  assert battlefield A contains "Welder Automaton"
}

scenario "Welder Automaton can be activated more than once per turn" {
  battlefield A: "Welder Automaton", 8 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Welder Automaton"
  turn 1 postcombat_main A: activate "Welder Automaton"
  run_to turn 1 end
  assert life B 18
  assert life A 20
}

scenario "Welder Automaton cannot be activated without enough mana" {
  battlefield A: "Welder Automaton", 3 "Mountain"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Welder Automaton"
  run_to turn 1 postcombat_main
  assert life B 20
  assert untapped "Welder Automaton"
}

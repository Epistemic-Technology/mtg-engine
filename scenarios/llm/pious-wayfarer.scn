# Pious Wayfarer: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "a nonenchantment creature entering does not trigger constellation" {
  battlefield A: "Pious Wayfarer", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert stack count 0
  assert power "Pious Wayfarer" 1
  assert toughness "Pious Wayfarer" 2
  assert power "Grizzly Bears" 2
}

scenario "casting the wayfarer itself does not trigger it" {
  battlefield A: "Plains"
  hand A: "Pious Wayfarer"
  start turn 1 A precombat_main
  turn 1 A: cast "Pious Wayfarer"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Pious Wayfarer"
  assert power "Pious Wayfarer" 1
  assert toughness "Pious Wayfarer" 2
}

scenario "the wayfarer attacks as a 1/2" {
  battlefield A: "Pious Wayfarer"
  start turn 2 A
  turn 2 A: attack "Pious Wayfarer"
  run_to turn 2 postcombat_main
  assert life B 19
}

scenario "shock kills the 1/2 wayfarer" {
  battlefield A: "Pious Wayfarer"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Pious Wayfarer"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Pious Wayfarer"
}

# Arcane Spyglass: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "sacrificing a land draws a card" {
  battlefield A: "Arcane Spyglass", 2 "Island", "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Arcane Spyglass" ability 1 sacrificing "Plains"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert graveyard A contains "Plains"
  assert tapped "Arcane Spyglass"
}

scenario "three charge counters are removed to draw a card" {
  battlefield A: "Arcane Spyglass", 6 "Island", 3 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Arcane Spyglass" ability 1 sacrificing "Plains"
  turn 3 A: activate "Arcane Spyglass" ability 1 sacrificing "Plains"
  illegal turn 3 postcombat_main A: activate "Arcane Spyglass" ability 2
  turn 5 A: activate "Arcane Spyglass" ability 1 sacrificing "Plains"
  turn 5 postcombat_main A: activate "Arcane Spyglass" ability 2
  run_to turn 5 end
  assert hand A count 6
  assert graveyard A contains 3 "Plains"
}

scenario "the counter ability can't be activated with too few counters" {
  battlefield A: "Arcane Spyglass", 2 "Island", "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Arcane Spyglass" ability 1 sacrificing "Plains"
  illegal turn 1 postcombat_main A: activate "Arcane Spyglass" ability 2
  run_to turn 1 end
  assert hand A count 1
}

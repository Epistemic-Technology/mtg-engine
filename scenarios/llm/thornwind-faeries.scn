# Thornwind Faeries: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Thornwind Faeries pings a player" {
  battlefield A: "Thornwind Faeries"
  turn 1 A: activate "Thornwind Faeries" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert tapped "Thornwind Faeries"
}

scenario "Thornwind Faeries pings a creature" {
  battlefield A: "Thornwind Faeries"
  battlefield B: "Grizzly Bears"
  turn 1 A: activate "Thornwind Faeries" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert damage "Grizzly Bears" 1
  assert battlefield B contains "Grizzly Bears"
}

scenario "Thornwind Faeries kills a 1/1 creature" {
  battlefield A: "Thornwind Faeries"
  battlefield B: "Thornwind Faeries"
  turn 1 A: activate "Thornwind Faeries" targeting B "Thornwind Faeries"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Thornwind Faeries"
  assert battlefield A contains "Thornwind Faeries"
}

scenario "Thornwind Faeries flies over ground blockers" {
  battlefield A: "Thornwind Faeries"
  battlefield B: "Grizzly Bears"
  turn 1 A: attack "Thornwind Faeries"
  illegal turn 1 B: block "Thornwind Faeries" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 19
}

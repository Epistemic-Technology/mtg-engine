# Deception: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Deception makes the target opponent discard two cards" {
  battlefield A: 3 "Swamp"
  hand A: "Deception"
  hand B: "Grizzly Bears", "Hill Giant", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Deception" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 1
  assert graveyard A contains "Deception"
  assert tapped oldest A "Swamp"
}

scenario "Deception with only one card in the opponent's hand discards it" {
  battlefield A: 3 "Swamp"
  hand A: "Deception"
  hand B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "Deception" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 0
  assert graveyard B contains "Serra Angel"
}

scenario "Deception's only legal target is the opponent, not its caster" {
  battlefield A: 3 "Swamp"
  hand A: "Deception", "Grizzly Bears", "Hill Giant"
  hand B: "Wind Drake", "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Deception" targeting auto
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert hand B count 0
  assert graveyard B contains "Wind Drake"
  assert graveyard B contains "Shock"
}

# Rabid Rats: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "rabid rats shrinks a blocker so the attacker survives" {
  battlefield A: "Rabid Rats", "Grizzly Bears"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Grizzly Bears"
  turn 1 declare_blockers A: activate "Rabid Rats" targeting B "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert tapped "Rabid Rats"
  assert graveyard B contains "Grizzly Bears"
  assert battlefield A contains "Grizzly Bears"
  assert damage A "Grizzly Bears" 1
}

scenario "rabid rats lets a 3-power attacker kill a 4/4 blocker" {
  battlefield A: "Rabid Rats", "Hill Giant"
  battlefield B: "Serra Angel"
  start turn 1 A
  turn 1 A: attack "Hill Giant"
  turn 1 B: block "Hill Giant" with "Serra Angel"
  turn 1 declare_blockers A: activate "Rabid Rats" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert graveyard A contains "Hill Giant"
}

scenario "rabid rats cannot target a creature that is not blocking" {
  battlefield A: "Rabid Rats"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Rabid Rats" targeting B "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert untapped "Rabid Rats"
  assert toughness B "Grizzly Bears" 2
}

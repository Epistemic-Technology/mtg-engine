# Ethereal Guidance: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Ethereal Guidance pumps only your creatures until end of turn" {
  battlefield A: "Grizzly Bears", "Hill Giant", 3 "Plains"
  battlefield B: "Serra Angel"
  hand A: "Ethereal Guidance"
  start turn 1 A precombat_main
  turn 1 A: cast "Ethereal Guidance"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 3
  assert power "Hill Giant" 5
  assert toughness "Hill Giant" 4
  assert power "Serra Angel" 4
  assert toughness "Serra Angel" 4
  assert graveyard A contains "Ethereal Guidance"
  run_to turn 2 precombat_main
  assert power "Grizzly Bears" 2
  assert toughness "Grizzly Bears" 2
  assert power "Hill Giant" 3
}

scenario "Ethereal Guidance adds combat damage" {
  battlefield A: "Grizzly Bears", 3 "Plains"
  hand A: "Ethereal Guidance"
  start turn 1 A precombat_main
  turn 1 A: cast "Ethereal Guidance"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "creatures arriving after Ethereal Guidance resolves are not pumped" {
  battlefield A: "Hill Giant", 3 "Plains", 3 "Forest"
  hand A: "Ethereal Guidance", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Ethereal Guidance"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert power "Grizzly Bears" 2
  assert toughness "Grizzly Bears" 2
  assert power "Hill Giant" 5
  assert toughness "Hill Giant" 4
}

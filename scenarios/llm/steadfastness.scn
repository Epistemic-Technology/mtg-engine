# Steadfastness: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Steadfastness pumps only your creatures" {
  battlefield A: "Grizzly Bears", "Hill Giant", 2 "Plains"
  battlefield B: "Serra Angel"
  hand A: "Steadfastness"
  start turn 1 A precombat_main
  turn 1 A: cast "Steadfastness"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Steadfastness"
  assert power "Grizzly Bears" 2
  assert toughness "Grizzly Bears" 5
  assert power "Hill Giant" 3
  assert toughness "Hill Giant" 6
  assert toughness "Serra Angel" 4
}

scenario "Steadfastness lets a creature survive Lightning Bolt" {
  battlefield A: "Grizzly Bears", 2 "Plains", "Mountain"
  hand A: "Steadfastness", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Steadfastness"
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 3
}

scenario "Steadfastness wears off at end of turn" {
  battlefield A: "Grizzly Bears", 2 "Plains"
  hand A: "Steadfastness"
  start turn 1 A precombat_main
  turn 1 A: cast "Steadfastness"
  run_to turn 1 postcombat_main
  assert toughness "Grizzly Bears" 5
  run_to turn 2 precombat_main
  assert toughness "Grizzly Bears" 2
}

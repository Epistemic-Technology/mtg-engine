# Sentinel Sliver: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Sentinel Sliver attacks without tapping; non-Sliver taps" {
  battlefield A: "Sentinel Sliver", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Sentinel Sliver", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 16
  assert untapped "Sentinel Sliver"
  assert tapped "Grizzly Bears"
}

scenario "only Sliver creatures you control gain vigilance" {
  battlefield A: "Sentinel Sliver", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  run_to turn 1 precombat_main
  assert has "Sentinel Sliver" vigilance
  assert has not "Grizzly Bears" vigilance
  assert has not "Hill Giant" vigilance
}

scenario "two Slivers both attack untapped, and one keeps vigilance after the other dies" {
  battlefield A: 2 "Sentinel Sliver", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: attack "Sentinel Sliver", "Sentinel Sliver"
  run_to turn 1 postcombat_main
  assert life B 16
  assert untapped oldest "Sentinel Sliver"
  assert untapped newest "Sentinel Sliver"
}

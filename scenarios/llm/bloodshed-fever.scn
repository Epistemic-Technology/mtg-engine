# Bloodshed Fever: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enchanted creature attacks without being told to, others stay home" {
  battlefield A: "Grizzly Bears", "Hill Giant", "Bloodshed Fever" on "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert life B 18
  assert tapped "Grizzly Bears"
  assert untapped "Hill Giant"
}

scenario "cast on an opponent's creature forces it to attack" {
  battlefield A: "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Bloodshed Fever"
  start turn 1 A precombat_main
  turn 1 A: cast "Bloodshed Fever" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert attached "Bloodshed Fever" to "Grizzly Bears"
  assert life A 18
}

scenario "a tapped enchanted creature is not able to attack" {
  battlefield A: "Grizzly Bears" tapped, "Bloodshed Fever" on "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert life B 20
  assert not game_over
}

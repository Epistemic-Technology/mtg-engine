# Rakshasa's Secret: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "target opponent discards two cards" {
  battlefield A: "Swamp", 2 "Plains"
  hand A: "Rakshasa's Secret"
  hand B: "Lightning Bolt", "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Rakshasa's Secret" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 0
  assert graveyard B contains "Lightning Bolt"
  assert graveyard B contains "Shock"
  assert graveyard A contains "Rakshasa's Secret"
}

scenario "caster mills the top two cards of their library" {
  battlefield A: "Swamp", 2 "Plains"
  hand A: "Rakshasa's Secret"
  hand B: "Lightning Bolt", "Shock"
  library A: "Grizzly Bears", "Hill Giant", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "Rakshasa's Secret" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Hill Giant"
  assert graveyard A lacks "Serra Angel"
  assert library A contains "Serra Angel"
}

scenario "opponent with three cards keeps one" {
  battlefield A: "Swamp", 2 "Plains"
  hand A: "Rakshasa's Secret"
  hand B: "Lightning Bolt", "Shock", "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Rakshasa's Secret" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 1
  assert hand A count 0
}

# Death Cultist: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Death Cultist drains target opponent" {
  battlefield A: "Death Cultist"
  start turn 1 A precombat_main
  turn 1 A: activate "Death Cultist" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert life A 21
  assert graveyard A contains "Death Cultist"
  assert battlefield A lacks "Death Cultist"
}

scenario "Death Cultist sacrificed in response to removal still drains" {
  battlefield A: "Death Cultist"
  battlefield B: 2 "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Death Cultist"
  turn 2 A: activate "Death Cultist" targeting player B
  run_to turn 2 postcombat_main
  assert life B 19
  assert life A 21
  assert graveyard A contains "Death Cultist"
  assert graveyard B contains "Lightning Bolt"
}

scenario "Death Cultist can target its controller" {
  battlefield A: "Death Cultist"
  life A 10
  start turn 1 A precombat_main
  turn 1 A: activate "Death Cultist" targeting player A
  run_to turn 1 postcombat_main
  assert life A 10
  assert life B 20
  assert graveyard A contains "Death Cultist"
}

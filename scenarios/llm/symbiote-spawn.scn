# Symbiote Spawn: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "dying to its controller's burn drains the opponent" {
  battlefield A: "Symbiote Spawn", "Mountain"
  hand A: "Lightning Bolt"
  turn 1 A: cast "Lightning Bolt" targeting "Symbiote Spawn"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Symbiote Spawn"
  assert life A 22
  assert life B 18
}

scenario "dying in combat drains the opponent" {
  battlefield A: "Symbiote Spawn"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Symbiote Spawn"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Symbiote Spawn"
  assert graveyard B contains "Hill Giant"
  assert life A 22
  assert life B 18
}

scenario "opponent's removal still triggers the drain for its controller" {
  battlefield A: "Symbiote Spawn"
  battlefield B: 3 "Swamp"
  hand B: "Murder"
  start turn 2 B
  turn 2 B: cast "Murder" targeting "Symbiote Spawn"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Symbiote Spawn"
  assert life A 22
  assert life B 18
}

# Parasitic Strix: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "strix enters without a black permanent: no drain" {
  battlefield A: 2 "Island", "Swamp"
  hand A: "Parasitic Strix"
  start turn 1 A precombat_main
  turn 1 A: cast "Parasitic Strix"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Parasitic Strix"
  assert life A 20
  assert life B 20
}

scenario "strix flies over a ground creature" {
  battlefield A: "Parasitic Strix"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Parasitic Strix"
  illegal turn 1 B: block "Parasitic Strix" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield A contains "Parasitic Strix"
}

scenario "a flier can block the strix" {
  battlefield A: "Parasitic Strix"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: attack "Parasitic Strix"
  turn 1 B: block "Parasitic Strix" with "Serra Angel"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Parasitic Strix"
  assert battlefield B contains "Serra Angel"
}

# Screeching Soulbreaker: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "attack trigger drains each opponent and gains life" {
  battlefield A: "Screeching Soulbreaker"
  start turn 1 A precombat_main
  turn 1 A: attack "Screeching Soulbreaker"
  run_to turn 1 postcombat_main
  assert life B 18
  assert life A 21
}

scenario "trigger happens even when blocked" {
  battlefield A: "Screeching Soulbreaker"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: attack "Screeching Soulbreaker"
  turn 1 B: block "Screeching Soulbreaker" with "Serra Angel"
  run_to turn 1 postcombat_main
  assert life B 19
  assert life A 21
  assert graveyard A contains "Screeching Soulbreaker"
  assert damage "Serra Angel" 1
}

scenario "flying evades ground blockers" {
  battlefield A: "Screeching Soulbreaker"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Screeching Soulbreaker"
  illegal turn 1 B: block "Screeching Soulbreaker" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert has "Screeching Soulbreaker" flying
  assert life B 18
}

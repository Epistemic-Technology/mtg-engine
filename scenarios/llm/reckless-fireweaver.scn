# Reckless Fireweaver: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "nonartifact creature entering does not trigger Fireweaver" {
  battlefield A: "Reckless Fireweaver", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert life B 20
  assert life A 20
}

scenario "Fireweaver itself entering deals no damage" {
  battlefield A: 2 "Mountain"
  hand A: "Reckless Fireweaver"
  start turn 1 A precombat_main
  turn 1 A: cast "Reckless Fireweaver"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Reckless Fireweaver"
  assert life B 20
}

scenario "Fireweaver 1/3 survives blocking a 2/2" {
  battlefield A: "Reckless Fireweaver"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Reckless Fireweaver"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Reckless Fireweaver"
  assert damage "Reckless Fireweaver" 2
  assert damage "Grizzly Bears" 1
  assert life A 20
}

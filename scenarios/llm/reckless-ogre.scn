# Reckless Ogre: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "attacking alone gives +3/+0" {
  battlefield A: "Reckless Ogre"
  start turn 1 A precombat_main
  turn 1 A: attack "Reckless Ogre"
  run_to turn 1 postcombat_main
  assert life B 14
  assert power "Reckless Ogre" 6
  assert toughness "Reckless Ogre" 2
}

scenario "attacking with another creature gives no bonus" {
  battlefield A: "Reckless Ogre", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Reckless Ogre", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 15
  assert power "Reckless Ogre" 3
}

scenario "bonus lasts only until end of turn" {
  battlefield A: "Reckless Ogre"
  start turn 1 A precombat_main
  turn 1 A: attack "Reckless Ogre"
  run_to turn 2 precombat_main
  assert life B 14
  assert power "Reckless Ogre" 3
}

scenario "pumped ogre kills a blocker and survives" {
  battlefield A: "Reckless Ogre"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Reckless Ogre"
  turn 1 B: block "Reckless Ogre" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Reckless Ogre"
  assert life B 20
}

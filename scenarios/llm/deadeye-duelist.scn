# Deadeye Duelist: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Deadeye Duelist pings an opponent for 1" {
  battlefield A: "Deadeye Duelist", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Deadeye Duelist" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert tapped "Deadeye Duelist"
  assert tapped "Mountain"
}

scenario "Deadeye Duelist needs mana to activate" {
  battlefield A: "Deadeye Duelist"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Deadeye Duelist" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
  assert untapped "Deadeye Duelist"
}

scenario "Deadeye Duelist has reach and blocks a flyer" {
  battlefield A: "Deadeye Duelist"
  battlefield B: "Wind Drake"
  start turn 2 B
  turn 2 B: attack "Wind Drake"
  turn 2 A: block "Wind Drake" with "Deadeye Duelist"
  run_to turn 2 postcombat_main
  assert life A 20
  assert battlefield A contains "Deadeye Duelist"
  assert damage "Deadeye Duelist" 2
  assert damage "Wind Drake" 1
}

# Glidedive Duo: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enters: each opponent loses 2 and you gain 2" {
  battlefield A: 5 "Swamp"
  hand A: "Glidedive Duo"
  start turn 1 A precombat_main
  turn 1 A: cast "Glidedive Duo"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Glidedive Duo"
  assert life B 18
  assert life A 22
}

scenario "flying: ground creature cannot block" {
  battlefield A: "Glidedive Duo"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Glidedive Duo"
  illegal turn 1 B: block "Glidedive Duo" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "flying creature can block it" {
  battlefield A: "Glidedive Duo"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: attack "Glidedive Duo"
  turn 1 B: block "Glidedive Duo" with "Serra Angel"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Glidedive Duo"
  assert battlefield B contains "Serra Angel"
}

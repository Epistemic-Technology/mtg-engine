# Inspiring Overseer: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Inspiring Overseer enters: gain 1 life and draw a card" {
  battlefield A: 3 "Plains"
  hand A: "Inspiring Overseer"
  library A: "Island", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: cast "Inspiring Overseer"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Inspiring Overseer"
  assert life A 21
  assert hand A count 1
  assert hand A contains "Island"
}

scenario "Inspiring Overseer flies over a ground blocker" {
  battlefield A: "Inspiring Overseer"
  battlefield B: "Grizzly Bears"
  start turn 3 A precombat_main
  turn 3 A: attack "Inspiring Overseer"
  illegal turn 3 B: block "Inspiring Overseer" with "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert life B 18
  assert battlefield A contains "Inspiring Overseer"
}

scenario "Inspiring Overseer can be blocked by a flyer and dies" {
  battlefield A: "Inspiring Overseer"
  battlefield B: "Serra Angel"
  start turn 3 A precombat_main
  turn 3 A: attack "Inspiring Overseer"
  turn 3 B: block "Inspiring Overseer" with "Serra Angel"
  run_to turn 3 postcombat_main
  assert life B 20
  assert graveyard A contains "Inspiring Overseer"
  assert battlefield B contains "Serra Angel"
}

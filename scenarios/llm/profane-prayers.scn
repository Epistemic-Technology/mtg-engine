# Profane Prayers: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "no Clerics means no damage and no life gain" {
  battlefield A: 4 "Swamp"
  hand A: "Profane Prayers"
  start turn 1 A precombat_main
  turn 1 A: cast "Profane Prayers" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
  assert life A 20
  assert graveyard A contains "Profane Prayers"
  assert hand A count 0
}

scenario "targeting a creature with no Clerics leaves it undamaged" {
  battlefield A: 4 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Profane Prayers"
  start turn 1 A precombat_main
  turn 1 A: cast "Profane Prayers" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert life A 20
  assert graveyard A contains "Profane Prayers"
}

scenario "sorcery cannot be cast during combat" {
  battlefield A: 4 "Swamp"
  hand A: "Profane Prayers"
  start turn 1 A precombat_main
  illegal turn 1 declare_attackers A: cast "Profane Prayers" targeting player B
  run_to turn 1 end
  assert hand A contains "Profane Prayers"
  assert life B 20
}

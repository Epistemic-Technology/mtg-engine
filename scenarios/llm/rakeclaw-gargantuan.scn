# Rakeclaw Gargantuan: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Rakeclaw gives itself first strike and survives a trade" {
  battlefield A: "Rakeclaw Gargantuan", "Mountain"
  battlefield B: "Hill Giant"
  turn 1 A: activate "Rakeclaw Gargantuan" targeting "Rakeclaw Gargantuan"
  turn 1 A: attack "Rakeclaw Gargantuan"
  turn 1 B: block "Rakeclaw Gargantuan" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Rakeclaw Gargantuan"
  assert graveyard B contains "Hill Giant"
  assert tapped "Mountain"
}

scenario "Rakeclaw activates first strike as a blocker during combat" {
  battlefield A: "Rakeclaw Gargantuan", "Mountain"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Rakeclaw Gargantuan"
  turn 2 declare_blockers A: activate "Rakeclaw Gargantuan" targeting "Rakeclaw Gargantuan"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Rakeclaw Gargantuan"
  assert graveyard B contains "Hill Giant"
  assert life A 20
}

scenario "pumped creature becomes a legal target and strikes first" {
  battlefield A: "Rakeclaw Gargantuan", "Grizzly Bears", "Forest", "Mountain"
  battlefield B: "Rakeclaw Gargantuan"
  hand A: "Giant Growth"
  turn 1 A: cast "Giant Growth" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: activate "Rakeclaw Gargantuan" targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Rakeclaw Gargantuan"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard B contains "Rakeclaw Gargantuan"
}

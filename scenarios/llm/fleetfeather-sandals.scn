# Fleetfeather Sandals: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "equipped creature gains flying and can't be blocked by a ground creature" {
  battlefield A: "Fleetfeather Sandals", "Grizzly Bears", 2 "Forest"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Fleetfeather Sandals" targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert attached "Fleetfeather Sandals" to "Grizzly Bears"
  assert has "Grizzly Bears" flying
  assert has "Grizzly Bears" haste
  assert life B 18
}

scenario "equipped creature has haste and attacks the turn it enters" {
  battlefield A: "Fleetfeather Sandals", 4 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: activate "Fleetfeather Sandals" targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Fleetfeather Sandals" to "Grizzly Bears"
  assert life B 18
}

scenario "unequipped creature has neither flying nor haste" {
  battlefield A: "Fleetfeather Sandals", "Grizzly Bears", 2 "Forest"
  start turn 1 A precombat_main
  run_to turn 1 precombat_main
  assert has not "Grizzly Bears" flying
  assert has not "Grizzly Bears" haste
}

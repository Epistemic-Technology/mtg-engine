# Air Marshal: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Air Marshal gives itself flying and evades a ground blocker" {
  battlefield A: "Air Marshal", 3 "Island"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Air Marshal" targeting "Air Marshal"
  turn 1 A: attack "Air Marshal"
  illegal turn 1 B: block "Air Marshal" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert has "Air Marshal" flying
  assert life B 18
  assert battlefield A contains "Air Marshal"
}

scenario "Air Marshal's flying lasts only until end of turn" {
  battlefield A: "Air Marshal", 3 "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Air Marshal" targeting "Air Marshal"
  run_to turn 1 postcombat_main
  assert has "Air Marshal" flying
  run_to turn 2 precombat_main
  assert has not "Air Marshal" flying
}

scenario "Air Marshal gains flying at instant speed to block a flyer" {
  battlefield A: "Air Marshal", 3 "Island"
  battlefield B: "Wind Drake"
  start turn 2 B precombat_main
  turn 2 B: attack "Wind Drake"
  turn 2 declare_attackers A: activate "Air Marshal" targeting "Air Marshal"
  turn 2 A: block "Wind Drake" with "Air Marshal"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Wind Drake"
  assert graveyard A contains "Air Marshal"
}

scenario "Air Marshal can give an opponent's Soldier flying" {
  battlefield A: "Air Marshal", 3 "Island"
  battlefield B: "Air Marshal"
  start turn 1 A precombat_main
  turn 1 A: activate "Air Marshal" targeting B "Air Marshal"
  run_to turn 1 postcombat_main
  assert has B "Air Marshal" flying
  assert has not A "Air Marshal" flying
}

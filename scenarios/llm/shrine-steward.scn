# Shrine Steward: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enters and search finds no Aura or Shrine" {
  battlefield A: 5 "Plains"
  hand A: "Shrine Steward"
  library A: "Grizzly Bears", "Forest", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Shrine Steward"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Shrine Steward"
  assert is "Shrine Steward" artifact
  assert is "Shrine Steward" creature
  assert hand A count 0
  assert library A contains "Grizzly Bears"
  assert library A contains "Hill Giant"
}

scenario "declining the search leaves the hand empty" {
  battlefield A: 5 "Plains"
  hand A: "Shrine Steward"
  library A: "Grizzly Bears", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Shrine Steward"
  turn 1 A: decline "Shrine Steward"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Shrine Steward"
  assert hand A count 0
  assert library A contains "Grizzly Bears"
}

scenario "trades with a 2/2 in combat" {
  battlefield A: "Shrine Steward"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Shrine Steward"
  turn 1 B: block "Shrine Steward" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Shrine Steward"
  assert graveyard B contains "Grizzly Bears"
  assert life B 20
}

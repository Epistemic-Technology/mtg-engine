# Fen Stalker: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Fen Stalker has fear with no untapped lands and can't be blocked by nonblack creature" {
  battlefield A: "Fen Stalker"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Fen Stalker"
  illegal turn 1 B: block "Fen Stalker" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert has "Fen Stalker" fear
  assert life B 17
  assert battlefield B contains "Grizzly Bears"
}

scenario "Fen Stalker lacks fear while you control an untapped land" {
  battlefield A: "Fen Stalker", "Swamp"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Fen Stalker"
  turn 1 B: block "Fen Stalker" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Fen Stalker"
  assert graveyard B contains "Grizzly Bears"
}

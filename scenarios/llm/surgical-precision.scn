# Surgical Precision: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "mode 1 destroys a creature with toughness 4 and gains 1 life" {
  battlefield A: 2 "Plains"
  hand A: "Surgical Precision"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "Surgical Precision" mode 1 targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert battlefield B lacks "Serra Angel"
  assert life A 21
  assert graveyard A contains "Surgical Precision"
}

scenario "mode 1 only targets creatures with toughness 4 or greater" {
  battlefield A: 2 "Plains"
  hand A: "Surgical Precision"
  battlefield B: "Hill Giant", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "Surgical Precision" mode 1 targeting auto
  run_to turn 1 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert graveyard B contains "Serra Angel"
  assert life A 21
}

scenario "mode 2 draws a card and gains 2 life" {
  battlefield A: 2 "Plains"
  hand A: "Surgical Precision"
  start turn 1 A precombat_main
  turn 1 A: cast "Surgical Precision" mode 2
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert life A 22
  assert graveyard A contains "Surgical Precision"
}

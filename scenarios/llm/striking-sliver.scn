# Striking Sliver: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "pumped Striking Sliver kills Hill Giant with first strike and takes no damage" {
  battlefield A: "Striking Sliver", "Forest"
  battlefield B: "Hill Giant"
  hand A: "Giant Growth"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Striking Sliver"
  turn 2 declare_blockers A: cast "Giant Growth" targeting "Striking Sliver"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Striking Sliver"
  assert damage "Striking Sliver" 0
}

scenario "non-Sliver creatures do not gain first strike" {
  battlefield A: "Striking Sliver", "Wind Drake"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Wind Drake"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Wind Drake"
  assert graveyard B contains "Grizzly Bears"
  assert battlefield A contains "Striking Sliver"
}

scenario "two first-striking Slivers kill an attacker before it deals damage" {
  battlefield A: 2 "Striking Sliver"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Striking Sliver"
  turn 2 A: block "Grizzly Bears" with "Striking Sliver"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert battlefield A contains 2 "Striking Sliver"
  assert life A 20
}

# Black Cat: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Black Cat dying to a burn spell makes the opponent discard" {
  battlefield A: "Black Cat", "Mountain"
  hand A: "Lightning Bolt"
  hand B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Black Cat"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Black Cat"
  assert graveyard B contains "Grizzly Bears"
  assert hand B count 0
}

scenario "Black Cat dying in combat discards one card at random" {
  battlefield A: "Black Cat"
  battlefield B: "Grizzly Bears"
  hand B: 2 "Forest"
  seed 7
  start turn 1 A precombat_main
  turn 1 A: attack "Black Cat"
  turn 1 B: block "Black Cat" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Black Cat"
  assert battlefield B contains "Grizzly Bears"
  assert hand B count 1
  assert graveyard B contains "Forest"
}

scenario "Black Cat dying with an empty opponent hand does nothing more" {
  battlefield A: "Black Cat", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Black Cat"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Black Cat"
  assert hand B count 0
  assert life B 20
  assert not game_over
}

# Windgrace Acolyte: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enters: mill three and gain 3 life" {
  battlefield A: 5 "Swamp"
  hand A: "Windgrace Acolyte"
  library A: "Grizzly Bears", "Hill Giant", "Wind Drake", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Windgrace Acolyte"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Windgrace Acolyte"
  assert life A 23
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Hill Giant"
  assert graveyard A contains "Wind Drake"
  assert library A contains "Forest"
}

scenario "flying: ground creature cannot block" {
  battlefield A: "Windgrace Acolyte"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Windgrace Acolyte"
  illegal turn 1 B: block "Windgrace Acolyte" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "flying creature can block it" {
  battlefield A: "Windgrace Acolyte"
  battlefield B: "Wind Drake"
  start turn 1 A precombat_main
  turn 1 A: attack "Windgrace Acolyte"
  turn 1 B: block "Windgrace Acolyte" with "Wind Drake"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Windgrace Acolyte"
  assert graveyard B contains "Wind Drake"
}

# Boggart Sprite-Chaser: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "without a Faerie it is a 1/2 without flying" {
  battlefield A: "Boggart Sprite-Chaser", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 precombat_main
  assert power "Boggart Sprite-Chaser" 1
  assert toughness "Boggart Sprite-Chaser" 2
  assert has not "Boggart Sprite-Chaser" flying
}

scenario "without a Faerie it can be blocked by a ground creature" {
  battlefield A: "Boggart Sprite-Chaser"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Boggart Sprite-Chaser"
  turn 1 B: block "Boggart Sprite-Chaser" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Boggart Sprite-Chaser"
  assert battlefield B contains "Grizzly Bears"
  assert damage "Grizzly Bears" 1
}

scenario "without a Faerie it unblocked deals 1 damage" {
  battlefield A: "Boggart Sprite-Chaser"
  start turn 1 A precombat_main
  turn 1 A: attack "Boggart Sprite-Chaser"
  run_to turn 1 postcombat_main
  assert life B 19
}

scenario "Shock kills it with no Faerie around" {
  battlefield A: "Boggart Sprite-Chaser"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Boggart Sprite-Chaser"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Boggart Sprite-Chaser"
}

# TVA Bureaucrat: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "noncreature spell makes it bigger and unblockable" {
  battlefield A: "TVA Bureaucrat", "Mountain"
  hand A: "Lightning Bolt"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 A: attack "TVA Bureaucrat"
  illegal turn 1 B: block "TVA Bureaucrat" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 15
  assert power "TVA Bureaucrat" 2
}

scenario "pump stacks with Giant Growth" {
  battlefield A: "TVA Bureaucrat", "Forest"
  hand A: "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Giant Growth" targeting "TVA Bureaucrat"
  run_to turn 1 begin_combat
  assert power "TVA Bureaucrat" 5
  assert toughness "TVA Bureaucrat" 6
}

scenario "creature spells do not trigger it" {
  battlefield A: "TVA Bureaucrat", 2 "Forest"
  hand A: "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: attack "TVA Bureaucrat"
  turn 1 B: block "TVA Bureaucrat" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "TVA Bureaucrat" 1
  assert life B 20
  assert battlefield A contains "Grizzly Bears"
}

scenario "bonus wears off at end of turn" {
  battlefield A: "TVA Bureaucrat", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 begin_combat
  assert power "TVA Bureaucrat" 2
  run_to turn 2 upkeep
  assert power "TVA Bureaucrat" 1
  assert life B 18
}

# Sunbathing Rootwalla: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "domain pump counts basic land types" {
  battlefield A: "Sunbathing Rootwalla", 2 "Forest", "Mountain", "Plains"
  turn 1 A: activate "Sunbathing Rootwalla"
  run_to turn 1 postcombat_main
  assert power "Sunbathing Rootwalla" 5
  assert toughness "Sunbathing Rootwalla" 5
  assert tapped "Mountain"
}

scenario "many lands of one type count once" {
  battlefield A: "Sunbathing Rootwalla", 5 "Forest"
  turn 1 A: activate "Sunbathing Rootwalla"
  run_to turn 1 postcombat_main
  assert power "Sunbathing Rootwalla" 3
  assert toughness "Sunbathing Rootwalla" 3
}

scenario "pump wears off at end of turn" {
  battlefield A: "Sunbathing Rootwalla", "Forest", "Island", "Swamp", "Mountain", "Plains"
  turn 1 A: activate "Sunbathing Rootwalla"
  run_to turn 1 postcombat_main
  assert power "Sunbathing Rootwalla" 7
  run_to turn 2 precombat_main
  assert power "Sunbathing Rootwalla" 2
  assert toughness "Sunbathing Rootwalla" 2
}

scenario "activate only once each turn" {
  battlefield A: "Sunbathing Rootwalla", 4 "Forest", 4 "Mountain"
  turn 1 A: activate "Sunbathing Rootwalla"
  illegal turn 1 postcombat_main A: activate "Sunbathing Rootwalla"
  run_to turn 1 end
  assert power "Sunbathing Rootwalla" 4
}

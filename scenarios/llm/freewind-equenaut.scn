# Freewind Equenaut: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "flying: ground creature cannot block it" {
  battlefield A: "Freewind Equenaut"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Freewind Equenaut"
  illegal turn 1 B: block "Freewind Equenaut" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield A contains "Freewind Equenaut"
}

scenario "flying creature can block it and trade" {
  battlefield A: "Freewind Equenaut"
  battlefield B: "Wind Drake"
  start turn 1 A
  turn 1 A: attack "Freewind Equenaut"
  turn 1 B: block "Freewind Equenaut" with "Wind Drake"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Freewind Equenaut"
  assert graveyard B contains "Wind Drake"
}

scenario "unenchanted it has no damage ability" {
  battlefield A: "Freewind Equenaut"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  illegal turn 2 declare_blockers A: activate "Freewind Equenaut" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life A 18
  assert battlefield B contains "Grizzly Bears"
  assert untapped "Freewind Equenaut"
}

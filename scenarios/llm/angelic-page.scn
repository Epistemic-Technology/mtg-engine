# Angelic Page: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Angelic Page pumps an attacking creature" {
  battlefield A: "Angelic Page", "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  turn 2 declare_attackers A: activate "Angelic Page" targeting "Grizzly Bears"
  run_to turn 2 combat_damage
  assert power "Grizzly Bears" 3
  assert tapped "Angelic Page"
  run_to turn 2 postcombat_main
  assert life B 17
  assert has "Angelic Page" flying
}

scenario "Angelic Page pumps a blocking creature" {
  battlefield A: "Angelic Page", "Wind Drake"
  battlefield B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Wind Drake"
  turn 2 declare_blockers A: activate "Angelic Page" targeting "Wind Drake"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Wind Drake"
  assert graveyard B contains "Grizzly Bears"
  assert life A 20
}

scenario "Angelic Page cannot target a creature outside combat" {
  battlefield A: "Angelic Page", "Grizzly Bears"
  start turn 2 A precombat_main
  illegal turn 2 A: activate "Angelic Page" targeting "Grizzly Bears"
  run_to turn 2 begin_combat
  assert untapped "Angelic Page"
  assert power "Grizzly Bears" 2
}

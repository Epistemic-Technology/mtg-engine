# Crossbow Infantry: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Crossbow Infantry pings an attacking creature" {
  battlefield A: "Crossbow Infantry"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 declare_attackers A: activate "Crossbow Infantry" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert tapped "Crossbow Infantry"
  assert damage "Grizzly Bears" 1
  assert life A 18
}

scenario "Crossbow Infantry finishes off a blocked attacker" {
  battlefield A: "Crossbow Infantry", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Grizzly Bears"
  turn 2 declare_blockers A: activate "Crossbow Infantry" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Grizzly Bears"
  assert life A 20
}

scenario "Crossbow Infantry cannot target a creature that is not in combat" {
  battlefield A: "Crossbow Infantry"
  battlefield B: "Grizzly Bears"
  illegal turn 1 A: activate "Crossbow Infantry" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert untapped "Crossbow Infantry"
  assert damage "Grizzly Bears" 0
}

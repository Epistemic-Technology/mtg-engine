# Last Caress: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Last Caress drains opponent for 1" {
  battlefield A: 3 "Swamp"
  hand A: "Last Caress"
  start turn 1 A precombat_main
  turn 1 A: cast "Last Caress" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert life A 21
  assert graveyard A contains "Last Caress"
}

scenario "Last Caress draws a card" {
  battlefield A: 3 "Swamp"
  hand A: "Last Caress"
  library A: "Island", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Last Caress" targeting player B
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert hand A contains "Island"
  assert library A contains "Forest"
}

scenario "Last Caress targeting yourself nets zero life" {
  battlefield A: 3 "Swamp"
  hand A: "Last Caress"
  start turn 1 A precombat_main
  turn 1 A: cast "Last Caress" targeting player A
  run_to turn 1 postcombat_main
  assert life A 20
  assert life B 20
  assert hand A count 1
}

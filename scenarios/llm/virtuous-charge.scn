# Virtuous Charge: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Virtuous Charge pumps only creatures you control" {
  battlefield A: "Grizzly Bears", "Hill Giant", 3 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Virtuous Charge"
  start turn 1 A precombat_main
  turn 1 A: cast "Virtuous Charge"
  run_to turn 1 begin_combat
  assert power A "Grizzly Bears" 3
  assert toughness A "Grizzly Bears" 3
  assert power A "Hill Giant" 4
  assert toughness A "Hill Giant" 4
  assert power B "Grizzly Bears" 2
  assert toughness B "Grizzly Bears" 2
  assert graveyard A contains "Virtuous Charge"
}

scenario "Virtuous Charge wears off at end of turn" {
  battlefield A: "Grizzly Bears", 3 "Plains"
  hand A: "Virtuous Charge"
  start turn 1 A precombat_main
  turn 1 A: cast "Virtuous Charge"
  run_to turn 1 begin_combat
  assert power "Grizzly Bears" 3
  run_to turn 2 upkeep
  assert power "Grizzly Bears" 2
  assert toughness "Grizzly Bears" 2
}

scenario "pumped attacker wins combat against an equal blocker" {
  battlefield A: "Grizzly Bears", 3 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Virtuous Charge"
  start turn 1 A precombat_main
  turn 1 A: cast "Virtuous Charge"
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage A "Grizzly Bears" 2
  assert graveyard B contains "Grizzly Bears"
  assert life B 20
}

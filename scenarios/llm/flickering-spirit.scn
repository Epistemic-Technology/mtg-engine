# Flickering Spirit: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "flickering removes counters" {
  battlefield A: "Flickering Spirit" with 2 +1/+1, 4 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Flickering Spirit"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Flickering Spirit"
  assert counters "Flickering Spirit" +1/+1 0
  assert power "Flickering Spirit" 2
  assert toughness "Flickering Spirit" 2
}

scenario "flickering ends a pump on the old object" {
  battlefield A: "Flickering Spirit", 4 "Plains", "Forest"
  hand A: "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Giant Growth" targeting "Flickering Spirit"
  turn 1 A: wait
  turn 1 A: activate "Flickering Spirit"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Flickering Spirit"
  assert graveyard A contains "Giant Growth"
  assert power "Flickering Spirit" 2
}

scenario "flying evades ground blockers" {
  battlefield A: "Flickering Spirit"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Flickering Spirit"
  illegal turn 1 B: block "Flickering Spirit" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert has "Flickering Spirit" flying
}

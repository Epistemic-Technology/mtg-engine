# Deadly Riposte: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Deadly Riposte kills a tapped creature and gains 2 life" {
  battlefield A: 2 "Plains"
  battlefield B: "Hill Giant" tapped
  hand A: "Deadly Riposte"
  start turn 1 A precombat_main
  turn 1 A: cast "Deadly Riposte" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Deadly Riposte"
  assert life A 22
}

scenario "Deadly Riposte cannot target an untapped creature" {
  battlefield A: 2 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Deadly Riposte"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Deadly Riposte" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
  assert hand A contains "Deadly Riposte"
  assert life A 20
}

scenario "Deadly Riposte deals 3 damage to a larger tapped creature" {
  battlefield A: 2 "Plains"
  battlefield B: "Serra Angel" tapped
  hand A: "Deadly Riposte"
  start turn 1 A precombat_main
  turn 1 A: cast "Deadly Riposte" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Serra Angel"
  assert damage "Serra Angel" 3
  assert life A 22
}

scenario "Deadly Riposte gains no life if its target is gone" {
  battlefield A: 2 "Plains"
  battlefield B: "Hill Giant" tapped, "Mountain"
  hand A: "Deadly Riposte"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Deadly Riposte" targeting "Hill Giant"
  turn 1 B: cast "Lightning Bolt" targeting "Hill Giant" in response to "Deadly Riposte"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Deadly Riposte"
  assert life A 20
}

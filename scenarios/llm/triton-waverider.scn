# Triton Waverider: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "a nonenchantment creature entering does not grant flying" {
  battlefield A: "Triton Waverider", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert has not "Triton Waverider" flying
}

scenario "casting the Waverider itself does not trigger constellation" {
  battlefield A: 4 "Island"
  hand A: "Triton Waverider"
  start turn 1 A precombat_main
  turn 1 A: cast "Triton Waverider"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Triton Waverider"
  assert has not "Triton Waverider" flying
}

scenario "without flying it can be blocked by a ground creature" {
  battlefield A: "Triton Waverider"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Triton Waverider"
  turn 1 B: block "Triton Waverider" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Grizzly Bears"
  assert battlefield A contains "Triton Waverider"
  assert damage "Triton Waverider" 2
}

scenario "without flying it cannot block a flier" {
  battlefield A: "Triton Waverider"
  battlefield B: "Wind Drake"
  start turn 2 B precombat_main
  turn 2 B: attack "Wind Drake"
  illegal turn 2 A: block "Wind Drake" with "Triton Waverider"
  run_to turn 2 postcombat_main
  assert life A 18
}

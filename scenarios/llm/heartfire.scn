# Heartfire: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Heartfire sacrifices a creature and deals 4 to a player" {
  battlefield A: "Grizzly Bears", 2 "Mountain"
  hand A: "Heartfire"
  turn 1 A: cast "Heartfire" sacrificing "Grizzly Bears" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Heartfire"
}

scenario "Heartfire kills a 4-toughness creature" {
  battlefield A: "Grizzly Bears", 2 "Mountain"
  battlefield B: "Serra Angel"
  hand A: "Heartfire"
  turn 1 A: cast "Heartfire" sacrificing "Grizzly Bears" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert graveyard A contains "Grizzly Bears"
  assert life B 20
}

scenario "Heartfire cannot be cast without a creature to sacrifice" {
  battlefield A: 2 "Mountain"
  hand A: "Heartfire"
  illegal turn 1 A: cast "Heartfire" targeting player B
  run_to turn 1 postcombat_main
  assert hand A contains "Heartfire"
  assert life B 20
}

scenario "Heartfire at instant speed kills an attacker" {
  battlefield A: "Grizzly Bears", 2 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Heartfire"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 declare_attackers A: cast "Heartfire" sacrificing "Grizzly Bears" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Grizzly Bears"
}

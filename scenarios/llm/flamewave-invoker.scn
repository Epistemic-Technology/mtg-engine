# Flamewave Invoker: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Flamewave Invoker deals 5 damage to target player" {
  battlefield A: "Flamewave Invoker", 8 "Mountain"
  turn 1 A: activate "Flamewave Invoker" targeting player B
  run_to turn 1 postcombat_main
  assert life B 15
  assert life A 20
  assert battlefield A contains "Flamewave Invoker"
}

scenario "Flamewave Invoker cannot activate without eight mana" {
  battlefield A: "Flamewave Invoker", 7 "Mountain"
  illegal turn 1 A: activate "Flamewave Invoker" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "Flamewave Invoker ability needs no tap and works at instant speed" {
  battlefield A: "Flamewave Invoker" tapped, 8 "Mountain"
  start turn 2 B precombat_main
  turn 2 A: activate "Flamewave Invoker" targeting player B
  run_to turn 2 postcombat_main
  assert life B 15
}

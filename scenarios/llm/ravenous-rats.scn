# Ravenous Rats: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Ravenous Rats makes target opponent discard a card" {
  battlefield A: 2 "Swamp"
  hand A: "Ravenous Rats"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Ravenous Rats"
  turn 1 A: trigger "Ravenous Rats" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Ravenous Rats"
  assert graveyard B contains "Lightning Bolt"
  assert hand B count 0
}

scenario "Ravenous Rats takes only one card" {
  battlefield A: 2 "Swamp"
  hand A: "Ravenous Rats"
  hand B: "Lightning Bolt", "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Ravenous Rats"
  turn 1 A: trigger "Ravenous Rats" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 1
  assert hand A count 0
}

scenario "Ravenous Rats against an empty hand does nothing" {
  battlefield A: 2 "Swamp"
  hand A: "Ravenous Rats", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Ravenous Rats"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Ravenous Rats"
  assert hand B count 0
  assert hand A contains "Grizzly Bears"
}

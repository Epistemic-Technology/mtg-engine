# Changeling Outcast: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "changeling outcast can't be blocked" {
  battlefield A: "Changeling Outcast"
  battlefield B: "Grizzly Bears"
  turn 1 A: attack "Changeling Outcast"
  illegal turn 1 B: block "Changeling Outcast" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 19
  assert battlefield A contains "Changeling Outcast"
}

scenario "changeling outcast can't block" {
  battlefield A: "Changeling Outcast"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  illegal turn 2 A: block "Grizzly Bears" with "Changeling Outcast"
  run_to turn 2 postcombat_main
  assert life A 18
  assert battlefield A contains "Changeling Outcast"
}

scenario "changeling outcast is every creature type" {
  battlefield A: "Changeling Outcast"
  run_to turn 1 precombat_main
  assert is "Changeling Outcast" Goblin
  assert is "Changeling Outcast" Elf
  assert is "Changeling Outcast" Shapeshifter
}

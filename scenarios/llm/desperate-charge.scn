# Desperate Charge: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Desperate Charge pumps only the caster's creatures" {
  battlefield A: "Grizzly Bears", 3 "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Desperate Charge"
  start turn 1 A precombat_main
  turn 1 A: cast "Desperate Charge"
  run_to turn 1 begin_combat
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 2
  assert power "Hill Giant" 3
  assert graveyard A contains "Desperate Charge"
}

scenario "Desperate Charge adds combat damage" {
  battlefield A: "Grizzly Bears", 3 "Swamp"
  hand A: "Desperate Charge"
  start turn 1 A precombat_main
  turn 1 A: cast "Desperate Charge"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "Desperate Charge wears off at end of turn" {
  battlefield A: "Grizzly Bears", 3 "Swamp"
  hand A: "Desperate Charge"
  start turn 1 A precombat_main
  turn 1 A: cast "Desperate Charge"
  run_to turn 2 upkeep
  assert power "Grizzly Bears" 2
}

scenario "creature entering after resolution is not pumped" {
  battlefield A: 3 "Swamp", 3 "Forest"
  hand A: "Desperate Charge", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Desperate Charge"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 begin_combat
  assert battlefield A contains "Grizzly Bears"
  assert power "Grizzly Bears" 2
}

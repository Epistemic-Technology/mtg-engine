# Call to Glory: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "untaps all creatures you control, not opponents'" {
  battlefield A: "Grizzly Bears" tapped, "Serra Angel" tapped, 2 "Plains"
  battlefield B: "Hill Giant" tapped
  hand A: "Call to Glory"
  start turn 1 A precombat_main
  turn 1 A: cast "Call to Glory"
  run_to turn 1 postcombat_main
  assert untapped "Grizzly Bears"
  assert untapped "Serra Angel"
  assert tapped "Hill Giant"
  assert graveyard A contains "Call to Glory"
}

scenario "non-Samurai creatures get no bonus" {
  battlefield A: "Grizzly Bears" tapped, 2 "Plains"
  hand A: "Call to Glory"
  start turn 1 A precombat_main
  turn 1 A: cast "Call to Glory"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 2
  assert toughness "Grizzly Bears" 2
}

scenario "untap an attacker during combat" {
  battlefield A: "Grizzly Bears", 2 "Plains"
  hand A: "Call to Glory"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 declare_blockers A: cast "Call to Glory"
  run_to turn 1 postcombat_main
  assert life B 18
  assert untapped "Grizzly Bears"
}

# Weldfast Wingsmith: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "a creature entering does not grant flying" {
  battlefield A: "Weldfast Wingsmith", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert has not "Weldfast Wingsmith" flying
}

scenario "a land entering does not grant flying" {
  battlefield A: "Weldfast Wingsmith"
  hand A: "Island"
  start turn 1 A precombat_main
  turn 1 A: play "Island"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Island"
  assert has not "Weldfast Wingsmith" flying
}

scenario "without an artifact it can be blocked by a ground creature" {
  battlefield A: "Weldfast Wingsmith"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Weldfast Wingsmith"
  turn 1 B: block "Weldfast Wingsmith" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Grizzly Bears"
  assert battlefield A contains "Weldfast Wingsmith"
  assert damage "Weldfast Wingsmith" 2
}

# Zephyr Net: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Zephyr Net grants defender and flying to the enchanted creature" {
  battlefield A: "Grizzly Bears", 2 "Island"
  hand A: "Zephyr Net"
  start turn 1 A precombat_main
  turn 1 A: cast "Zephyr Net" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Zephyr Net" to "Grizzly Bears"
  assert has "Grizzly Bears" flying
  assert has "Grizzly Bears" defender
}

scenario "enchanted creature cannot attack" {
  battlefield A: "Grizzly Bears", "Hill Giant", "Zephyr Net" on "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "enchanted creature can block a flier" {
  battlefield A: "Grizzly Bears", "Zephyr Net" on "Grizzly Bears"
  battlefield B: "Wind Drake"
  start turn 2 B
  turn 2 B: attack "Wind Drake"
  turn 2 A: block "Wind Drake" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Wind Drake"
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Zephyr Net"
}

# Kobold Taskmaster: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "taskmaster does not pump itself or non-Kobolds" {
  battlefield A: "Kobold Taskmaster", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Kobold Taskmaster" 1
  assert toughness "Kobold Taskmaster" 2
  assert power "Grizzly Bears" 2
}

scenario "two taskmasters pump each other" {
  battlefield A: 2 "Kobold Taskmaster"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power oldest A "Kobold Taskmaster" 2
  assert power newest A "Kobold Taskmaster" 2
  assert toughness oldest A "Kobold Taskmaster" 2
}

scenario "opponent's Kobold is not pumped" {
  battlefield A: "Kobold Taskmaster"
  battlefield B: "Kobold Taskmaster"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power A "Kobold Taskmaster" 1
  assert power B "Kobold Taskmaster" 1
}

scenario "pump ends when the taskmaster dies" {
  battlefield A: 2 "Kobold Taskmaster"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 1 A precombat_main
  turn 1 B: cast "Shock" targeting oldest A "Kobold Taskmaster"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Kobold Taskmaster"
  assert power "Kobold Taskmaster" 1
}

# Vermin Gorger: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "sacrificing another creature drains 2" {
  battlefield A: "Vermin Gorger", "Grizzly Bears"
  turn 1 A: activate "Vermin Gorger" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert life A 22
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Vermin Gorger"
  assert tapped "Vermin Gorger"
}

scenario "cannot sacrifice itself" {
  battlefield A: "Vermin Gorger"
  illegal turn 1 A: activate "Vermin Gorger"
  run_to turn 1 postcombat_main
  assert life B 20
  assert life A 20
  assert battlefield A contains "Vermin Gorger"
}

scenario "cannot activate while tapped" {
  battlefield A: "Vermin Gorger" tapped, "Hill Giant"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Vermin Gorger"
  run_to turn 1 postcombat_main
  assert life B 20
  assert battlefield A contains "Hill Giant"
}

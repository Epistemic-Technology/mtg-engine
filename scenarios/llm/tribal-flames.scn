# Tribal Flames: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "five basic land types deal 5 to a player" {
  battlefield A: "Plains", "Island", "Swamp", "Mountain", "Forest"
  hand A: "Tribal Flames"
  start turn 1 A precombat_main
  turn 1 A: cast "Tribal Flames" targeting player B
  run_to turn 1 postcombat_main
  assert life B 15
  assert graveyard A contains "Tribal Flames"
}

scenario "duplicate land types count once" {
  battlefield A: 3 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Tribal Flames"
  start turn 1 A precombat_main
  turn 1 A: cast "Tribal Flames" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert damage "Hill Giant" 1
}

scenario "four types kill Serra Angel" {
  battlefield A: "Mountain", "Island", "Forest", "Swamp"
  battlefield B: "Serra Angel"
  hand A: "Tribal Flames"
  start turn 1 A precombat_main
  turn 1 A: cast "Tribal Flames" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
}

scenario "tapped lands still count toward domain" {
  battlefield A: "Mountain", "Plains", "Island" tapped
  hand A: "Tribal Flames"
  start turn 1 A precombat_main
  turn 1 A: cast "Tribal Flames" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
}

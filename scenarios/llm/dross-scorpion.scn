# Dross Scorpion: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "another artifact creature dying untaps target artifact" {
  battlefield A: "Dross Scorpion" tapped, "Mountain"
  battlefield B: "Dross Scorpion"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting B "Dross Scorpion"
  turn 1 B: decline "Dross Scorpion"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Dross Scorpion"
  assert untapped A "Dross Scorpion"
}

scenario "this creature dying untaps target artifact" {
  battlefield A: "Dross Scorpion", "Mountain"
  battlefield B: "Dross Scorpion" tapped
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting A "Dross Scorpion"
  turn 1 B: decline "Dross Scorpion"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Dross Scorpion"
  assert untapped B "Dross Scorpion"
}

scenario "untap is optional" {
  battlefield A: "Dross Scorpion", "Mountain"
  battlefield B: "Dross Scorpion" tapped
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting A "Dross Scorpion"
  turn 1 A: decline "Dross Scorpion"
  turn 1 B: decline "Dross Scorpion"
  run_to turn 1 postcombat_main
  assert tapped B "Dross Scorpion"
}

scenario "nonartifact creature dying does not trigger" {
  battlefield A: "Dross Scorpion" tapped, "Grizzly Bears", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert tapped "Dross Scorpion"
}

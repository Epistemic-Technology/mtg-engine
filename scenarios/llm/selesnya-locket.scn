# Selesnya Locket: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "locket draws two with green mana" {
  battlefield A: "Selesnya Locket", 4 "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Selesnya Locket"
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert graveyard A contains "Selesnya Locket"
}

scenario "locket hybrid cost paid with mixed green and white" {
  battlefield A: "Selesnya Locket", 2 "Forest", 2 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Selesnya Locket"
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert graveyard A contains "Selesnya Locket"
}

scenario "locket produces green mana for a spell" {
  battlefield A: "Selesnya Locket", "Plains"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert tapped "Selesnya Locket"
  assert battlefield A contains "Selesnya Locket"
}

scenario "locket cannot sacrifice without enough colored mana" {
  battlefield A: "Selesnya Locket", 4 "Island"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Selesnya Locket"
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert battlefield A contains "Selesnya Locket"
}

# Highway Robber: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Highway Robber drains the opponent for 2 on entering" {
  battlefield A: 4 "Swamp"
  hand A: "Highway Robber"
  start turn 1 A precombat_main
  turn 1 A: cast "Highway Robber"
  turn 1 A: trigger "Highway Robber" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Highway Robber"
  assert life B 18
  assert life A 22
}

scenario "two Highway Robbers drain twice" {
  battlefield A: 8 "Swamp"
  hand A: 2 "Highway Robber"
  start turn 1 A precombat_main
  turn 1 A: cast "Highway Robber"
  turn 1 A: wait
  turn 1 A: cast "Highway Robber"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Highway Robber"
  assert life B 16
  assert life A 24
}

scenario "life drain stays after Highway Robber is killed" {
  battlefield A: 4 "Swamp"
  hand A: "Highway Robber"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Highway Robber"
  turn 1 postcombat_main B: cast "Lightning Bolt" targeting "Highway Robber"
  run_to turn 1 end
  assert graveyard A contains "Highway Robber"
  assert life B 18
  assert life A 22
}

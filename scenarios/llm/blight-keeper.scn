# Blight Keeper: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "sacrifice to drain 4" {
  battlefield A: "Blight Keeper", 8 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Blight Keeper" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
  assert life A 24
  assert graveyard A contains "Blight Keeper"
}

scenario "cannot activate without enough mana" {
  battlefield A: "Blight Keeper", 7 "Swamp"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Blight Keeper" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
  assert battlefield A contains "Blight Keeper"
}

scenario "flying evades ground blocker" {
  battlefield A: "Blight Keeper"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Blight Keeper"
  illegal turn 1 B: block "Blight Keeper" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 19
  assert battlefield A contains "Blight Keeper"
}

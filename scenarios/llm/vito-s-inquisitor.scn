# Vito's Inquisitor: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "sacrificing another creature grows it and grants menace" {
  battlefield A: "Vito's Inquisitor", "Swamp", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Vito's Inquisitor" sacrificing "Grizzly Bears"
  run_to turn 1 begin_combat
  assert graveyard A contains "Grizzly Bears"
  assert counters "Vito's Inquisitor" +1/+1 1
  assert power "Vito's Inquisitor" 4
  assert toughness "Vito's Inquisitor" 4
  assert has "Vito's Inquisitor" menace
}

scenario "menace stops a single blocker" {
  battlefield A: "Vito's Inquisitor", "Swamp", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Vito's Inquisitor" sacrificing "Grizzly Bears"
  turn 1 A: attack "Vito's Inquisitor"
  illegal turn 1 B: block "Vito's Inquisitor" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 16
  assert battlefield B contains "Hill Giant"
}

scenario "menace ends at end of turn but the counter stays" {
  battlefield A: "Vito's Inquisitor", "Swamp", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Vito's Inquisitor" sacrificing "Grizzly Bears"
  run_to turn 2 upkeep
  assert has not "Vito's Inquisitor" menace
  assert counters "Vito's Inquisitor" +1/+1 1
  assert power "Vito's Inquisitor" 4
}

scenario "cannot sacrifice itself" {
  battlefield A: "Vito's Inquisitor", "Swamp"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Vito's Inquisitor"
  run_to turn 1 begin_combat
  assert battlefield A contains "Vito's Inquisitor"
  assert power "Vito's Inquisitor" 3
}

# Moonlit Scavengers: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "no artifact or enchantment: enters without bouncing" {
  battlefield A: 6 "Island"
  hand A: "Moonlit Scavengers"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Moonlit Scavengers"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Moonlit Scavengers"
  assert battlefield B contains "Grizzly Bears"
  assert hand B lacks "Grizzly Bears"
}

scenario "4/5 body blocks and kills Hill Giant" {
  battlefield A: "Moonlit Scavengers"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Moonlit Scavengers"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Moonlit Scavengers"
  assert damage "Moonlit Scavengers" 3
  assert graveyard B contains "Hill Giant"
  assert life A 20
}

scenario "survives Lightning Bolt but not Bolt plus Shock" {
  battlefield A: "Moonlit Scavengers"
  battlefield B: 2 "Mountain"
  hand B: "Lightning Bolt", "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Moonlit Scavengers"
  turn 2 B: wait
  turn 2 B: cast "Shock" targeting "Moonlit Scavengers"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Moonlit Scavengers"
}

# Ubul Sar Gatekeepers: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "without two Gates the enters trigger does nothing" {
  battlefield A: 4 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Ubul Sar Gatekeepers"
  start turn 1 A precombat_main
  turn 1 A: cast "Ubul Sar Gatekeepers"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Ubul Sar Gatekeepers"
  assert battlefield B contains "Grizzly Bears"
  assert power "Grizzly Bears" 2
  assert toughness "Grizzly Bears" 2
}

scenario "basic lands are not Gates" {
  battlefield A: 2 "Swamp", 2 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Ubul Sar Gatekeepers"
  start turn 1 A precombat_main
  turn 1 A: cast "Ubul Sar Gatekeepers"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 3
  assert toughness "Hill Giant" 3
  assert stack count 0
}

scenario "a 2/4 body survives blocking a 3/3" {
  battlefield A: "Ubul Sar Gatekeepers"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Ubul Sar Gatekeepers"
  run_to turn 2 postcombat_main
  assert life A 20
  assert battlefield A contains "Ubul Sar Gatekeepers"
  assert damage "Ubul Sar Gatekeepers" 3
  assert battlefield B contains "Hill Giant"
  assert damage "Hill Giant" 2
}

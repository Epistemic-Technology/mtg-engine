# Abzan Runemark: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Abzan Runemark grants +2/+2 and vigilance with a green permanent" {
  battlefield A: 3 "Plains", "Hill Giant", "Grizzly Bears"
  hand A: "Abzan Runemark"
  turn 1 A: cast "Abzan Runemark" targeting "Hill Giant"
  turn 1 declare_attackers A: attack "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 5
  assert toughness "Hill Giant" 5
  assert has "Hill Giant" vigilance
  assert untapped "Hill Giant"
  assert life B 15
}

scenario "Abzan Runemark grants no vigilance without a black or green permanent" {
  battlefield A: 3 "Plains", "Hill Giant"
  hand A: "Abzan Runemark"
  turn 1 A: cast "Abzan Runemark" targeting "Hill Giant"
  turn 1 declare_attackers A: attack "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 5
  assert has not "Hill Giant" vigilance
  assert tapped "Hill Giant"
  assert life B 15
}

scenario "Abzan Runemark loses vigilance when the green permanent dies" {
  battlefield A: 3 "Swamp", "Hill Giant", "Grizzly Bears", "Abzan Runemark" on "Hill Giant"
  hand A: "Murder"
  start turn 1 A precombat_main
  run_to turn 1 precombat_main
  assert has "Hill Giant" vigilance
  turn 1 A: cast "Murder" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert graveyard A contains "Grizzly Bears"
  assert has not "Hill Giant" vigilance
  assert power "Hill Giant" 5
}

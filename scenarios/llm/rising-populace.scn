# Rising Populace: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "another creature you control dying grows Rising Populace" {
  battlefield A: "Rising Populace", "Grizzly Bears", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert counters "Rising Populace" +1/+1 1
  assert power "Rising Populace" 3
  assert toughness "Rising Populace" 3
}

scenario "an opponent's creature dying does not trigger" {
  battlefield A: "Rising Populace", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert power "Rising Populace" 2
  assert toughness "Rising Populace" 2
}

scenario "creature dying in combat grows Rising Populace" {
  battlefield A: "Rising Populace", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 2 A
  turn 2 A: attack "Grizzly Bears"
  turn 2 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert counters "Rising Populace" +1/+1 1
  assert power "Rising Populace" 3
}

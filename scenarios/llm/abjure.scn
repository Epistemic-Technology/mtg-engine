# Abjure: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Abjure counters a burn spell by sacrificing a blue creature" {
  battlefield A: "Island", "Wind Drake"
  hand A: "Abjure"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: cast "Abjure" sacrificing "Wind Drake" targeting "Lightning Bolt" in response to "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Lightning Bolt"
  assert graveyard A contains "Wind Drake"
  assert graveyard A contains "Abjure"
  assert battlefield A lacks "Wind Drake"
}

scenario "Abjure counters a creature spell" {
  battlefield A: "Island", "Wind Drake"
  hand A: "Abjure"
  battlefield B: 2 "Forest"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Abjure" sacrificing "Wind Drake" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B lacks "Grizzly Bears"
  assert graveyard B contains "Grizzly Bears"
  assert graveyard A contains "Wind Drake"
}

scenario "Abjure can't be cast without a blue permanent to sacrifice" {
  battlefield A: "Island", "Grizzly Bears"
  hand A: "Abjure"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  illegal turn 2 A: cast "Abjure" sacrificing "Grizzly Bears" targeting "Lightning Bolt" in response to "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert life A 17
  assert hand A contains "Abjure"
  assert battlefield A contains "Grizzly Bears"
}

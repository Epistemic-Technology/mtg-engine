# Armory Veteran: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "unequipped Armory Veteran lacks menace" {
  battlefield A: "Armory Veteran"
  start turn 1 A precombat_main
  run_to turn 1 precombat_main
  assert has not "Armory Veteran" menace
}

scenario "unequipped Armory Veteran can be blocked by a single creature" {
  battlefield A: "Armory Veteran"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Armory Veteran"
  turn 1 B: block "Armory Veteran" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Armory Veteran"
  assert graveyard B contains "Grizzly Bears"
}

scenario "unblocked Armory Veteran deals 2 damage" {
  battlefield A: "Armory Veteran"
  start turn 1 A precombat_main
  turn 1 A: attack "Armory Veteran"
  run_to turn 1 postcombat_main
  assert life B 18
}

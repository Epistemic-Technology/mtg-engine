# Nature's Claim: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Nature's Claim cannot target a creature" {
  battlefield A: "Forest"
  battlefield B: "Grizzly Bears"
  hand A: "Nature's Claim"
  illegal turn 1 A: cast "Nature's Claim" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Nature's Claim"
  assert battlefield B contains "Grizzly Bears"
  assert life B 20
  assert life A 20
}

scenario "Nature's Claim cannot target a land" {
  battlefield A: "Forest"
  battlefield B: "Forest"
  hand A: "Nature's Claim"
  illegal turn 1 A: cast "Nature's Claim" targeting B "Forest"
  run_to turn 1 postcombat_main
  assert hand A contains "Nature's Claim"
  assert battlefield B contains "Forest"
  assert life B 20
}

scenario "Nature's Claim cannot target a player" {
  battlefield A: "Forest"
  hand A: "Nature's Claim"
  illegal turn 1 A: cast "Nature's Claim" targeting player B
  run_to turn 1 postcombat_main
  assert hand A contains "Nature's Claim"
  assert life B 20
  assert life A 20
}

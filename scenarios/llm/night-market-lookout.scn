# Night Market Lookout: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "attacking taps the lookout: drain 1 plus combat damage" {
  battlefield A: "Night Market Lookout"
  start turn 1 A precombat_main
  turn 1 A: attack "Night Market Lookout"
  run_to turn 1 postcombat_main
  assert life B 18
  assert life A 21
  assert tapped "Night Market Lookout"
}

scenario "drain still happens when the attacker is blocked and dies" {
  battlefield A: "Night Market Lookout"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Night Market Lookout"
  turn 1 B: block "Night Market Lookout" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 19
  assert life A 21
  assert graveyard A contains "Night Market Lookout"
}

scenario "no trigger without becoming tapped" {
  battlefield A: "Night Market Lookout"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert life B 20
  assert life A 20
  assert untapped "Night Market Lookout"
}

scenario "untapping during the untap step does not trigger" {
  battlefield A: "Night Market Lookout" tapped
  start turn 1 A
  run_to turn 1 precombat_main
  assert untapped "Night Market Lookout"
  assert life B 20
  assert life A 20
}

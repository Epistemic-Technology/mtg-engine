# Impact Tremors: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "creature entering under your control deals 1 to each opponent" {
  battlefield A: "Impact Tremors", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert life B 19
  assert life A 20
}

scenario "triggers once for each creature that enters" {
  battlefield A: "Impact Tremors", 2 "Forest", 4 "Mountain"
  hand A: "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert life B 18
}

scenario "opponent's creature entering does not trigger" {
  battlefield A: "Impact Tremors"
  battlefield B: 2 "Forest"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
  assert life A 20
  assert life B 20
}

scenario "cast the enchantment, then a creature" {
  battlefield A: 2 "Mountain", 2 "Forest"
  hand A: "Impact Tremors", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Impact Tremors"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Impact Tremors"
  assert battlefield A contains "Grizzly Bears"
  assert life B 19
}

# Flutterfox: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Flutterfox lacks flying without an artifact or enchantment" {
  battlefield A: "Flutterfox", "Plains"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert has not "Flutterfox" flying
  assert power "Flutterfox" 2
  assert toughness "Flutterfox" 2
}

scenario "without flying, Flutterfox can be blocked by a ground creature" {
  battlefield A: "Flutterfox"
  battlefield B: "Grizzly Bears"
  start turn 2 A
  turn 2 A: attack "Flutterfox"
  turn 2 B: block "Flutterfox" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 20
  assert graveyard A contains "Flutterfox"
  assert graveyard B contains "Grizzly Bears"
}

scenario "unblocked Flutterfox deals 2 damage" {
  battlefield A: "Flutterfox"
  start turn 2 A
  turn 2 A: attack "Flutterfox"
  run_to turn 2 postcombat_main
  assert life B 18
  assert battlefield A contains "Flutterfox"
}

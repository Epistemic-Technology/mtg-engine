# Celestial Messenger: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "flash lets it be cast on the opponent's turn" {
  battlefield A: 4 "Island"
  hand A: "Celestial Messenger"
  start turn 2 B precombat_main
  turn 2 A: cast "Celestial Messenger"
  run_to turn 2 end
  assert battlefield A contains "Celestial Messenger"
  assert hand A count 0
}

scenario "flying attacker can't be blocked by a ground creature" {
  battlefield A: "Celestial Messenger"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Celestial Messenger"
  illegal turn 1 B: block "Celestial Messenger" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 17
  assert battlefield B contains "Grizzly Bears"
}

scenario "without a Yanling planeswalker it is a 3/2 and dies to Shock" {
  battlefield A: "Celestial Messenger"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  assert power "Celestial Messenger" 3
  assert toughness "Celestial Messenger" 2
  turn 2 B: cast "Shock" targeting "Celestial Messenger"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Celestial Messenger"
}

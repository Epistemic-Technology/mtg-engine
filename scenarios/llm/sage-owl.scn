# Sage Owl: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Sage Owl enters and looks at the top four, keeping them in the library" {
  battlefield A: 2 "Island"
  hand A: "Sage Owl"
  library A: "Grizzly Bears", "Hill Giant", "Serra Angel", "Wind Drake", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Sage Owl"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Sage Owl"
  assert hand A count 0
  assert stack count 0
  assert library A contains "Grizzly Bears"
  assert library A contains "Hill Giant"
  assert library A contains "Serra Angel"
  assert library A contains "Wind Drake"
  assert library A contains "Forest"
}

scenario "Sage Owl has flying and can't be blocked by a ground creature" {
  battlefield A: "Sage Owl"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Sage Owl"
  illegal turn 1 B: block "Sage Owl" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert has "Sage Owl" flying
  assert life B 19
  assert battlefield A contains "Sage Owl"
}

scenario "Sage Owl can be blocked by a flier" {
  battlefield A: "Sage Owl"
  battlefield B: "Wind Drake"
  start turn 1 A precombat_main
  turn 1 A: attack "Sage Owl"
  turn 1 B: block "Sage Owl" with "Wind Drake"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Sage Owl"
  assert battlefield B contains "Wind Drake"
  assert damage "Wind Drake" 1
}

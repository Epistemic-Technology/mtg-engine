# Burning Inquiry: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "each player draws three then discards three" {
  battlefield A: "Mountain"
  hand A: "Burning Inquiry"
  start turn 1 A precombat_main
  turn 1 A: cast "Burning Inquiry"
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert hand B count 0
  assert graveyard A contains "Burning Inquiry"
  assert graveyard A contains 3 "Plains"
  assert graveyard B contains 3 "Plains"
}

scenario "discards are three of the whole hand at random" {
  battlefield A: "Mountain"
  hand A: "Burning Inquiry", "Lightning Bolt", "Shock"
  hand B: "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Burning Inquiry"
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert hand B count 2
  assert graveyard A contains "Burning Inquiry"
}

scenario "drawing from a short library loses the game" {
  battlefield A: "Mountain"
  hand A: "Burning Inquiry"
  library B: "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Burning Inquiry"
  run_to turn 1 postcombat_main
  assert winner A
}

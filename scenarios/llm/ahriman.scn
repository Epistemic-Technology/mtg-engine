# Ahriman: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "sacrifice another creature to draw a card" {
  battlefield A: "Ahriman", "Grizzly Bears", 3 "Swamp"
  library A: "Island", "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Ahriman" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Ahriman"
  assert tapped oldest A "Swamp"
}

scenario "cannot sacrifice itself" {
  battlefield A: "Ahriman", 3 "Swamp"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Ahriman"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Ahriman"
  assert hand A count 0
}

scenario "deathtouch blocker kills larger attacker" {
  battlefield A: "Ahriman"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Ahriman"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Ahriman"
  assert life A 20
}

scenario "flying cannot be blocked by ground creature" {
  battlefield A: "Ahriman"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Ahriman"
  illegal turn 1 B: block "Ahriman" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield B contains "Grizzly Bears"
}

# Subterranean Scout: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enters trigger makes a small creature unblockable" {
  battlefield A: "Grizzly Bears", 2 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Subterranean Scout"
  turn 1 A: cast "Subterranean Scout"
  turn 1 A: trigger "Subterranean Scout" targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield A contains "Grizzly Bears"
  assert battlefield B contains "Hill Giant"
}

scenario "a pumped creature cannot be chosen and stays blockable" {
  battlefield A: "Grizzly Bears", 2 "Mountain", "Forest"
  battlefield B: "Hill Giant"
  hand A: "Giant Growth", "Subterranean Scout"
  turn 1 A: cast "Giant Growth" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Subterranean Scout"
  turn 1 A: trigger "Subterranean Scout" targeting "Subterranean Scout"
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
}

scenario "the evasion lasts only this turn" {
  battlefield A: "Grizzly Bears", 2 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Subterranean Scout"
  turn 1 A: cast "Subterranean Scout"
  turn 1 A: trigger "Subterranean Scout" targeting "Grizzly Bears"
  turn 3 A: attack "Grizzly Bears"
  turn 3 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 3 postcombat_main
  assert life B 20
  assert graveyard A contains "Grizzly Bears"
  assert damage "Hill Giant" 2
}

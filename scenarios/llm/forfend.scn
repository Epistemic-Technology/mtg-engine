# Forfend: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Forfend prevents noncombat damage to a creature" {
  battlefield A: 2 "Plains", "Mountain", "Grizzly Bears"
  hand A: "Forfend", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Forfend"
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert graveyard A contains "Forfend"
  assert graveyard A contains "Lightning Bolt"
}

scenario "Forfend does not prevent damage to players" {
  battlefield A: 2 "Plains", "Mountain"
  hand A: "Forfend", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Forfend"
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "Forfend prevents combat damage to creatures but not to players" {
  battlefield A: 2 "Plains", "Grizzly Bears"
  battlefield B: "Hill Giant", "Serra Angel"
  hand A: "Forfend"
  start turn 2 B
  turn 2 B: attack "Hill Giant", "Serra Angel"
  turn 2 A: block "Hill Giant" with "Grizzly Bears"
  turn 2 declare_blockers A: cast "Forfend"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert damage "Hill Giant" 0
  assert life A 16
}

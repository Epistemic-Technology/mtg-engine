# Parapet Watchers: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "white mana pumps toughness until end of turn" {
  battlefield A: "Parapet Watchers", "Plains"
  turn 1 A: activate "Parapet Watchers"
  run_to turn 1 postcombat_main
  assert toughness "Parapet Watchers" 3
  assert power "Parapet Watchers" 2
  assert tapped "Plains"
  run_to turn 2 upkeep
  assert toughness "Parapet Watchers" 2
}

scenario "two activations in response save it from Lightning Bolt" {
  battlefield A: "Parapet Watchers", "Island", "Plains"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Parapet Watchers"
  turn 2 A: activate "Parapet Watchers"
  turn 2 A: activate "Parapet Watchers"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Parapet Watchers"
  assert damage "Parapet Watchers" 3
  assert toughness "Parapet Watchers" 4
}

scenario "without activation Lightning Bolt kills it" {
  battlefield A: "Parapet Watchers"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Parapet Watchers"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Parapet Watchers"
}

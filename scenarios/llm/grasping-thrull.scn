# Grasping Thrull: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enters: deals 2 damage to each opponent and controller gains 2 life" {
  battlefield A: 3 "Plains", 2 "Swamp"
  hand A: "Grasping Thrull"
  start turn 1 A precombat_main
  turn 1 A: cast "Grasping Thrull"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grasping Thrull"
  assert life B 18
  assert life A 22
}

scenario "flying: ground creature cannot block it" {
  battlefield A: "Grasping Thrull"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Grasping Thrull"
  illegal turn 1 B: block "Grasping Thrull" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 17
  assert battlefield B contains "Grizzly Bears"
}

scenario "flying creature can block it" {
  battlefield A: "Grasping Thrull"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: attack "Grasping Thrull"
  turn 1 B: block "Grasping Thrull" with "Serra Angel"
  run_to turn 1 postcombat_main
  assert life B 20
  assert damage "Serra Angel" 3
  assert graveyard A contains "Grasping Thrull"
}

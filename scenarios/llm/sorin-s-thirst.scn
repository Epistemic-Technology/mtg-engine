# Sorin's Thirst: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Sorin's Thirst kills a 2/2 and gains 2 life" {
  life A 15
  battlefield A: 2 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Sorin's Thirst"
  start turn 1 A precombat_main
  turn 1 A: cast "Sorin's Thirst" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert graveyard A contains "Sorin's Thirst"
  assert life A 17
  assert life B 20
}

scenario "Sorin's Thirst deals only 2 damage to a larger creature" {
  battlefield A: 2 "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Sorin's Thirst"
  start turn 1 A precombat_main
  turn 1 A: cast "Sorin's Thirst" targeting "Hill Giant"
  run_to turn 1 begin_combat
  assert battlefield B contains "Hill Giant"
  assert damage "Hill Giant" 2
  assert life A 22
}

scenario "Sorin's Thirst gains no life if its target becomes illegal" {
  battlefield A: 2 "Swamp"
  battlefield B: "Grizzly Bears", 3 "Swamp"
  hand A: "Sorin's Thirst"
  hand B: "Murder"
  start turn 1 A precombat_main
  turn 1 A: cast "Sorin's Thirst" targeting "Grizzly Bears"
  turn 1 B: cast "Murder" targeting "Grizzly Bears" in response to "Sorin's Thirst"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert graveyard A contains "Sorin's Thirst"
  assert life A 20
}

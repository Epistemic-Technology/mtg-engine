# Fleeting Flight: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Fleeting Flight puts a counter and grants flying" {
  battlefield A: "Grizzly Bears", "Plains"
  hand A: "Fleeting Flight"
  start turn 1 A precombat_main
  turn 1 A: cast "Fleeting Flight" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 3
  assert has "Grizzly Bears" flying
  assert graveyard A contains "Fleeting Flight"
}

scenario "Fleeting Flight prevents combat damage to the creature" {
  battlefield A: "Grizzly Bears", "Plains"
  hand A: "Fleeting Flight"
  battlefield B: "Hill Giant"
  start turn 1 A
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Hill Giant"
  turn 1 declare_blockers A: cast "Fleeting Flight" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert graveyard B contains "Hill Giant"
  assert life B 20
}

scenario "Fleeting Flight does not prevent noncombat damage" {
  battlefield A: "Grizzly Bears", "Plains", "Mountain"
  hand A: "Fleeting Flight", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Fleeting Flight" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A lacks "Grizzly Bears"
}

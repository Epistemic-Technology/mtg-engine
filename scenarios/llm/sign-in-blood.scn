# Sign in Blood: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Sign in Blood targeting yourself draws two and loses two" {
  battlefield A: 2 "Swamp"
  hand A: "Sign in Blood"
  turn 1 A: cast "Sign in Blood" targeting player A
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert life A 18
  assert graveyard A contains "Sign in Blood"
}

scenario "Sign in Blood targeting the opponent" {
  battlefield A: 2 "Swamp"
  hand A: "Sign in Blood"
  turn 1 A: cast "Sign in Blood" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 2
  assert life B 18
  assert life A 20
  assert hand A count 0
}

scenario "Sign in Blood finishes an opponent at 2 life" {
  life B 2
  battlefield A: 2 "Swamp"
  hand A: "Sign in Blood"
  turn 1 A: cast "Sign in Blood" targeting player B
  run_to end
  assert winner A
}

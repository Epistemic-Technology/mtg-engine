# Ember Weaver: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Ember Weaver gets +1/+0 with a red permanent" {
  battlefield A: "Ember Weaver", "Hill Giant"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Ember Weaver" 3
  assert toughness "Ember Weaver" 3
  assert has "Ember Weaver" reach
}

scenario "Ember Weaver loses the bonus when the red permanent leaves" {
  battlefield A: "Ember Weaver", "Hill Giant", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Hill Giant"
  assert power "Ember Weaver" 2
}

scenario "Ember Weaver with reach blocks a flier" {
  battlefield A: "Ember Weaver"
  battlefield B: "Wind Drake"
  start turn 2 B
  turn 2 B: attack "Wind Drake"
  turn 2 A: block "Wind Drake" with "Ember Weaver"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Wind Drake"
  assert battlefield A contains "Ember Weaver"
  assert damage "Ember Weaver" 2
}

scenario "Ember Weaver strikes first and takes no damage" {
  battlefield A: "Ember Weaver", "Hill Giant"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Ember Weaver"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert battlefield A contains "Ember Weaver"
  assert damage "Ember Weaver" 0
}

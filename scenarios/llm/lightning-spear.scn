# Lightning Spear: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "equipped creature gets +1/+0 and trample" {
  battlefield A: "Lightning Spear", "Grizzly Bears", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Lightning Spear" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Lightning Spear" to "Grizzly Bears"
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 2
  assert has "Grizzly Bears" trample
}

scenario "equipped attacker tramples over a blocker" {
  battlefield A: "Lightning Spear", "Hill Giant", "Mountain"
  battlefield B: "Wind Drake"
  start turn 1 A precombat_main
  turn 1 A: activate "Lightning Spear" targeting "Hill Giant"
  turn 1 A: attack "Hill Giant"
  turn 1 B: block "Hill Giant" with "Wind Drake"
  turn 1 combat_damage A: assign "Hill Giant" to "Wind Drake" 2, player B 2
  run_to turn 1 postcombat_main
  assert life B 18
  assert graveyard B contains "Wind Drake"
  assert battlefield A contains "Hill Giant"
}

scenario "sacrifice to deal 3 damage to a player" {
  battlefield A: "Lightning Spear", 3 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Lightning Spear" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert graveyard A contains "Lightning Spear"
}

scenario "sacrifice to kill a creature" {
  battlefield A: "Lightning Spear", 3 "Mountain"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Lightning Spear" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Lightning Spear"
}

# Mobilize: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Mobilize untaps all creatures you control" {
  battlefield A: "Grizzly Bears" tapped, "Hill Giant" tapped, "Forest"
  hand A: "Mobilize"
  start turn 1 A precombat_main
  turn 1 A: cast "Mobilize"
  run_to turn 1 begin_combat
  assert untapped "Grizzly Bears"
  assert untapped "Hill Giant"
  assert graveyard A contains "Mobilize"
}

scenario "Mobilize does not untap lands or opponent's creatures" {
  battlefield A: "Grizzly Bears" tapped, "Forest", "Plains" tapped
  battlefield B: "Serra Angel" tapped
  hand A: "Mobilize"
  start turn 1 A precombat_main
  turn 1 A: cast "Mobilize"
  run_to turn 1 begin_combat
  assert untapped "Grizzly Bears"
  assert tapped "Plains"
  assert tapped "Forest"
  assert tapped "Serra Angel"
}

scenario "Mobilize untaps attackers after combat" {
  battlefield A: "Grizzly Bears", "Forest"
  hand A: "Mobilize"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 postcombat_main A: cast "Mobilize"
  run_to turn 1 end
  assert life B 18
  assert untapped "Grizzly Bears"
  assert graveyard A contains "Mobilize"
}

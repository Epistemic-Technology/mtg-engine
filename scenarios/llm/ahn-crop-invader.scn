# Ahn-Crop Invader: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "first strike during your turn kills blocker first" {
  battlefield A: "Ahn-Crop Invader"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Ahn-Crop Invader"
  turn 1 B: block "Ahn-Crop Invader" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Ahn-Crop Invader"
  assert graveyard B contains "Grizzly Bears"
  assert damage "Ahn-Crop Invader" 0
}

scenario "no first strike on opponent's turn" {
  battlefield A: "Ahn-Crop Invader"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Ahn-Crop Invader"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Ahn-Crop Invader"
  assert graveyard B contains "Grizzly Bears"
}

scenario "sacrifice another creature for +2/+0" {
  battlefield A: "Ahn-Crop Invader", "Grizzly Bears", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Ahn-Crop Invader" sacrificing "Grizzly Bears"
  run_to turn 1 begin_combat
  assert power "Ahn-Crop Invader" 4
  assert toughness "Ahn-Crop Invader" 2
  assert graveyard A contains "Grizzly Bears"
  assert tapped "Mountain"
}

# Reckless Scholar: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Reckless Scholar loots its controller" {
  battlefield A: "Reckless Scholar"
  hand A: "Grizzly Bears"
  library A: "Grizzly Bears", "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Reckless Scholar" targeting player A
  run_to turn 1 postcombat_main
  assert tapped "Reckless Scholar"
  assert hand A count 1
  assert hand A contains "Grizzly Bears"
  assert graveyard A contains "Grizzly Bears"
}

scenario "Reckless Scholar makes an opponent draw then discard the drawn card" {
  battlefield A: "Reckless Scholar"
  library B: "Hill Giant", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Reckless Scholar" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 0
  assert graveyard B contains "Hill Giant"
  assert tapped "Reckless Scholar"
}

scenario "Reckless Scholar cannot activate while tapped" {
  battlefield A: "Reckless Scholar" tapped
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Reckless Scholar" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 0
}

# Seraph Sanctuary: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Seraph Sanctuary gains 1 life when it enters" {
  hand A: "Seraph Sanctuary"
  start turn 1 A precombat_main
  turn 1 A: play "Seraph Sanctuary"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Seraph Sanctuary"
  assert life A 21
}

scenario "Seraph Sanctuary gains 1 life when an Angel you control enters" {
  battlefield A: "Seraph Sanctuary", 5 "Plains"
  hand A: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Serra Angel"
  assert life A 21
}

scenario "Seraph Sanctuary ignores non-Angel creatures" {
  battlefield A: "Seraph Sanctuary", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert life A 20
}

scenario "Seraph Sanctuary ignores an opponent's Angel" {
  battlefield A: "Seraph Sanctuary"
  battlefield B: 5 "Plains"
  hand B: "Serra Angel"
  start turn 2 B precombat_main
  turn 2 B: cast "Serra Angel"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Serra Angel"
  assert life A 20
  assert life B 20
}

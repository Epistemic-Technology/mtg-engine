# Vapor Snag: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Vapor Snag bounces an opponent's creature and its controller loses 1 life" {
  battlefield A: "Island"
  battlefield B: "Grizzly Bears"
  hand A: "Vapor Snag"
  turn 1 A: cast "Vapor Snag" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand B contains "Grizzly Bears"
  assert battlefield B lacks "Grizzly Bears"
  assert life B 19
  assert life A 20
  assert graveyard A contains "Vapor Snag"
}

scenario "Vapor Snag on your own creature makes you lose the life" {
  battlefield A: "Island", "Hill Giant"
  hand A: "Vapor Snag"
  turn 1 A: cast "Vapor Snag" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Hill Giant"
  assert battlefield A lacks "Hill Giant"
  assert life A 19
  assert life B 20
}

scenario "Vapor Snag does nothing if its target is gone" {
  battlefield A: "Island"
  battlefield B: "Grizzly Bears", "Mountain"
  hand A: "Vapor Snag"
  hand B: "Shock"
  turn 1 A: cast "Vapor Snag" targeting "Grizzly Bears"
  turn 1 B: cast "Shock" targeting "Grizzly Bears" in response to "Vapor Snag"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert hand B lacks "Grizzly Bears"
  assert life B 20
  assert graveyard A contains "Vapor Snag"
}

# Ghoulcaller's Chant: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "mode 1 returns a creature card to hand" {
  battlefield A: "Swamp"
  hand A: "Ghoulcaller's Chant"
  graveyard A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Ghoulcaller's Chant" mode 1 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert graveyard A lacks "Grizzly Bears"
  assert graveyard A contains "Ghoulcaller's Chant"
}

scenario "mode 1 returns only the chosen creature" {
  battlefield A: "Swamp"
  hand A: "Ghoulcaller's Chant"
  graveyard A: "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Ghoulcaller's Chant" mode 1 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Hill Giant"
  assert graveyard A contains "Grizzly Bears"
  assert hand A lacks "Grizzly Bears"
}

scenario "opponent's graveyard is untouched" {
  battlefield A: "Swamp"
  hand A: "Ghoulcaller's Chant"
  graveyard A: "Serra Angel"
  graveyard B: "Wind Drake"
  start turn 1 A precombat_main
  turn 1 A: cast "Ghoulcaller's Chant" mode 1 targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert hand A contains "Serra Angel"
  assert graveyard B contains "Wind Drake"
}

# Hierophant's Chalice: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "chalice enters: opponent loses 1, you gain 1" {
  battlefield A: 3 "Plains"
  hand A: "Hierophant's Chalice"
  start turn 1 A precombat_main
  turn 1 precombat_main A: cast "Hierophant's Chalice"
  turn 1 precombat_main A: trigger "Hierophant's Chalice" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hierophant's Chalice"
  assert life B 19
  assert life A 21
}

scenario "chalice taps for colorless mana" {
  battlefield A: "Hierophant's Chalice", 3 "Mountain"
  hand A: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 precombat_main A: cast "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert tapped "Hierophant's Chalice"
}

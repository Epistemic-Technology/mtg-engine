# Rhystic Study: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "opponent's spell lets you draw when they can't pay" {
  battlefield A: "Rhystic Study"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: accept "Rhystic Study"
  run_to turn 2 postcombat_main
  assert life A 17
  assert hand A count 1
  assert graveyard B contains "Lightning Bolt"
}

scenario "you may decline to draw" {
  battlefield A: "Rhystic Study"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: decline "Rhystic Study"
  run_to turn 2 postcombat_main
  assert life A 17
  assert hand A count 0
}

scenario "your own spells do not trigger it" {
  battlefield A: "Rhystic Study", 3 "Island"
  hand A: "Divination"
  start turn 1 A precombat_main
  turn 1 A: cast "Divination"
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert graveyard A contains "Divination"
}

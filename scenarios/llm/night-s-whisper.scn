# Night's Whisper: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Night's Whisper draws two cards and costs 2 life" {
  battlefield A: 2 "Swamp"
  hand A: "Night's Whisper"
  library A: "Island", "Forest", "Mountain"
  turn 1 A: cast "Night's Whisper"
  run_to turn 1 postcombat_main
  assert life A 18
  assert hand A count 2
  assert hand A contains "Island"
  assert hand A contains "Forest"
  assert library A contains "Mountain"
  assert graveyard A contains "Night's Whisper"
}

scenario "Night's Whisper life loss can be lethal" {
  life A 2
  battlefield A: 2 "Swamp"
  hand A: "Night's Whisper"
  turn 1 A: cast "Night's Whisper"
  run_to end
  assert winner B
}

scenario "Night's Whisper drawing from a too-small library loses the game" {
  battlefield A: 2 "Swamp"
  hand A: "Night's Whisper"
  library A: "Island"
  turn 1 A: cast "Night's Whisper"
  run_to end
  assert winner B
}

scenario "Night's Whisper cannot be cast on the opponent's turn" {
  battlefield A: 2 "Swamp"
  hand A: "Night's Whisper"
  start turn 2 B
  illegal turn 2 precombat_main A: cast "Night's Whisper"
  run_to turn 2 postcombat_main
  assert hand A contains "Night's Whisper"
  assert life A 20
}

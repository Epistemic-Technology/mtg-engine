# Kithkin Daggerdare: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Daggerdare pumps an attacking creature" {
  battlefield A: "Kithkin Daggerdare", "Grizzly Bears", "Forest"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 declare_attackers A: activate "Kithkin Daggerdare" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
  assert tapped "Kithkin Daggerdare"
  assert life B 16
}

scenario "Daggerdare cannot target a creature that is not attacking" {
  battlefield A: "Kithkin Daggerdare", "Grizzly Bears", "Forest"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Kithkin Daggerdare" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert untapped "Kithkin Daggerdare"
  assert power "Grizzly Bears" 2
}

scenario "pumped attacker survives a block and kills the blocker" {
  battlefield A: "Kithkin Daggerdare", "Grizzly Bears", "Forest"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Hill Giant"
  turn 1 declare_blockers A: activate "Kithkin Daggerdare" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
  assert damage "Grizzly Bears" 3
  assert life B 20
}

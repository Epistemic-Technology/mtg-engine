# Skymarch Bloodletter: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enters: opponent loses 1 life and you gain 1 life" {
  battlefield A: 3 "Swamp"
  hand A: "Skymarch Bloodletter"
  start turn 1 A precombat_main
  turn 1 A: cast "Skymarch Bloodletter"
  turn 1 A: trigger "Skymarch Bloodletter" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Skymarch Bloodletter"
  assert life B 19
  assert life A 21
}

scenario "flying: ground creature can't block it" {
  battlefield A: "Skymarch Bloodletter"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Skymarch Bloodletter"
  illegal turn 1 B: block "Skymarch Bloodletter" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield B contains "Grizzly Bears"
}

scenario "flying creature can block it" {
  battlefield A: "Skymarch Bloodletter"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: attack "Skymarch Bloodletter"
  turn 1 B: block "Skymarch Bloodletter" with "Serra Angel"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Skymarch Bloodletter"
  assert battlefield B contains "Serra Angel"
}

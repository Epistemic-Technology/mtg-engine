# Indestructible Aura: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "prevents burn damage to the target creature" {
  battlefield A: "Grizzly Bears", "Plains"
  battlefield B: "Mountain"
  hand A: "Indestructible Aura"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 1 A: cast "Indestructible Aura" targeting "Grizzly Bears" in response to "Lightning Bolt"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert graveyard A contains "Indestructible Aura"
  assert graveyard B contains "Lightning Bolt"
}

scenario "prevents combat damage to a blocker but not damage it deals" {
  battlefield A: "Grizzly Bears", "Plains"
  battlefield B: "Hill Giant"
  hand A: "Indestructible Aura"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Grizzly Bears"
  turn 2 declare_blockers A: cast "Indestructible Aura" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert damage "Hill Giant" 2
  assert life A 20
}

scenario "does not stop destroy effects" {
  battlefield A: "Grizzly Bears", "Plains"
  battlefield B: 3 "Swamp"
  hand A: "Indestructible Aura"
  hand B: "Murder"
  turn 1 A: cast "Indestructible Aura" targeting "Grizzly Bears"
  turn 1 postcombat_main B: cast "Murder" targeting "Grizzly Bears"
  run_to turn 1 end
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A lacks "Grizzly Bears"
}

# Sneering Shadewriter: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "enters drains each opponent for 2" {
  battlefield A: 5 "Swamp"
  hand A: "Sneering Shadewriter"
  start turn 1 A precombat_main
  turn 1 A: cast "Sneering Shadewriter"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Sneering Shadewriter"
  assert life B 18
  assert life A 22
}

scenario "flying evades ground blockers" {
  battlefield A: "Sneering Shadewriter"
  battlefield B: "Grizzly Bears"
  start turn 2 A
  turn 2 A: attack "Sneering Shadewriter"
  illegal turn 2 B: block "Sneering Shadewriter" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert has "Sneering Shadewriter" flying
  assert life B 17
}

scenario "flying creature can block it" {
  battlefield A: "Sneering Shadewriter"
  battlefield B: "Serra Angel"
  start turn 2 A
  turn 2 A: attack "Sneering Shadewriter"
  turn 2 B: block "Sneering Shadewriter" with "Serra Angel"
  run_to turn 2 postcombat_main
  assert life B 20
  assert graveyard A contains "Sneering Shadewriter"
  assert battlefield B contains "Serra Angel"
}

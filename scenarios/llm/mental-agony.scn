# Mental Agony: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Mental Agony makes target player discard two and lose 2 life" {
  battlefield A: "Swamp", 3 "Plains"
  hand A: "Mental Agony"
  hand B: "Grizzly Bears", "Hill Giant", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Mental Agony" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand B count 1
  assert graveyard A contains "Mental Agony"
  assert life A 20
}

scenario "Mental Agony with one card in hand discards it and still costs 2 life" {
  battlefield A: "Swamp", 3 "Plains"
  hand A: "Mental Agony"
  hand B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "Mental Agony" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand B count 0
  assert graveyard B contains "Serra Angel"
}

scenario "Mental Agony against an empty hand still causes life loss" {
  battlefield A: "Swamp", 3 "Plains"
  hand A: "Mental Agony"
  start turn 1 A precombat_main
  turn 1 A: cast "Mental Agony" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand B count 0
}

scenario "Mental Agony can target its caster" {
  battlefield A: "Swamp", 3 "Plains"
  hand A: "Mental Agony", "Shock", "Giant Growth", "Murder"
  start turn 1 A precombat_main
  turn 1 A: cast "Mental Agony" targeting player A
  run_to turn 1 postcombat_main
  assert life A 18
  assert hand A count 1
  assert life B 20
}

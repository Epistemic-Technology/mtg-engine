# Shrivel: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Shrivel gives every creature -1/-1 until end of turn" {
  battlefield A: 2 "Swamp", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Shrivel"
  turn 1 A: cast "Shrivel"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 1
  assert toughness "Grizzly Bears" 1
  assert power "Hill Giant" 2
  assert toughness "Hill Giant" 2
  assert graveyard A contains "Shrivel"
}

scenario "Shrivel's effect wears off at end of turn" {
  battlefield A: 2 "Swamp", "Grizzly Bears"
  hand A: "Shrivel"
  turn 1 A: cast "Shrivel"
  run_to turn 2 precombat_main
  assert power "Grizzly Bears" 2
  assert toughness "Grizzly Bears" 2
}

scenario "Shrivel finishes off a damaged creature" {
  battlefield A: 2 "Swamp", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Shock", "Shrivel"
  turn 1 A: cast "Shock" targeting "Hill Giant"
  turn 1 A: wait
  turn 1 A: cast "Shrivel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

scenario "Creatures entering after Shrivel resolves are unaffected" {
  battlefield A: 2 "Swamp", 2 "Forest"
  hand A: "Shrivel", "Grizzly Bears"
  turn 1 A: cast "Shrivel"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert power "Grizzly Bears" 2
  assert toughness "Grizzly Bears" 2
}

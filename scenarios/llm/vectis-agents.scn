# Vectis Agents: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "activation makes it unblockable and shrinks power" {
  battlefield A: "Vectis Agents", "Island", "Swamp"
  battlefield B: "Grizzly Bears"
  turn 1 A: activate "Vectis Agents"
  turn 1 A: attack "Vectis Agents"
  illegal turn 1 B: block "Vectis Agents" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Vectis Agents" 2
  assert toughness "Vectis Agents" 3
  assert life B 18
  assert battlefield B contains "Grizzly Bears"
}

scenario "without activation it can be blocked" {
  battlefield A: "Vectis Agents", "Island", "Swamp"
  battlefield B: "Grizzly Bears"
  turn 1 A: attack "Vectis Agents"
  turn 1 B: block "Vectis Agents" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Grizzly Bears"
  assert battlefield A contains "Vectis Agents"
  assert damage "Vectis Agents" 2
}

scenario "the power reduction ends at end of turn" {
  battlefield A: "Vectis Agents", "Island", "Swamp"
  turn 1 A: activate "Vectis Agents"
  run_to turn 1 postcombat_main
  assert power "Vectis Agents" 2
  run_to turn 2 precombat_main
  assert power "Vectis Agents" 4
}

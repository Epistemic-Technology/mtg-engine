# Samite Herbalist: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "attacking taps the Herbalist and gains 1 life" {
  battlefield A: "Samite Herbalist"
  start turn 1 A precombat_main
  turn 1 A: attack "Samite Herbalist"
  run_to turn 1 postcombat_main
  assert tapped "Samite Herbalist"
  assert life A 21
  assert life B 18
}

scenario "trigger resolves even when the Herbalist is blocked and dies" {
  battlefield A: "Samite Herbalist"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Samite Herbalist"
  turn 1 B: block "Samite Herbalist" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 21
  assert life B 20
  assert graveyard A contains "Samite Herbalist"
  assert graveyard B contains "Grizzly Bears"
}

scenario "no life gain when the Herbalist does not become tapped" {
  battlefield A: "Samite Herbalist"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert untapped "Samite Herbalist"
  assert life A 20
}

# Woodland Liege: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Woodland Liege entering is not a Beast and draws nothing" {
  battlefield A: 3 "Forest"
  hand A: "Woodland Liege"
  start turn 1 A precombat_main
  turn 1 A: cast "Woodland Liege"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Woodland Liege"
  assert hand A count 0
}

scenario "a non-Beast creature entering does not draw" {
  battlefield A: "Woodland Liege", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert hand A count 0
}

scenario "an opponent's creature entering does not draw" {
  battlefield A: "Woodland Liege"
  battlefield B: 5 "Mountain"
  hand B: "Hill Giant"
  start turn 2 B precombat_main
  turn 2 B: cast "Hill Giant"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert hand A count 0
}

# Fodder Tosser: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "Fodder Tosser discards a card to deal 2 damage to a player" {
  battlefield A: "Fodder Tosser"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Fodder Tosser" discarding "Grizzly Bears" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand A count 0
  assert graveyard A contains "Grizzly Bears"
  assert tapped "Fodder Tosser"
}

scenario "Fodder Tosser cannot be activated with an empty hand" {
  battlefield A: "Fodder Tosser"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Fodder Tosser" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
  assert untapped "Fodder Tosser"
}

scenario "Fodder Tosser cannot be activated while tapped" {
  battlefield A: "Fodder Tosser" tapped
  hand A: "Hill Giant"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Fodder Tosser" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
  assert hand A contains "Hill Giant"
}

# Call to Heel: card and scenarios authored by claude-opus-5-5 through `mtg-cards model-author`,
# accepted by the round-trip gate and these scenarios.

scenario "bouncing an opponent's creature makes that opponent draw" {
  battlefield A: 2 "Island"
  battlefield B: "Grizzly Bears"
  hand A: "Call to Heel"
  start turn 1 A precombat_main
  turn 1 A: cast "Call to Heel" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B lacks "Grizzly Bears"
  assert hand B contains "Grizzly Bears"
  assert hand B count 2
  assert hand A count 0
  assert graveyard A contains "Call to Heel"
}

scenario "bouncing your own creature lets you draw" {
  battlefield A: 2 "Island", "Hill Giant"
  hand A: "Call to Heel"
  start turn 1 A precombat_main
  turn 1 A: cast "Call to Heel" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Hill Giant"
  assert hand A contains "Hill Giant"
  assert hand A count 2
}

scenario "no one draws if the target becomes illegal" {
  battlefield A: 2 "Island", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Call to Heel", "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Call to Heel" targeting "Grizzly Bears"
  turn 1 A: cast "Shock" targeting "Grizzly Bears" in response to "Call to Heel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert hand B count 0
  assert hand A count 0
  assert graveyard A contains "Call to Heel"
}

scenario "Docent of Perfection transforms once you control three Wizards" {
  battlefield A: "Docent of Perfection", 3 "Mountain"
  hand A: "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"
  start turn 2 A precombat_main
  turn 2 A: cast "Lightning Bolt" targeting player B
  turn 2 A: wait
  turn 2 A: cast "Lightning Bolt" targeting player B
  turn 2 A: wait
  turn 2 A: cast "Lightning Bolt" targeting player B
  run_to turn 2 postcombat_main
  assert battlefield A contains 3 "Human Wizard"
  assert power "Final Iteration" 6
  assert power newest A "Human Wizard" 3
  assert has newest A "Human Wizard" flying
}

scenario "Docent of Perfection with two Wizards doesn't transform" {
  battlefield A: "Docent of Perfection", 2 "Mountain"
  hand A: "Lightning Bolt", "Lightning Bolt"
  start turn 2 A precombat_main
  turn 2 A: cast "Lightning Bolt" targeting player B
  turn 2 A: wait
  turn 2 A: cast "Lightning Bolt" targeting player B
  run_to turn 2 postcombat_main
  assert battlefield A contains 2 "Human Wizard"
  assert power "Docent of Perfection" 5
  assert power newest A "Human Wizard" 1
}

scenario "Curious Homunculus transforms at upkeep with three instants and sorceries in the graveyard" {
  battlefield A: "Curious Homunculus"
  graveyard A: "Lightning Bolt", "Shock", "Divination"
  library A: 5 "Island"
  start turn 2 A upkeep
  run_to turn 2 precombat_main
  assert power "Voracious Reader" 3
}

scenario "Curious Homunculus stays with two" {
  battlefield A: "Curious Homunculus"
  graveyard A: "Lightning Bolt", "Shock", "Grizzly Bears"
  library A: 5 "Island"
  start turn 2 A upkeep
  run_to turn 2 precombat_main
  assert power "Curious Homunculus" 1
}

scenario "Voracious Reader makes instants cost {1} less" {
  battlefield A: "Curious Homunculus", 2 "Island"
  graveyard A: "Lightning Bolt", "Shock", "Divination"
  hand A: "Divination"
  library A: 5 "Island"
  start turn 2 A upkeep
  turn 2 precombat_main A: cast "Divination"
  run_to turn 2 postcombat_main
  assert hand A count 3
}

scenario "Aberrant Researcher transforms when it mills an instant" {
  battlefield A: "Aberrant Researcher"
  library A: "Lightning Bolt", 5 "Island"
  start turn 2 A upkeep
  run_to turn 2 precombat_main
  assert graveyard A contains "Lightning Bolt"
  assert power "Perfected Form" 5
}

scenario "Aberrant Researcher doesn't transform when it mills a land" {
  battlefield A: "Aberrant Researcher"
  library A: 6 "Island"
  start turn 2 A upkeep
  run_to turn 2 precombat_main
  assert graveyard A contains "Island"
  assert power "Aberrant Researcher" 3
}

scenario "Lone Rider transforms at the end step after its controller gained 3 life" {
  battlefield A: "Lone Rider", "Plains"
  hand A: "Healing Salve"
  start turn 2 A precombat_main
  turn 2 A: cast "Healing Salve" mode 1 targeting player A
  run_to turn 2 cleanup
  assert power "It That Rides as One" 4
  assert has "It That Rides as One" trample
}

scenario "Lone Rider doesn't transform without lifegain" {
  battlefield A: "Lone Rider", "Plains"
  start turn 2 A precombat_main
  run_to turn 2 cleanup
  assert power "Lone Rider" 1
}

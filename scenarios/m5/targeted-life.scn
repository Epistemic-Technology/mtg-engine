# "Spells your opponents cast that target this creature cost an
# additional 3 life to cast." (Terror of the Peaks; CR 601.2f, 119.4):
# the life is paid as the spell's costs are, and the permanent can be
# chosen as a target only with that much life to pay.

scenario "Terror of the Peaks: a spell targeting it costs 3 life" {
  battlefield A: "Terror of the Peaks"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Terror of the Peaks"
  run_to turn 2 postcombat_main
  assert life B 17
  assert damage "Terror of the Peaks" 3
}

scenario "Terror of the Peaks: not targetable with 2 life" {
  battlefield A: "Terror of the Peaks"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  life B 2
  start turn 2 B precombat_main
  illegal turn 2 B: cast "Lightning Bolt" targeting "Terror of the Peaks"
  turn 2 B: cast "Lightning Bolt" targeting player A
  run_to turn 2 postcombat_main
  assert life B 2
  assert life A 17
}

scenario "Terror of the Peaks: other targets cost nothing more" {
  battlefield A: "Terror of the Peaks", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 20
  assert graveyard A contains "Grizzly Bears"
}

scenario "Terror of the Peaks: its controller's own spells pay nothing" {
  battlefield A: "Terror of the Peaks", "Forest"
  hand A: "Giant Growth"
  turn 1 A: cast "Giant Growth" targeting "Terror of the Peaks"
  run_to turn 1 postcombat_main
  assert life A 20
  assert power "Terror of the Peaks" 8
}

scenario "Terror of the Peaks: another creature entering deals its power" {
  battlefield A: "Terror of the Peaks", 4 "Mountain"
  hand A: "Hill Giant"
  turn 1 A: cast "Hill Giant"
  turn 1 A: wait
  turn 1 A: trigger "Terror of the Peaks" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
}

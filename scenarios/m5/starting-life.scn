# Your life total against your starting life total (CR 103.4; 20 here):
# "greater than", "greater than or equal to", "at least 7 life more than".

scenario "Path of Bravery: at the starting life total, creatures get +1/+1" {
  battlefield A: "Path of Bravery", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 3
}

scenario "Path of Bravery: below it, no bonus" {
  life A 19
  battlefield A: "Path of Bravery", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 2
}

scenario "Path of Bravery: attacking gains life for each attacker, and the bonus returns" {
  life A 18
  battlefield A: "Path of Bravery", "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert life A 20
  assert power "Grizzly Bears" 3
  assert life B 13
}

scenario "Leyline of Hope: 7 more than the starting life total, +2/+2" {
  life A 27
  battlefield A: "Leyline of Hope", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
}

scenario "Leyline of Hope: 6 more isn't enough; life gained is one more" {
  life A 26
  battlefield A: "Leyline of Hope", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 2
}

scenario "Speaker of the Heavens: only with 7 more life than the start" {
  life A 26
  battlefield A: "Speaker of the Heavens"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Speaker of the Heavens"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Angel"
}

scenario "Speaker of the Heavens makes an Angel at 27 life" {
  life A 27
  battlefield A: "Speaker of the Heavens"
  start turn 1 A precombat_main
  turn 1 A: activate "Speaker of the Heavens"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Angel"
}

scenario "Cosmos Elixir: above the starting life total, draw" {
  life A 21
  battlefield A: "Cosmos Elixir"
  start turn 1 A precombat_main
  run_to turn 2 upkeep
  assert hand A count 1
  assert life A 21
}

scenario "Cosmos Elixir: at the starting life total, gain 2 life" {
  battlefield A: "Cosmos Elixir"
  start turn 1 A precombat_main
  run_to turn 2 upkeep
  assert hand A count 0
  assert life A 22
}

scenario "Ayli: exile only with 10 more life than the start" {
  life A 29
  battlefield A: "Ayli, Eternal Pilgrim", "Grizzly Bears", "Plains", "Swamp", "Plains"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Ayli, Eternal Pilgrim" ability 2 sacrificing "Grizzly Bears" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Serra Angel"
}

scenario "Ayli: at 30 life it exiles" {
  life A 30
  battlefield A: "Ayli, Eternal Pilgrim", "Grizzly Bears", "Plains", "Swamp", "Plains"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: activate "Ayli, Eternal Pilgrim" ability 2 sacrificing "Grizzly Bears" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert exile B contains "Serra Angel"
}

scenario "Ayli: a sacrifice gains life equal to its toughness" {
  battlefield A: "Ayli, Eternal Pilgrim", "Hill Giant", "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Ayli, Eternal Pilgrim" ability 1 sacrificing "Hill Giant"
  run_to turn 1 postcombat_main
  assert life A 23
}

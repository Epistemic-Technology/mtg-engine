# Cast triggers by where the spell was cast from and by ordinal:
# "a spell from your graveyard", "a spell from anywhere other than your
# hand", "their second spell each turn" for any player.

scenario "Secrets of the Dead draws for a flashback spell" {
  battlefield A: "Secrets of the Dead", 5 "Mountain"
  graveyard A: "Firebolt"
  library A: "Island", "Plains"
  start turn 2 A precombat_main
  turn 2 A: cast "Firebolt" from graveyard targeting player B
  run_to turn 2 postcombat_main
  assert hand A count 1
  assert life B 18
  assert exile A contains "Firebolt"
}

scenario "Secrets of the Dead: a spell from hand draws nothing" {
  battlefield A: "Secrets of the Dead", "Mountain"
  hand A: "Firebolt"
  start turn 2 A precombat_main
  turn 2 A: cast "Firebolt" targeting player B
  run_to turn 2 postcombat_main
  assert hand A count 0
}

scenario "Burning Vengeance deals 2 to the target when you flash back" {
  battlefield A: "Burning Vengeance", 5 "Mountain"
  battlefield B: "Grizzly Bears"
  graveyard A: "Firebolt"
  start turn 2 A precombat_main
  turn 2 A: cast "Firebolt" from graveyard targeting player B
  turn 2 A: trigger "Burning Vengeance" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life B 18
}

scenario "Burning Vengeance: an opponent's flashback doesn't trigger it" {
  battlefield A: "Burning Vengeance"
  battlefield B: 5 "Mountain"
  graveyard B: "Firebolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Firebolt" from graveyard targeting player A
  run_to turn 2 postcombat_main
  assert life A 18
  assert life B 20
}

scenario "Vega draws for a spell cast from the graveyard, not from hand" {
  battlefield A: "Vega, the Watcher", 6 "Mountain"
  graveyard A: "Firebolt"
  hand A: "Shock"
  library A: "Island", "Plains"
  start turn 2 A precombat_main
  turn 2 A: cast "Shock" targeting player B
  turn 2 A: wait
  turn 2 A: cast "Firebolt" from graveyard targeting player B
  run_to turn 2 postcombat_main
  assert hand A count 1
  assert life B 16
}

scenario "Dreamtide Whale proliferates on an opponent's second spell" {
  battlefield A: "Dreamtide Whale" with 1 time
  battlefield B: 2 "Mountain"
  hand B: "Shock", "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 B: wait
  turn 2 B: cast "Shock" targeting player A
  run_to turn 2 postcombat_main
  assert counters "Dreamtide Whale" time 2
}

scenario "Ledger Shredder connives on any player's second spell, not the first" {
  battlefield A: "Ledger Shredder"
  battlefield B: 2 "Mountain"
  hand B: "Shock", "Shock"
  library A: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 B: wait
  assert hand A count 0
  turn 2 B: cast "Shock" targeting player A
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert counters "Ledger Shredder" +1/+1 1
}

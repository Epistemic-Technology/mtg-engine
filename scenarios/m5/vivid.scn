# Vivid (an ability word): counts the colors among permanents you control.

scenario "Vivid: Shinestriker draws a card for each color among your permanents" {
  battlefield A: 6 "Island", "Grizzly Bears", "Shock Troops"
  hand A: "Shinestriker"
  library A: "Forest", "Plains", "Swamp", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: cast "Shinestriker"
  run_to turn 1 postcombat_main
  assert hand A count 3
}

scenario "Vivid: lands are colorless and don't count" {
  battlefield A: 6 "Island"
  hand A: "Shinestriker"
  library A: "Forest", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Shinestriker"
  run_to turn 1 postcombat_main
  assert hand A count 1
}

scenario "Vivid: Squawkroaster's power is the number of colors" {
  battlefield A: "Squawkroaster", "Grizzly Bears", "Azorius First-Wing"
  run_to turn 1 precombat_main
  assert power "Squawkroaster" 4
}

scenario "Vivid: Explosive Prodigy deals damage equal to the colors" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Explosive Prodigy"
  start turn 1 A precombat_main
  turn 1 A: cast "Explosive Prodigy"
  run_to turn 1 postcombat_main
  assert graveyard B lacks "Hill Giant"
  assert damage "Hill Giant" 2
}

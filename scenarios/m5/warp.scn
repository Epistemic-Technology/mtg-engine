# Warp (CR 702.185): cast from the hand for the warp cost; the permanent
# is exiled at the beginning of the next end step, and its owner may cast
# it from exile on a later turn.

scenario "warp: cast for the warp cost, its enters trigger, exiled at the end step" {
  battlefield A: 2 "Forest"
  hand A: "Germinating Wurm"
  turn 1 A: cast "Germinating Wurm" warped
  run_to turn 1 postcombat_main
  assert battlefield A contains "Germinating Wurm"
  assert life A 22
  run_to turn 2 upkeep
  assert exile A contains "Germinating Wurm"
}

scenario "warp: cast from exile on a later turn, for its mana cost" {
  battlefield A: 5 "Forest"
  hand A: "Germinating Wurm"
  turn 1 A: cast "Germinating Wurm" warped
  turn 3 A: cast "Germinating Wurm"
  run_to turn 3 postcombat_main
  assert battlefield A contains "Germinating Wurm"
  assert life A 24
  run_to turn 4 upkeep
  assert battlefield A contains "Germinating Wurm"
}

scenario "warp: the warp cost isn't payable, so it isn't offered" {
  battlefield A: "Island"
  hand A: "Starbreach Whale"
  illegal turn 1 A: cast "Starbreach Whale" warped
  run_to turn 1 postcombat_main
  assert hand A contains "Starbreach Whale"
}

# M5: a condition of two alternatives, `either <a> else <b>` ("as long as
# you control a land creature or a land entered the battlefield under your
# control this turn").

scenario "either: a land creature" {
  battlefield A: "Earth Rumble Wrestlers", "Dryad Arbor"
  assert power "Earth Rumble Wrestlers" 4
  assert has "Earth Rumble Wrestlers" trample
}

scenario "either: a land entered this turn" {
  battlefield A: "Earth Rumble Wrestlers"
  hand A: "Forest"
  turn 1 A: play "Forest"
  run_to turn 1 postcombat_main
  assert power "Earth Rumble Wrestlers" 4
  assert has "Earth Rumble Wrestlers" trample
}

scenario "either: neither" {
  battlefield A: "Earth Rumble Wrestlers", "Forest"
  assert power "Earth Rumble Wrestlers" 3
  assert has not "Earth Rumble Wrestlers" trample
}

scenario "either: a Hero attacked, a card at the end step" {
  battlefield A: "Avengers Assemble!", "Amateur Hero"
  library A: "Island", "Island", "Island"
  turn 1 A: attack "Amateur Hero"
  run_to turn 2 upkeep
  assert power "Amateur Hero" 5
  assert hand A count 1
  assert life B 15
}

scenario "either: a Hero entered, a card" {
  battlefield A: "Avengers Assemble!", "Plains", "Plains", "Plains"
  hand A: "Amateur Hero"
  library A: "Island", "Island", "Island"
  turn 1 A: cast "Amateur Hero"
  run_to turn 2 upkeep
  assert hand A count 1
}

scenario "either: neither, no card" {
  battlefield A: "Avengers Assemble!", "Amateur Hero"
  library A: "Island", "Island", "Island"
  run_to turn 2 upkeep
  assert hand A count 0
}

# Forecast (CR 702.57a): "Forecast — [activated ability]" means
# "[activated ability]. Activate only during your upkeep and only once
# each turn." Its cost reveals the card from the hand, where it stays.

scenario "forecast: Piercing Rays taps a creature during your upkeep" {
  battlefield A: 3 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Piercing Rays"
  start turn 3 A
  turn 3 upkeep A: activate "Piercing Rays" targeting "Grizzly Bears"
  run_to turn 3 precombat_main
  assert tapped "Grizzly Bears"
  assert hand A contains "Piercing Rays"
  assert known B "Piercing Rays"
}

scenario "forecast: not outside your upkeep" {
  battlefield A: 3 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Piercing Rays"
  start turn 3 A
  illegal turn 3 precombat_main A: activate "Piercing Rays" targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert untapped "Grizzly Bears"
}

scenario "forecast: not during the opponent's upkeep" {
  battlefield A: 3 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Piercing Rays"
  start turn 2 B
  illegal turn 2 upkeep A: activate "Piercing Rays" targeting "Grizzly Bears"
  run_to turn 2 precombat_main
  assert untapped "Grizzly Bears"
}

scenario "forecast: only once each turn" {
  battlefield A: 6 "Plains"
  battlefield B: "Grizzly Bears", "Hill Giant"
  hand A: "Piercing Rays"
  start turn 3 A
  turn 3 upkeep A: activate "Piercing Rays" targeting "Grizzly Bears"
  turn 3 upkeep A: wait
  illegal turn 3 upkeep A: activate "Piercing Rays" targeting "Hill Giant"
  run_to turn 3 precombat_main
  assert tapped "Grizzly Bears"
  assert untapped "Hill Giant"
}

scenario "forecast: then the card is cast as usual" {
  battlefield A: 5 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Piercing Rays"
  start turn 3 A
  turn 3 upkeep A: activate "Piercing Rays" targeting "Grizzly Bears"
  turn 3 A: cast "Piercing Rays" targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert exile B contains "Grizzly Bears"
}

scenario "forecast: Spirit en-Dal gives shadow from the hand" {
  battlefield A: 2 "Plains", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Spirit en-Dal"
  start turn 3 A
  turn 3 upkeep A: activate "Spirit en-Dal" targeting "Grizzly Bears"
  turn 3 A: attack "Grizzly Bears"
  illegal turn 3 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 3 postcombat_main
  assert has "Grizzly Bears" shadow
  assert life B 18
}

scenario "forecast: Plumes of Peace taps a creature; as an Aura it keeps it tapped" {
  battlefield A: 6 "Island", 3 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Plumes of Peace"
  start turn 3 A
  turn 3 upkeep A: activate "Plumes of Peace" targeting "Grizzly Bears"
  turn 3 A: cast "Plumes of Peace" targeting "Grizzly Bears"
  run_to turn 5 upkeep
  assert tapped "Grizzly Bears"
  assert attached "Plumes of Peace" to "Grizzly Bears"
}

scenario "forecast: Skyscribing's forecast makes each player draw" {
  battlefield A: 3 "Island"
  hand A: "Skyscribing"
  library A: "Forest", "Plains", "Swamp"
  library B: "Forest", "Plains", "Swamp"
  start turn 3 A
  turn 3 upkeep A: activate "Skyscribing"
  run_to turn 3 precombat_main
  assert hand B count 1
  assert library B count 2
  assert hand A contains "Skyscribing"
}

scenario "forecast: Skyscribing cast for X" {
  battlefield A: 4 "Island"
  hand A: "Skyscribing"
  library A: "Forest", "Plains", "Swamp"
  library B: "Forest", "Plains", "Swamp"
  turn 1 A: cast "Skyscribing" x 2
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert hand B count 2
}

scenario "forecast: Steeling Stance pumps one creature, then the team" {
  battlefield A: 4 "Plains", "Grizzly Bears", "Hill Giant"
  hand A: "Steeling Stance"
  start turn 3 A
  turn 3 upkeep A: activate "Steeling Stance" targeting "Grizzly Bears"
  turn 3 A: cast "Steeling Stance"
  run_to turn 3 postcombat_main
  assert power "Grizzly Bears" 4
  assert power "Hill Giant" 4
}

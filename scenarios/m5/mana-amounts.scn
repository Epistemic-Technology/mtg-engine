// "Choose a color. Add an amount of mana of that color equal to ...",
// "add {R} or {G} for each Raccoon you control", "Add X {G} or X {W},
// where X is ..." (CR 106.1b, 106.4).

scenario "Three Tree City adds a mana of the chosen color per creature of the chosen type" {
  battlefield A: 2 "Forest", 2 "Grizzly Bears"
  hand A: "Three Tree City", "Grizzly Bears"
  turn 1 A: play "Three Tree City"
  turn 1 A: choose Bear
  turn 1 A: activate "Three Tree City"
  turn 1 A: choose green
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 end
  assert battlefield A contains 3 "Grizzly Bears"
}

scenario "Three Tree City adds nothing for another creature type" {
  battlefield A: 2 "Forest", 2 "Grizzly Bears"
  hand A: "Three Tree City", "Grizzly Bears"
  turn 1 A: play "Three Tree City"
  turn 1 A: choose Elf
  turn 1 A: activate "Three Tree City"
  illegal turn 1 A: cast "Grizzly Bears"
  run_to turn 1 end
  assert battlefield A contains 2 "Grizzly Bears"
}

scenario "Muerra adds a red or green mana for each Raccoon at the first main phase" {
  battlefield A: "Muerra, Trash Tactician"
  hand A: "Shock"
  start turn 2 A upkeep
  turn 2 precombat_main A: choose red
  turn 2 precombat_main A: wait
  turn 2 precombat_main A: cast "Shock" targeting player B
  run_to turn 2 end
  assert life B 18
}

scenario "Brigid, Doun's Mind adds X mana of one color" {
  battlefield A: "Brigid, Doun's Mind", 2 "Grizzly Bears"
  hand A: "Centaur Courser", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: decline "Brigid, Doun's Mind"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  illegal turn 1 A: cast "Centaur Courser"
  run_to turn 1 end
  assert battlefield A contains 3 "Grizzly Bears"
}

scenario "Brigid, Doun's Mind's mana is all one color" {
  battlefield A: "Brigid, Doun's Mind", 2 "Grizzly Bears"
  hand A: "Watchwolf"
  start turn 1 A precombat_main
  turn 1 A: decline "Brigid, Doun's Mind"
  turn 1 A: wait
  illegal turn 1 A: cast "Watchwolf"
  run_to turn 1 end
  assert battlefield A lacks "Watchwolf"
}

# Riders on the mana spent to cast a spell (CR 601.2h): "if {B} was spent
# to cast this spell", adamant, converge, "mana from a Treasure", "if at
# least four mana was spent to cast it" on a cast trigger, and mana
# restricted to an artifact source's abilities or to foretelling (CR 106.6).

scenario "Tin Street Hooligan: {G} spent, so it destroys an artifact" {
  battlefield A: "Mountain", "Forest"
  battlefield B: "Ornithopter"
  hand A: "Tin Street Hooligan"
  turn 1 A: cast "Tin Street Hooligan"
  turn 1 A: trigger "Tin Street Hooligan" targeting "Ornithopter"
  run_to turn 1 end
  assert graveyard B contains "Ornithopter"
}

scenario "Tin Street Hooligan: no {G} spent, no trigger" {
  battlefield A: 2 "Mountain"
  battlefield B: "Ornithopter"
  hand A: "Tin Street Hooligan"
  turn 1 A: cast "Tin Street Hooligan"
  run_to turn 1 end
  assert battlefield A contains "Tin Street Hooligan"
  assert battlefield B contains "Ornithopter"
}

scenario "Steamcore Weird: the payment spends the Mountain on generic mana for the rider" {
  battlefield A: 4 "Island", "Mountain"
  hand A: "Steamcore Weird"
  turn 1 A: cast "Steamcore Weird"
  turn 1 A: trigger "Steamcore Weird" targeting player B
  run_to turn 1 end
  assert life B 18
  assert tapped "Mountain"
}

scenario "Searing Barrage: adamant with three red mana" {
  battlefield A: 3 "Mountain", 2 "Island"
  battlefield B: "Serra Angel"
  hand A: "Searing Barrage"
  turn 1 A: cast "Searing Barrage" targeting "Serra Angel"
  run_to turn 1 end
  assert graveyard B contains "Serra Angel"
  assert life B 17
}

scenario "Searing Barrage: two red mana is not adamant" {
  battlefield A: 2 "Mountain", 3 "Island"
  battlefield B: "Serra Angel"
  hand A: "Searing Barrage"
  turn 1 A: cast "Searing Barrage" targeting "Serra Angel"
  run_to turn 1 end
  assert graveyard B contains "Serra Angel"
  assert life B 20
}

scenario "Dryad's Caress: {W} spent untaps creatures you control" {
  battlefield A: 4 "Forest", "Plains", "Forest", "Grizzly Bears" tapped
  hand A: "Dryad's Caress"
  turn 1 A: cast "Dryad's Caress"
  run_to turn 1 end
  assert life A 21
  assert untapped "Grizzly Bears"
}

scenario "Hired Hexblade: a Treasure is spent, so you draw and lose 1 life" {
  battlefield A: "Swamp", "Swamp", "Treasure"
  hand A: "Hired Hexblade"
  turn 1 A: cast "Hired Hexblade"
  run_to turn 1 end
  assert battlefield A lacks "Treasure"
  assert hand A count 1
  assert life A 19
}

scenario "Hired Hexblade: no Treasure, no trigger" {
  battlefield A: 2 "Swamp"
  hand A: "Hired Hexblade"
  turn 1 A: cast "Hired Hexblade"
  run_to turn 1 end
  assert hand A count 0
  assert life A 20
}

scenario "Marut: a Treasure for each mana from a Treasure spent" {
  battlefield A: 5 "Plains", 3 "Treasure"
  hand A: "Marut"
  turn 1 A: cast "Marut"
  run_to turn 1 end
  assert battlefield A contains "Marut"
  assert battlefield A contains 3 "Treasure"
}

scenario "Roilmage's Trick: converge counts the colors spent" {
  battlefield A: "Island", "Plains", "Swamp", "Mountain"
  battlefield B: "Serra Angel"
  hand A: "Roilmage's Trick"
  turn 1 A: cast "Roilmage's Trick"
  run_to turn 1 end
  assert power "Serra Angel" 0
  assert hand A count 1
}

scenario "Roilmage's Trick: one color spent" {
  battlefield A: 4 "Island"
  battlefield B: "Serra Angel"
  hand A: "Roilmage's Trick"
  turn 1 A: cast "Roilmage's Trick"
  run_to turn 1 end
  assert power "Serra Angel" 3
}

scenario "Induce Paranoia: {B} spent mills the countered spell's mana value" {
  battlefield A: 3 "Island", "Swamp"
  battlefield B: 4 "Mountain"
  hand A: "Induce Paranoia"
  hand B: "Hill Giant"
  library B: 6 "Island"
  start turn 2 B precombat_main
  turn 2 B: cast "Hill Giant"
  turn 2 A: cast "Induce Paranoia" targeting "Hill Giant"
  run_to turn 2 end
  assert graveyard B contains "Hill Giant"
  assert graveyard B contains 4 "Island"
}

scenario "Induce Paranoia: no {B} spent, no mill" {
  battlefield A: 4 "Island"
  battlefield B: 4 "Mountain"
  hand A: "Induce Paranoia"
  hand B: "Hill Giant"
  library B: 6 "Island"
  start turn 2 B precombat_main
  turn 2 B: cast "Hill Giant"
  turn 2 A: cast "Induce Paranoia" targeting "Hill Giant"
  run_to turn 2 end
  assert graveyard B contains "Hill Giant"
  assert graveyard B lacks "Island"
}

scenario "Sahagin: four mana spent on a noncreature spell, X included" {
  battlefield A: "Sahagin", 4 "Mountain"
  hand A: "Blaze"
  turn 1 A: cast "Blaze" x 3 targeting player B
  run_to turn 1 end
  assert life B 17
  assert counters "Sahagin" +1/+1 1
}

scenario "Sahagin: three mana is not enough" {
  battlefield A: "Sahagin", 3 "Mountain"
  hand A: "Blaze"
  turn 1 A: cast "Blaze" x 2 targeting player B
  run_to turn 1 end
  assert life B 18
  assert counters "Sahagin" +1/+1 0
}

scenario "Tackle Artist: opus puts two counters for five mana, one otherwise" {
  battlefield A: "Tackle Artist", 6 "Mountain"
  hand A: "Blaze", "Shock"
  turn 1 A: cast "Blaze" x 4 targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 end
  assert life B 14
  assert counters "Tackle Artist" +1/+1 3
}

scenario "Expressive Firedancer: five mana also gives double strike" {
  battlefield A: "Expressive Firedancer", 5 "Mountain"
  hand A: "Blaze"
  turn 1 A: cast "Blaze" x 4 targeting player B
  run_to turn 1 postcombat_main
  assert power "Expressive Firedancer" 3
  assert has "Expressive Firedancer" double_strike
}

scenario "Expressive Firedancer: a cheap spell gives only +1/+1" {
  battlefield A: "Expressive Firedancer", "Mountain"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert power "Expressive Firedancer" 3
  assert has not "Expressive Firedancer" double_strike
}

scenario "a creature put onto the battlefield had no mana spent on it" {
  battlefield A: 4 "Plains"
  battlefield B: "Ornithopter"
  graveyard A: "Tin Street Hooligan"
  hand A: "Resurrection"
  turn 1 A: cast "Resurrection" targeting "Tin Street Hooligan"
  run_to turn 1 end
  assert battlefield A contains "Tin Street Hooligan"
  assert battlefield B contains "Ornithopter"
}

scenario "Oaken Siren's mana pays for an artifact's ability" {
  battlefield A: "Oaken Siren", 2 "Island", "Rod of Ruin"
  turn 1 A: activate "Rod of Ruin" targeting player B
  run_to turn 1 end
  assert life B 19
  assert tapped "Oaken Siren"
}

scenario "Oaken Siren's mana can't pay for a nonartifact's ability" {
  battlefield A: "Oaken Siren", "Blighted Bat"
  illegal turn 1 A: activate "Blighted Bat"
  run_to turn 1 end
  assert untapped "Oaken Siren"
}

scenario "Karfell Harbinger's mana pays to foretell" {
  battlefield A: "Karfell Harbinger", "Plains"
  hand A: "Iron Verdict"
  turn 1 A: foretell "Iron Verdict"
  run_to turn 1 end
  assert exile A contains "Iron Verdict"
  assert tapped "Karfell Harbinger"
}

scenario "Karfell Harbinger's mana can't pay for a creature spell" {
  battlefield A: "Karfell Harbinger", "Forest"
  hand A: "Grizzly Bears"
  illegal turn 1 A: cast "Grizzly Bears"
  run_to turn 1 end
  assert hand A contains "Grizzly Bears"
}

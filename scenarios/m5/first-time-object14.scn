# Per-object "if it's the first time ... this turn" (fourteenth wave).

scenario "Captain America, Living Legend: a creature's first tap during your turn is undone" {
  battlefield A: "Captain America, Living Legend", "Grizzly Bears", 4 "Mountain"
  hand A: "Relentless Assault"
  turn 1 A: attack "Grizzly Bears"
  turn 1 postcombat_main A: cast "Relentless Assault"
  turn 1 declare_attackers combat 2 A: attack "Grizzly Bears"
  run_to turn 1 declare_blockers
  assert untapped "Grizzly Bears"
  run_to turn 1 end
  # The second attack is its second tap this turn: it stays tapped.
  assert tapped "Grizzly Bears"
  assert life B 16
}

scenario "Captain America, Living Legend: a new turn starts the count again" {
  battlefield A: "Captain America, Living Legend", "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  turn 3 A: attack "Grizzly Bears"
  run_to turn 3 declare_blockers
  assert untapped "Grizzly Bears"
  assert life B 18
}

scenario "Stalwart Successor: the first counters on a creature each turn bring one more" {
  battlefield A: "Stalwart Successor", "Grizzly Bears", 6 "Island"
  hand A: "Stealth Mission", "Stealth Mission"
  turn 1 A: cast "Stealth Mission" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Stealth Mission" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  # 2 + 1 from the first (its own counter is a second event: no more),
  # then 2 from the second.
  assert counters "Grizzly Bears" +1/+1 5
  assert counters "Stalwart Successor" +1/+1 0
}

scenario "Stalwart Successor: another creature's counters this turn don't count" {
  battlefield A: "Stalwart Successor", "Grizzly Bears", "Llanowar Elves", 6 "Island"
  hand A: "Stealth Mission", "Stealth Mission"
  turn 1 A: cast "Stealth Mission" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Stealth Mission" targeting "Llanowar Elves"
  run_to turn 1 begin_combat
  assert counters "Grizzly Bears" +1/+1 3
  assert counters "Llanowar Elves" +1/+1 3
}

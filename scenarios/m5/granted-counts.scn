# A count in an ability one card grants to another permanent is the
# granting card's ("equal to the number of ..."), read as the ability
# resolves on the permanent that has it.

scenario "Biorganic Carapace: draw a card for each modified creature you control" {
  battlefield A: "Grizzly Bears", "Biorganic Carapace" on "Grizzly Bears", "Hill Giant" with 1 +1/+1, "Llanowar Elves"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 16
  # The equipped Bears and the Giant with a counter are modified; the Elves aren't.
  assert hand A count 2
}

scenario "Avatar of Burgeoning Echoes: the granted -10 counts your lands" {
  battlefield A: "Avatar of Burgeoning Echoes", "Jace Beleren" with 10 loyalty, 3 "Forest", "Grizzly Bears"
  turn 1 A: activate "Jace Beleren" ability 4 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
}

scenario "Friendly Neighborhood: +1/+1 for each creature you control" {
  battlefield A: "Forest", "Friendly Neighborhood" on "Forest", "Mountain", "Grizzly Bears", "Hill Giant"
  turn 1 A: activate "Forest" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
}

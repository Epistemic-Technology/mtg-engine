# One-off trigger events (fourteenth wave): life gained as an amount,
# graveyard triggers, a Curse's player dealt damage, draws, searches,
# land plays.

scenario "Ageless Entity: gaining 3 life puts three +1/+1 counters on it" {
  battlefield A: "Ageless Entity", "Plains"
  hand A: "Healing Salve"
  turn 1 A: cast "Healing Salve" mode 1 targeting player A
  run_to turn 1 postcombat_main
  assert life A 23
  assert counters "Ageless Entity" +1/+1 3
  assert power "Ageless Entity" 7
}

scenario "Ageless Entity: an opponent gaining life doesn't count" {
  battlefield A: "Ageless Entity", "Plains"
  hand A: "Healing Salve"
  turn 1 A: cast "Healing Salve" mode 1 targeting player B
  run_to turn 1 postcombat_main
  assert life B 23
  assert counters "Ageless Entity" +1/+1 0
}

scenario "Sunbond: the enchanted creature gets that many counters as you gain life" {
  battlefield A: "Grizzly Bears", "Plains", "Plains", "Plains", "Plains", "Plains"
  hand A: "Sunbond", "Healing Salve"
  turn 1 A: cast "Sunbond" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Healing Salve" mode 1 targeting player A
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
  assert power "Grizzly Bears" 5
}

scenario "Light of Promise: the enchanted creature grows with each life gain" {
  battlefield A: "Grizzly Bears", "Plains", "Plains", "Plains", "Plains"
  hand A: "Light of Promise", "Healing Salve"
  turn 1 A: cast "Light of Promise" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Healing Salve" mode 1 targeting player A
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
}

scenario "Furious Forebear: paying {1}{W} as a creature you control dies returns it to hand" {
  battlefield A: "Grizzly Bears", "Plains", "Plains"
  battlefield B: "Mountain"
  graveyard A: "Furious Forebear"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Grizzly Bears"
  turn 2 A: accept "Furious Forebear"
  run_to turn 2 postcombat_main
  assert hand A contains "Furious Forebear"
  assert graveyard A lacks "Furious Forebear"
  assert tapped oldest "Plains"
  assert tapped newest "Plains"
}

scenario "Furious Forebear: declining leaves it in the graveyard" {
  battlefield A: "Grizzly Bears", "Plains", "Plains"
  battlefield B: "Mountain"
  graveyard A: "Furious Forebear"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Grizzly Bears"
  turn 2 A: decline "Furious Forebear"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Furious Forebear"
}

scenario "Furious Forebear: dying itself, it sees no death (CR 400.7)" {
  battlefield A: "Furious Forebear", "Plains", "Plains"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Furious Forebear"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Furious Forebear"
  assert untapped oldest "Plains"
  assert untapped newest "Plains"
}

scenario "Furious Forebear: an opponent's creature dying doesn't trigger it" {
  battlefield A: "Plains", "Plains", "Mountain"
  battlefield B: "Grizzly Bears"
  graveyard A: "Furious Forebear"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Furious Forebear"
  assert untapped oldest "Plains"
  assert untapped newest "Plains"
}

scenario "Grievous Wound: damage to the enchanted player makes them lose half their life, rounded up" {
  battlefield A: 5 "Swamp", "Mountain"
  hand A: "Grievous Wound", "Shock"
  turn 1 A: cast "Grievous Wound" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 9
  assert life A 20
}

scenario "Grievous Wound: the enchanted player can't gain life, and damage to you doesn't trigger it" {
  battlefield A: 5 "Swamp"
  battlefield B: "Plains", "Mountain"
  hand A: "Grievous Wound"
  hand B: "Healing Salve", "Shock"
  turn 1 A: cast "Grievous Wound" targeting player B
  turn 1 end B: cast "Healing Salve" mode 1 targeting player B
  turn 1 end B: wait
  turn 1 end B: cast "Shock" targeting player A
  run_to turn 2 upkeep
  assert life B 20
  assert life A 18
}

scenario "Lady Octopus: the first and second cards drawn each turn add ingenuity counters, the third doesn't" {
  battlefield A: "Lady Octopus, Inspired Inventor", 3 "Island"
  hand A: "Divination"
  library A: 6 "Island"
  start turn 2 A upkeep
  turn 2 A: cast "Divination"
  run_to turn 2 postcombat_main
  assert counters "Lady Octopus, Inspired Inventor" ingenuity 2
  assert hand A count 3
}

scenario "Lady Octopus: casts an artifact with mana value up to its ingenuity counters for free" {
  battlefield A: "Lady Octopus, Inspired Inventor" with 1 ingenuity
  hand A: "Bonesplitter"
  turn 1 A: activate "Lady Octopus, Inspired Inventor"
  turn 1 A: choose "Bonesplitter"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Bonesplitter"
}

scenario "Lady Octopus: an artifact with greater mana value can't be cast" {
  battlefield A: "Lady Octopus, Inspired Inventor"
  hand A: "Bonesplitter"
  turn 1 A: activate "Lady Octopus, Inspired Inventor"
  run_to turn 1 postcombat_main
  assert hand A contains "Bonesplitter"
}

scenario "Wan Shi Tong: an opponent's library search puts a counter on him and draws a card" {
  battlefield A: "Wan Shi Tong, Librarian"
  battlefield B: "Evolving Wilds"
  library A: 5 "Island"
  library B: "Forest", 5 "Island"
  start turn 2 B precombat_main
  turn 2 B: activate "Evolving Wilds"
  run_to turn 2 postcombat_main
  assert counters "Wan Shi Tong, Librarian" +1/+1 1
  assert hand A count 1
  assert battlefield B contains "Forest"
}

scenario "Wan Shi Tong: your own search doesn't trigger it" {
  battlefield A: "Wan Shi Tong, Librarian", "Evolving Wilds"
  library A: "Forest", 5 "Island"
  turn 1 A: activate "Evolving Wilds"
  run_to turn 1 postcombat_main
  assert counters "Wan Shi Tong, Librarian" +1/+1 0
  assert hand A count 0
}

scenario "Wan Shi Tong: X counters as it enters, then half X cards rounded down" {
  battlefield A: 5 "Island"
  hand A: "Wan Shi Tong, Librarian"
  library A: 5 "Island"
  turn 1 A: cast "Wan Shi Tong, Librarian" x 3
  run_to turn 1 postcombat_main
  assert counters "Wan Shi Tong, Librarian" +1/+1 3
  assert hand A count 1
}

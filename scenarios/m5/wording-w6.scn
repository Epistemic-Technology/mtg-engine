scenario "Valley Questcaller: other Rabbits, Bats, Birds, and Mice get +1/+1; one entering scries" {
  battlefield A: "Valley Questcaller", "Bartizan Bats", "Grizzly Bears", 3 "Plains"
  hand A: "Apex Hawks"
  library A: "Island", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Apex Hawks"
  run_to turn 1 postcombat_main
  assert power "Bartizan Bats" 4
  assert power "Apex Hawks" 3
  assert power "Grizzly Bears" 2
  assert power "Valley Questcaller" 2
}

scenario "Triceraton Commander: X Dinosaur Soldiers that get +1/+1 and flying when it attacks" {
  battlefield A: 6 "Plains"
  hand A: "Triceraton Commander"
  start turn 1 A precombat_main
  turn 1 A: cast "Triceraton Commander" x 2
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Dinosaur Soldier"
  turn 3 A: attack "Triceraton Commander"
  run_to turn 3 declare_blockers
  assert power oldest "Dinosaur Soldier" 3
  assert has newest "Dinosaur Soldier" flying
  assert power "Triceraton Commander" 2
}

scenario "Ureni: X damage, X the number of lands you control" {
  battlefield A: 3 "Forest", 2 "Island", 3 "Mountain"
  battlefield B: "Ureni, the Song Unending"
  hand A: "Ureni, the Song Unending"
  start turn 1 A precombat_main
  turn 1 A: cast "Ureni, the Song Unending"
  turn 1 A: trigger "Ureni, the Song Unending" targeting B "Ureni, the Song Unending"
  run_to turn 1 postcombat_main
  assert damage B "Ureni, the Song Unending" 8
}

scenario "Restless Cottage: a 4/4 black and green Horror; attacking makes a Food and exiles a card" {
  battlefield A: "Restless Cottage", 2 "Swamp", 2 "Forest"
  graveyard B: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: activate "Restless Cottage"
  turn 2 A: attack "Restless Cottage"
  turn 2 declare_attackers A: trigger "Restless Cottage" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 16
  assert battlefield A contains "Food"
  assert exile B contains "Grizzly Bears"
  assert is "Restless Cottage" black
  assert is "Restless Cottage" green
  assert is "Restless Cottage" Horror
}

scenario "Illusion Spinners: flash with a Faerie; hexproof while untapped" {
  battlefield A: 5 "Island", "Zephyr Sprite"

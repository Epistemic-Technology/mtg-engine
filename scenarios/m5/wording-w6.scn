scenario "Wrench: +1/+1, vigilance, and a tapping ability; sacrifice it to draw" {
  battlefield A: "Grizzly Bears", "Wrench" on "Grizzly Bears", 5 "Plains"
  battlefield B: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: activate "Grizzly Bears" targeting "Hill Giant"

# Cards whose Oracle wording the renderer now prints exactly (sixth wave):
# each scenario checks that the wording means what the card does.

scenario "Crossway Troublemakers: a Vampire dying, pay 2 life to draw" {
  battlefield A: "Crossway Troublemakers", "Arrogant Vampire"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 B: cast "Lightning Bolt" targeting "Arrogant Vampire"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Arrogant Vampire"
  assert life A 18
  assert hand A count 1
}

scenario "Crossway Troublemakers: a non-Vampire dying draws nothing; attackers have lifelink" {
  battlefield A: "Crossway Troublemakers", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 A precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 2 A: attack "Crossway Troublemakers"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 0
  assert life A 25
  assert life B 15
}

scenario "Rakish Crew: a Mercenary, and an outlaw dying drains 1" {
  battlefield A: 3 "Swamp", "Agent of Kotis"
  battlefield B: "Mountain"
  hand A: "Rakish Crew"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Rakish Crew"
  turn 1 postcombat_main B: cast "Lightning Bolt" targeting "Agent of Kotis"
  run_to turn 1 end
  assert battlefield A contains "Mercenary"
  assert life B 19
  assert life A 21
}

scenario "Rakish Crew: a non-outlaw dying drains nothing" {
  battlefield A: "Rakish Crew", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "Caparocti Sunborn: tapping two artifacts and/or creatures discovers 3" {
  battlefield A: "Caparocti Sunborn", "Ornithopter", "Hill Giant"
  library A: "Island", "Grizzly Bears", "Island"
  start turn 2 A precombat_main
  turn 2 A: attack "Caparocti Sunborn"
  run_to turn 2 postcombat_main
  assert tapped "Ornithopter"
  assert tapped "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
}

scenario "Caparocti Sunborn: declining to tap discovers nothing" {
  battlefield A: "Caparocti Sunborn", "Ornithopter", "Hill Giant"
  library A: "Island", "Grizzly Bears", "Island"
  start turn 2 A precombat_main
  turn 2 A: attack "Caparocti Sunborn"
  turn 2 declare_attackers A: decline "Caparocti Sunborn"
  run_to turn 2 postcombat_main
  assert untapped "Ornithopter"
  assert battlefield A lacks "Grizzly Bears"
}

scenario "Wingnut: another creature entering gives it a keyword; its attack pumps the other attackers" {
  battlefield A: "Wingnut, Bat on the Belfry", "Grizzly Bears", "Forest", "Forest"
  hand A: "Llanowar Elves"
  start turn 2 A precombat_main
  turn 2 A: cast "Llanowar Elves"
  turn 2 A: choose "1"
  turn 2 A: attack "Wingnut, Bat on the Belfry", "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert has "Wingnut, Bat on the Belfry" flying
  assert power "Grizzly Bears" 3
  assert power "Wingnut, Bat on the Belfry" 1
  assert life B 16
}

scenario "Stalactite Stalker: -X/-X where X is its power" {
  battlefield A: "Stalactite Stalker" with 2 +1/+1, 3 "Swamp"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Stalactite Stalker" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Stalactite Stalker"
}

scenario "Evil Reawakened: two additional +1/+1 counters" {
  battlefield A: 5 "Swamp"
  graveyard A: "Grizzly Bears"
  hand A: "Evil Reawakened"
  start turn 1 A precombat_main
  turn 1 A: cast "Evil Reawakened" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
}

scenario "Prison Break: an additional +1/+1 counter" {
  battlefield A: 5 "Swamp"
  graveyard A: "Hill Giant"
  hand A: "Prison Break"
  start turn 1 A precombat_main
  turn 1 A: cast "Prison Break" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 1
  assert power "Hill Giant" 4
}

scenario "Generous Revival: mana value 3 or less, an additional counter" {
  battlefield A: 3 "Plains"
  graveyard A: "Grizzly Bears", "Hill Giant"
  hand A: "Generous Revival"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Generous Revival" targeting "Hill Giant"
  turn 1 A: cast "Generous Revival" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Aetherize: all attacking creatures return to their owner's hand" {
  battlefield A: "Grizzly Bears", "Hill Giant", "Raging Goblin"
  battlefield B: 4 "Island"
  hand B: "Aetherize"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears", "Hill Giant"
  turn 2 declare_attackers B: cast "Aetherize"
  run_to turn 2 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand A contains "Hill Giant"
  assert battlefield A contains "Raging Goblin"
  assert life B 20
}

scenario "River's Rebuke: target player's nonland permanents return" {
  battlefield A: 6 "Island", "Grizzly Bears"
  battlefield B: "Hill Giant", "Ornithopter", "Mountain"
  hand A: "River's Rebuke"
  start turn 1 A precombat_main
  turn 1 A: cast "River's Rebuke" targeting player B
  run_to turn 1 postcombat_main
  assert hand B contains "Hill Giant"
  assert hand B contains "Ornithopter"
  assert battlefield B contains "Mountain"
  assert battlefield A contains "Grizzly Bears"
}

scenario "Nurturing Pixie: returning a non-Faerie, nonland permanent puts a counter on it" {
  battlefield A: "Plains", "Grizzly Bears"
  hand A: "Nurturing Pixie"
  start turn 1 A precombat_main
  turn 1 A: cast "Nurturing Pixie"
  turn 1 A: trigger "Nurturing Pixie" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert counters "Nurturing Pixie" +1/+1 1
}

scenario "Nurturing Pixie: a Faerie or a land can't be returned" {
  battlefield A: "Plains", "Zephyr Sprite", "Grizzly Bears"
  hand A: "Nurturing Pixie"
  start turn 1 A precombat_main
  turn 1 A: cast "Nurturing Pixie"
  illegal turn 1 A: trigger "Nurturing Pixie" targeting "Zephyr Sprite"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Zephyr Sprite"
  assert battlefield A contains "Plains"
}

scenario "Sphinx of False Conclusions: dying, a nontoken makes a token copy" {
  battlefield A: "Sphinx of False Conclusions"
  battlefield B: "Mountain", "Mountain"
  hand B: "Lightning Bolt", "Shock"
  start turn 1 A precombat_main
  turn 1 B: cast "Lightning Bolt" targeting "Sphinx of False Conclusions"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Sphinx of False Conclusions"
  assert battlefield A contains "Sphinx of False Conclusions"
  turn 1 postcombat_main B: cast "Shock" targeting "Sphinx of False Conclusions"
  run_to turn 1 end
  assert battlefield A lacks "Sphinx of False Conclusions"
}

scenario "Zoetic Glyph: the artifact is a 5/4 Golem creature; the Glyph leaving discovers 3" {
  battlefield A: "Ornithopter", "Zoetic Glyph" on "Ornithopter", "Mountain", "Mountain"
  library A: "Island", "Grizzly Bears", "Island"
  hand A: "Shatter"
  start turn 1 A precombat_main
  run_to turn 1 begin_combat
  assert power "Ornithopter" 5
  assert toughness "Ornithopter" 4
  assert is "Ornithopter" Golem
  turn 1 postcombat_main A: cast "Shatter" targeting "Ornithopter"
  run_to turn 1 end
  assert graveyard A contains "Zoetic Glyph"
  assert battlefield A contains "Grizzly Bears"
}

scenario "Stinging Vitriol: 2 damage, then they discard the nonland card you choose" {
  battlefield A: "Swamp", "Mountain"
  hand A: "Stinging Vitriol"
  hand B: "Forest", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Stinging Vitriol" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert graveyard B contains "Grizzly Bears"
  assert hand B contains "Forest"
}

scenario "Bucolic Ranch: a Mount card on top goes to hand" {
  battlefield A: "Bucolic Ranch", 3 "Plains"
  library A: "Alacrian Jaguar", "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Bucolic Ranch"
  run_to turn 1 postcombat_main
  assert hand A contains "Alacrian Jaguar"
}

scenario "Bucolic Ranch: a non-Mount card may go to the bottom" {
  battlefield A: "Bucolic Ranch", 3 "Plains"
  library A: "Island", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Bucolic Ranch"
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert library A count 2
}

scenario "Curse-Marred Demon: the searched card is the only card in hand and is discarded" {
  battlefield A: 4 "Mountain"
  hand A: "Curse-Marred Demon"
  library A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Curse-Marred Demon"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 0
}

scenario "Champion of the Clachan: behold and exile a Kithkin; it returns when the Champion leaves" {
  battlefield A: 4 "Plains", "Amrou Kithkin", "Amrou Kithkin"
  battlefield B: "Mountain", "Mountain"
  hand A: "Champion of the Clachan"
  hand B: "Lightning Bolt", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Champion of the Clachan"
  run_to turn 1 postcombat_main
  assert exile A contains "Amrou Kithkin"
  assert power "Amrou Kithkin" 2
  turn 1 postcombat_main B: cast "Lightning Bolt" targeting "Champion of the Clachan"
  turn 1 postcombat_main B: cast "Lightning Bolt" targeting "Champion of the Clachan"
  run_to turn 1 end
  assert graveyard A contains "Champion of the Clachan"
  assert hand A contains "Amrou Kithkin"
}

scenario "Blasphemous Edict: {B} with thirteen creatures on the battlefield" {
  battlefield A: "Swamp", 7 "Grizzly Bears"
  battlefield B: 6 "Hill Giant"
  hand A: "Blasphemous Edict"
  start turn 1 A precombat_main
  turn 1 A: cast "Blasphemous Edict" alternative
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Grizzly Bears"
  assert battlefield B lacks "Hill Giant"
}

scenario "Blasphemous Edict: twelve creatures, no {B} cost" {
  battlefield A: "Swamp", 6 "Grizzly Bears"
  battlefield B: 6 "Hill Giant"
  hand A: "Blasphemous Edict"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Blasphemous Edict" alternative
  run_to turn 1 postcombat_main
  assert battlefield A contains 6 "Grizzly Bears"
}

scenario "Proft: can't be cast with six cards in the graveyard" {
  battlefield A: 3 "Swamp"
  graveyard A: 6 "Island"
  hand A: "Proft, Sinister Mastermind"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Proft, Sinister Mastermind"
  run_to turn 1 postcombat_main
  assert hand A contains "Proft, Sinister Mastermind"
}

scenario "Proft: cast with seven cards in the graveyard" {
  battlefield A: 3 "Swamp"
  graveyard A: 7 "Island"
  hand A: "Proft, Sinister Mastermind"
  start turn 1 A precombat_main
  turn 1 A: cast "Proft, Sinister Mastermind"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Proft, Sinister Mastermind"
}

scenario "Tune Up: a returned Vehicle is an artifact creature" {
  battlefield A: 4 "Plains"
  graveyard A: "Adventurer's Airship"
  hand A: "Tune Up"
  start turn 1 A precombat_main
  turn 1 A: cast "Tune Up" targeting "Adventurer's Airship"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Adventurer's Airship"
  assert is "Adventurer's Airship" creature
  assert power "Adventurer's Airship" 3
}

scenario "Tune Up: a returned non-Vehicle stays a noncreature" {
  battlefield A: 4 "Plains"
  graveyard A: "Abzan Banner"
  hand A: "Tune Up"
  start turn 1 A precombat_main
  turn 1 A: cast "Tune Up" targeting "Abzan Banner"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Abzan Banner"
  assert is not "Abzan Banner" creature
}

scenario "Colossal Rattlewurm: flash with a Desert" {
  battlefield A: "Bucolic Ranch", 3 "Forest"
  hand A: "Colossal Rattlewurm"
  start turn 2 B precombat_main
  turn 2 end A: cast "Colossal Rattlewurm"
  run_to turn 3 upkeep
  assert battlefield A contains "Colossal Rattlewurm"
}

scenario "Colossal Rattlewurm: no Desert, no flash" {
  battlefield A: 4 "Forest"
  hand A: "Colossal Rattlewurm"
  start turn 2 B precombat_main
  illegal turn 2 end A: cast "Colossal Rattlewurm"
  run_to turn 3 upkeep
  assert hand A contains "Colossal Rattlewurm"
}

scenario "Hylda's Crown of Winter: free to activate during your turn" {
  battlefield A: "Hylda's Crown of Winter"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Hylda's Crown of Winter" ability 1 targeting "Hill Giant"
  run_to turn 1 end
  assert tapped "Hill Giant"
}

scenario "Hylda's Crown of Winter: {1} during an opponent's turn" {
  battlefield A: "Hylda's Crown of Winter"
  battlefield B: "Hill Giant"
  start turn 2 B precombat_main
  illegal turn 2 B: activate "Hylda's Crown of Winter" ability 1 targeting "Hill Giant"
  run_to turn 2 end
  assert untapped "Hill Giant"
}

scenario "Hylda's Crown of Winter: sacrifice to draw for each tapped creature your opponents control" {
  battlefield A: "Hylda's Crown of Winter", 3 "Island"
  battlefield B: "Hill Giant" tapped, "Grizzly Bears" tapped, "Ornithopter"
  start turn 1 A precombat_main
  turn 1 A: activate "Hylda's Crown of Winter" ability 2
  run_to turn 1 postcombat_main
  assert hand A count 2
}

scenario "Encumbered Reejerey: becoming tapped removes a -1/-1 counter" {
  battlefield A: 2 "Plains"
  hand A: "Encumbered Reejerey"
  start turn 1 A precombat_main
  turn 1 A: cast "Encumbered Reejerey"
  run_to turn 1 postcombat_main
  assert counters "Encumbered Reejerey" -1/-1 3
  turn 3 A: attack "Encumbered Reejerey"
  run_to turn 3 postcombat_main
  assert counters "Encumbered Reejerey" -1/-1 2
  assert life B 17
}

scenario "Demon Wall: with a counter it can attack" {
  battlefield A: "Demon Wall" with 1 +1/+1
  start turn 2 A precombat_main
  turn 2 A: attack "Demon Wall"
  run_to turn 2 postcombat_main
  assert life B 16
}

scenario "Demon Wall: without a counter it can't attack" {
  battlefield A: "Demon Wall"
  start turn 2 A precombat_main
  illegal turn 2 A: attack "Demon Wall"
  run_to turn 2 postcombat_main
  assert life B 20
}

scenario "Vadmir: four +1/+1 counters give menace and lifelink" {
  battlefield A: "Vadmir, New Blood" with 4 +1/+1
  start turn 1 A precombat_main
  run_to turn 1 begin_combat
  assert has "Vadmir, New Blood" menace
  assert has "Vadmir, New Blood" lifelink
}

scenario "Vadmir: a crime adds a counter; three counters, no keywords" {
  battlefield A: "Vadmir, New Blood" with 2 +1/+1, "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert counters "Vadmir, New Blood" +1/+1 3
  assert has not "Vadmir, New Blood" menace
}

scenario "Ragost: artifacts are Foods; sacrificing one deals 3 to each opponent" {
  battlefield A: "Ragost, Deft Gastronaut", "Ornithopter", "Mountain"
  start turn 1 A precombat_main
  run_to turn 1 begin_combat
  assert is "Ornithopter" Food
  turn 1 postcombat_main A: activate "Ragost, Deft Gastronaut" sacrificing "Ornithopter"
  run_to turn 1 end
  assert life B 17
  assert graveyard A contains "Ornithopter"
}

scenario "Ragost: an artifact's Food ability gains 3 life and untaps Ragost at the end step" {
  battlefield A: "Ragost, Deft Gastronaut", "Ornithopter", "Memnite", 3 "Mountain"
  start turn 2 A precombat_main
  turn 2 A: activate "Ragost, Deft Gastronaut" sacrificing "Ornithopter"
  turn 2 A: wait
  turn 2 A: activate "Memnite"
  run_to turn 2 cleanup
  assert life A 23
  assert untapped "Ragost, Deft Gastronaut"
}

scenario "Harried Dronesmith: a hasty Thopter, sacrificed at your next end step" {
  battlefield A: "Harried Dronesmith"
  start turn 2 A precombat_main
  turn 2 A: attack "Thopter"
  run_to turn 2 postcombat_main
  assert life B 19
  run_to turn 3
  assert battlefield A lacks "Thopter"
}

scenario "Brass's Bounty: a Treasure for each land you control" {
  battlefield A: 7 "Mountain"
  hand A: "Brass's Bounty"
  start turn 1 A precombat_main
  turn 1 A: cast "Brass's Bounty"
  run_to turn 1 postcombat_main
  assert battlefield A contains 7 "Treasure"
}

scenario "Vengeful Villagers: tap the creature; a sacrifice puts a stun counter on it" {
  battlefield A: "Vengeful Villagers", "Ornithopter"
  battlefield B: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: attack "Vengeful Villagers"
  turn 2 declare_attackers A: trigger "Vengeful Villagers" targeting "Hill Giant"
  turn 2 declare_attackers A: choose "Ornithopter"
  run_to turn 2 postcombat_main
  assert tapped "Hill Giant"
  assert graveyard A contains "Ornithopter"
  assert counters "Hill Giant" stun 1
}

scenario "Vengeful Villagers: no sacrifice, no stun counter" {
  battlefield A: "Vengeful Villagers", "Ornithopter"
  battlefield B: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: attack "Vengeful Villagers"
  turn 2 declare_attackers A: trigger "Vengeful Villagers" targeting "Hill Giant"
  turn 2 declare_attackers A: decline "Vengeful Villagers"
  run_to turn 2 postcombat_main
  assert tapped "Hill Giant"
  assert battlefield A contains "Ornithopter"
  assert counters "Hill Giant" stun 0
}

scenario "Turncoat Kunoichi: cast normally, the creature returns when it leaves" {
  battlefield A: 3 "Plains"
  battlefield B: "Hill Giant", "Mountain"
  hand A: "Turncoat Kunoichi"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Turncoat Kunoichi"
  turn 1 A: trigger "Turncoat Kunoichi" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  turn 1 postcombat_main B: cast "Lightning Bolt" targeting "Turncoat Kunoichi"
  run_to turn 1 end
  assert battlefield B contains "Hill Giant"
}


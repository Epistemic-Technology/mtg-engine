  turn 2 end A: cast "Illusion Spinners"
  illegal turn 3 upkeep B: cast "Lightning Bolt" targeting "Illusion Spinners"
  run_to turn 3 precombat_main
  assert battlefield A contains "Illusion Spinners"
}

scenario "Illusion Spinners: no Faerie, no flash" {

# Split second (CR 702.61a): as long as the spell is on the stack, players
# can't cast other spells or activate abilities that aren't mana
# abilities. Triggered abilities still trigger, and the spell can still
# be responded to by mana abilities only.

scenario "split second: no response to Sudden Shock" {
  battlefield A: 2 "Mountain"
  battlefield B: "Grizzly Bears", "Forest"
  hand A: "Sudden Shock"
  hand B: "Giant Growth"
  turn 1 A: cast "Sudden Shock" targeting "Grizzly Bears"
  illegal turn 1 precombat_main B: cast "Giant Growth" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "split second: a spell without it can be answered" {
  battlefield A: "Mountain"
  battlefield B: "Grizzly Bears", "Forest"
  hand A: "Shock"
  hand B: "Giant Growth"
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  turn 1 precombat_main B: cast "Giant Growth" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

scenario "split second: no activated abilities in response" {
  battlefield A: 2 "Mountain"
  battlefield B: "Prodigal Sorcerer"
  hand A: "Sudden Shock"
  turn 1 A: cast "Sudden Shock" targeting "Prodigal Sorcerer"
  illegal turn 1 precombat_main B: activate "Prodigal Sorcerer" targeting player A
  run_to turn 1 postcombat_main
  assert graveyard B contains "Prodigal Sorcerer"
  assert life A 20
}

scenario "split second: once it resolves, spells can be cast again" {
  battlefield A: 4 "Mountain"
  battlefield B: "Grizzly Bears", "Hill Giant"
  hand A: "Sudden Shock", "Shock"
  turn 1 A: cast "Sudden Shock" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life B 18
}

scenario "split second: the caster can't add spells on top either" {
  battlefield A: 4 "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Sudden Shock", "Shock"
  turn 1 A: cast "Sudden Shock" targeting "Grizzly Bears"
  illegal turn 1 A: cast "Shock" targeting player B in response to "Sudden Shock"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "split second: Sudden Death gives -4/-4" {
  battlefield A: 3 "Swamp"
  battlefield B: "Hill Giant", "Forest"
  hand B: "Giant Growth"
  hand A: "Sudden Death"
  turn 1 A: cast "Sudden Death" targeting "Hill Giant"
  illegal turn 1 precombat_main B: cast "Giant Growth" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

scenario "split second: Sudden Edict makes the player sacrifice" {
  battlefield A: 2 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Sudden Edict"
  turn 1 A: cast "Sudden Edict" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "split second: Krosan Grip destroys an artifact" {
  battlefield A: 3 "Forest"
  battlefield B: "Ornithopter"
  hand A: "Krosan Grip"
  turn 1 A: cast "Krosan Grip" targeting "Ornithopter"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Ornithopter"
}

scenario "split second: Siege Smash pumps and grants trample" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  hand A: "Siege Smash"
  turn 1 A: cast "Siege Smash" mode 2 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 5
  assert toughness "Grizzly Bears" 4
  assert has "Grizzly Bears" trample
}

scenario "split second: Siege Smash destroys an artifact" {
  battlefield A: 2 "Mountain"
  battlefield B: "Ornithopter"
  hand A: "Siege Smash"
  turn 1 A: cast "Siege Smash" mode 1 targeting "Ornithopter"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Ornithopter"
}

scenario "split second: Stonewood Invocation" {
  battlefield A: 4 "Forest", "Grizzly Bears"
  hand A: "Stonewood Invocation"
  turn 1 A: cast "Stonewood Invocation" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 7
  assert has "Grizzly Bears" shroud
}

scenario "split second: Wipe Away returns a permanent" {
  battlefield A: 3 "Island"
  battlefield B: "Hill Giant"
  hand A: "Wipe Away"
  turn 1 A: cast "Wipe Away" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand B contains "Hill Giant"
}

scenario "split second: Word of Seizing takes a creature for the turn with haste" {
  battlefield A: 5 "Mountain"
  battlefield B: "Hill Giant" tapped
  hand A: "Word of Seizing"
  turn 1 A: cast "Word of Seizing" targeting "Hill Giant"
  turn 1 A: attack "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 17
  run_to turn 2 upkeep
  assert battlefield B contains "Hill Giant"
}

scenario "split second: Sulfur Elemental with flash, white creatures get +1/-1" {
  battlefield A: 3 "Mountain"
  battlefield B: "Savannah Lions"
  hand A: "Sulfur Elemental"
  start turn 2 B
  turn 2 B: attack "Savannah Lions"
  turn 2 declare_attackers A: cast "Sulfur Elemental"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Savannah Lions"
}

scenario "split second: Celestial Crusader pumps other white creatures" {
  battlefield A: 4 "Plains", "Savannah Lions"
  hand A: "Celestial Crusader"
  turn 1 A: cast "Celestial Crusader"
  run_to turn 1 postcombat_main
  assert power "Savannah Lions" 3
  assert power "Celestial Crusader" 2
}

scenario "split second: Take Possession takes a land" {
  battlefield A: 7 "Island"
  battlefield B: "Forest"
  hand A: "Take Possession"
  turn 1 A: cast "Take Possession" targeting "Forest"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Forest"
}

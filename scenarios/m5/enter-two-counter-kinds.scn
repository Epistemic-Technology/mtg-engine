# A permanent entering with counters of two kinds (CR 614.1c, 122.1b):
# "If this creature was kicked, it enters with two +1/+1 counters and a
# trample counter on it and with haste." (Voidpouncer).

scenario "Voidpouncer kicked: both kinds of counter, and haste" {
  battlefield A: "Mountain", 4 "Wastes"
  hand A: "Voidpouncer"
  start turn 1 A precombat_main
  turn 1 A: cast "Voidpouncer" kicked
  turn 1 A: attack "Voidpouncer"
  run_to turn 1 postcombat_main
  assert counters "Voidpouncer" +1/+1 2
  assert counters "Voidpouncer" trample 1
  assert has "Voidpouncer" trample
  assert power "Voidpouncer" 5
  assert life B 15
}

scenario "Voidpouncer unkicked: no counters, no haste" {
  battlefield A: 2 "Mountain"
  hand A: "Voidpouncer"
  start turn 1 A precombat_main
  turn 1 A: cast "Voidpouncer"
  illegal turn 1 A: attack "Voidpouncer"
  run_to turn 1 postcombat_main
  assert counters "Voidpouncer" +1/+1 0
  assert has not "Voidpouncer" trample
  assert power "Voidpouncer" 3
}

# "If you control five or more untapped lands, this creature enters with two
# +1/+1 counters and a lifelink counter on it." (Dust Animus)

scenario "Dust Animus with five untapped lands left: both kinds" {
  battlefield A: 7 "Plains"
  hand A: "Dust Animus"
  start turn 1 A precombat_main
  turn 1 A: cast "Dust Animus"
  run_to turn 1 postcombat_main
  assert counters "Dust Animus" +1/+1 2
  assert counters "Dust Animus" lifelink 1
  assert has "Dust Animus" lifelink
  assert power "Dust Animus" 4
}

scenario "Dust Animus with four untapped lands left: neither" {
  battlefield A: 6 "Plains"
  hand A: "Dust Animus"
  start turn 1 A precombat_main
  turn 1 A: cast "Dust Animus"
  run_to turn 1 postcombat_main
  assert counters "Dust Animus" +1/+1 0
  assert counters "Dust Animus" lifelink 0
  assert power "Dust Animus" 2
}

# "Return that card to the battlefield under its owner's control at the
# beginning of the next end step. If it enters as a creature, it enters with
# an additional +1/+1 counter on it." (Teferi's Time Twist)

scenario "Teferi's Time Twist: a creature comes back with a +1/+1 counter" {
  battlefield A: 2 "Island", "Grizzly Bears"
  hand A: "Teferi's Time Twist"
  start turn 1 A precombat_main
  turn 1 A: cast "Teferi's Time Twist" targeting "Grizzly Bears"
  run_to turn 1 cleanup
  assert battlefield A contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
}

scenario "Teferi's Time Twist: a noncreature permanent comes back without one" {
  battlefield A: 2 "Island", "Darksteel Relic"
  hand A: "Teferi's Time Twist"
  start turn 1 A precombat_main
  turn 1 A: cast "Teferi's Time Twist" targeting "Darksteel Relic"
  run_to turn 1 cleanup
  assert battlefield A contains "Darksteel Relic"
  assert counters "Darksteel Relic" +1/+1 0
}

# "with a hexproof counter and an indestructible counter on it" (Perennation)

scenario "Perennation: two kinds of counter on the returned permanent" {
  battlefield A: 3 "Forest", "Plains", "Swamp", "Mountain"
  hand A: "Perennation"
  graveyard A: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Perennation" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" hexproof 1
  assert counters "Hill Giant" indestructible 1
  assert has "Hill Giant" hexproof
  assert has "Hill Giant" indestructible
}

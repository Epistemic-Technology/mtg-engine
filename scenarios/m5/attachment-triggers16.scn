# "Whenever this Equipment becomes attached to a creature" and "...
# becomes unattached from a permanent" (`TriggerSpec::ThisAttachment`, CR
# 701.3): moving it to another creature, destroying it while attached, and
# the creature leaving.

scenario "Grafted Wargear: moving it sacrifices the creature it left" {
  battlefield A: "Grizzly Bears", "Hill Giant", "Grafted Wargear" on "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: activate "Grafted Wargear" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert attached "Grafted Wargear" to "Hill Giant"
  assert power "Hill Giant" 6
  assert toughness "Hill Giant" 5
}

scenario "Grafted Wargear: destroyed while attached, the creature is sacrificed" {
  battlefield A: "Hill Giant", "Grafted Wargear" on "Hill Giant"
  battlefield B: "Forest", "Forest"
  hand B: "Naturalize"
  start turn 2 B precombat_main
  turn 2 B: cast "Naturalize" targeting "Grafted Wargear"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grafted Wargear"
  assert graveyard A contains "Hill Giant"
}

scenario "Grafted Wargear: unattached, destroying it sacrifices nothing" {
  battlefield A: "Grafted Wargear", "Hill Giant"
  battlefield B: "Forest", "Forest"
  hand B: "Naturalize"
  start turn 2 B precombat_main
  turn 2 B: cast "Naturalize" targeting "Grafted Wargear"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grafted Wargear"
  assert battlefield A contains "Hill Giant"
}

scenario "Grafted Wargear: first attaching sacrifices nothing" {
  battlefield A: "Grafted Wargear", "Hill Giant", "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: activate "Grafted Wargear" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
  assert power "Hill Giant" 6
}

scenario "Grafted Exoskeleton: the creature dying leaves the Equipment on the battlefield" {
  battlefield A: "Grizzly Bears", "Hill Giant", "Grafted Exoskeleton" on "Grizzly Bears"
  battlefield B: "Swamp", "Swamp", "Swamp"
  hand B: "Murder"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grafted Exoskeleton"
  assert battlefield A contains "Hill Giant"
}

scenario "Grafted Exoskeleton grants infect" {
  battlefield A: "Grizzly Bears", "Grafted Exoskeleton" on "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert poison B 4
  assert life B 20
}

scenario "Stitcher's Graft: moved, the old creature is sacrificed; it attacks without untapping" {
  battlefield A: "Grizzly Bears", "Hill Giant", 2 "Plains", "Stitcher's Graft" on "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  turn 2 postcombat_main A: activate "Stitcher's Graft" targeting "Hill Giant"
  run_to turn 3 upkeep
  assert graveyard A contains "Grizzly Bears"
  assert life B 15
}

scenario "Stitcher's Graft: the attacker doesn't untap" {
  battlefield A: "Grizzly Bears", "Stitcher's Graft" on "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  run_to turn 4 upkeep
  assert tapped "Grizzly Bears"
}

scenario "Enormous Energy Blade taps the creature it becomes attached to" {
  battlefield A: "Enormous Energy Blade", "Grizzly Bears", 2 "Swamp"
  start turn 2 A precombat_main
  turn 2 A: activate "Enormous Energy Blade" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert tapped "Grizzly Bears"
  assert power "Grizzly Bears" 6
  assert untapped "Enormous Energy Blade"
}

# Rooms (CR 709.5): a half cast enters with its door unlocked; a locked
# door is unlocked as a sorcery for its mana cost (`unlock`), and "When
# you unlock this door" triggers then.

scenario "Rooms: casting Ticket Booth manifests dread" {
  battlefield A: 3 "Mountain"
  hand A: "Ticket Booth // Tunnel of Hate"
  library A: "Grizzly Bears", "Hill Giant"
  turn 1 A: cast "Ticket Booth"
  turn 1 A: choose "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "face-down creature"
  assert graveyard A contains "Grizzly Bears"
}

scenario "Rooms: Tunnel of Hate's attack trigger needs its door unlocked" {
  battlefield A: "Tunnel of Hate", "Grizzly Bears"
  start turn 3 A
  turn 3 A: attack "Grizzly Bears"
  turn 3 A: trigger "Tunnel of Hate" targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert life B 16
}

scenario "Rooms: unlocking Weight Room manifests dread with three counters" {
  battlefield A: 6 "Forest", "Moldering Gym"
  library A: "Grizzly Bears", "Hill Giant"
  turn 1 A: unlock "Weight Room"
  turn 1 A: choose "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "face-down creature" +1/+1 3
  assert power "face-down creature" 5
  assert graveyard A contains "Grizzly Bears"
}

scenario "Rooms: Slimy Aquarium puts a counter on the manifested creature" {
  battlefield A: 4 "Island", "Underwater Tunnel"
  library A: "Grizzly Bears", "Hill Giant"
  turn 1 A: unlock "Slimy Aquarium"
  turn 1 A: choose "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "face-down creature" 3
}

scenario "Rooms: Restricted Office destroys creatures with power 3 or greater" {
  battlefield A: 2 "Plains", 2 "Plains"
  battlefield B: "Hill Giant", "Grizzly Bears"
  hand A: "Restricted Office // Lecture Hall"
  turn 1 A: cast "Restricted Office"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Rooms: Roaring Furnace deals damage equal to the cards in hand" {
  battlefield A: 2 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Roaring Furnace // Steaming Sauna", "Shock", "Murder", "Divination"
  turn 1 A: cast "Roaring Furnace"
  turn 1 A: trigger "Roaring Furnace" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

scenario "Rooms: Surgical Suite returns a creature card with mana value 3 or less" {
  battlefield A: 2 "Plains"
  graveyard A: "Grizzly Bears", "Hill Giant"
  hand A: "Surgical Suite // Hospital Room"
  turn 1 A: cast "Surgical Suite"
  turn 1 A: trigger "Surgical Suite" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

scenario "Rooms: not a creature card with greater mana value" {
  battlefield A: 2 "Plains"
  graveyard A: "Grizzly Bears", "Hill Giant"
  hand A: "Surgical Suite // Hospital Room"
  turn 1 A: cast "Surgical Suite"
  illegal turn 1 A: trigger "Surgical Suite" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Hill Giant"
}

scenario "Rooms: Unholy Annex without a Demon" {
  battlefield A: "Unholy Annex"
  library A: "Island", "Island"
  run_to turn 1 cleanup
  assert life A 18
  assert life B 20
  assert hand A count 1
}

scenario "Rooms: Ritual Chamber's Demon turns Unholy Annex into a drain" {
  battlefield A: 5 "Swamp", "Unholy Annex"
  library A: "Island", "Island"
  turn 1 A: unlock "Ritual Chamber"
  run_to turn 1 cleanup
  assert battlefield A contains "Demon"
  assert life A 22
  assert life B 18
}

scenario "Rooms: Grand Entryway creates a Glimmer; Elegant Rotunda counters" {
  battlefield A: 5 "Plains"
  battlefield A: "Grizzly Bears"
  hand A: "Grand Entryway // Elegant Rotunda"
  turn 1 A: cast "Grand Entryway"
  turn 1 A: wait
  turn 1 A: unlock "Elegant Rotunda"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Glimmer" +1/+1 1
}

scenario "Rooms: Greenhouse gives lands any color" {
  battlefield A: "Greenhouse", "Forest"
  battlefield B: "Grizzly Bears"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "Rooms: Rickety Gazebo returns permanent cards from among the milled" {
  battlefield A: 4 "Forest", "Greenhouse"
  library A: "Shock", "Grizzly Bears", "Hill Giant", "Murder", "Island"
  turn 1 A: unlock "Rickety Gazebo"
  turn 1 A: choose "Grizzly Bears"
  turn 1 A: choose "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand A contains "Hill Giant"
  assert graveyard A contains "Shock"
  assert graveyard A contains "Murder"
}

scenario "Rooms: Painter's Studio's cards may be played" {
  battlefield A: 4 "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Painter's Studio // Defaced Gallery"
  library A: "Shock", "Island", "Island"
  turn 1 A: cast "Painter's Studio"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "Rooms: Defaced Gallery pumps attackers" {
  battlefield A: "Defaced Gallery", "Grizzly Bears"
  start turn 3 A
  turn 3 A: attack "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert life B 17
}

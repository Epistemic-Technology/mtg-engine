scenario "chandra plus one pings any target" {
  battlefield A: "Chandra, the Firebrand"
  turn 1 precombat_main A: activate "Chandra, the Firebrand" ability 1 targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert counters "Chandra, the Firebrand" loyalty 4
}
scenario "chandra minus two copies the next instant this turn" {
  battlefield A: "Chandra, the Firebrand", "Mountain"
  hand A: "Lightning Bolt"
  turn 1 precombat_main A: activate "Chandra, the Firebrand" ability 2
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 14
  assert counters "Chandra, the Firebrand" loyalty 1
}
scenario "chandra minus six hits up to six targets for six" {
  battlefield A: "Chandra, the Firebrand" with 6 loyalty
  battlefield B: "Grizzly Bears", "Hill Giant"
  turn 1 precombat_main A: activate "Chandra, the Firebrand" ability 3 targeting "Grizzly Bears", "Hill Giant", player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
  assert life B 14
}

# Cards the template author wrote as it stood at the start of the
# eighteenth wave (`mtg-cards author --format modern`): manlands,
# Keyrunes and Monuments, morph costs that reveal a card, Rings that
# grow a creature of their color, and lines the corpus already printed.

scenario "Faerie Conclave: enters tapped, attacks as a 2/1 flyer, and is a land again next turn" {
  battlefield A: 2 "Island"
  hand A: "Faerie Conclave"
  start turn 1 A precombat_main
  turn 1 A: play "Faerie Conclave"
  run_to turn 1 postcombat_main
  assert tapped "Faerie Conclave"
}

scenario "Faerie Conclave: {1}{U} animates it" {
  battlefield A: "Faerie Conclave", 2 "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Faerie Conclave"
  turn 1 A: attack "Faerie Conclave"
  run_to turn 1 postcombat_main
  assert life B 18
  assert has "Faerie Conclave" flying
  assert is "Faerie Conclave" Faerie
  assert is "Faerie Conclave" land
  run_to turn 2 precombat_main
  assert is not "Faerie Conclave" creature
}

scenario "Treetop Village: {1}{G} makes it a 3/3 Ape with trample" {
  battlefield A: "Treetop Village", 2 "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Treetop Village"
  turn 1 A: attack "Treetop Village"
  run_to turn 1 postcombat_main
  assert life B 17
  assert has "Treetop Village" trample
  assert is "Treetop Village" Ape
  run_to turn 2 precombat_main
  assert is not "Treetop Village" creature
}

scenario "Cave of the Frost Dragon: enters tapped with two other lands" {
  battlefield A: 2 "Plains"
  hand A: "Cave of the Frost Dragon"
  start turn 1 A precombat_main
  turn 1 A: play "Cave of the Frost Dragon"
  run_to turn 1 postcombat_main
  assert tapped "Cave of the Frost Dragon"
}

scenario "Cave of the Frost Dragon: enters untapped with one other land, and becomes a 3/4 flyer" {
  battlefield A: "Plains"
  hand A: "Cave of the Frost Dragon"
  start turn 1 A precombat_main
  turn 1 A: play "Cave of the Frost Dragon"
  run_to turn 1 postcombat_main
  assert untapped "Cave of the Frost Dragon"
}

scenario "Cave of the Frost Dragon: {4}{W} animates it" {
  battlefield A: "Cave of the Frost Dragon", 5 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Cave of the Frost Dragon"
  turn 1 A: attack "Cave of the Frost Dragon"
  run_to turn 1 postcombat_main
  assert life B 17
  assert toughness "Cave of the Frost Dragon" 4
  assert has "Cave of the Frost Dragon" flying
  assert is "Cave of the Frost Dragon" Dragon
}

scenario "Dromoka Monument: a 4/4 green and white flying Dragon" {
  battlefield A: "Dromoka Monument", 3 "Forest", 3 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Dromoka Monument"
  turn 1 A: attack "Dromoka Monument"
  run_to turn 1 postcombat_main
  assert life B 16
  assert has "Dromoka Monument" flying
  assert is "Dromoka Monument" green
  assert is "Dromoka Monument" white
  assert is "Dromoka Monument" artifact
  run_to turn 2 precombat_main
  assert is not "Dromoka Monument" creature
}


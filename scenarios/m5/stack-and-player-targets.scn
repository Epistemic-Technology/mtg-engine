# "Counter target activated ability, triggered ability, or noncreature
# spell" (Louisoix's Sacrifice, CR 115.1, 118.7), and "each player who
# doesn't have max speed" (Outpace Oblivion, CR 702.179e).

scenario "Louisoix's Sacrifice counters a noncreature spell, paying {2}" {
  battlefield A: 3 "Island"
  battlefield B: "Mountain"
  hand A: "Louisoix's Sacrifice"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 A: cast "Louisoix's Sacrifice" other_cost targeting "Shock" in response to "Shock"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Shock"
}

scenario "Louisoix's Sacrifice counters an activated ability, sacrificing a legendary creature" {
  battlefield A: "Island", "Isamaru, Hound of Konda"
  battlefield B: "Prodigal Sorcerer"
  hand A: "Louisoix's Sacrifice"
  start turn 2 B precombat_main
  turn 2 B: activate "Prodigal Sorcerer" targeting player A
  turn 2 A: cast "Louisoix's Sacrifice" sacrificing "Isamaru, Hound of Konda" targeting "Prodigal Sorcerer" in response to trigger "Prodigal Sorcerer"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard A contains "Isamaru, Hound of Konda"
}

scenario "Louisoix's Sacrifice counters a triggered ability" {
  battlefield A: 3 "Island"
  battlefield B: "Blood Artist", "Grizzly Bears"
  hand A: "Louisoix's Sacrifice", "Shock"
  battlefield A: "Mountain"
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  turn 1 A: cast "Louisoix's Sacrifice" other_cost targeting "Blood Artist" in response to trigger "Blood Artist"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life A 20
  assert life B 20
}

scenario "Louisoix's Sacrifice can't counter a creature spell" {
  battlefield A: 3 "Island"
  battlefield B: 2 "Forest"
  hand A: "Louisoix's Sacrifice"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  illegal turn 2 A: cast "Louisoix's Sacrifice" other_cost targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

scenario "Louisoix's Sacrifice needs a legendary creature or {2}" {
  battlefield A: "Island", "Grizzly Bears"
  battlefield B: "Mountain"
  hand A: "Louisoix's Sacrifice"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  illegal turn 2 A: cast "Louisoix's Sacrifice" targeting "Shock" in response to "Shock"
  run_to turn 2 postcombat_main
  assert life A 18
}

scenario "Outpace Oblivion deals 2 damage to each player without max speed" {
  speed A: 4
  speed B: 2
  battlefield A: "Outpace Oblivion", 2 "Mountain"
  turn 1 A: activate "Outpace Oblivion"
  run_to turn 1 postcombat_main
  assert life A 20
  assert life B 18
  assert graveyard A contains "Outpace Oblivion"
}

scenario "Outpace Oblivion: a player with no speed is dealt damage too" {
  speed B: 4
  battlefield A: "Outpace Oblivion", 2 "Mountain"
  turn 1 A: activate "Outpace Oblivion"
  run_to turn 1 postcombat_main
  assert life A 18
  assert life B 20
}

scenario "Outpace Oblivion deals 5 damage to up to one target creature as it enters" {
  battlefield A: 3 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Outpace Oblivion"
  turn 1 A: cast "Outpace Oblivion"
  turn 1 A: trigger "Outpace Oblivion" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

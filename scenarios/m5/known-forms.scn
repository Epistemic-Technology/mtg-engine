# KNOWN-ISSUES section 2 forms, now bound correctly: "that player
# controls" after a target permanent in an enters trigger (`controller of
# target 1 controls`); a dies trigger's count of the counters the source
# had; "those creatures" after "target creature and each other creature
# that shares a color with it"; "if that creature is a token"; "whenever a
# face-down permanent you control is turned face up"; "instead create X of
# those tokens" after tapped tokens.

scenario "Deputy of Detention exiles the target and the others of that name its controller controls" {
  battlefield A: "Hill Giant", 2 "Island", "Plains"
  battlefield B: 2 "Hill Giant", "Grizzly Bears"
  hand A: "Deputy of Detention"
  turn 1 A: cast "Deputy of Detention"
  turn 1 A: trigger "Deputy of Detention" targeting oldest B "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains 2 "Hill Giant"
  assert battlefield A contains "Hill Giant"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Deputy of Detention leaves: both return" {
  battlefield A: 2 "Island", "Plains"
  battlefield B: 2 "Hill Giant", 3 "Swamp"
  hand A: "Deputy of Detention"
  hand B: "Murder"
  turn 1 A: cast "Deputy of Detention"
  turn 1 A: trigger "Deputy of Detention" targeting oldest B "Hill Giant"
  turn 1 postcombat_main B: cast "Murder" targeting "Deputy of Detention"
  run_to turn 1 end
  assert battlefield B contains 2 "Hill Giant"
  assert graveyard A contains "Deputy of Detention"
}

scenario "Grief Tyrant: as many -1/-1 counters as it had as it died" {
  battlefield A: "Grief Tyrant" with 2 -1/-1
  battlefield B: "Hill Giant", 3 "Swamp"
  hand B: "Murder"
  turn 1 B: cast "Murder" targeting "Grief Tyrant"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grief Tyrant"
  assert counters "Hill Giant" -1/-1 2
  assert toughness "Hill Giant" 1
}

scenario "Grief Tyrant enters with four -1/-1 counters" {
  battlefield A: 6 "Swamp"
  hand A: "Grief Tyrant"
  turn 1 A: cast "Grief Tyrant"
  run_to turn 1 postcombat_main
  assert counters "Grief Tyrant" -1/-1 4
  assert power "Grief Tyrant" 4
}

scenario "Rally the Righteous: the target and the creatures sharing its color untap and get +2/+0" {
  battlefield A: "Hill Giant" tapped, "Raging Goblin" tapped, "Grizzly Bears" tapped, "Mountain", "Plains", "Mountain"
  hand A: "Rally the Righteous"
  start turn 1 A precombat_main
  turn 1 A: cast "Rally the Righteous" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert untapped "Hill Giant"
  assert untapped "Raging Goblin"
  assert tapped "Grizzly Bears"
  assert power "Hill Giant" 5
  assert power "Raging Goblin" 3
  assert power "Grizzly Bears" 2
}

scenario "Hazardroot Herbalist: a token also gains deathtouch" {
  battlefield A: "Hazardroot Herbalist", "Soldier", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Soldier"
  turn 1 declare_attackers A: trigger "Hazardroot Herbalist" targeting "Soldier"
  run_to turn 1 declare_blockers
  assert power "Soldier" 2
  assert has "Soldier" deathtouch
}

scenario "Hazardroot Herbalist: a nontoken creature does not" {
  battlefield A: "Hazardroot Herbalist", "Soldier", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 declare_attackers A: trigger "Hazardroot Herbalist" targeting "Grizzly Bears"
  run_to turn 1 declare_blockers
  assert power "Grizzly Bears" 3
  assert has not "Grizzly Bears" deathtouch
}

scenario "Sumala Sentry: a face-down permanent turned face up, a counter on each" {
  battlefield A: "Sumala Sentry", 8 "Mountain"
  hand A: "Atarka Efreet"
  start turn 1 A precombat_main
  turn 1 A: cast "Atarka Efreet" face_down
  turn 1 postcombat_main A: unmorph "Atarka Efreet"
  turn 1 postcombat_main A: trigger "Atarka Efreet" targeting player B
  run_to turn 1 end
  assert counters "Sumala Sentry" +1/+1 1
  assert counters "Atarka Efreet" +1/+1 2
}

scenario "The Final Days: two tapped Horrors" {
  battlefield A: 4 "Swamp"
  hand A: "The Final Days"
  start turn 1 A precombat_main
  turn 1 A: cast "The Final Days"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Horror"
  assert tapped oldest "Horror"
  assert tapped newest "Horror"
}

scenario "The Final Days flashed back: X tapped Horrors" {
  battlefield A: 6 "Swamp"
  graveyard A: "The Final Days", "Grizzly Bears", "Hill Giant", "Llanowar Elves"
  start turn 1 A precombat_main
  turn 1 A: cast "The Final Days" from graveyard
  run_to turn 1 postcombat_main
  assert battlefield A contains 3 "Horror"
  assert tapped oldest "Horror"
  assert tapped newest "Horror"
  assert exile A contains "The Final Days"
}

# Copying spells (CR 707.10): a copy is put onto the stack with the
# original's choices (mode, X, targets) under the copier's control; it is
# not cast. "You may choose new targets for the copy" lets its controller
# change targets (CR 707.10c). A copy of a permanent spell becomes a token
# as it resolves (CR 608.3f). Magecraft sees copies too.

scenario "twincast: the copy keeps the original's target" {
  battlefield A: 4 "Island", "Mountain"
  hand A: "Shock", "Twincast"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: cast "Twincast" targeting "Shock" in response to "Shock"
  run_to turn 1 postcombat_main
  assert life B 16
  assert graveyard A contains "Twincast"
  assert graveyard A contains "Shock"
}

scenario "twincast: the copy may have a new target" {
  battlefield A: 4 "Island", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Shock", "Twincast"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: cast "Twincast" targeting "Shock" in response to "Shock"
  turn 1 A: choose "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 18
  assert damage "Hill Giant" 2
}

scenario "twincast: copies an opponent's spell, the copy is the copier's" {
  battlefield A: 2 "Island"
  battlefield B: "Mountain"
  hand A: "Twincast"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 A: cast "Twincast" targeting "Shock"
  run_to turn 2 postcombat_main
  assert life A 16
}

scenario "reverberate: nothing to copy, no cast" {
  battlefield A: 2 "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Reverberate", "Shock"
  illegal turn 1 A: cast "Reverberate" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
}

scenario "nivix guildmage: only a spell you control" {
  battlefield A: 2 "Island", 2 "Mountain", "Nivix Guildmage"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B
  turn 2 B: cast "Shock" targeting player A
  illegal turn 2 A: activate "Nivix Guildmage" ability 2 targeting "Shock"
  run_to turn 2 postcombat_main
}

scenario "nivix guildmage: copies your instant" {
  battlefield A: 2 "Island", 3 "Mountain", "Nivix Guildmage"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: activate "Nivix Guildmage" ability 2 targeting "Shock"
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "naru meha: copies a spell as it enters" {
  battlefield A: 4 "Island", "Mountain"
  hand A: "Shock", "Naru Meha, Master Wizard"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: cast "Naru Meha, Master Wizard" in response to "Shock"
  turn 1 A: trigger "Naru Meha, Master Wizard" targeting "Shock"
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "magecraft: a copy triggers it" {
  battlefield A: 2 "Island", "Mountain", "Quandrix Pledgemage"
  hand A: "Shock", "Twincast"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: cast "Twincast" targeting "Shock" in response to "Shock"
  run_to turn 1 postcombat_main
  assert counters "Quandrix Pledgemage" +1/+1 3
}

scenario "photon blast barrage: copied X times as it is cast" {
  battlefield A: 4 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Photon Blast Barrage"
  turn 1 A: cast "Photon Blast Barrage" x 2 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

scenario "photon blast barrage: X is 0, no copies" {
  battlefield A: 2 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Photon Blast Barrage"
  turn 1 A: cast "Photon Blast Barrage" x 0 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert damage "Hill Giant" 1
}

scenario "thousand-year storm: once for each instant or sorcery cast before it" {
  battlefield A: 3 "Mountain", "Thousand-Year Storm"
  hand A: 3 "Shock"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 8
}

scenario "thousand-year storm: creature spells don't count" {
  battlefield A: 3 "Mountain", 2 "Forest", "Thousand-Year Storm"
  hand A: "Grizzly Bears", "Shock"
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "show of confidence: copied for each other instant and sorcery" {
  battlefield A: 2 "Mountain", 2 "Plains", "Grizzly Bears"
  hand A: 2 "Shock", "Show of Confidence"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Show of Confidence" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
}

scenario "doublecast: the next instant or sorcery is copied" {
  battlefield A: 4 "Mountain"
  hand A: "Doublecast", 2 "Shock"
  turn 1 A: cast "Doublecast"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 14
}

scenario "doublecast: a creature spell doesn't use it up" {
  battlefield A: 4 "Mountain", 2 "Forest"
  hand A: "Doublecast", "Grizzly Bears", "Shock"
  turn 1 A: cast "Doublecast"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
  assert battlefield A contains 1 "Grizzly Bears"
}

scenario "doublecast: ends with the turn" {
  battlefield A: 3 "Mountain"
  hand A: "Doublecast", "Shock"
  turn 1 A: cast "Doublecast"
  turn 3 A: cast "Shock" targeting player B
  run_to turn 3 postcombat_main
  assert life B 18
}

scenario "dual strike: only a spell with mana value 4 or less" {
  battlefield A: 4 "Mountain"
  hand A: "Dual Strike", "Shock"
  turn 1 A: cast "Dual Strike"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "storm of saruman: the second spell's copy isn't legendary" {
  battlefield A: 3 "Island", "Mountain", "Storm of Saruman"
  hand A: "Shock", "Kitsa, Otterball Elite"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Kitsa, Otterball Elite"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Kitsa, Otterball Elite"
  assert life B 18
}

scenario "storm of saruman: the first spell isn't copied" {
  battlefield A: 2 "Island", "Storm of Saruman"
  hand A: "Kitsa, Otterball Elite"
  turn 1 A: cast "Kitsa, Otterball Elite"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Kitsa, Otterball Elite"
}

scenario "sage of the skies: copied as a token if another spell was cast" {
  battlefield A: 3 "Plains", "Mountain"
  hand A: "Shock", "Sage of the Skies"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Sage of the Skies"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Sage of the Skies"
}

scenario "sage of the skies: the first spell isn't copied" {
  battlefield A: 3 "Plains"
  hand A: "Sage of the Skies"
  turn 1 A: cast "Sage of the Skies"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Sage of the Skies"
}

scenario "swarm intelligence: may decline the copy" {
  battlefield A: "Mountain", "Swarm Intelligence"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: decline "Swarm Intelligence"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "swarm intelligence: copies an instant" {
  battlefield A: "Mountain", "Swarm Intelligence"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "double down: an outlaw spell's copy becomes a token" {
  battlefield A: "Island", "Double Down"
  hand A: "Slither Blade"
  turn 1 A: cast "Slither Blade"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Slither Blade"
}

scenario "double down: a non-outlaw spell isn't copied" {
  battlefield A: 2 "Forest", "Double Down"
  hand A: "Grizzly Bears"
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Grizzly Bears"
}

scenario "drafna: copies an artifact spell you control" {
  battlefield A: 6 "Island", "Drafna, Founder of Lat-Nam"
  hand A: "Skyshaper"
  turn 1 A: cast "Skyshaper"
  turn 1 A: activate "Drafna, Founder of Lat-Nam" ability 2 targeting "Skyshaper"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Skyshaper"
}

scenario "mirari: pay {3} to copy" {
  battlefield A: 4 "Mountain", "Mirari"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "lumaret's favor: no life gained, no copy" {
  battlefield A: 2 "Forest", "Grizzly Bears"
  hand A: "Lumaret's Favor"
  turn 1 A: cast "Lumaret's Favor" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
}

scenario "lumaret's favor: copied after life was gained" {
  battlefield A: 3 "Plains", 2 "Forest", "Grizzly Bears"
  hand A: "Lumaret's Favor", "Renewed Faith"
  turn 1 A: cast "Renewed Faith"
  turn 1 A: wait
  turn 1 A: cast "Lumaret's Favor" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 6
}

# A third sweep of one-off phrasings.

scenario "entered with: another Knight entering gives first strike" {
  battlefield A: "Swordsworn Cavalier", 2 "Plains"
  hand A: "Knight of Glory"
  start turn 3 A
  turn 3 A: cast "Knight of Glory"
  run_to turn 3 postcombat_main
  assert has "Swordsworn Cavalier" first_strike
}

scenario "entered with: the Knight still counts after it leaves" {
  battlefield A: "Swordsworn Cavalier", 2 "Plains", "Mountain"
  hand A: "Knight of Glory", "Shock"
  start turn 3 A
  turn 3 A: cast "Knight of Glory"
  turn 3 main2 A: cast "Shock" targeting "Knight of Glory"
  run_to turn 3 end
  assert graveyard A contains "Knight of Glory"
  assert has "Swordsworn Cavalier" first_strike
}

scenario "entered with: a non-Knight or the Cavalier itself doesn't count" {
  battlefield A: 4 "Plains"
  hand A: "Swordsworn Cavalier", "Memnite"
  start turn 3 A
  turn 3 A: cast "Swordsworn Cavalier"
  turn 3 A: cast "Memnite"
  run_to turn 3 postcombat_main
  assert has not "Swordsworn Cavalier" first_strike
}

scenario "entered with: first strike ends with the turn" {
  battlefield A: "Swordsworn Cavalier", 2 "Plains"
  hand A: "Knight of Glory"
  start turn 3 A
  turn 3 A: cast "Knight of Glory"
  run_to turn 4 upkeep
  assert has not "Swordsworn Cavalier" first_strike
}

scenario "had another creature enter: trample and indestructible" {
  battlefield A: "Bellowing Elk"
  hand A: "Memnite"
  start turn 3 A
  turn 3 A: cast "Memnite"
  run_to turn 3 postcombat_main
  assert has "Bellowing Elk" trample
  assert has "Bellowing Elk" indestructible
}

scenario "had another creature enter: the Elk's own entry doesn't count" {
  battlefield A: 4 "Forest"
  hand A: "Bellowing Elk"
  start turn 3 A
  turn 3 A: cast "Bellowing Elk"
  run_to turn 3 postcombat_main
  assert has not "Bellowing Elk" trample
}

scenario "entered with flying: the loot costs {1}{U} less" {
  battlefield A: "Flying Drone"
  hand A: "Ornithopter", "Memnite"
  library A: "Island", "Island"
  start turn 3 A
  turn 3 A: cast "Ornithopter"
  turn 3 A: activate "Flying Drone"
  run_to turn 3 end
  assert tapped "Flying Drone"
}

scenario "entered with flying: a creature without flying doesn't reduce" {
  battlefield A: "Flying Drone"
  hand A: "Memnite"
  start turn 3 A
  turn 3 A: cast "Memnite"
  illegal turn 3 A: activate "Flying Drone"
  run_to turn 3 end
}

scenario "had a counter: dying with a +1/+1 counter draws a card" {
  battlefield A: "Promising Duskmage" with 1 +1/+1, 3 "Swamp"
  hand A: "Murder"
  library A: "Swamp", "Swamp"
  start turn 3 A
  turn 3 A: cast "Murder" targeting "Promising Duskmage"
  run_to turn 3 end
  assert graveyard A contains "Promising Duskmage"
  assert hand A count 2
}

scenario "had a counter: dying without one draws nothing" {
  battlefield A: "Promising Duskmage", 3 "Swamp"
  hand A: "Murder"
  library A: "Swamp", "Swamp"
  start turn 3 A
  turn 3 A: cast "Murder" targeting "Promising Duskmage"
  run_to turn 3 end
  assert graveyard A contains "Promising Duskmage"
  assert hand A count 1
}

scenario "dig: Ancient Stirrings finds a colorless card, then the rest go to the bottom" {
  battlefield A: "Forest"
  hand A: "Ancient Stirrings"
  library A: "Grizzly Bears", "Shock", "Ornithopter", "Murder", "Doom Blade", "Swamp"
  turn 1 A: cast "Ancient Stirrings"
  run_to turn 1 postcombat_main
  assert hand A contains "Ornithopter"
  assert library A count 5
}

scenario "cost change: creature spells with flying cost {1} less" {
  battlefield A: "Warden of Evos Isle", "Island"
  hand A: "Storm Crow"
  start turn 3 A
  turn 3 A: cast "Storm Crow"
  run_to turn 3 end
  assert battlefield A contains "Storm Crow"
}

scenario "cost change: a creature spell without flying costs full" {
  battlefield A: "Warden of Evos Isle", "Forest"
  hand A: "Grizzly Bears"
  start turn 3 A
  illegal turn 3 A: cast "Grizzly Bears"
  run_to turn 3 end
}

scenario "spell number: the second spell each turn costs {1} less" {
  battlefield A: "Highspire Bell-Ringer", "Island"
  hand A: "Memnite", "Storm Crow"
  start turn 3 A
  turn 3 A: cast "Memnite"
  turn 3 A: cast "Storm Crow"
  run_to turn 3 end
  assert battlefield A contains "Storm Crow"
}

scenario "spell number: the first spell costs full" {
  battlefield A: "Highspire Bell-Ringer", "Island"
  hand A: "Storm Crow"
  start turn 3 A
  illegal turn 3 A: cast "Storm Crow"
  run_to turn 3 end
}

scenario "spell number: the third spell costs full" {
  battlefield A: "Highspire Bell-Ringer", "Island"
  hand A: "Memnite", "Ornithopter", "Storm Crow"
  start turn 3 A
  turn 3 A: cast "Memnite"
  turn 3 A: cast "Ornithopter"
  illegal turn 3 A: cast "Storm Crow"
  run_to turn 3 end
}

scenario "that player may pay: paying {4} untaps the creature" {
  battlefield A: "Swamp"
  battlefield B: "Grizzly Bears", 4 "Forest"
  hand A: "Paralyze"
  turn 1 A: cast "Paralyze" targeting "Grizzly Bears"
  turn 2 upkeep B: accept "Paralyze"
  run_to turn 2 precombat_main
  assert untapped "Grizzly Bears"
  assert tapped oldest "Forest"
}

scenario "that player may pay: declining leaves it tapped" {
  battlefield A: "Swamp"
  battlefield B: "Grizzly Bears", 4 "Forest"
  hand A: "Paralyze"
  turn 1 A: cast "Paralyze" targeting "Grizzly Bears"
  turn 2 upkeep B: decline "Paralyze"
  run_to turn 2 precombat_main
  assert tapped "Grizzly Bears"
}

scenario "that player may pay: unable to pay, nothing happens" {
  battlefield A: "Swamp"
  battlefield B: "Grizzly Bears", 3 "Forest"
  hand A: "Paralyze"
  turn 1 A: cast "Paralyze" targeting "Grizzly Bears"
  run_to turn 2 precombat_main
  assert tapped "Grizzly Bears"
}

scenario "that player may discard at random: the creature untaps" {
  battlefield A: "Island"
  battlefield B: "Grizzly Bears" tapped
  hand A: "Apathy"
  hand B: "Shock"
  turn 1 A: cast "Apathy" targeting "Grizzly Bears"
  turn 2 upkeep B: accept "Apathy"
  run_to turn 2 precombat_main
  assert untapped "Grizzly Bears"
  assert graveyard B contains "Shock"
}

scenario "that player may discard at random: an empty hand keeps it tapped" {
  battlefield A: "Island"
  battlefield B: "Grizzly Bears" tapped
  hand A: "Apathy"
  library B: "Forest"
  turn 1 A: cast "Apathy" targeting "Grizzly Bears"
  run_to turn 2 precombat_main
  assert tapped "Grizzly Bears"
}

scenario "you scry: the enchanted creature attacks, pumped" {
  battlefield A: "Grizzly Bears", "Psychic Impetus" on "Grizzly Bears"
  library A: "Island", "Island", "Island"
  start turn 3 A
  turn 3 A: attack "Grizzly Bears"
  run_to turn 3 end
  assert life B 16
  assert library A count 2
}

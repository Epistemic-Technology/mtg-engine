# Graveyard, library, hand, and exile forms from the zones branch of the
# seventh wave.

# "If this creature would die, put it on top of its owner's library
# instead." (Gravebane Zombie) and "on the bottom" (Nissa's Chosen): a
# replacement of the zone change (CR 614.1a, 700.4).

scenario "dies to library: Gravebane Zombie goes on top of its owner's library" {
  battlefield A: "Gravebane Zombie"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  library A: "Island", "Forest"
  start turn 2 B
  turn 2 B: cast "Lightning Bolt" targeting "Gravebane Zombie"
  run_to turn 3 precombat_main
  assert graveyard A lacks "Gravebane Zombie"
  assert hand A contains "Gravebane Zombie"
  assert hand A lacks "Island"
}

scenario "dies to library: Nissa's Chosen goes on the bottom" {
  battlefield A: "Nissa's Chosen"
  battlefield B: "Swamp", "Swamp", "Swamp"
  hand B: "Murder"
  library A: "Island", "Forest"
  start turn 2 B
  turn 2 B: cast "Murder" targeting "Nissa's Chosen"
  run_to turn 3 precombat_main
  assert graveyard A lacks "Nissa's Chosen"
  assert hand A contains "Island"
  assert hand A lacks "Nissa's Chosen"
  assert library A contains "Nissa's Chosen"
  assert library A count 2
}

scenario "dies to library: sacrificed, it is put on top too" {
  battlefield A: "Gravebane Zombie", "Cartel Aristocrat"
  library A: "Island", "Forest"
  turn 1 A: activate "Cartel Aristocrat" sacrificing "Gravebane Zombie"
  run_to turn 1 end
  assert graveyard A lacks "Gravebane Zombie"
  assert library A count 3
}

scenario "dies to library: exiled, it is not dying, so it stays in exile" {
  battlefield A: "Plains", "Plains", "Plains", "Plains", "Plains"
  battlefield B: "Gravebane Zombie"
  hand A: "Banish from Edoras"
  turn 1 A: cast "Banish from Edoras" targeting "Gravebane Zombie"
  run_to turn 1 end
  assert exile B contains "Gravebane Zombie"
}

# "Reveal any number of green cards in your hand." (CR 701.20a): chosen as
# the spell resolves; the cards stay in the hand, known to every player,
# and "cards revealed this way" counts them.

scenario "reveal from hand: Scent of Ivy counts the green cards revealed" {
  battlefield A: "Forest", "Grizzly Bears"
  hand A: "Scent of Ivy", "Giant Growth", "Grizzly Bears", "Serra Angel"
  turn 1 A: cast "Scent of Ivy" targeting A "Grizzly Bears"
  turn 1 A: choose "Giant Growth"
  turn 1 A: choose "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
  assert hand A contains "Giant Growth"
  assert hand A contains "Grizzly Bears"
  assert known B "Giant Growth"
  assert unknown B "Serra Angel"
}

scenario "reveal from hand: only cards of the color are offered" {
  battlefield A: "Plains"
  hand A: "Scent of Jasmine", "Serra Angel", "Grizzly Bears"
  turn 1 A: cast "Scent of Jasmine"
  illegal turn 1 A: choose "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 22
}

scenario "reveal from hand: revealing nothing counts zero" {
  battlefield A: "Plains"
  hand A: "Scent of Jasmine", "Serra Angel"
  turn 1 A: cast "Scent of Jasmine"
  turn 1 A: choose done
  run_to turn 1 postcombat_main
  assert life A 20
}

scenario "reveal from hand: Scent of Cinder deals X damage" {
  battlefield A: "Mountain", "Mountain"
  hand A: "Scent of Cinder", "Lightning Bolt", "Shock"
  turn 1 A: cast "Scent of Cinder" targeting player B
  turn 1 A: choose "Lightning Bolt"
  turn 1 A: choose "Shock"
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand A count 2
}

scenario "reveal from hand: Scent of Brine counters unless {1} per card revealed is paid" {
  battlefield A: "Island", "Island"
  battlefield B: "Mountain", "Mountain"
  hand A: "Scent of Brine", "Wind Drake", "Divination"
  hand B: "Lightning Bolt"
  start turn 2 B
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: cast "Scent of Brine" targeting "Lightning Bolt"
  turn 2 A: choose "Wind Drake"
  turn 2 A: choose "Divination"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Lightning Bolt"
}

scenario "reveal from hand: Scent of Nightshade gives -X/-X" {
  battlefield A: "Swamp", "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Scent of Nightshade", "Murder"
  turn 1 A: cast "Scent of Nightshade" targeting "Hill Giant"
  turn 1 A: choose "Murder"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 2
  assert toughness "Hill Giant" 2
}

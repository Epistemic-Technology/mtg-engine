# Cards completed by renderer and parser fixes (render-a).

scenario "Captain America pumps each other Hero by its toughness" {
  battlefield A: "Captain America, Wings of Freedom" with 2 +1/+1, "Sif's Spearmaster", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Captain America, Wings of Freedom"
  run_to turn 1 declare_blockers
  assert power "Sif's Spearmaster" 4
  assert toughness "Sif's Spearmaster" 7
  assert power "Grizzly Bears" 2
  assert power "Captain America, Wings of Freedom" 5
}

scenario "Ouroboroid puts its power in counters on each creature you control" {
  battlefield A: "Ouroboroid", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 declare_attackers
  assert counters "Ouroboroid" +1/+1 1
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Ouroboroid" 2
}

scenario "Ouroboroid's second combat uses its grown power" {
  battlefield A: "Ouroboroid" with 2 +1/+1, "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 declare_attackers
  assert counters "Ouroboroid" +1/+1 5
  assert counters "Grizzly Bears" +1/+1 3
}

scenario "Halana and Alena give another creature counters and haste" {
  battlefield A: "Halana and Alena, Partners" with 1 +1/+1, "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Halana and Alena, Partners" targeting "Grizzly Bears"
  run_to turn 1 declare_attackers
  assert counters "Grizzly Bears" +1/+1 3
  assert has "Grizzly Bears" haste
  assert counters "Halana and Alena, Partners" +1/+1 1
}

scenario "Abomination's power-up grows him and he fights" {
  battlefield A: "Abomination, Terrifying Titan", 7 "Mountain"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Abomination, Terrifying Titan" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Abomination, Terrifying Titan" +1/+1 1
  assert graveyard B contains "Hill Giant"
  assert damage "Abomination, Terrifying Titan" 3
}

scenario "Abomination's power-up is activated only once" {
  battlefield A: "Abomination, Terrifying Titan", 14 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Abomination, Terrifying Titan"
  illegal turn 1 postcombat_main A: activate "Abomination, Terrifying Titan"
  run_to turn 1 end
  assert counters "Abomination, Terrifying Titan" +1/+1 1
}

scenario "Madame Masque connives as she enters" {
  battlefield A: 5 "Swamp"
  hand A: "Madame Masque"
  library A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Madame Masque"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert counters "Madame Masque" +1/+1 1
}

scenario "Brambleguard Captain gives its power to a creature you control" {
  battlefield A: "Brambleguard Captain" with 1 +1/+1, "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Brambleguard Captain" targeting "Grizzly Bears"
  run_to turn 1 declare_attackers
  assert power "Grizzly Bears" 5
  assert toughness "Grizzly Bears" 2
}

scenario "Hemosymbic Mite pumps another creature as it attacks" {
  battlefield A: "Hemosymbic Mite", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Hemosymbic Mite"
  turn 1 declare_attackers A: trigger "Hemosymbic Mite" targeting "Grizzly Bears"
  run_to turn 1 declare_blockers
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 3
}

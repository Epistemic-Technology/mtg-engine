  hand A: "Leonardo's Technique"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Leonardo's Technique" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Serra Angel"
}


# "If you don't, ..." and "If you can't, ..." after an optional or a
# chosen action (CR 608.2c): the follow-up happens only when the action
# before it didn't.

scenario "Traumatic Revelation: a creature card is chosen, no Incubator" {
  battlefield A: 2 "Swamp"
  hand A: "Traumatic Revelation"
  hand B: "Grizzly Bears", "Forest"
  turn 1 A: cast "Traumatic Revelation" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert hand B contains "Forest"
  assert battlefield A lacks "Incubator"
}

scenario "Traumatic Revelation: nothing to choose, incubate 3" {
  battlefield A: 2 "Swamp"
  hand A: "Traumatic Revelation"
  hand B: "Forest", "Shock"
  turn 1 A: cast "Traumatic Revelation" targeting player B
  run_to turn 1 postcombat_main
  assert hand B contains "Forest"
  assert hand B contains "Shock"
  assert battlefield A contains "Incubator"
}

scenario "Knight of the Mists: paying {U} spares the Knight" {
  battlefield A: 4 "Island"
  battlefield B: "Knight of the Mists"
  hand A: "Knight of the Mists"
  turn 1 A: cast "Knight of the Mists"
  turn 1 A: trigger "Knight of the Mists" targeting B "Knight of the Mists"
  turn 1 A: accept "Knight of the Mists"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Knight of the Mists"
}

scenario "Knight of the Mists: declining destroys the target Knight" {
  battlefield A: 4 "Island"
  battlefield B: "Knight of the Mists"
  hand A: "Knight of the Mists"
  turn 1 A: cast "Knight of the Mists"
  turn 1 A: trigger "Knight of the Mists" targeting B "Knight of the Mists"
  turn 1 A: decline "Knight of the Mists"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Knight of the Mists"
  assert battlefield A contains "Knight of the Mists"
}

scenario "Knight of the Mists: unable to pay, the Knight is destroyed" {
  battlefield A: 3 "Island"
  battlefield B: "Knight of the Mists"
  hand A: "Knight of the Mists"
  turn 1 A: cast "Knight of the Mists"
  turn 1 A: trigger "Knight of the Mists" targeting B "Knight of the Mists"
  turn 1 A: accept "Knight of the Mists"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Knight of the Mists"
}

scenario "Patient Naturalist: a land among the milled cards goes to hand" {
  battlefield A: 3 "Forest"
  hand A: "Patient Naturalist"
  library A: "Shock", "Forest", "Grizzly Bears", "Hill Giant"
  turn 1 A: cast "Patient Naturalist"
  run_to turn 1 postcombat_main
  assert hand A contains "Forest"
  assert graveyard A contains "Shock"
  assert battlefield A lacks "Treasure"
}

scenario "Patient Naturalist: no land milled, a Treasure instead" {
  battlefield A: 3 "Forest"
  hand A: "Patient Naturalist"
  library A: "Shock", "Murder", "Grizzly Bears", "Forest"
  turn 1 A: cast "Patient Naturalist"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert library A count 1
  assert battlefield A contains "Treasure"
}

# Cards whose phrases the templates now spell as the language takes them
# (seventeenth wave): "that were dealt damage this turn", a spell
# target's colors before its mana value and "if it targets a blue spell".

scenario "Death-Rattle Oni: destroys the other creatures dealt damage this turn" {
  battlefield A: 7 "Swamp", "Mountain", "Grizzly Bears"
  battlefield B: "Hill Giant", "Serra Angel"
  hand A: "Death-Rattle Oni", "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Hill Giant"
  turn 1 A: wait
  turn 1 A: cast "Death-Rattle Oni"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield B contains "Serra Angel"
  assert battlefield A contains "Grizzly Bears"
  assert battlefield A contains "Death-Rattle Oni"
}

scenario "Change the Equation: a red spell with mana value 6 or less" {
  battlefield A: "Island", "Island"
  battlefield B: "Mountain"
  hand A: "Change the Equation"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 A: cast "Change the Equation" mode 2 targeting "Shock" in response to "Shock"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Shock"
}

scenario "Change the Equation: not a white spell" {
  battlefield A: "Island", "Island"
  battlefield B: 5 "Plains"
  hand A: "Change the Equation"
  hand B: "Serra Angel"
  start turn 2 B precombat_main
  turn 2 B: cast "Serra Angel"
  illegal turn 2 A: cast "Change the Equation" mode 2 targeting "Serra Angel" in response to "Serra Angel"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Serra Angel"
}

scenario "Mystical Dispute: {2} less against a blue spell" {
  battlefield A: "Island"
  battlefield B: 5 "Island"
  hand A: "Mystical Dispute"
  hand B: "Inspiration"
  start turn 2 B precombat_main
  turn 2 B: cast "Inspiration" targeting player B
  turn 2 A: cast "Mystical Dispute" targeting "Inspiration" in response to "Inspiration"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Inspiration"
  assert hand B count 0
}

scenario "Mystical Dispute: full price against a red spell" {
  battlefield A: "Island"
  battlefield B: "Mountain"
  hand A: "Mystical Dispute"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  illegal turn 2 A: cast "Mystical Dispute" targeting "Shock" in response to "Shock"
  run_to turn 2 postcombat_main
  assert life A 18
}

scenario "No One Left Behind: {3} less for a creature card with mana value 3 or less" {
  battlefield A: 2 "Swamp"
  graveyard A: "Grizzly Bears", "Hill Giant"
  hand A: "No One Left Behind"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "No One Left Behind" targeting "Hill Giant"
  turn 1 A: cast "No One Left Behind" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

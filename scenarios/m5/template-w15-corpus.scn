scenario "Charforger: a Goblin, oil for each death, and an impulse for three oil" {
  battlefield A: 3 "Mountain", "Swamp", "Grizzly Bears"
  hand A: "Charforger", "Shock"
  library A: "Forest", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Charforger"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Phyrexian Goblin"
  assert counters "Charforger" oil 1
}

scenario "Charforger: remove three oil counters to play the top card this turn" {
  battlefield A: "Charforger" with 3 oil
  library A: "Forest", "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Charforger"
  turn 1 A: wait
  turn 1 A: play "Forest"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Forest"
  assert counters "Charforger" oil 0
}


# Cards the template author writes from a line an accepted card already
# says (the corpus line index), and from the 1/1-creature filter, "each of
# two targets", "that creature's controller", and "+X/+X, where X is its
# power".

scenario "Alloy Animist: a noncreature artifact becomes a 4/4 until end of turn" {
  battlefield A: "Alloy Animist", 3 "Forest", "Darksteel Relic", "Ornithopter"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Alloy Animist" targeting "Ornithopter"
  turn 1 A: activate "Alloy Animist" targeting "Darksteel Relic"
  run_to turn 1 postcombat_main
  assert is "Darksteel Relic" creature
  assert power "Darksteel Relic" 4
  run_to turn 2 upkeep
  assert is not "Darksteel Relic" creature
}

scenario "Amphibian Downpour: a blue 1/1 Frog with no abilities" {
  battlefield A: 3 "Island"
  battlefield B: "Serra Angel"
  hand A: "Amphibian Downpour"
  start turn 1 A precombat_main
  turn 1 A: cast "Amphibian Downpour" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert power "Serra Angel" 1
  assert toughness "Serra Angel" 1
  assert has not "Serra Angel" flying
  assert is "Serra Angel" Frog
  assert is "Serra Angel" blue
  assert is not "Serra Angel" white
}

scenario "Blitz Hellion: its owner shuffles it into the library at the end step" {
  battlefield A: 3 "Mountain", 2 "Forest"
  hand A: "Blitz Hellion"
  start turn 1 A precombat_main
  turn 1 A: cast "Blitz Hellion"
  turn 1 A: attack "Blitz Hellion"
  run_to turn 1 cleanup
  assert life B 13
  assert library A contains "Blitz Hellion"
  assert battlefield A lacks "Blitz Hellion"
}

scenario "Challenger Troll: a creature with power 4 or greater can't be double-blocked" {
  battlefield A: "Challenger Troll", "Craw Wurm"
  battlefield B: "Grizzly Bears", "Runeclaw Bear"
  start turn 1 A precombat_main
  turn 1 A: attack "Craw Wurm"
  turn 1 B: block "Craw Wurm" with "Grizzly Bears"
  illegal turn 1 B: block "Craw Wurm" with "Runeclaw Bear"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert battlefield B contains "Runeclaw Bear"
}

scenario "Chameleon Colossus: +X/+X where X is its power, counted once" {
  battlefield A: "Chameleon Colossus", 4 "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Chameleon Colossus"
  run_to turn 1 postcombat_main
  assert power "Chameleon Colossus" 8
  assert toughness "Chameleon Colossus" 8
}


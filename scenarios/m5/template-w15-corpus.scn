scenario "Shadowspear: equipped creature gets +1/+1, trample, and lifelink" {
  battlefield A: "Grizzly Bears", "Shadowspear" on "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 17
  assert life A 23
  assert has "Grizzly Bears" trample
}

scenario "Sharpened Pitchfork: first strike, and +1/+1 on a Human" {
  battlefield A: "Elite Vanguard", "Sharpened Pitchfork" on "Elite Vanguard", "Grizzly Bears", "Sharpened Pitchfork" on "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 precombat_main
  assert power "Elite Vanguard" 3
  assert has "Elite Vanguard" first_strike
  assert power "Grizzly Bears" 2
  assert has "Grizzly Bears" first_strike
}

scenario "Sindbad: a nonland card drawn this way is discarded" {
  battlefield A: "Sindbad"
  library A: "Shock", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Sindbad"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Shock"
  assert hand A count 0
}

scenario "Sindbad: a land drawn this way is kept" {
  battlefield A: "Sindbad"
  library A: "Forest", "Shock"
  start turn 1 A precombat_main
  turn 1 A: activate "Sindbad"
  run_to turn 1 postcombat_main
  assert hand A contains "Forest"
}

scenario "Skittering Monstrosity: casting a creature spell sacrifices it" {
  battlefield A: "Skittering Monstrosity", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Skittering Monstrosity"
  assert battlefield A contains "Grizzly Bears"
}

scenario "Skyclave Shadowcat: sacrifice for a counter; a creature with a counter dies, draw" {
  battlefield A: "Skyclave Shadowcat", 2 "Swamp", "Grizzly Bears" with 1 +1/+1, "Mountain"
  hand A: "Shock"
  library A: "Swamp", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Skyclave Shadowcat" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Skyclave Shadowcat" +1/+1 1
  assert hand A count 2
}

scenario "Somberwald Stag: it may fight a creature you don't control" {
  battlefield A: 5 "Forest"
  battlefield B: "Grizzly Bears"
  hand A: "Somberwald Stag"
  start turn 1 A precombat_main
  turn 1 A: cast "Somberwald Stag"
  turn 1 A: trigger "Somberwald Stag" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert damage "Somberwald Stag" 2
  assert battlefield A contains "Somberwald Stag"
}

scenario "Sphinx of the Guildpact: all colors, hexproof from monocolored" {
  battlefield A: "Sphinx of the Guildpact"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B
  illegal turn 2 B: cast "Shock" targeting "Sphinx of the Guildpact"
  run_to turn 2 postcombat_main
  assert is "Sphinx of the Guildpact" green
  assert is "Sphinx of the Guildpact" white
  assert has "Sphinx of the Guildpact" flying
}

scenario "Starfield Mystic: enchantment spells cost {1} less; a counter when one dies" {
  battlefield A: "Starfield Mystic", "Plains", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Pacifism"
  start turn 1 A precombat_main
  turn 1 A: cast "Pacifism" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Pacifism" to "Grizzly Bears"
  assert untapped "Mountain"
}

scenario "Starfield Mystic: an enchantment put into the graveyard gives a counter" {
  battlefield A: "Starfield Mystic", "Glorious Anthem"
  battlefield B: 2 "Forest"
  hand B: "Naturalize"
  start turn 2 B
  turn 2 B: cast "Naturalize" targeting "Glorious Anthem"
  run_to turn 2 postcombat_main
  assert counters "Starfield Mystic" +1/+1 1
}

scenario "Tajic, Legion's Edge: noncombat damage to other creatures you control is prevented" {
  battlefield A: "Tajic, Legion's Edge", "Grizzly Bears"
  battlefield B: 2 "Mountain"
  hand B: "Shock", "Shock"
  start turn 2 B
  turn 2 B: cast "Shock" targeting "Grizzly Bears"
  turn 2 B: wait
  turn 2 B: cast "Shock" targeting "Tajic, Legion's Edge"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert graveyard A contains "Tajic, Legion's Edge"
}

scenario "Thalia and The Gitrog Monster: two lands a turn; opponents' creatures enter tapped" {
  battlefield A: "Thalia and The Gitrog Monster"
  battlefield B: 2 "Forest"
  hand A: "Forest", "Plains"
  hand B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: play "Forest"
  turn 1 A: play "Plains"
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Plains"
  assert tapped "Grizzly Bears"
}

scenario "Thalia and The Gitrog Monster: attacking, sacrifice a creature or land, then draw" {
  battlefield A: "Thalia and The Gitrog Monster", "Forest"
  library A: "Island", "Island"
  start turn 1 A precombat_main
  turn 1 A: attack "Thalia and The Gitrog Monster"
  turn 1 A: choose "Forest"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Forest"
  assert hand A count 1
}

scenario "The Great Henge: {X} less for the greatest power; counters and a card for each creature" {
  battlefield A: 3 "Forest", "Craw Wurm"
  hand A: "The Great Henge", "Grizzly Bears"
  library A: "Island", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "The Great Henge"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "The Great Henge"
  assert counters "Grizzly Bears" +1/+1 1
  assert hand A count 1
  assert life A 22
}

scenario "Tidehollow Sculler: exile a nonland card until it leaves" {
  battlefield A: "Plains", "Swamp", "Mountain"
  hand A: "Tidehollow Sculler", "Shock"
  hand B: "Lightning Bolt", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Tidehollow Sculler"
  turn 1 A: trigger "Tidehollow Sculler" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Tidehollow Sculler"
  run_to turn 1 postcombat_main
  assert hand B contains "Lightning Bolt"
  assert graveyard A contains "Tidehollow Sculler"
}

scenario "Tidehollow Sculler: the card stays exiled while it remains" {
  battlefield A: "Plains", "Swamp"
  hand A: "Tidehollow Sculler"
  hand B: "Lightning Bolt", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Tidehollow Sculler"
  turn 1 A: trigger "Tidehollow Sculler" targeting player B
  run_to turn 1 postcombat_main
  assert exile B contains "Lightning Bolt"
  assert hand B contains "Forest"
}

scenario "Transplant Theorist: loot when an artifact enters; a graveyard card to the bottom" {
  battlefield A: "Transplant Theorist", 2 "Island"
  hand A: "Ornithopter", "Shock"
  graveyard A: "Grizzly Bears"
  library A: "Island", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Ornithopter"
  turn 1 A: accept "Transplant Theorist"
  turn 1 precombat_main A: discard "Shock"
  turn 1 A: wait
  turn 1 A: activate "Transplant Theorist" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Shock"
  assert library A contains "Grizzly Bears"
  assert hand A contains "Island"
}

scenario "Unravel the Aether: its owner shuffles it into the library" {
  battlefield A: 2 "Forest"
  battlefield B: "Glorious Anthem"
  hand A: "Unravel the Aether"
  start turn 1 A precombat_main
  turn 1 A: cast "Unravel the Aether" targeting "Glorious Anthem"
  run_to turn 1 postcombat_main
  assert library B contains "Glorious Anthem"
  assert battlefield B lacks "Glorious Anthem"
}

scenario "Veteran Adventurer: also a Cleric, Rogue, Warrior, and Wizard; cheaper with a party" {
  battlefield A: 5 "Forest", "Goblin Piker"
  hand A: "Veteran Adventurer"
  start turn 1 A precombat_main
  turn 1 A: cast "Veteran Adventurer"
  run_to turn 1 postcombat_main
  assert is "Veteran Adventurer" Wizard
  assert is "Veteran Adventurer" Rogue
  assert has "Veteran Adventurer" vigilance
}

scenario "Volcanic Salvo: {X} less for total power, 6 damage to each of up to two creatures" {
  battlefield A: 2 "Mountain", "Craw Wurm", "Colossal Dreadmaw"
  battlefield B: "Hill Giant", "Serra Angel"
  hand A: "Volcanic Salvo"
  start turn 1 A precombat_main
  turn 1 A: cast "Volcanic Salvo" targeting "Hill Giant", "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard B contains "Serra Angel"
}

scenario "Wall of Essence: gain life equal to the combat damage dealt to it" {
  battlefield A: "Wall of Essence"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Wall of Essence"
  run_to turn 2 postcombat_main
  assert life A 23
}

scenario "Yarok's Wavecrasher: return another creature you control" {
  battlefield A: 4 "Island", "Grizzly Bears"
  hand A: "Yarok's Wavecrasher"
  start turn 1 A precombat_main
  turn 1 A: cast "Yarok's Wavecrasher"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert battlefield A contains "Yarok's Wavecrasher"
}

# CR 205.4e: a legendary sorcery needs a legendary creature or planeswalker.

scenario "Karn's Temporal Sundering: not without a legendary creature or planeswalker" {
  battlefield A: 6 "Island", "Grizzly Bears"
  hand A: "Karn's Temporal Sundering"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Karn's Temporal Sundering" targeting player A, none
  run_to turn 1 postcombat_main
}

scenario "Karn's Temporal Sundering: with a legendary creature" {
  battlefield A: 6 "Island", "Exava, Rakdos Blood Witch"
  hand A: "Karn's Temporal Sundering"
  start turn 1 A precombat_main
  turn 1 A: cast "Karn's Temporal Sundering" targeting player A, none
  run_to turn 1 postcombat_main
  assert exile A contains "Karn's Temporal Sundering"
}

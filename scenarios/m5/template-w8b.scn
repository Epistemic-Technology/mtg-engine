  battlefield A: 3 "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Nightmarish End", "Forest", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Nightmarish End" targeting "Hill Giant"

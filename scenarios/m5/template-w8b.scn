scenario "Lys Alana Scarblade: -X/-X by Elves you control" {
  battlefield A: "Lys Alana Scarblade", "Llanowar Elves"
  battlefield B: "Hill Giant"
  hand A: "Llanowar Elves"
  start turn 1 A precombat_main
  turn 1 A: activate "Lys Alana Scarblade" discarding "Llanowar Elves" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 1
  assert graveyard A contains "Llanowar Elves"
}

scenario "Korvold enters: sacrifice another permanent, then a counter and a card" {
  battlefield A: 2 "Swamp", 2 "Mountain", "Forest", "Grizzly Bears"
  library A: "Forest", "Forest"
  hand A: "Korvold, Fae-Cursed King"
  start turn 1 A precombat_main
  turn 1 A: cast "Korvold, Fae-Cursed King"
  turn 1 A: choose "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert counters "Korvold, Fae-Cursed King" +1/+1 1
  assert hand A count 1
}

scenario "Demonspine Whip: equipped creature gets +X/+0" {
  battlefield A: "Demonspine Whip" on "Grizzly Bears", "Grizzly Bears", 3 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Demonspine Whip" x 3
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 5
}

scenario "Luxurious Libation: +X/+X and a Citizen" {
  battlefield A: 3 "Forest", "Grizzly Bears"
  hand A: "Luxurious Libation"
  start turn 1 A precombat_main
  turn 1 A: cast "Luxurious Libation" x 2 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert battlefield A contains "Citizen"
}

scenario "Sorcerer's Strongbox: won flip sacrifices it and draws three" {
  battlefield A: "Sorcerer's Strongbox", 2 "Island"
  library A: "Forest", "Forest", "Forest", "Forest"
  seed 1
  start turn 1 A precombat_main
  turn 1 A: activate "Sorcerer's Strongbox"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Sorcerer's Strongbox"
  assert hand A count 3
}

scenario "Sorcerer's Strongbox: lost flip, nothing" {
  battlefield A: "Sorcerer's Strongbox", 2 "Island"
  library A: "Forest", "Forest", "Forest", "Forest"
  seed 2
  start turn 1 A precombat_main
  turn 1 A: activate "Sorcerer's Strongbox"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Sorcerer's Strongbox"
  assert hand A count 0
}

scenario "Sokenzan Smelter: pay {1} and sacrifice an artifact for a 3/1 Construct" {
  battlefield A: "Sokenzan Smelter", "Ornithopter", "Mountain"
  start turn 1 A precombat_main
  run_to turn 1 declare_attackers
  assert graveyard A contains "Ornithopter"
  assert battlefield A contains "Construct"
  assert power "Construct" 3
  assert has "Construct" haste
}

scenario "Sokenzan Smelter: no artifact, no Construct" {
  battlefield A: "Sokenzan Smelter", "Mountain"
  start turn 1 A precombat_main
  run_to turn 1 declare_attackers
  assert battlefield A lacks "Construct"
  assert untapped "Mountain"
}

scenario "Geology Enthusiast: a tapped Powerstone at end step; draw and a counter" {
  battlefield A: "Geology Enthusiast", 6 "Island"
  library A: "Forest", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Geology Enthusiast"
  run_to turn 1 cleanup
  assert hand A count 1
  assert counters "Geology Enthusiast" +1/+1 1
  assert battlefield A contains "Powerstone"
}


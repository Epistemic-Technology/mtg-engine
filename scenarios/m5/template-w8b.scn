}

scenario "Rubblebelt Rioters: +X/+0 by greatest power" {
  battlefield A: "Rubblebelt Rioters", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Rubblebelt Rioters"
  run_to turn 1 declare_blockers
  assert power "Rubblebelt Rioters" 3
}

scenario "Norn's Wellspring: scry and an oil counter per creature death" {
  battlefield A: "Norn's Wellspring", "Grizzly Bears", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Norn's Wellspring" oil 1
}

scenario "Nadir Kraken: pay {1} on a draw, a counter and a Tentacle" {
  battlefield A: "Nadir Kraken", "Island"
  start turn 2 A upkeep
  run_to turn 2 precombat_main
  assert counters "Nadir Kraken" +1/+1 1
  assert battlefield A contains "Tentacle"
}

scenario "Mark of Mutiny: control until end of turn, a +1/+1 counter, untapped, haste" {
  battlefield A: 3 "Mountain"
  battlefield B: "Hill Giant" tapped
  hand A: "Mark of Mutiny"
  start turn 1 A precombat_main
  turn 1 A: cast "Mark of Mutiny" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert untapped "Hill Giant"
  assert counters "Hill Giant" +1/+1 1
  assert has "Hill Giant" haste
  run_to turn 2 upkeep
  assert battlefield B contains "Hill Giant"
  assert counters "Hill Giant" +1/+1 1
  assert has not "Hill Giant" haste
}

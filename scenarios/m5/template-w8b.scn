  battlefield A: "Trelasarra, Moon Dancer", "Plains"
  hand A: "Healing Salve"
  start turn 1 A precombat_main
  turn 1 A: cast "Healing Salve" targeting player A
  run_to turn 1 postcombat_main
  assert counters "Trelasarra, Moon Dancer" +1/+1 1
}


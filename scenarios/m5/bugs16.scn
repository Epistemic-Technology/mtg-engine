# The sixteenth wave's bug fixes (KNOWN-ISSUES.md section 2 and the card
# agents' MEANING / ENGINE BUG reports).

scenario "Plasm Capture: the countered spell's mana value in mana at your next main phase" {
  battlefield A: 2 "Forest", 2 "Island"
  battlefield B: 4 "Mountain"
  hand A: "Plasm Capture", "Hill Giant", "Wind Drake"
  hand B: "Hill Giant"
  start turn 2 B precombat_main
  turn 2 B: cast "Hill Giant"
  turn 2 A: cast "Plasm Capture" targeting "Hill Giant" in response to "Hill Giant"
  turn 3 A: choose red
  turn 3 A: cast "Hill Giant"
  turn 3 A: wait
  turn 3 A: cast "Wind Drake"
  run_to turn 3 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Hill Giant"
  assert battlefield A contains "Wind Drake"
}

scenario "Vanish into Memory: draw its power, then discard its toughness as it returns" {
  battlefield A: "Hill Giant", 2 "Plains", 2 "Island"
  hand A: "Vanish into Memory"
  start turn 1 A precombat_main
  turn 1 A: cast "Vanish into Memory" targeting "Hill Giant"
  run_to turn 1 end
  assert hand A count 3
  assert exile A contains "Hill Giant"
  run_to turn 3 draw
  assert battlefield A contains "Hill Giant"
  assert hand A count 1
  assert graveyard A contains 3 "Plains"
}

scenario "Conqueror's Galleon: exiled at end of combat, it returns transformed" {
  battlefield A: "Conqueror's Galleon // Conqueror's Foothold", "Hill Giant", "Grizzly Bears", 4 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Conqueror's Galleon"
  turn 1 declare_attackers A: attack "Conqueror's Galleon"
  turn 1 postcombat_main A: activate "Conqueror's Foothold" ability 2
  run_to turn 1 combat_damage
  assert life B 18
  run_to turn 1 end
  assert battlefield A contains "Conqueror's Foothold"
  assert is "Conqueror's Foothold" land
  assert tapped "Conqueror's Foothold"
  assert exile A lacks "Conqueror's Galleon"
  assert hand A count 1
}

scenario "Bretagard Stronghold: both targets get a counter, vigilance, and lifelink" {
  battlefield A: "Bretagard Stronghold", "Grizzly Bears", "Hill Giant", "Serra Angel", "Forest", 2 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Bretagard Stronghold" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 begin_combat
  assert graveyard A contains "Bretagard Stronghold"
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 1
  assert counters "Serra Angel" +1/+1 0
  assert has "Grizzly Bears" vigilance
  assert has "Hill Giant" lifelink
  assert has "Hill Giant" vigilance
  assert has "Grizzly Bears" lifelink
  assert has not "Serra Angel" lifelink
}

scenario "Hallar: a kicked spell puts a counter on Hallar, then it deals damage equal to its counters" {
  battlefield A: "Hallar, the Firefletcher" with 1 +1/+1, 2 "Mountain"
  hand A: "Goblin Bushwhacker"
  start turn 1 A precombat_main
  turn 1 A: cast "Goblin Bushwhacker" kicked
  run_to turn 1 begin_combat
  assert counters "Hallar, the Firefletcher" +1/+1 2
  assert life B 18
}

scenario "Hallar: an unkicked spell does nothing" {
  battlefield A: "Hallar, the Firefletcher", 2 "Mountain"
  hand A: "Goblin Bushwhacker"
  start turn 1 A precombat_main
  turn 1 A: cast "Goblin Bushwhacker"
  run_to turn 1 begin_combat
  assert counters "Hallar, the Firefletcher" +1/+1 0
  assert life B 20
}

scenario "Visions of Brutality: the enchanted creature's controller loses the damage it deals to a player" {
  battlefield A: "Visions of Brutality" on "Hill Giant"
  battlefield B: "Hill Giant"
  start turn 2 B precombat_main
  turn 2 B: attack "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 17
  assert life B 17
}

scenario "Visions of Brutality: damage to a creature costs its controller life too" {
  battlefield A: "Visions of Brutality" on "Hill Giant", "Serra Angel"
  battlefield B: "Hill Giant"
  start turn 2 B precombat_main
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Serra Angel"
  run_to turn 2 postcombat_main
  assert life A 20
  assert life B 17
  assert damage "Serra Angel" 3
}

scenario "Guilty Conscience: the enchanted creature is dealt the damage it deals" {
  battlefield A: "Guilty Conscience" on "Hill Giant"
  battlefield B: "Hill Giant"
  start turn 2 B precombat_main
  turn 2 B: attack "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 17
  assert graveyard B contains "Hill Giant"
}

scenario "Kusari-Gama: damage to a blocker is dealt to each other creature defending player controls" {
  battlefield A: "Hill Giant", "Kusari-Gama" on "Hill Giant"
  battlefield B: "Serra Angel", "Grizzly Bears", "Wind Drake"
  start turn 1 A precombat_main
  turn 1 A: attack "Hill Giant"
  turn 1 B: block "Hill Giant" with "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Serra Angel"
  assert damage "Serra Angel" 3
  assert graveyard B contains "Grizzly Bears"
  assert graveyard B contains "Wind Drake"
  assert life A 20
}

scenario "Kusari-Gama: equipped creature has the pump ability" {
  battlefield A: "Hill Giant", "Kusari-Gama" on "Hill Giant", 2 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Hill Giant"
  run_to turn 1 begin_combat
  assert power "Hill Giant" 4
}

scenario "Fighter Class level 3: the target blocks the attacking creature if able" {
  battlefield A: "Fighter Class", 4 "Mountain", 4 "Plains", "Hill Giant"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Fighter Class"
  turn 1 A: wait
  turn 1 A: activate "Fighter Class"
  turn 1 A: attack "Hill Giant"
  turn 1 declare_attackers A: trigger "Fighter Class" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Grizzly Bears"
}

scenario "Fighter Class level 3: blocking another attacker doesn't meet the requirement" {
  battlefield A: "Fighter Class", 4 "Mountain", 4 "Plains", "Hill Giant", "Wind Drake"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Fighter Class"
  turn 1 A: wait
  turn 1 A: activate "Fighter Class"
  turn 1 A: attack "Hill Giant", "Wind Drake"
  turn 1 declare_attackers A: trigger "Fighter Class" targeting "Grizzly Bears"
  turn 1 declare_attackers A: trigger "Fighter Class" targeting none
  illegal turn 1 B: block "Wind Drake" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert graveyard B contains "Grizzly Bears"
}

scenario "Fighter Class level 2: equip abilities cost {2} less" {
  battlefield A: "Fighter Class", 2 "Mountain", 2 "Plains", "Hill Giant", "Kusari-Gama"
  start turn 1 A precombat_main
  turn 1 A: activate "Fighter Class"
  turn 1 A: wait
  turn 1 A: activate "Kusari-Gama" targeting "Hill Giant"
  run_to turn 1 begin_combat
  assert attached "Kusari-Gama" to "Hill Giant"
}

scenario "Fighter Class: it searches for an Equipment card as it enters" {
  battlefield A: "Plains", "Mountain"
  hand A: "Fighter Class"
  library A: "Forest", "Kusari-Gama"
  start turn 1 A precombat_main
  turn 1 A: cast "Fighter Class"
  turn 1 A: choose "Kusari-Gama"
  run_to turn 1 postcombat_main
  assert hand A contains "Kusari-Gama"
}

scenario "Horrid Shadowspinner: draw cards equal to its power, then discard that many" {
  battlefield A: "Horrid Shadowspinner" with 2 +1/+1
  hand A: "Forest"
  start turn 1 A precombat_main
  turn 1 A: attack "Horrid Shadowspinner"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert graveyard A count 4
  assert life B 16
  assert life A 24
}

scenario "Horrid Shadowspinner: declining draws and discards nothing" {
  battlefield A: "Horrid Shadowspinner"
  hand A: "Forest"
  start turn 1 A precombat_main
  turn 1 A: attack "Horrid Shadowspinner"
  turn 1 declare_attackers A: decline "Horrid Shadowspinner"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert graveyard A count 0
}

scenario "Nykthos Paragon: counters on each creature you control, only once each turn" {
  battlefield A: "Nykthos Paragon", "Grizzly Bears", 4 "Plains"
  hand A: "Revitalize", "Revitalize"
  start turn 1 A precombat_main
  turn 1 A: cast "Revitalize"
  turn 1 A: wait
  turn 1 A: cast "Revitalize"
  run_to turn 1 postcombat_main
  assert life A 26
  assert counters "Nykthos Paragon" +1/+1 3
  assert counters "Grizzly Bears" +1/+1 3
}

scenario "Nykthos Paragon: declined the first time, it may be done the second" {
  battlefield A: "Nykthos Paragon", "Grizzly Bears", 4 "Plains"
  hand A: "Revitalize", "Revitalize"
  start turn 1 A precombat_main
  turn 1 A: cast "Revitalize"
  turn 1 A: decline "Nykthos Paragon"
  turn 1 A: wait
  turn 1 A: cast "Revitalize"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
}

scenario "Dreamtide Whale: its controller's second spell of the turn proliferates" {
  battlefield A: "Dreamtide Whale" with 2 time, "Grizzly Bears" with 1 +1/+1, 2 "Mountain"
  hand A: "Shock", "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
  assert counters "Grizzly Bears" +1/+1 2
}

scenario "Dreamtide Whale: cast as the first spell, the second one proliferates" {
  battlefield A: "Grizzly Bears" with 1 +1/+1, 3 "Island", "Mountain"
  hand A: "Dreamtide Whale", "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Dreamtide Whale"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert counters "Dreamtide Whale" time 3
  assert counters "Grizzly Bears" +1/+1 2
}

scenario "Dreamtide Whale: an opponent's second spell proliferates, the first doesn't" {
  battlefield A: "Dreamtide Whale" with 2 time, "Grizzly Bears" with 1 +1/+1
  battlefield B: 2 "Mountain"
  hand B: "Shock", "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  run_to turn 2 begin_combat
  assert counters "Grizzly Bears" +1/+1 1
  turn 2 postcombat_main B: cast "Shock" targeting player A
  run_to turn 2 end
  assert counters "Grizzly Bears" +1/+1 2
}

scenario "Mogg Salvage: free while an opponent controls an Island and you a Mountain" {
  battlefield A: "Mountain"
  battlefield B: "Island", "Zuran Orb"
  hand A: "Mogg Salvage"
  start turn 1 A precombat_main
  turn 1 A: cast "Mogg Salvage" alternative targeting "Zuran Orb"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Zuran Orb"
  assert untapped "Mountain"
}

scenario "Mogg Salvage: your own Island doesn't make it free" {
  battlefield A: "Mountain", "Island"
  battlefield B: "Zuran Orb"
  hand A: "Mogg Salvage"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Mogg Salvage" alternative targeting "Zuran Orb"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Zuran Orb"
}

scenario "Metallic Mimic: a creature of the chosen type enters with an additional +1/+1 counter" {
  battlefield A: 4 "Forest"
  hand A: "Metallic Mimic", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Metallic Mimic"
  turn 1 A: choose Bear
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert is "Metallic Mimic" Bear
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Metallic Mimic" +1/+1 0
}

scenario "Metallic Mimic: a creature of another type gets no counter" {
  battlefield A: 6 "Mountain"
  hand A: "Metallic Mimic", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Metallic Mimic"
  turn 1 A: choose Bear
  turn 1 A: wait
  turn 1 A: cast "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 0
}

scenario "Emergency Powers: cast in a main phase, the addendum puts a permanent card onto the battlefield" {
  battlefield A: "Plains", "Island", 5 "Forest"
  hand A: "Emergency Powers"
  library A: 10 "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Emergency Powers"
  turn 1 A: choose "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert hand A count 6
  assert hand B count 7
  assert exile A contains "Emergency Powers"
}

scenario "Rushed Rebirth: the search finds a creature card with lesser mana value" {
  battlefield A: "Grizzly Bears", "Swamp", "Forest", "Mountain"
  hand A: "Rushed Rebirth", "Shock"
  library A: "Serra Angel", "Savannah Lions"
  start turn 1 A precombat_main
  turn 1 A: cast "Rushed Rebirth" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  turn 1 A: choose "Savannah Lions"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Savannah Lions"
  assert tapped "Savannah Lions"
}

scenario "Rushed Rebirth: a creature card with greater mana value isn't found" {
  battlefield A: "Grizzly Bears", "Swamp", "Forest", "Mountain"
  hand A: "Rushed Rebirth", "Shock"
  library A: "Serra Angel", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Rushed Rebirth" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A lacks "Serra Angel"
  assert library A contains "Serra Angel"
}

scenario "Sentry Oak: winning the clash, it gets +2/+0 and loses defender" {
  battlefield A: "Sentry Oak"
  library A: "Serra Angel"
  library B: "Plains"
  start turn 1 A precombat_main
  turn 1 A: attack "Sentry Oak"
  run_to turn 1 postcombat_main
  assert life B 15
}

scenario "Sentry Oak: losing the clash, it keeps defender" {
  battlefield A: "Sentry Oak"
  library A: "Plains"
  library B: "Serra Angel"
  start turn 1 A precombat_main
  illegal turn 1 A: attack "Sentry Oak"
  run_to turn 1 postcombat_main
  assert life B 20
  assert power "Sentry Oak" 3
}

scenario "Walking Bulwark: a creature with defender gains haste, attacks, and assigns damage equal to its toughness" {
  battlefield A: 3 "Plains"
  hand A: "Walking Bulwark"
  start turn 1 A precombat_main
  turn 1 A: cast "Walking Bulwark"
  turn 1 A: wait
  turn 1 A: activate "Walking Bulwark" targeting "Walking Bulwark"
  turn 1 A: attack "Walking Bulwark"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "Basri's Lieutenant: another creature that dies with a +1/+1 counter makes a Knight" {
  battlefield A: "Basri's Lieutenant", "Grizzly Bears" with 1 +1/+1, "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Knight"
}

scenario "Basri's Lieutenant: a creature without counters makes none, whatever the Lieutenant has" {
  battlefield A: "Basri's Lieutenant" with 1 +1/+1, "Grizzly Bears", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A lacks "Knight"
}

scenario "Basri's Lieutenant: dying with a counter itself, it makes a Knight" {
  battlefield A: "Basri's Lieutenant" with 1 +1/+1
  battlefield B: "Mountain"
  hand B: "Murder"
  battlefield B: 3 "Swamp"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Basri's Lieutenant"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Basri's Lieutenant"
  assert battlefield A contains "Knight"
}

scenario "Spirit Link: its controller gains the damage the enchanted creature deals" {
  battlefield A: "Spirit Link" on "Hill Giant"
  battlefield B: "Hill Giant"
  life A 10
  start turn 2 B precombat_main
  turn 2 B: attack "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 10
}

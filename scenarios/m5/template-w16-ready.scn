# Cards the template author wrote as it stood at the start of the
# sixteenth wave (`mtg-cards author --format pauper` and `--format
# modern`): the life-gain "that much" trigger, draw replacements, and
# lines the corpus already printed.

scenario "Deepwood Denizen: {1} less for each +1/+1 counter on creatures you control" {
  battlefield A: "Deepwood Denizen", "Grizzly Bears" with 2 +1/+1, 4 "Forest"
  battlefield B: "Hill Giant" with 3 +1/+1
  start turn 1 A precombat_main
  turn 1 A: activate "Deepwood Denizen"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert tapped "Deepwood Denizen"
}

scenario "Deepwood Denizen: an opponent's counters don't reduce it" {
  battlefield A: "Deepwood Denizen", 5 "Forest"
  battlefield B: "Hill Giant" with 3 +1/+1
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Deepwood Denizen"
  run_to turn 1 postcombat_main
  assert hand A count 0
}

scenario "Sunbond: the enchanted creature gets a counter for each life gained" {
  battlefield A: "Grizzly Bears", "Sunbond" on "Grizzly Bears", "Plains"
  hand A: "Chaplain's Blessing"
  start turn 1 A precombat_main
  turn 1 A: cast "Chaplain's Blessing"
  run_to turn 1 postcombat_main
  assert life A 25
  assert counters "Grizzly Bears" +1/+1 5
}

scenario "Light of Promise: the enchanted creature gets a counter for each life gained" {
  battlefield A: "Grizzly Bears", "Light of Promise" on "Grizzly Bears", "Plains"
  battlefield B: "Hill Giant"
  hand A: "Chaplain's Blessing"
  start turn 1 A precombat_main
  turn 1 A: cast "Chaplain's Blessing"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 5
  assert counters "Hill Giant" +1/+1 0
}

scenario "Ageless Entity: a +1/+1 counter for each life gained" {
  battlefield A: "Ageless Entity", "Plains"
  hand A: "Chaplain's Blessing"
  start turn 1 A precombat_main
  turn 1 A: cast "Chaplain's Blessing"
  run_to turn 1 postcombat_main
  assert counters "Ageless Entity" +1/+1 5
  assert power "Ageless Entity" 9
}

scenario "Ageless Entity: an opponent's life gain doesn't count" {
  battlefield A: "Ageless Entity"
  battlefield B: "Plains"
  hand B: "Chaplain's Blessing"
  start turn 2 B precombat_main
  turn 2 B: cast "Chaplain's Blessing"
  run_to turn 2 postcombat_main
  assert life B 25
  assert counters "Ageless Entity" +1/+1 0
}

scenario "Sanguine Bond: the opponent loses as much life as you gained" {
  battlefield A: "Sanguine Bond", "Plains"
  hand A: "Chaplain's Blessing"
  start turn 1 A precombat_main
  turn 1 A: cast "Chaplain's Blessing"
  run_to turn 1 postcombat_main
  assert life A 25
  assert life B 15
}

scenario "Defiant Bloodlord: the opponent loses as much life as you gained" {
  battlefield A: "Defiant Bloodlord", "Plains"
  hand A: "Chaplain's Blessing"
  start turn 1 A precombat_main
  turn 1 A: cast "Chaplain's Blessing"
  run_to turn 1 postcombat_main
  assert life B 15
}

scenario "Vito: lifelink for each creature until end of turn, then the drain" {
  battlefield A: "Vito, Thorn of the Dusk Rose", "Grizzly Bears", 3 "Swamp", 2 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Vito, Thorn of the Dusk Rose"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 22
  assert life B 16
  assert has "Grizzly Bears" lifelink
  run_to turn 2 upkeep
  assert has not "Grizzly Bears" lifelink
}

scenario "Teferi's Ageless Insight: the draw step's first draw is one card, the others two" {
  battlefield A: "Teferi's Ageless Insight", 3 "Island"
  hand A: "Divination"
  start turn 3 A upkeep
  run_to turn 3 precombat_main
  assert hand A count 2
  turn 3 A: cast "Divination"
  run_to turn 3 postcombat_main
  assert hand A count 5
}

scenario "Alhammarret's Archive: twice the life, and two cards for each draw but the first" {
  battlefield A: "Alhammarret's Archive", 3 "Island", "Plains"
  hand A: "Divination", "Chaplain's Blessing"
  start turn 3 A upkeep
  run_to turn 3 precombat_main
  assert hand A count 3
  turn 3 A: cast "Chaplain's Blessing"
  turn 3 A: cast "Divination"
  run_to turn 3 postcombat_main
  assert life A 30
  assert hand A count 5
}

scenario "Char-Rumbler: a -1/3 double striker pumps to deal damage" {
  battlefield A: "Char-Rumbler", 2 "Mountain"
  start turn 1 A precombat_main
  assert power "Char-Rumbler" -1
  turn 1 A: activate "Char-Rumbler"
  turn 1 A: activate "Char-Rumbler"
  turn 1 A: attack "Char-Rumbler"
  run_to turn 1 postcombat_main
  assert power "Char-Rumbler" 1
  assert life B 18
}

scenario "Cho-Manno: all damage to it is prevented" {
  battlefield A: "Cho-Manno, Revolutionary", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Cho-Manno, Revolutionary"
  run_to turn 1 postcombat_main
  assert damage "Cho-Manno, Revolutionary" 0
  assert battlefield A contains "Cho-Manno, Revolutionary"
}

scenario "Blot Out: the opponent exiles its creature or planeswalker with the greatest mana value" {
  battlefield A: 3 "Swamp", "Craw Wurm"
  battlefield B: "Grizzly Bears", "Hill Giant", "Jace Beleren"
  hand A: "Blot Out"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Blot Out" targeting player A
  turn 1 A: cast "Blot Out" targeting player B
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert battlefield B contains "Grizzly Bears"
  assert battlefield B contains "Jace Beleren"
  assert battlefield A contains "Craw Wurm"
}

scenario "Portal of Sanctuary: the creature and each Aura on it go to their owners' hands" {
  battlefield A: "Portal of Sanctuary", "Island", "Grizzly Bears", "Holy Strength" on "Grizzly Bears"
  battlefield B: "Pacifism" on "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Portal of Sanctuary" targeting "Hill Giant"
  turn 1 A: activate "Portal of Sanctuary" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand A contains "Holy Strength"
  assert hand B contains "Pacifism"
  assert battlefield B contains "Hill Giant"
}

scenario "Portal of Sanctuary: only during your turn" {
  battlefield A: "Portal of Sanctuary", "Island", "Grizzly Bears"
  start turn 2 B precombat_main
  illegal turn 2 A: activate "Portal of Sanctuary" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

scenario "Hydra Trainer: exerted, +X/+X for the counters on permanents you control" {
  battlefield A: "Hydra Trainer", "Grizzly Bears" with 2 +1/+1, "Jace Beleren"
  battlefield B: "Hill Giant" with 4 +1/+1
  start turn 2 A precombat_main
  turn 2 A: attack "Hydra Trainer"
  turn 2 A: accept "Hydra Trainer"
  turn 2 A: trigger "Hydra Trainer" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert power "Grizzly Bears" 9
  assert toughness "Grizzly Bears" 9
  run_to turn 3 upkeep
  assert power "Grizzly Bears" 4
}

scenario "Riveteers Ascendancy: a creature card with lesser mana value returns tapped, once each turn" {
  battlefield A: "Riveteers Ascendancy", 2 "Swamp", "Hill Giant", "Craw Wurm"
  battlefield B: "Serra Angel"
  graveyard A: "Grizzly Bears", "Air Elemental"
  hand A: "Bone Splinters", "Village Rites"
  start turn 1 A precombat_main
  turn 1 A: cast "Bone Splinters" sacrificing "Hill Giant" targeting "Serra Angel"
  illegal turn 1 A: trigger "Riveteers Ascendancy" targeting "Air Elemental"
  turn 1 A: trigger "Riveteers Ascendancy" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Village Rites" sacrificing "Craw Wurm"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert tapped "Grizzly Bears"
  assert graveyard A contains "Air Elemental"
  assert graveyard A contains "Craw Wurm"
  assert graveyard A contains "Hill Giant"
}

scenario "Chandra Nalaar: +1 and -X" {
  battlefield A: "Chandra Nalaar"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Chandra Nalaar" ability 1 targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert counters "Chandra Nalaar" loyalty 7
  turn 3 A: activate "Chandra Nalaar" ability 2 x 4 targeting "Hill Giant"
  run_to turn 3 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert counters "Chandra Nalaar" loyalty 3
}

scenario "Chandra Nalaar: -8 hits the player and each creature that player controls" {
  battlefield A: "Chandra Nalaar" with 8 loyalty, "Craw Wurm"
  battlefield B: "Hill Giant", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: activate "Chandra Nalaar" ability 3 targeting player B
  run_to turn 1 postcombat_main
  assert life B 10
  assert graveyard B contains "Hill Giant"
  assert graveyard B contains "Serra Angel"
  assert battlefield A contains "Craw Wurm"
  assert damage "Craw Wurm" 0
}

scenario "Chandra Nalaar: -8 at a planeswalker hits its controller's creatures" {
  battlefield A: "Chandra Nalaar" with 8 loyalty, "Craw Wurm"
  battlefield B: "Hill Giant", "Jace Beleren"
  start turn 1 A precombat_main
  turn 1 A: activate "Chandra Nalaar" ability 3 targeting "Jace Beleren"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Jace Beleren"
  assert graveyard B contains "Hill Giant"
  assert damage "Craw Wurm" 0
}

# Checks the language already had, on cards now added: "If a Werewolf is
# dealt damage this way" (a permanent the resolution damaged) and a
# trigger's "if its power is 2 or less" about the attacking enchanted
# creature as it is (`if its power is ...`).

scenario "Silver Bolt: a Werewolf dealt damage this way is destroyed" {
  battlefield A: "Silver Bolt", 3 "Plains"
  battlefield B: "Greater Werewolf"
  start turn 1 A precombat_main
  turn 1 A: activate "Silver Bolt" targeting "Greater Werewolf"
  run_to turn 1 begin_combat
  assert graveyard B contains "Greater Werewolf"
  assert graveyard A contains "Silver Bolt"
}

scenario "Silver Bolt: another creature is only dealt 3 damage" {
  battlefield A: "Silver Bolt", 3 "Plains"
  battlefield B: "Giant Spider"
  start turn 1 A precombat_main
  turn 1 A: activate "Silver Bolt" targeting "Giant Spider"
  run_to turn 1 begin_combat
  assert battlefield B contains "Giant Spider"
  assert damage "Giant Spider" 3
}

scenario "Writ of Passage: a power-2 attacker can't be blocked" {
  battlefield A: "Grizzly Bears", "Writ of Passage" on "Grizzly Bears"
  battlefield B: "Giant Spider"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 B: block "Grizzly Bears" with "Giant Spider"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "Writ of Passage: a power-3 attacker can be blocked" {
  battlefield A: "Hill Giant", "Writ of Passage" on "Hill Giant"
  battlefield B: "Giant Spider"
  start turn 1 A precombat_main
  turn 1 A: attack "Hill Giant"
  turn 1 B: block "Hill Giant" with "Giant Spider"
  run_to turn 1 postcombat_main
  assert life B 20
}

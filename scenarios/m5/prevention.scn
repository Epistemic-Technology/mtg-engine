# Damage prevention tied to a source or a group (CR 615): "Prevent all
# combat damage that would be dealt by target attacking creature this
# turn" (Restrain), "... dealt this turn by creatures with power 4 or
# less" (Vine Snare, judged as the damage is dealt), "... dealt to players"
# (Defend the Hearth), "... by creatures other than target creature"
# (Terrifying Presence), and static abilities: "dealt to enchanted
# creature" (Inviolability), "dealt by enchanted creature" (Muzzle), "dealt
# to and dealt by enchanted creature" (Gaseous Form), "that this creature
# would deal to snow creatures" (Goblin Furrier), "dealt to this creature by
# artifact sources" (Argothian Treefolk).

scenario "prevention: Restrain prevents the combat damage the target attacker would deal" {
  battlefield A: "Hill Giant", "Grizzly Bears"
  battlefield B: "Savannah Lions", 3 "Plains"
  hand B: "Restrain"
  library B: "Island"
  turn 1 A: attack "Hill Giant", "Grizzly Bears"
  turn 1 B: block "Hill Giant" with "Savannah Lions"
  turn 1 declare_blockers B: cast "Restrain" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  # The Lions survive and still deal their damage; the unblocked Bears are
  # unaffected.
  assert battlefield B contains "Savannah Lions"
  assert damage "Savannah Lions" 0
  assert damage "Hill Giant" 2
  assert life B 18
  assert hand B contains "Island"
}

scenario "prevention: Restrain's target must be attacking" {
  battlefield A: "Hill Giant"
  battlefield B: 3 "Plains"
  hand B: "Restrain"
  illegal turn 1 B: cast "Restrain" targeting "Hill Giant"
  run_to turn 1 end
}

scenario "prevention: Fend Off prevents only the target's combat damage" {
  battlefield A: "Prodigal Sorcerer"
  battlefield B: 2 "Plains"
  hand B: "Fend Off"
  turn 1 B: cast "Fend Off" targeting "Prodigal Sorcerer"
  turn 1 A: activate "Prodigal Sorcerer" targeting player B
  run_to turn 1 end
  assert life B 19
}

scenario "prevention: Vine Snare stops small attackers but not big ones" {
  battlefield A: "Hill Giant", "Craw Wurm"
  battlefield B: 3 "Forest"
  hand B: "Vine Snare"
  turn 1 A: attack "Hill Giant", "Craw Wurm"
  turn 1 declare_attackers B: cast "Vine Snare"
  run_to turn 1 postcombat_main
  assert life B 14
}

scenario "prevention: Vine Snare checks power as the damage is dealt" {
  battlefield A: "Hill Giant", "Forest"
  battlefield B: 3 "Forest"
  hand A: "Giant Growth"
  hand B: "Vine Snare"
  turn 1 A: attack "Hill Giant"
  turn 1 declare_attackers B: cast "Vine Snare"
  turn 1 declare_blockers A: cast "Giant Growth" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 14
}

scenario "prevention: Defend the Hearth prevents combat damage to players only" {
  battlefield A: "Hill Giant", "Grizzly Bears"
  battlefield B: "Savannah Lions", 2 "Forest"
  hand B: "Defend the Hearth"
  turn 1 A: attack "Hill Giant", "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Savannah Lions"
  turn 1 declare_blockers B: cast "Defend the Hearth"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Savannah Lions"
  assert graveyard A contains "Grizzly Bears"
}

scenario "prevention: Terrifying Presence spares only the target's damage" {
  battlefield A: "Hill Giant", "Grizzly Bears"
  battlefield B: 2 "Forest"
  hand B: "Terrifying Presence"
  turn 1 A: attack "Hill Giant", "Grizzly Bears"
  turn 1 declare_attackers B: cast "Terrifying Presence" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "prevention: Inviolability protects only the enchanted creature" {
  battlefield A: "Grizzly Bears", "Savannah Lions", "Inviolability" on "Grizzly Bears"
  battlefield B: 2 "Mountain"
  hand B: "Lightning Bolt", "Shock"
  turn 1 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 1 postcombat_main B: cast "Shock" targeting "Savannah Lions"
  run_to turn 1 end
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert graveyard A contains "Savannah Lions"
}

scenario "prevention: Muzzle prevents all damage the enchanted creature deals, not damage to it" {
  battlefield A: "Hill Giant", "Muzzle" on "Hill Giant"
  battlefield B: "Grizzly Bears"
  turn 1 A: attack "Hill Giant"
  turn 1 B: block "Hill Giant" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
  assert damage "Hill Giant" 2
}

scenario "prevention: Muzzle on an unblocked attacker" {
  battlefield A: "Hill Giant", "Grizzly Bears", "Muzzle" on "Hill Giant"
  turn 1 A: attack "Hill Giant", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "prevention: Gaseous Form prevents combat damage to and by the creature" {
  battlefield A: "Hill Giant", "Gaseous Form" on "Hill Giant"
  battlefield B: "Craw Wurm", "Mountain"
  hand B: "Shock"
  turn 1 A: attack "Hill Giant"
  turn 1 B: block "Hill Giant" with "Craw Wurm"
  turn 1 postcombat_main B: cast "Shock" targeting "Hill Giant"
  run_to turn 1 end
  assert damage "Craw Wurm" 0
  # The Shock is noncombat damage.
  assert damage "Hill Giant" 2
}

scenario "prevention: Goblin Furrier deals no damage to snow creatures" {
  battlefield A: "Goblin Furrier", "Grizzly Bears"
  battlefield B: "Sculptor of Winter", "Savannah Lions"
  turn 1 A: attack "Goblin Furrier", "Grizzly Bears"
  turn 1 B: block "Goblin Furrier" with "Sculptor of Winter"
  turn 1 B: block "Grizzly Bears" with "Savannah Lions"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Sculptor of Winter"
  assert damage "Sculptor of Winter" 0
  assert graveyard A contains "Goblin Furrier"
}

scenario "prevention: Goblin Furrier still damages a creature that isn't snow" {
  battlefield A: "Goblin Furrier"
  battlefield B: "Grizzly Bears"
  turn 1 A: attack "Goblin Furrier"
  turn 1 B: block "Goblin Furrier" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "prevention: Argothian Treefolk takes no damage from artifact sources" {
  battlefield A: "Argothian Treefolk"
  battlefield B: "Rod of Ruin", "Prodigal Sorcerer", 3 "Island"
  turn 1 B: activate "Rod of Ruin" targeting "Argothian Treefolk"
  turn 1 postcombat_main B: activate "Prodigal Sorcerer" targeting "Argothian Treefolk"
  run_to turn 1 end
  assert damage "Argothian Treefolk" 1
}

scenario "prevention: Maze of Ith untaps the attacker and prevents damage to and by it" {
  battlefield A: "Hill Giant"
  battlefield B: "Maze of Ith", "Grizzly Bears"
  turn 1 A: attack "Hill Giant"
  turn 1 declare_attackers B: activate "Maze of Ith" targeting "Hill Giant"
  turn 1 B: block "Hill Giant" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert untapped "Hill Giant"
  assert life B 20
  assert damage "Hill Giant" 0
  assert damage "Grizzly Bears" 0
}

scenario "prevention: Chameleon Blur stops creature damage to players, not to creatures" {
  battlefield A: "Hill Giant", "Grizzly Bears"
  battlefield B: "Savannah Lions", 4 "Forest"
  hand B: "Chameleon Blur"
  turn 1 A: attack "Hill Giant", "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Savannah Lions"
  turn 1 declare_blockers B: cast "Chameleon Blur"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Savannah Lions"
}

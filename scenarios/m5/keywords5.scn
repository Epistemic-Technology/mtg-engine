# M5: small keyword mechanics that expand to ordinary triggers and
# effects: fabricate (CR 702.123), renown (702.112), evolve (702.100),
# unleash (702.98), support (701.41), bolster (701.39), populate (701.36),
# incubate (701.53).

scenario "fabricate: counters on it when you take them" {
  battlefield A: 3 "Plains"
  hand A: "Glint-Sleeve Artisan"
  turn 1 A: cast "Glint-Sleeve Artisan"
  turn 1 A: accept "Glint-Sleeve Artisan"
  run_to turn 1 postcombat_main
  assert counters "Glint-Sleeve Artisan" +1/+1 1
  assert power "Glint-Sleeve Artisan" 3
  assert battlefield A lacks "Servo"
}

scenario "fabricate: a Servo if you don't" {
  battlefield A: 3 "Plains"
  hand A: "Glint-Sleeve Artisan"
  turn 1 A: cast "Glint-Sleeve Artisan"
  turn 1 A: decline "Glint-Sleeve Artisan"
  run_to turn 1 postcombat_main
  assert counters "Glint-Sleeve Artisan" +1/+1 0
  assert battlefield A contains 1 "Servo"
  assert is "Servo" artifact
  assert power "Servo" 1
}

scenario "fabricate: gone before it resolves, Servos instead" {
  battlefield A: 4 "Plains"
  battlefield B: "Mountain"
  graveyard A: "Glint-Sleeve Artisan"
  hand A: "Breath of Life"
  hand B: "Lightning Bolt"
  turn 1 A: cast "Breath of Life" targeting "Glint-Sleeve Artisan"
  turn 1 B: cast "Lightning Bolt" targeting "Glint-Sleeve Artisan" in response to "Glint-Sleeve Artisan"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Glint-Sleeve Artisan"
  assert battlefield A contains 1 "Servo"
}

scenario "renown: counters once, then renowned" {
  battlefield A: "Topan Freeblade"
  turn 1 A: attack "Topan Freeblade"
  turn 3 A: attack "Topan Freeblade"
  run_to turn 1 postcombat_main
  assert life B 18
  assert counters "Topan Freeblade" +1/+1 1
  run_to turn 3 postcombat_main
  assert life B 15
  assert counters "Topan Freeblade" +1/+1 1
}

scenario "renown: no trigger when blocked" {
  battlefield A: "Rhox Maulers"
  battlefield B: "Hill Giant"
  turn 1 A: attack "Rhox Maulers"
  turn 1 B: block "Rhox Maulers" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Rhox Maulers" +1/+1 0
}

scenario "renown: trample damage to the player counts" {
  battlefield A: "Rhox Maulers"
  battlefield B: "Grizzly Bears"
  turn 1 A: attack "Rhox Maulers"
  turn 1 B: block "Rhox Maulers" with "Grizzly Bears"
  turn 1 A: assign "Rhox Maulers" to "Grizzly Bears" 2, player B 2
  run_to turn 1 postcombat_main
  assert life B 18
  assert counters "Rhox Maulers" +1/+1 2
  assert power "Rhox Maulers" 6
}

scenario "evolve: a bigger creature entering adds a counter" {
  battlefield A: "Cloudfin Raptor", 2 "Forest"
  hand A: "Grizzly Bears"
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Cloudfin Raptor" +1/+1 1
  assert power "Cloudfin Raptor" 1
  assert toughness "Cloudfin Raptor" 2
}

scenario "evolve: neither power nor toughness greater, no counter" {
  battlefield A: "Cloudfin Raptor" with 2 +1/+1, 2 "Forest"
  hand A: "Grizzly Bears"
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Cloudfin Raptor" +1/+1 2
}

scenario "evolve: an opponent's creature doesn't count" {
  battlefield A: "Cloudfin Raptor"
  battlefield B: 2 "Forest"
  hand B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert counters "Cloudfin Raptor" +1/+1 0
}

scenario "evolve: checked again as it resolves" {
  battlefield A: "Cloudfin Raptor", 3 "Forest"
  hand A: "Grizzly Bears", "Giant Growth"
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: cast "Giant Growth" targeting "Cloudfin Raptor" in response to "Cloudfin Raptor"
  run_to turn 1 postcombat_main
  assert counters "Cloudfin Raptor" +1/+1 0
}

scenario "unleash: entered with a counter, it can't block" {
  battlefield A: 3 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Dead Reveler"
  turn 1 A: cast "Dead Reveler"
  turn 1 A: accept "Dead Reveler"
  illegal turn 2 A: block "Grizzly Bears" with "Dead Reveler"
  turn 2 B: attack "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert counters "Dead Reveler" +1/+1 1
  assert power "Dead Reveler" 3
  assert life A 18
}

scenario "unleash: without the counter, it blocks" {
  battlefield A: 3 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Dead Reveler"
  turn 1 A: cast "Dead Reveler"
  turn 1 A: decline "Dead Reveler"
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Dead Reveler"
  run_to turn 2 postcombat_main
  assert counters "Dead Reveler" +1/+1 0
  assert life A 20
  assert graveyard B contains "Grizzly Bears"
}

scenario "support: a counter on each of up to two target creatures" {
  battlefield A: "Grizzly Bears", "Hill Giant", 2 "Forest"
  hand A: "Lead by Example"
  turn 1 A: cast "Lead by Example" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 1
}

scenario "support on a permanent: other target creatures, fewer is fine" {
  battlefield A: "Grizzly Bears", 4 "Plains", "Forest"
  hand A: "Aerie Auxiliary"
  turn 1 A: cast "Aerie Auxiliary"
  turn 1 A: trigger "Aerie Auxiliary" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Aerie Auxiliary" +1/+1 0
}

scenario "bolster: the creature with the least toughness" {
  battlefield A: "Hill Giant", 3 "Plains"
  hand A: "Sandcrafter Mage"
  turn 1 A: cast "Sandcrafter Mage"
  run_to turn 1 postcombat_main
  assert counters "Sandcrafter Mage" +1/+1 1
  assert counters "Hill Giant" +1/+1 0
}

scenario "bolster: tied for least, the controller chooses" {
  battlefield A: "Grizzly Bears", 3 "Plains"
  hand A: "Sandcrafter Mage"
  turn 1 A: cast "Sandcrafter Mage"
  turn 1 A: choose "Sandcrafter Mage"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
  assert counters "Sandcrafter Mage" +1/+1 1
}

scenario "bolster: only your own creatures" {
  battlefield A: "Hill Giant", 5 "Forest"
  battlefield B: "Wind Drake", "Grizzly Bears"
  hand A: "Pinion Feast"
  turn 1 A: cast "Pinion Feast" targeting "Wind Drake"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Wind Drake"
  assert counters "Hill Giant" +1/+1 2
  assert counters "Grizzly Bears" +1/+1 0
}

scenario "populate: a copy of a creature token you control" {
  battlefield A: 4 "Plains"
  hand A: "Eyes in the Skies"
  turn 1 A: cast "Eyes in the Skies"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Bird"
  assert has newest A "Bird" flying
}

scenario "populate: the controller chooses which token" {
  battlefield A: 10 "Plains", 5 "Forest"
  hand A: "Eyes in the Skies", "Coursers' Accord", "Wake the Reflections"
  turn 1 A: cast "Eyes in the Skies"
  turn 1 A: wait
  turn 1 A: cast "Coursers' Accord"
  turn 1 A: choose "Bird"
  turn 1 A: wait
  turn 1 A: cast "Wake the Reflections"
  turn 1 A: choose "Centaur"
  run_to turn 1 postcombat_main
  assert battlefield A contains 3 "Bird"
  assert battlefield A contains 2 "Centaur"
}

scenario "populate: no creature token, nothing" {
  battlefield A: 6 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Trostani's Judgment"
  turn 1 A: cast "Trostani's Judgment" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile B contains "Grizzly Bears"
  assert battlefield A count 6
}

scenario "incubate: an Incubator with counters that transforms for {2}" {
  battlefield A: 5 "Island"
  hand A: "Eyes of Gitaxias"
  turn 1 A: cast "Eyes of Gitaxias"
  turn 1 A: activate "Incubator"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Incubator"
  assert is "Phyrexian Token" creature
  assert is "Phyrexian Token" artifact
  assert is "Phyrexian Token" "Phyrexian"
  assert counters "Phyrexian Token" +1/+1 3
  assert power "Phyrexian Token" 3
}

scenario "incubate: untransformed, it is not a creature" {
  battlefield A: 3 "Island"
  hand A: "Eyes of Gitaxias"
  turn 1 A: cast "Eyes of Gitaxias"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Incubator"
  assert is not "Incubator" creature
  assert counters "Incubator" +1/+1 3
  assert hand A count 1
}

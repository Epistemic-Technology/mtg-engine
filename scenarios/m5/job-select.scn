# Job select (CR 702.182): "When this Equipment enters, create a 1/1
# colorless Hero creature token, then attach this Equipment to it."

scenario "job select: a 1/1 Hero, then the Equipment attached to it" {
  battlefield A: 2 "Mountain"
  hand A: "Monk's Fist"
  turn 1 A: cast "Monk's Fist"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Hero"
  assert attached "Monk's Fist" to "Hero"
  # 1/1 plus the Fist's +1/+0, and a Monk in addition to its other types.
  assert power "Hero" 2
  assert toughness "Hero" 1
  assert is "Hero" colorless
  assert is "Hero" Hero
  assert is "Hero" Monk
}

scenario "job select: the Hero stays when the Equipment moves on" {
  battlefield A: 9 "Mountain", "Grizzly Bears"
  hand A: "Warrior's Sword"
  turn 1 A: cast "Warrior's Sword"
  turn 1 A: activate "Warrior's Sword" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Hero"
  assert attached "Warrior's Sword" to "Grizzly Bears"
  assert power "Hero" 1
  assert power "Grizzly Bears" 5
  assert toughness "Grizzly Bears" 4
  assert is "Grizzly Bears" Warrior
  assert is not "Hero" Warrior
}

scenario "job select: the Hero has what the Equipment grants" {
  battlefield A: 3 "Plains"
  hand A: "Paladin's Arms"
  turn 1 A: cast "Paladin's Arms"
  run_to turn 1 postcombat_main
  assert power "Hero" 3
  assert toughness "Hero" 2
  assert is "Hero" Knight
}

scenario "job select: a granted attack trigger on the Hero" {
  battlefield A: 2 "Plains"
  hand A: "White Mage's Staff"
  turn 1 A: cast "White Mage's Staff"
  turn 3 A: attack "Hero"
  run_to turn 3 postcombat_main
  assert life A 21
  assert life B 18
}

scenario "job select: a granted combat damage trigger" {
  battlefield A: 3 "Island"
  hand A: "Thief's Knife"
  library A: 5 "Island"
  turn 1 A: cast "Thief's Knife"
  turn 3 A: attack "Hero"
  run_to turn 3 postcombat_main
  assert life B 18
  # The turn 3 draw and the Knife's trigger.
  assert hand A count 2
}

scenario "job select: a granted cast trigger" {
  battlefield A: 3 "Swamp"
  hand A: "Black Mage's Rod", "Duress"
  library B: 5 "Island"
  turn 1 A: cast "Black Mage's Rod"
  turn 1 A: cast "Duress" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
}

scenario "job select: Red Mage's Rapier pumps on a noncreature spell" {
  battlefield A: 3 "Mountain"
  hand A: "Red Mage's Rapier", "Shock"
  turn 1 A: cast "Red Mage's Rapier"
  turn 1 begin_combat A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert power "Hero" 3
  assert is "Hero" Wizard
}

scenario "job select: Samurai's Katana, trample and haste" {
  battlefield A: 3 "Mountain"
  hand A: "Samurai's Katana"
  turn 1 A: cast "Samurai's Katana"
  turn 1 A: attack "Hero"
  run_to turn 1 postcombat_main
  assert life B 17
  assert is "Hero" Samurai
  assert has "Hero" trample
}

scenario "job select: Dragoon's Lance flies only on its controller's turn" {
  battlefield A: 2 "Plains"
  hand A: "Dragoon's Lance"
  turn 1 A: cast "Dragoon's Lance"
  run_to turn 1 postcombat_main
  assert has "Hero" flying
  assert power "Hero" 2
  run_to turn 2 upkeep
  assert has not "Hero" flying
}

scenario "job select: Machinist's Arsenal counts artifacts" {
  battlefield A: 5 "Plains", "Ornithopter"
  hand A: "Machinist's Arsenal"
  turn 1 A: cast "Machinist's Arsenal"
  run_to turn 1 postcombat_main
  # Two artifacts: the Arsenal and the Ornithopter.
  assert power "Hero" 5
  assert toughness "Hero" 5
  assert is "Hero" Artificer
}

scenario "job select: Sage's Nouliths untaps an attacker" {
  battlefield A: 2 "Island", "Grizzly Bears"
  hand A: "Sage's Nouliths"
  turn 1 A: cast "Sage's Nouliths"
  turn 3 A: attack "Hero", "Grizzly Bears"
  turn 3 declare_attackers A: trigger "Hero" targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert untapped "Grizzly Bears"
  assert tapped "Hero"
}

scenario "job select: Bard's Bow gives reach and +2/+2" {
  battlefield A: 3 "Forest"
  hand A: "Bard's Bow"
  turn 1 A: cast "Bard's Bow"
  run_to turn 1 postcombat_main
  assert power "Hero" 3
  assert toughness "Hero" 3
  assert has "Hero" reach
  assert is "Hero" Bard
}

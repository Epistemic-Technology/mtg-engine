  turn 1 A: cast "Cleansing Nova" mode 2
  run_to turn 1 postcombat_main
  assert graveyard B contains "Ornithopter"
  assert graveyard B contains "Glorious Anthem"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Fated Retribution: destroys all creatures and planeswalkers" {
  battlefield A: 7 "Plains"
  battlefield B: "Grizzly Bears", "Jace Beleren", "Mind Stone"

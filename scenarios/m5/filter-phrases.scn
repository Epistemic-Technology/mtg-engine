scenario "Obliterate: destroys all artifacts, creatures, and lands" {
  battlefield A: 8 "Mountain"
  battlefield B: "Grizzly Bears", "Mind Stone", "Glorious Anthem", "Forest"
  hand A: "Obliterate"
  turn 1 A: cast "Obliterate"
  run_to turn 1 postcombat_main

  battlefield A: 2 "Swamp"
  battlefield B: "Ali Baba", "Grizzly Bears"
  hand A: "Shoot the Sheriff"
  illegal turn 1 A: cast "Shoot the Sheriff" targeting "Ali Baba"
  turn 1 A: cast "Shoot the Sheriff" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}


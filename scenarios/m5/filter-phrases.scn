scenario "Simple: destroys all Auras and Equipment" {
  battlefield A: "Grizzly Bears", "Holy Strength" on "Grizzly Bears", "Bonesplitter", "Glorious Anthem", "Forest", "Plains", "Island"
  hand A: "Pure // Simple"
  turn 1 A: cast "Simple"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Holy Strength"
  assert graveyard A contains "Bonesplitter"
  assert battlefield A contains "Glorious Anthem"
}

scenario "Reduce to Dreams: returns all artifacts and enchantments" {
  battlefield A: 5 "Island"

# ---- subtypes ----

scenario "Blood-Chin Rager: attacking, Warrior creatures you control gain menace" {
  battlefield A: "Blood-Chin Rager", "Grizzly Bears"
  turn 1 A: attack "Blood-Chin Rager"
  run_to turn 1 declare_blockers
  assert has "Blood-Chin Rager" menace
  assert has not "Grizzly Bears" menace
}

scenario "Ezuri, Renegade Leader: Elf creatures you control get +3/+3 and trample" {
  battlefield A: "Ezuri, Renegade Leader", "Llanowar Elves", "Grizzly Bears", 5 "Forest"
  battlefield B: "Llanowar Elves"
  turn 1 A: activate "Ezuri, Renegade Leader" ability 2
  run_to turn 1 postcombat_main
  assert power A "Llanowar Elves" 4
  assert power B "Llanowar Elves" 1
  assert power "Ezuri, Renegade Leader" 5
  assert power "Grizzly Bears" 2
  assert has A "Llanowar Elves" trample
}

scenario "Iizuka the Ruthless: sacrificing a Samurai, Samurai gain double strike" {
  battlefield A: "Iizuka the Ruthless", "Nagao, Bound by Honor", "Grizzly Bears", 3 "Mountain"
  turn 1 A: activate "Iizuka the Ruthless" sacrificing "Nagao, Bound by Honor"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Nagao, Bound by Honor"
  assert has "Iizuka the Ruthless" double_strike
  assert has not "Grizzly Bears" double_strike
}

scenario "Nagao, Bound by Honor: attacking, Samurai creatures you control get +1/+1" {
  battlefield A: "Nagao, Bound by Honor", "Iizuka the Ruthless", "Grizzly Bears"
  turn 1 A: attack "Nagao, Bound by Honor"
  run_to turn 1 declare_blockers
  assert power "Nagao, Bound by Honor" 4
  assert power "Iizuka the Ruthless" 4
  assert power "Grizzly Bears" 2
}

scenario "Hero of Iroas: Aura spells cost {1} less" {
  battlefield A: "Hero of Iroas", "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Pacifism"
  turn 1 A: cast "Pacifism" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Pacifism" to "Grizzly Bears"
}

scenario "Otepec Huntmaster: Dinosaur spells cost {1} less" {
  battlefield A: "Otepec Huntmaster", 4 "Plains"
  hand A: "Armasaur Guide"
  turn 1 A: cast "Armasaur Guide"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Armasaur Guide"
}

scenario "Starnheim Aspirant: Angel spells cost {2} less" {
  battlefield A: "Starnheim Aspirant", 3 "Plains"
  hand A: "Serra Angel"
  turn 1 A: cast "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Serra Angel"
}

scenario "Rattlechains: Spirit spells have flash" {
  battlefield A: "Rattlechains", 4 "Swamp"
  hand A: "Accursed Spirit"
  start turn 1 B precombat_main
  turn 1 end A: cast "Accursed Spirit"
  run_to turn 1 cleanup
  assert battlefield A contains "Accursed Spirit"
}


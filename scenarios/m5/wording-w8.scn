# Cards whose Oracle wording the renderer now prints exactly (eighth
# wave): each scenario checks that the wording means what the card does,
# amounts and targets included.

scenario "Agency Coroner: two cards for a suspected creature, one otherwise" {
  battlefield A: "Agency Coroner", "Repeat Offender", "Grizzly Bears", 9 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Repeat Offender"
  turn 1 A: wait
  turn 1 A: activate "Agency Coroner" sacrificing "Repeat Offender"
  run_to turn 1 begin_combat
  assert hand A count 2
  turn 1 postcombat_main A: activate "Agency Coroner" sacrificing "Grizzly Bears"
  run_to turn 1 end
  assert hand A count 3
}

scenario "Angelic Renewal: the dead creature returns when the enchantment is sacrificed" {
  battlefield A: "Angelic Renewal", "Grizzly Bears", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard A contains "Angelic Renewal"
  assert graveyard A lacks "Grizzly Bears"
}

scenario "Angelic Renewal: declined, the creature stays dead" {
  battlefield A: "Angelic Renewal", "Grizzly Bears", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  turn 1 A: decline "Angelic Renewal"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Angelic Renewal"
}

scenario "Bloodstone Goblin: pumped by a kicked spell, not by an unkicked one" {
  battlefield A: "Bloodstone Goblin", 4 "Mountain"
  hand A: "Goblin Bushwhacker", "Goblin Bushwhacker"
  start turn 1 A precombat_main
  turn 1 A: cast "Goblin Bushwhacker"
  run_to turn 1 begin_combat
  assert toughness "Bloodstone Goblin" 2
  assert has not "Bloodstone Goblin" menace
  turn 1 postcombat_main A: cast "Goblin Bushwhacker" kicked
  run_to turn 1 end
  assert toughness "Bloodstone Goblin" 3
  assert power "Bloodstone Goblin" 4
  assert has "Bloodstone Goblin" menace
}

scenario "Boros Fury-Shield: with {R} spent, the attacker's power is dealt to its controller" {
  battlefield A: "Plains", "Plains", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Boros Fury-Shield"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 declare_attackers A: cast "Boros Fury-Shield" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 20
  assert life B 17
}

scenario "Boros Fury-Shield: without {R}, only the prevention" {
  battlefield A: 3 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Boros Fury-Shield"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 declare_attackers A: cast "Boros Fury-Shield" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 20
  assert life B 20
}

scenario "Carbonize: a creature dealt lethal damage is exiled; a player takes 3" {
  battlefield A: 6 "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Carbonize", "Carbonize"
  start turn 1 A precombat_main
  turn 1 A: cast "Carbonize" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Carbonize" targeting player B
  run_to turn 1 postcombat_main
  assert exile B contains "Grizzly Bears"
  assert graveyard B lacks "Grizzly Bears"
  assert life B 17
}

scenario "Disintegrate: X damage, the creature exiled" {
  battlefield A: 4 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Disintegrate"
  start turn 1 A precombat_main
  turn 1 A: cast "Disintegrate" x 3 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
}

scenario "Collision Course: X counts creatures and Vehicles you control, not lands" {
  battlefield A: "Grizzly Bears", "Smuggler's Copter", 2 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Collision Course"
  start turn 1 A precombat_main
  turn 1 A: cast "Collision Course" mode 1 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert damage "Hill Giant" 2
  assert battlefield B contains "Hill Giant"
}

scenario "Huddle Up: two target players each draw a card" {
  battlefield A: 3 "Island"
  hand A: "Huddle Up"
  start turn 1 A precombat_main
  turn 1 A: cast "Huddle Up" targeting player A, player B
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert hand B count 1
}

scenario "Wizard Mentor: itself and the target creature return to hand" {
  battlefield A: "Wizard Mentor", "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Wizard Mentor" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Wizard Mentor"
  assert hand A contains "Grizzly Bears"
  assert battlefield A contains "Hill Giant"
}

scenario "Festering Newt: without Bogbrew Witch, -1/-1 until end of turn" {
  battlefield A: "Festering Newt", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Festering Newt"
  turn 1 A: trigger "Festering Newt" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 2
  assert toughness "Hill Giant" 2
  run_to turn 2 upkeep
  assert power "Hill Giant" 3
}

scenario "Elvish Healer: 2 prevented on a green creature" {
  battlefield A: "Elvish Healer", "Grizzly Bears", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: activate "Elvish Healer" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
}

scenario "Elvish Healer: 1 prevented on a player" {
  battlefield A: "Elvish Healer", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: activate "Elvish Healer" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
}

scenario "Expel the Unworthy: unkicked, a small creature exiled, its controller gains its mana value" {
  battlefield A: 2 "Plains"
  battlefield B: "Grizzly Bears", "Hill Giant"
  hand A: "Expel the Unworthy"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Expel the Unworthy" targeting "Hill Giant"
  turn 1 A: cast "Expel the Unworthy" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile B contains "Grizzly Bears"
  assert life B 22
}

scenario "Expel the Unworthy: kicked, any creature" {
  battlefield A: 5 "Plains"
  battlefield B: "Grizzly Bears", "Hill Giant"
  hand A: "Expel the Unworthy"
  start turn 1 A precombat_main
  turn 1 A: cast "Expel the Unworthy" kicked targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert battlefield B contains "Grizzly Bears"
  assert life B 24
}

scenario "Glorious Gale: a legendary creature spell countered, the Ring tempts you" {
  battlefield A: 2 "Island"
  battlefield B: "Plains"
  hand A: "Glorious Gale"
  hand B: "Isamaru, Hound of Konda"
  start turn 2 B precombat_main
  turn 2 B: cast "Isamaru, Hound of Konda"
  turn 2 A: cast "Glorious Gale" targeting "Isamaru, Hound of Konda"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Isamaru, Hound of Konda"
  assert tempted A 1
}

scenario "Glorious Gale: a nonlegendary creature spell, no temptation" {
  battlefield A: 2 "Island"
  battlefield B: 2 "Forest"
  hand A: "Glorious Gale"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Glorious Gale" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert tempted A 0
}

scenario "Goblin Anarchomancer: green and red spells cost {1} less, blue ones don't" {
  battlefield A: "Goblin Anarchomancer", "Forest", 3 "Mountain"
  hand A: "Grizzly Bears", "Hill Giant", "Wizard Mentor"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert battlefield A contains "Hill Giant"
}

scenario "Goblin Anarchomancer: a blue spell isn't reduced" {
  battlefield A: "Goblin Anarchomancer", "Island", "Island"
  hand A: "Wizard Mentor"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Wizard Mentor"
  run_to turn 1 postcombat_main
}

scenario "Gorging Vulture: 1 life for each creature card milled" {
  battlefield A: 3 "Swamp"
  hand A: "Gorging Vulture"
  library A: "Grizzly Bears", "Swamp", "Hill Giant", "Shock", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Gorging Vulture"
  run_to turn 1 postcombat_main
  assert life A 22
  assert graveyard A count 4
  assert library A count 1
}

scenario "Howl of the Hunt: a Wolf is untapped, a Bear isn't" {
  battlefield A: "Arlinn's Wolf" tapped, "Grizzly Bears" tapped, 6 "Forest"
  hand A: "Howl of the Hunt", "Howl of the Hunt"
  start turn 1 A precombat_main
  turn 1 A: cast "Howl of the Hunt" targeting "Arlinn's Wolf"
  turn 1 A: wait
  turn 1 A: cast "Howl of the Hunt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert untapped "Arlinn's Wolf"
  assert tapped "Grizzly Bears"
  assert power "Arlinn's Wolf" 5
  assert has "Grizzly Bears" vigilance
}

scenario "Khalni Heart Expedition: three quest counters, two basic lands onto the battlefield tapped" {
  battlefield A: "Khalni Heart Expedition" with 2 quest
  hand A: "Forest"
  library A: "Forest", "Island", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: play "Forest"
  turn 1 postcombat_main A: activate "Khalni Heart Expedition"
  run_to turn 1 end
  assert graveyard A contains "Khalni Heart Expedition"
  assert battlefield A contains 2 "Forest"
  assert battlefield A contains "Island"
  assert tapped "Island"
}

scenario "Lethargy Trap: {U} with three attackers, each gets -3/-0" {
  battlefield A: "Island"
  battlefield B: "Hill Giant", "Grizzly Bears", "Arlinn's Wolf"
  hand A: "Lethargy Trap"
  start turn 2 B
  turn 2 B: attack "Hill Giant", "Grizzly Bears", "Arlinn's Wolf"
  turn 2 declare_attackers A: cast "Lethargy Trap" alternative
  run_to turn 2 postcombat_main
  assert life A 20
}

scenario "Lethargy Trap: two attackers, the alternative cost can't be paid" {
  battlefield A: "Island"
  battlefield B: "Hill Giant", "Grizzly Bears"
  hand A: "Lethargy Trap"
  start turn 2 B
  turn 2 B: attack "Hill Giant", "Grizzly Bears"
  illegal turn 2 declare_attackers A: cast "Lethargy Trap" alternative
  run_to turn 2 postcombat_main
  assert life A 15
}

scenario "Mental Modulation: {U} during your turn, tap and draw" {
  battlefield A: "Island"
  battlefield B: "Hill Giant"
  hand A: "Mental Modulation"
  start turn 1 A precombat_main
  turn 1 A: cast "Mental Modulation" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert tapped "Hill Giant"
  assert hand A count 1
}

scenario "Mental Modulation: full cost on another player's turn" {
  battlefield A: "Island"
  battlefield B: "Hill Giant"
  hand A: "Mental Modulation"
  start turn 2 B precombat_main
  illegal turn 2 A: cast "Mental Modulation" targeting "Hill Giant"
  run_to turn 2 postcombat_main
}

scenario "Outmuscle: adamant keeps the creature you control alive" {
  battlefield A: "Grizzly Bears", 4 "Forest"
  battlefield B: "Hill Giant"
  hand A: "Outmuscle"
  start turn 1 A precombat_main
  turn 1 A: cast "Outmuscle" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 1
  assert graveyard B contains "Hill Giant"
}

scenario "Outmuscle: without three green, both die" {
  battlefield A: "Grizzly Bears", "Forest", 3 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Outmuscle"
  start turn 1 A precombat_main
  turn 1 A: cast "Outmuscle" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
}

scenario "Power Plant Worker: +2/+2 once each turn" {
  battlefield A: "Power Plant Worker", 6 "Plains"

scenario "Soldevi Adnate: an artifact creature's mana value in {B}" {
  battlefield A: "Soldevi Adnate", "Tower Worker"
  hand A: "Gorging Vulture"
  library A: "Plains", "Plains", "Plains", "Plains", "Plains"

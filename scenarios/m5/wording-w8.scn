}

scenario "Stronghold Discipline: each player loses life for their own creatures" {
  battlefield A: "Grizzly Bears", 4 "Swamp"
  battlefield B: "Hill Giant", "Grizzly Bears", "Arlinn's Wolf"
  hand A: "Stronghold Discipline"
  start turn 1 A precombat_main
  turn 1 A: cast "Stronghold Discipline"
  run_to turn 1 postcombat_main

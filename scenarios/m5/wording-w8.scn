}

scenario "Thraben Charm: any number of target players' graveyards exiled" {
  battlefield A: 2 "Plains"
  graveyard A: "Shock"
  graveyard B: "Hill Giant", "Grizzly Bears"
  hand A: "Thraben Charm"
  start turn 1 A precombat_main
  turn 1 A: cast "Thraben Charm" mode 3 targeting player A, player B
  run_to turn 1 postcombat_main
  assert graveyard B count 0
  assert exile A contains "Shock"
  assert exile B contains "Hill Giant"
}

scenario "Unnatural Aggression: the opponent's creature is exiled if it would die" {
  battlefield A: "Hill Giant", 3 "Forest"

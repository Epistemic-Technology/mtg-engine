scenario "Nature's Panoply: a counter on each chosen creature, strive paid for the second" {
  battlefield A: "Grizzly Bears", "Hill Giant", "Arlinn's Wolf", 4 "Forest"
  hand A: "Nature's Panoply"
  start turn 1 A precombat_main
  turn 1 A: cast "Nature's Panoply" targeting "Grizzly Bears", "Hill Giant"

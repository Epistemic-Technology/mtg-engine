// Riders on how a source's mana is spent (CR 106.6): "When that mana is
// spent to cast ...". Payment doesn't
// activate a rider's mana ability on its own, so each is activated first.

scenario "Pyromancer's Goggles copies the red instant its mana is spent on" {
  battlefield A: "Pyromancer's Goggles"
  hand A: "Shock"
  turn 1 A: activate "Pyromancer's Goggles"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 end
  assert life B 16
}

scenario "Pyromancer's Goggles' mana spent on a creature spell copies nothing" {
  battlefield A: "Pyromancer's Goggles", "Mountain"
  hand A: "Dragon Hatchling"
  turn 1 A: activate "Pyromancer's Goggles"
  turn 1 A: cast "Dragon Hatchling"
  run_to turn 1 end
  assert battlefield A contains 1 "Dragon Hatchling"
}

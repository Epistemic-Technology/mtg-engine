# One scenario per card added with the new counts and costs that the
# feature scenarios don't already exercise.

scenario "Rowdy Research costs {1} less for each creature that attacked" {
  battlefield A: 4 "Island", "Grizzly Bears", "Hill Giant", "Llanowar Elves"
  hand A: "Rowdy Research"
  turn 1 A: attack "Grizzly Bears", "Hill Giant", "Llanowar Elves"
  turn 1 postcombat_main A: cast "Rowdy Research"
  run_to turn 1 end
  assert hand A count 3
}

scenario "The Lord of the Eagles counts only creatures with flying" {
  battlefield A: 4 "Island", "Serra Angel", "Craw Wurm"
  hand A: "The Lord of the Eagles"
  # {7}{U}{U} less 4 (Serra Angel): {3}{U}{U}, one land short.
  illegal turn 1 A: cast "The Lord of the Eagles"
  run_to turn 1 postcombat_main
  assert hand A contains "The Lord of the Eagles"
}

scenario "The Lord of the Eagles costs {X} less for flying power" {
  battlefield A: 5 "Island", "Serra Angel"
  hand A: "The Lord of the Eagles"
  turn 1 A: cast "The Lord of the Eagles"
  run_to turn 1 postcombat_main
  assert battlefield A contains "The Lord of the Eagles"
}

scenario "Glen Elendra Guardian counters a noncreature spell; its controller draws" {
  battlefield A: "Glen Elendra Guardian" with 1 -1/-1, 2 "Island"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 A: activate "Glen Elendra Guardian" targeting "Shock"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Shock"
  assert hand B count 1
  assert counters "Glen Elendra Guardian" -1/-1 0
}

scenario "Burdened Stoneback makes a creature indestructible" {
  battlefield A: "Burdened Stoneback" with 2 -1/-1, 2 "Plains", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 A: activate "Burdened Stoneback" targeting "Grizzly Bears"
  turn 1 postcombat_main B: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 end
  assert battlefield A contains "Grizzly Bears"
  assert counters "Burdened Stoneback" -1/-1 1
}

scenario "Hovel Hurler gives another creature +1/+0 and flying" {
  battlefield A: "Hovel Hurler" with 2 -1/-1, 2 "Mountain", "Grizzly Bears"
  turn 1 A: activate "Hovel Hurler" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 3
  assert has "Grizzly Bears" flying
}

scenario "Hovel Hurler can't target itself" {
  battlefield A: "Hovel Hurler" with 2 -1/-1, 2 "Mountain"
  illegal turn 1 A: activate "Hovel Hurler" targeting "Hovel Hurler"
  run_to turn 1 postcombat_main
  assert counters "Hovel Hurler" -1/-1 2
}

scenario "Gnarlbark Elm removes two counters to give -2/-2" {
  battlefield A: "Gnarlbark Elm" with 2 -1/-1, 3 "Swamp"
  battlefield B: "Grizzly Bears"
  turn 1 A: activate "Gnarlbark Elm" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert counters "Gnarlbark Elm" -1/-1 0
}

scenario "Gnarlbark Elm with one counter can't activate" {
  battlefield A: "Gnarlbark Elm" with 1 -1/-1, 3 "Swamp"
  battlefield B: "Grizzly Bears"
  illegal turn 1 A: activate "Gnarlbark Elm" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

scenario "Reaping Willow returns a small creature card" {
  battlefield A: "Reaping Willow" with 2 -1/-1, 2 "Plains"
  graveyard A: "Grizzly Bears"
  turn 1 A: activate "Reaping Willow" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

scenario "Pride Sovereign exerts for two Cats and grows" {
  battlefield A: "Pride Sovereign", "Plains"
  turn 1 A: activate "Pride Sovereign"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Cat"
  assert power "Pride Sovereign" 4
  run_to turn 3 upkeep
  assert tapped "Pride Sovereign"
}

scenario "Hope Tender exerts to untap two lands" {
  battlefield A: "Hope Tender", "Forest" tapped, "Island" tapped, "Plains"
  turn 1 A: activate "Hope Tender" ability 2 targeting "Forest", "Island"
  run_to turn 1 postcombat_main
  assert untapped "Forest"
  assert untapped "Island"
  run_to turn 3 upkeep
  assert tapped "Hope Tender"
}

scenario "Nightmare Lash: equip for 3 life" {
  battlefield A: "Nightmare Lash", "Grizzly Bears", 2 "Swamp"
  turn 1 A: activate "Nightmare Lash" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 17
  assert power "Grizzly Bears" 4
}

scenario "Piston Sledge: equip by sacrificing an artifact" {
  battlefield A: "Piston Sledge", "Grizzly Bears", "Ornithopter"
  turn 1 A: activate "Piston Sledge" sacrificing "Ornithopter" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Piston Sledge" to "Grizzly Bears"
  assert graveyard A contains "Ornithopter"
}

scenario "Inventor's Axe: equip for two energy" {
  battlefield A: "Mountain", "Grizzly Bears", "Hill Giant"
  hand A: "Inventor's Axe"
  turn 1 A: cast "Inventor's Axe"
  turn 1 A: trigger "Inventor's Axe" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: activate "Inventor's Axe" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert attached "Inventor's Axe" to "Hill Giant"
  assert energy A 0
}

scenario "Sigil of Distinction: equip by removing a charge counter" {
  battlefield A: "Sigil of Distinction" with 3 charge, "Grizzly Bears"
  turn 1 A: activate "Sigil of Distinction" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Sigil of Distinction" to "Grizzly Bears"
  assert power "Grizzly Bears" 4
}

scenario "Dissection Tools: equip by sacrificing a creature" {
  battlefield A: "Dissection Tools", "Grizzly Bears", "Llanowar Elves"
  turn 1 A: activate "Dissection Tools" sacrificing "Llanowar Elves" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Dissection Tools" to "Grizzly Bears"
  assert has "Grizzly Bears" deathtouch
  assert has "Grizzly Bears" lifelink
}

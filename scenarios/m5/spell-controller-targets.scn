# A target spell by its controller: "target spell you don't control"
# (Counterflux, Hullbreaker Horror) and "target spell an opponent
# controls" (Hope-Ender Coatl), CR 115.1, 110.2.

scenario "spell you don't control: Counterflux counters an opponent's spell" {
  battlefield A: 2 "Forest"
  battlefield B: 2 "Island", "Mountain"
  hand A: "Grizzly Bears"
  hand B: "Counterflux"
  turn 1 A: cast "Grizzly Bears"
  turn 1 B: cast "Counterflux" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
}

scenario "spell you don't control: Counterflux can't target its caster's own spell" {
  battlefield A: 2 "Island", "Mountain", "Forest"
  hand A: "Counterflux", "Shock"
  turn 1 A: cast "Shock" targeting player B
  illegal turn 1 A: cast "Counterflux" targeting "Shock" in response to "Shock"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "spell you don't control: overloaded Counterflux counters each spell you don't control" {
  battlefield A: 3 "Island", "Mountain", "Mountain"
  battlefield B: 2 "Mountain"
  hand A: "Counterflux", "Shock"
  hand B: "Shock", "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 B: cast "Lightning Bolt" targeting player A in response to "Shock"
  turn 2 A: cast "Shock" targeting player B in response to "Lightning Bolt"
  turn 2 A: cast "Counterflux" overloaded in response to "Shock"
  run_to turn 2 postcombat_main
  assert life A 20
  assert life B 18
  assert graveyard B contains "Lightning Bolt"
}

scenario "spell an opponent controls: Hope-Ender Coatl counters it unless they pay {1}" {
  battlefield A: 3 "Island"
  battlefield B: "Mountain"
  hand A: "Hope-Ender Coatl"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 A: cast "Hope-Ender Coatl" in response to "Shock"
  turn 2 A: trigger "Hope-Ender Coatl" targeting "Shock"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Shock"
  assert battlefield A contains "Hope-Ender Coatl"
}

scenario "spell an opponent controls: Hope-Ender Coatl's target resolves when they pay" {
  battlefield A: 3 "Island"
  battlefield B: 2 "Mountain"
  hand A: "Hope-Ender Coatl"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 A: cast "Hope-Ender Coatl" in response to "Shock"
  turn 2 A: trigger "Hope-Ender Coatl" targeting "Shock"
  run_to turn 2 postcombat_main
  assert life A 18
}

scenario "spell an opponent controls: Hope-Ender Coatl can't target its caster's own spell" {
  battlefield A: 3 "Island", "Mountain"
  hand A: "Hope-Ender Coatl", "Shock"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: cast "Hope-Ender Coatl" in response to "Shock"
  # Its only spell is its controller's own: the trigger has no target
  # and is removed (CR 603.3d).
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "spell you don't control: Hullbreaker Horror returns an opponent's spell" {
  battlefield A: "Hullbreaker Horror", "Mountain"
  battlefield B: "Mountain"
  hand A: "Shock"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: cast "Shock" targeting player B in response to "Lightning Bolt"
  turn 2 A: trigger "Hullbreaker Horror" mode 1 targeting "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert hand B contains "Lightning Bolt"
  assert life A 20
  assert life B 18
}

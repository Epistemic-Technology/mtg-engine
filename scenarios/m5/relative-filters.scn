# Filters that compare with something else (relative-filters13).

scenario "Break Under Pressure: the greatest mana value among creatures and planeswalkers" {
  battlefield A: 3 "Swamp"
  battlefield B: "Grizzly Bears", "Jace Beleren", "Hill Giant"
  hand A: "Break Under Pressure"
  start turn 1 A precombat_main
  turn 1 A: cast "Break Under Pressure" targeting player B
  run_to turn 1 postcombat_main
  # Jace (3) and Hill Giant (4): only the Giant can be chosen.
  assert graveyard B contains "Hill Giant"
  assert battlefield B contains "Jace Beleren"
  assert battlefield B contains "Grizzly Bears"
  assert life A 22
}

scenario "Break Under Pressure: a planeswalker with the greatest mana value" {
  battlefield A: 3 "Swamp"
  battlefield B: "Grizzly Bears", "Garruk Wildspeaker"
  hand A: "Break Under Pressure"
  start turn 1 A precombat_main
  turn 1 A: cast "Break Under Pressure" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Garruk Wildspeaker"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Consumed by Greed: the greatest power" {
  battlefield A: 3 "Swamp"
  battlefield B: "Serra Angel", "Grizzly Bears", "Craw Wurm"
  hand A: "Consumed by Greed"
  start turn 1 A precombat_main
  turn 1 A: cast "Consumed by Greed" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Craw Wurm"
  assert battlefield B contains "Serra Angel"
}

scenario "Consumed by Greed: power as it is now, not as printed" {
  battlefield A: 3 "Swamp"
  battlefield B: "Grizzly Bears", "Serra Angel" with 2 -1/-1, "Phantom Warrior" with 1 +1/+1
  hand A: "Consumed by Greed"
  start turn 1 A precombat_main
  turn 1 A: cast "Consumed by Greed" targeting player B
  run_to turn 1 postcombat_main
  # Phantom Warrior 3/3 beats a 2/2 Angel.
  assert graveyard B contains "Phantom Warrior"
  assert battlefield B contains "Serra Angel"
}

scenario "Consumed by Greed: two tied, the opponent picks" {
  battlefield A: 3 "Swamp"
  battlefield B: "Hill Giant", "Grizzly Bears", "Serra Angel" with 1 -1/-1
  hand A: "Consumed by Greed"
  start turn 1 A precombat_main
  turn 1 A: cast "Consumed by Greed" targeting player B
  run_to turn 1 postcombat_main
  # The first of the tied 3/3s, taken by default.
  assert graveyard B contains "Hill Giant"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Consumed by Greed: two tied, the opponent chooses either" {
  battlefield A: 3 "Swamp"
  battlefield B: "Hill Giant", "Grizzly Bears", "Serra Angel" with 1 -1/-1
  hand A: "Consumed by Greed"
  start turn 1 A precombat_main
  turn 1 A: cast "Consumed by Greed" targeting player B
  turn 1 B: choose "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert battlefield B contains "Hill Giant"
}

scenario "Consumed by Greed: the gift returns a creature card" {
  battlefield A: 3 "Swamp"
  battlefield B: "Grizzly Bears"
  graveyard A: "Hill Giant"
  hand A: "Consumed by Greed"
  start turn 1 A precombat_main
  turn 1 A: cast "Consumed by Greed" gift targeting player B, "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert hand A contains "Hill Giant"
  assert hand B count 1
}

scenario "End of the Hunt exiles the greatest mana value" {
  battlefield A: 2 "Swamp"
  battlefield B: "Craw Wurm", "Jace Beleren", "Grizzly Bears"
  hand A: "End of the Hunt"
  start turn 1 A precombat_main
  turn 1 A: cast "End of the Hunt" targeting player B
  run_to turn 1 postcombat_main
  assert exile B contains "Craw Wurm"
  assert battlefield B contains "Jace Beleren"
}

scenario "Extract a Confession: with evidence, the greatest power" {
  battlefield A: 2 "Swamp"
  graveyard A: "Craw Wurm"
  battlefield B: "Grizzly Bears", "Hill Giant"
  hand A: "Extract a Confession"
  start turn 1 A precombat_main
  turn 1 A: cast "Extract a Confession" kicked
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield B contains "Grizzly Bears"
  assert exile A contains "Craw Wurm"
}

scenario "Extract a Confession: without evidence, any creature" {
  battlefield A: 2 "Swamp"
  battlefield B: "Grizzly Bears", "Hill Giant"
  hand A: "Extract a Confession"
  start turn 1 A precombat_main
  turn 1 A: cast "Extract a Confession"
  turn 1 B: choose "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert battlefield B contains "Hill Giant"
}

scenario "Transit Mage finds an artifact with mana value 4 or 5" {
  battlefield A: 3 "Island"
  hand A: "Transit Mage"
  library A: "Steel Overseer", "Solemn Simulacrum", "Batterskull"
  start turn 1 A precombat_main
  turn 1 A: cast "Transit Mage"
  turn 1 A: choose "Batterskull"
  run_to turn 1 postcombat_main
  assert hand A contains "Batterskull"
  assert library A contains "Steel Overseer"
}

scenario "Transit Mage: mana value 3 isn't 4 or 5" {
  battlefield A: 3 "Island"
  hand A: "Transit Mage"
  library A: "Steel Overseer", "Mind Stone"
  start turn 1 A precombat_main
  turn 1 A: cast "Transit Mage"
  run_to turn 1 postcombat_main
  assert hand A count 0
}

scenario "Meek Attack puts a small creature onto the battlefield, sacrificed at end of turn" {
  battlefield A: 2 "Mountain", "Meek Attack"
  hand A: "Hill Giant", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Meek Attack"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert life B 18
  assert hand A contains "Hill Giant"
  run_to turn 2 upkeep
  assert graveyard A contains "Grizzly Bears"
}

scenario "Origin of the Avengers: a Hero with mana value 3 or less" {
  battlefield A: "Origin of the Avengers" with 1 lore
  hand A: "Valkyrior Skyrider", "Agent of Atlas"
  start turn 3 A upkeep
  run_to turn 3 postcombat_main
  assert battlefield A contains "Agent of Atlas"
  assert hand A contains "Valkyrior Skyrider"
  assert hand A count 2
}

scenario "Origin of the Avengers: none put, draw a card" {
  battlefield A: "Origin of the Avengers" with 1 lore
  hand A: "Valkyrior Skyrider"
  start turn 3 A upkeep
  run_to turn 3 postcombat_main
  assert hand A count 3
}

scenario "Mind into Matter: X 2 puts a permanent card with mana value 2 or less" {
  battlefield A: 2 "Forest", 2 "Island"
  hand A: "Mind into Matter", "Hill Giant", "Mind Stone"
  library A: "Island", "Island", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Mind into Matter" x 2
  run_to turn 1 postcombat_main
  assert battlefield A contains "Mind Stone"
  assert tapped "Mind Stone"
  assert hand A contains "Hill Giant"
  assert hand A count 3
}

scenario "Secret Tunnel: two creatures that share a creature type can't be blocked" {
  battlefield A: "Secret Tunnel", 4 "Forest", "Grizzly Bears", "Runeclaw Bear"
  battlefield B: "Wall of Stone"
  start turn 2 A precombat_main
  turn 2 A: activate "Secret Tunnel" ability 2 targeting "Grizzly Bears", "Runeclaw Bear"
  turn 2 A: attack "Grizzly Bears", "Runeclaw Bear"
  illegal turn 2 B: block "Grizzly Bears" with "Wall of Stone"
  run_to turn 2 postcombat_main
  assert life B 16
}

scenario "Secret Tunnel: creatures that share no creature type aren't a legal pair" {
  battlefield A: "Secret Tunnel", 4 "Forest", "Grizzly Bears", "Llanowar Elves"
  start turn 2 A precombat_main
  illegal turn 2 A: activate "Secret Tunnel" ability 2 targeting "Grizzly Bears", "Llanowar Elves"
  run_to turn 2 postcombat_main
}

scenario "Spider-Man, To the Rescue: tap him, another nonattacking creature gains indestructible" {
  battlefield A: 3 "Forest", "Grizzly Bears"
  hand A: "Spider-Man, To the Rescue", "Lightning Bolt"
  battlefield A: "Mountain"
  start turn 2 A precombat_main
  turn 2 A: cast "Spider-Man, To the Rescue"
  turn 2 A: trigger "Spider-Man, To the Rescue" targeting "Grizzly Bears"
  turn 2 A: wait
  turn 2 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert tapped "Spider-Man, To the Rescue"
  assert battlefield A contains "Grizzly Bears"
  assert has "Grizzly Bears" indestructible
}

scenario "Spider-Man, To the Rescue: an attacking creature isn't a legal target" {
  battlefield A: 3 "Forest", "Grizzly Bears"
  hand A: "Spider-Man, To the Rescue"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  turn 2 declare_attackers A: cast "Spider-Man, To the Rescue"
  illegal turn 2 declare_attackers A: trigger "Spider-Man, To the Rescue" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert has not "Grizzly Bears" indestructible
}

scenario "Kindred Judgment destroys every creature not of the chosen type" {
  battlefield A: 7 "Plains", "Grizzly Bears", "Llanowar Elves"
  battlefield B: "Runeclaw Bear", "Hill Giant"
  hand A: "Kindred Judgment"
  start turn 1 A precombat_main
  turn 1 A: cast "Kindred Judgment"
  turn 1 A: choose Bear
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert battlefield B contains "Runeclaw Bear"
  assert graveyard A contains "Llanowar Elves"
  assert graveyard B contains "Hill Giant"
}

scenario "Prehistoric Pet can't be blocked by creatures with greater power" {
  battlefield A: "Prehistoric Pet"
  battlefield B: "Grizzly Bears", "Llanowar Elves"
  start turn 2 A precombat_main
  turn 2 A: attack "Prehistoric Pet"
  illegal turn 2 B: block "Prehistoric Pet" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 19
}

scenario "Prehistoric Pet can be blocked by a creature with equal power" {
  battlefield A: "Prehistoric Pet"
  battlefield B: "Llanowar Elves"
  start turn 2 A precombat_main
  turn 2 A: attack "Prehistoric Pet"
  turn 2 B: block "Prehistoric Pet" with "Llanowar Elves"
  run_to turn 2 postcombat_main
  assert life B 20
  assert graveyard B contains "Llanowar Elves"
}

scenario "Prehistoric Pet returns another creature only during your turn" {
  battlefield A: "Prehistoric Pet", "Grizzly Bears", 2 "Plains"
  start turn 2 B precombat_main
  illegal turn 2 precombat_main A: activate "Prehistoric Pet" targeting "Grizzly Bears"
  turn 3 A: activate "Prehistoric Pet" targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert hand A contains "Grizzly Bears"
}

scenario "Clement, the Worrywort returns a creature with lesser mana value than the one entering" {
  battlefield A: "Clement, the Worrywort", "Grizzly Bears", 4 "Mountain"
  hand A: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: cast "Hill Giant"
  illegal turn 2 A: trigger "Clement, the Worrywort" targeting "Hill Giant"
  turn 2 A: trigger "Clement, the Worrywort" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert battlefield A contains "Hill Giant"
}

scenario "Clement, the Worrywort: nothing has lesser mana value than a 1-drop" {
  battlefield A: "Clement, the Worrywort", "Grizzly Bears", "Forest"
  hand A: "Llanowar Elves"
  start turn 2 A precombat_main
  turn 2 A: cast "Llanowar Elves"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert battlefield A contains "Llanowar Elves"
}

scenario "Clement, the Worrywort: Frogs tap for mana for creature spells" {
  battlefield A: "Clement, the Worrywort", "Forest"
  hand A: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: activate "Clement, the Worrywort"
  turn 2 A: choose green
  turn 2 A: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert tapped "Clement, the Worrywort"
}

scenario "Jackdaw Savior returns a creature card with lesser mana value" {
  battlefield A: "Jackdaw Savior", "Mountain"
  graveyard A: "Serra Angel", "Grizzly Bears"
  hand A: "Lightning Bolt"
  start turn 2 A precombat_main
  turn 2 A: cast "Lightning Bolt" targeting "Jackdaw Savior"
  illegal turn 2 A: trigger "Jackdaw Savior" targeting "Serra Angel"
  turn 2 A: trigger "Jackdaw Savior" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard A contains "Serra Angel"
  assert graveyard A contains "Jackdaw Savior"
}

scenario "Pawpatch Recruit: a counter on another creature, not the one targeted" {
  battlefield A: "Pawpatch Recruit", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  illegal turn 2 A: trigger "Pawpatch Recruit" targeting "Grizzly Bears"
  turn 2 A: trigger "Pawpatch Recruit" targeting "Pawpatch Recruit"
  run_to turn 2 postcombat_main
  assert counters "Pawpatch Recruit" +1/+1 1
  assert graveyard A contains "Grizzly Bears"
}

scenario "The Apprentice's Folly copies only a creature no token you control shares a name with" {
  battlefield A: 2 "Island", 2 "Mountain", "Grizzly Bears", "Hill Giant"
  hand A: "The Apprentice's Folly"
  start turn 1 A precombat_main
  turn 1 A: cast "The Apprentice's Folly"
  turn 1 A: trigger "The Apprentice's Folly" targeting "Grizzly Bears"
  run_to turn 2 upkeep
  assert battlefield A contains 2 "Grizzly Bears"
  assert is newest A "Grizzly Bears" Reflection
  assert has newest A "Grizzly Bears" haste
  illegal turn 3 A: trigger "The Apprentice's Folly" targeting oldest "Grizzly Bears"
  turn 3 A: trigger "The Apprentice's Folly" targeting "Hill Giant"
  run_to turn 4 upkeep
  assert battlefield A contains 2 "Hill Giant"
  assert battlefield A contains 2 "Grizzly Bears"
  run_to turn 5 postcombat_main
  # III: the Reflections are sacrificed.
  assert battlefield A contains 1 "Grizzly Bears"
  assert battlefield A contains 1 "Hill Giant"
}

scenario "Ajani Unrelenting: damage to each creature except for tokens you control" {
  battlefield A: "Ajani Unrelenting", "Cadet", "Grizzly Bears"
  battlefield B: "Cadet", "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: activate "Ajani Unrelenting" ability 3
  run_to turn 2 postcombat_main
  # The loyalty trigger's Cadet resolves first and is spared too.
  assert battlefield A contains 2 "Cadet"
  assert graveyard A contains "Grizzly Bears"
  assert battlefield B lacks "Cadet"
  assert graveyard B contains "Hill Giant"
  assert counters "Ajani Unrelenting" loyalty 2
}

scenario "Nervous Gardener finds a land card with a basic land type" {
  battlefield A: 4 "Forest"
  hand A: "Nervous Gardener"
  library A: "Mishra's Factory", "Hill Giant", "Forest"
  start turn 2 A precombat_main
  turn 2 A: cast "Nervous Gardener" face_down
  turn 2 A: unmorph "Nervous Gardener"
  run_to turn 2 postcombat_main
  assert hand A contains "Forest"
  assert library A contains "Mishra's Factory"
}

scenario "Nervous Gardener: a land with no basic land type isn't found" {
  battlefield A: 4 "Forest"
  hand A: "Nervous Gardener"
  library A: "Mishra's Factory", "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: cast "Nervous Gardener" face_down
  turn 2 A: unmorph "Nervous Gardener"
  run_to turn 2 postcombat_main
  assert hand A count 0
}

scenario "Anticausal Vestige: a permanent card with mana value up to the lands you control" {
  battlefield A: 4 "Island"
  hand A: "Anticausal Vestige", "Craw Wurm", "Hill Giant"
  library A: "Island", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Anticausal Vestige" warped
  run_to turn 2 upkeep
  # Exiled at the end step: draw, then Hill Giant (4) but not Craw Wurm (6).
  assert exile A contains "Anticausal Vestige"
  assert battlefield A contains "Hill Giant"
  assert tapped "Hill Giant"
  assert hand A contains "Craw Wurm"
  assert hand A count 2
}

scenario "Kinscaer Sentry: mana value up to the number of attacking creatures" {
  battlefield A: "Kinscaer Sentry", "Grizzly Bears"
  hand A: "Hill Giant", "Llanowar Elves"
  start turn 2 A precombat_main
  turn 2 A: attack "Kinscaer Sentry", "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Llanowar Elves"
  assert hand A contains "Hill Giant"
  assert life B 15
  assert life A 22
}

scenario "Kinscaer Sentry attacking alone: mana value 1 or less" {
  battlefield A: "Kinscaer Sentry"
  hand A: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Kinscaer Sentry"
  run_to turn 2 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert life B 18
}

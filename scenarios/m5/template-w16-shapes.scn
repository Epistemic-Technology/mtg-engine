scenario "Heroes of the Revel: a Satyr that can't block; a spell targeting it pumps the team" {
  battlefield A: 5 "Mountain", "Forest"
  hand A: "Heroes of the Revel", "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Heroes of the Revel"
  turn 1 A: wait
  turn 1 A: cast "Giant Growth" targeting "Heroes of the Revel"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Satyr"
  assert power "Satyr" 2
  assert power "Heroes of the Revel" 8
  battlefield B: "Grizzly Bears"
  turn 2 B: attack "Grizzly Bears"
  illegal turn 2 A: block "Grizzly Bears" with "Satyr"
  run_to turn 2 postcombat_main
  assert life A 18
}


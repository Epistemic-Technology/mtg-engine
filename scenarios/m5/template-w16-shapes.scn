scenario "Synod Centurion: sacrificed once you control no other artifacts" {
  battlefield A: "Synod Centurion", "Ornithopter", 2 "Forest"
  hand A: "Naturalize"
  start turn 1 A precombat_main
  turn 1 A: cast "Naturalize" targeting "Ornithopter"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Synod Centurion"
}

scenario "Synod Centurion: another artifact keeps it" {
  battlefield A: "Synod Centurion", "Ornithopter", "Darksteel Relic", 2 "Forest"
  hand A: "Naturalize"
  start turn 1 A precombat_main
  turn 1 A: cast "Naturalize" targeting "Ornithopter"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Synod Centurion"
}

scenario "Terra Eternal: all lands have indestructible" {
  battlefield A: "Terra Eternal", 3 "Mountain"
  battlefield B: "Forest"
  hand A: "Stone Rain"
  start turn 1 A precombat_main
  turn 1 A: cast "Stone Rain" targeting "Forest"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Forest"
  assert has "Forest" indestructible
}

scenario "Tolarian Kraken: pay {1} on a draw to tap a creature" {
  battlefield A: "Tolarian Kraken", "Island"
  battlefield B: "Grizzly Bears"
  start turn 3 A upkeep
  turn 3 draw A: accept "Tolarian Kraken"
  turn 3 draw A: trigger "Tolarian Kraken" targeting "Grizzly Bears"
  run_to turn 3 precombat_main
  assert tapped "Grizzly Bears"
  assert tapped "Island"
}

scenario "Treacherous Blessing: draw three, lose 1 life a spell, sacrificed when targeted" {
  battlefield A: 3 "Swamp", "Mountain", 2 "Island"
  hand A: "Treacherous Blessing", "Shock", "Boomerang"
  start turn 1 A precombat_main
  turn 1 A: cast "Treacherous Blessing"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Boomerang" targeting "Treacherous Blessing"
  run_to turn 1 postcombat_main
  assert life A 18
  assert life B 18
  assert graveyard A contains "Treacherous Blessing"
  assert hand A count 3
}

scenario "Vat of Rebirth: oil for another creature dying; four oil returns a creature card" {
  battlefield A: "Vat of Rebirth" with 3 oil, "Grizzly Bears", 4 "Swamp", "Mountain"
  graveyard A: "Hill Giant"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: activate "Vat of Rebirth" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert counters "Vat of Rebirth" oil 0
}

scenario "Wolfwillow Haven: the enchanted land's controller adds an additional {G}" {
  battlefield A: 2 "Forest"
  battlefield B: "Forest"
  hand A: "Wolfwillow Haven"
  hand B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Wolfwillow Haven" targeting B "Forest"
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

scenario "Wolfwillow Haven: sacrificed for a Wolf, only during your turn" {
  battlefield A: 5 "Forest", "Wolfwillow Haven" on "Forest"
  start turn 2 B precombat_main
  illegal turn 2 A: activate "Wolfwillow Haven"
  turn 3 A: activate "Wolfwillow Haven"
  run_to turn 3 postcombat_main
  assert battlefield A contains "Wolf"
}

scenario "Zurgo Bellstriker: it can't block power 2 or greater" {
  battlefield A: "Zurgo Bellstriker"
  battlefield B: "Grizzly Bears", "Memnite"
  start turn 2 B precombat_main
  turn 2 B: attack "Grizzly Bears", "Memnite"
  illegal turn 2 A: block "Grizzly Bears" with "Zurgo Bellstriker"
  turn 2 A: block "Memnite" with "Zurgo Bellstriker"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Memnite"
  assert life A 18
}

scenario "Shocker: 2 damage to a creature and 2 to its controller; first strike on your turn" {
  battlefield A: 6 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Shocker, Unshakable"
  start turn 1 A precombat_main
  turn 1 A: cast "Shocker, Unshakable"
  turn 1 A: trigger "Shocker, Unshakable" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert damage "Hill Giant" 2
  assert life B 18
  assert has "Shocker, Unshakable" first_strike
  run_to turn 2 upkeep
  assert has not "Shocker, Unshakable" first_strike
}

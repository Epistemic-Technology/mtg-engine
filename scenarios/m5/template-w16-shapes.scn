  start turn 1 A precombat_main
  turn 1 A: cast "Steal Artifact" targeting "Darksteel Relic"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Darksteel Relic"
}

scenario "Banshee's Blade: a charge counter for combat damage, +1/+1 for each" {
  battlefield A: "Banshee's Blade", "Grizzly Bears", 2 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Banshee's Blade" targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert counters "Banshee's Blade" charge 1
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 3
}

scenario "Malefic Scythe: a soul counter as it enters and for each equipped creature that dies" {
  battlefield A: 2 "Swamp", "Plains", "Mountain", "Grizzly Bears"
  hand A: "Malefic Scythe", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Malefic Scythe"
  turn 1 A: activate "Malefic Scythe" targeting "Grizzly Bears"
  run_to turn 1 combat_damage
  assert counters "Malefic Scythe" soul 1
  assert power "Grizzly Bears" 3
  turn 1 postcombat_main A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 end
  assert graveyard A contains "Grizzly Bears"
  assert counters "Malefic Scythe" soul 2
}


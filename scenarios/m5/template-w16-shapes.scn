scenario "Dark Knight's Greatsword: job select, then equip for 3 life once each turn" {
  battlefield A: 3 "Swamp", "Grizzly Bears"
  hand A: "Dark Knight's Greatsword"
  start turn 1 A precombat_main
  turn 1 A: cast "Dark Knight's Greatsword"
  run_to turn 1 begin_combat
  assert power "Hero" 4
  assert is "Hero" Knight
  turn 1 postcombat_main A: activate "Dark Knight's Greatsword" targeting "Grizzly Bears"
  turn 1 postcombat_main A: wait
  illegal turn 1 postcombat_main A: activate "Dark Knight's Greatsword" targeting "Hero"
  run_to turn 1 end
  assert life A 17
  assert power "Grizzly Bears" 5
  assert is "Grizzly Bears" Knight
  assert power "Hero" 1
}

scenario "Death's Shadow: -X/-X where X is your life total" {
  life A 10
  battlefield A: "Death's Shadow", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  assert power "Death's Shadow" 3
  turn 1 A: cast "Shock" targeting player A
  run_to turn 1 postcombat_main
  assert power "Death's Shadow" 5
  assert toughness "Death's Shadow" 5
}

scenario "Death's Shadow: at 13 life it dies" {

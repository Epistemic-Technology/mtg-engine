}

scenario "Inferno Titan: 3 damage divided as it enters and as it attacks; firebreathing" {
  battlefield A: 7 "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Inferno Titan"
  start turn 1 A precombat_main
  turn 1 A: cast "Inferno Titan"
  turn 1 A: trigger "Inferno Titan" targeting "Grizzly Bears", player B dividing 2, 1
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life B 19
  turn 3 A: activate "Inferno Titan"
  turn 3 A: attack "Inferno Titan"
  turn 3 declare_attackers A: trigger "Inferno Titan" targeting player B
  run_to turn 3 postcombat_main
  assert life B 9
}

scenario "Mogg Mob: sacrificed, 3 damage divided" {
  battlefield A: "Mogg Mob"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Mogg Mob" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard A contains "Mogg Mob"
  assert battlefield B contains "Grizzly Bears"
  assert life B 17
}

scenario "Ceremonial Groundbreaker: equip Citizen {1} only onto a Citizen" {
  battlefield A: "Ceremonial Groundbreaker", "Backup Agent", "Grizzly Bears", "Plains"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Ceremonial Groundbreaker" ability 1 targeting "Grizzly Bears"
  turn 1 A: activate "Ceremonial Groundbreaker" ability 1 targeting "Backup Agent"
  run_to turn 1 postcombat_main
  assert attached "Ceremonial Groundbreaker" to "Backup Agent"
  assert power "Backup Agent" 3
  assert toughness "Backup Agent" 2
  assert has "Backup Agent" trample
}

scenario "Steelclaw Lance: equip Knight {1}, equip {3}" {
  battlefield A: "Steelclaw Lance", "Zhalfirin Knight", "Grizzly Bears", 3 "Plains"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Steelclaw Lance" ability 1 targeting "Grizzly Bears"
  turn 1 A: activate "Steelclaw Lance" ability 2 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
}


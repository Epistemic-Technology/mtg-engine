# Cards the template author writes from the corpus line index once it
# substitutes colors, card types, subtypes and counter kinds one to one,
# reads a labeled line an accepted card prints bare, and takes a corpus
# spell's sentence as an ability's effect.

scenario "Angel of Salvation: a 5-damage shield on a creature" {
  battlefield A: 8 "Plains", "Mountain", "Grizzly Bears"
  hand A: "Angel of Salvation", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Angel of Salvation"
  turn 1 A: trigger "Angel of Salvation" targeting "Grizzly Bears" dividing 5
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 0
}

scenario "Angelic Captain: +1/+1 for each other attacking Ally" {
  battlefield A: "Angelic Captain", "Zulaport Cutthroat", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Angelic Captain", "Zulaport Cutthroat", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Angelic Captain" 5
  assert toughness "Angelic Captain" 4
  assert life B 12
}

scenario "Dire Fleet Captain: +1/+1 for each other attacking Pirate" {
  battlefield A: "Dire Fleet Captain", "Storm Fleet Spy", "Siren Lookout", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Dire Fleet Captain", "Storm Fleet Spy", "Siren Lookout"
  run_to turn 1 postcombat_main
  assert power "Dire Fleet Captain" 4
  assert life B 13
}

scenario "Rimehorn Aurochs: +1/+0 for each other attacking Aurochs" {
  battlefield A: 2 "Rimehorn Aurochs"
  start turn 1 A precombat_main
  turn 1 A: attack "Rimehorn Aurochs", "Rimehorn Aurochs"
  run_to turn 1 postcombat_main
  assert life B 12
}

scenario "Rimehorn Aurochs: a creature must block the chosen attacker" {
  battlefield A: "Rimehorn Aurochs", "Craw Wurm", 3 "Snow-Covered Forest"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Rimehorn Aurochs" targeting "Grizzly Bears", "Rimehorn Aurochs"
  turn 1 A: attack "Rimehorn Aurochs", "Craw Wurm"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life B 14
}

scenario "Annex: you control the enchanted land" {
  battlefield A: 4 "Island"
  battlefield B: "Forest"
  hand A: "Annex"
  start turn 1 A precombat_main
  turn 1 A: cast "Annex" targeting "Forest"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Forest"
  assert battlefield B lacks "Forest"
}

scenario "Steal Artifact: you control the enchanted artifact" {

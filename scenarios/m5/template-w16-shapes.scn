scenario "Dragonlord Ojutai: hexproof while untapped; a dig on combat damage" {
  battlefield A: "Dragonlord Ojutai"
  battlefield B: 2 "Mountain"
  hand B: "Shock", "Lightning Bolt"
  library A: "Island", "Forest", "Plains", "Swamp"
  start turn 1 A precombat_main
  illegal turn 1 B: cast "Shock" targeting "Dragonlord Ojutai"
  turn 1 A: attack "Dragonlord Ojutai"
  turn 1 declare_blockers B: cast "Shock" targeting "Dragonlord Ojutai"
  run_to turn 1 postcombat_main
  assert life B 15
  assert hand A count 1
  assert damage "Dragonlord Ojutai" 2
}


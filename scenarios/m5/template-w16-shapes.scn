  start turn 1 A precombat_main
  turn 1 A: cast "Bogardan Hellkite"
  turn 1 A: trigger "Bogardan Hellkite" targeting "Grizzly Bears", player B dividing 2, 3
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life B 17
}

scenario "Gang of Devils: 3 damage divided as it dies" {
  battlefield A: "Gang of Devils", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Gang of Devils"
  turn 1 A: trigger "Gang of Devils" targeting "Grizzly Bears", player B dividing 2, 1
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"

# Token-creation replacement effects (CR 614.1a, 111.1) apply to every
# token maker, not only `create`: amass, fabricate, populate, incubate.
# New forms: "instead create those tokens plus an additional Map token"
# (artifact tokens), "that many 5/5 red Dragon creature tokens with flying
# are created instead", "those tokens plus a Clue token".

scenario "token replacements: Parallel Lives doubles fabricate's Servos" {
  battlefield A: "Parallel Lives", 3 "Plains"
  hand A: "Glint-Sleeve Artisan"
  turn 1 A: cast "Glint-Sleeve Artisan"
  turn 1 A: decline "Glint-Sleeve Artisan"
  run_to turn 1 end
  assert battlefield A contains 2 "Servo"
  assert counters "Glint-Sleeve Artisan" +1/+1 0
}

scenario "token replacements: Parallel Lives doubles amass's Army, one gets the counters" {
  battlefield A: "Parallel Lives", "Mountain"
  hand A: "Tidings of War"
  turn 1 A: cast "Tidings of War"
  run_to turn 1 end
  assert battlefield A contains 1 "Goblin Army"
}

scenario "token replacements: Parallel Lives doubles a populated token" {
  battlefield A: "Parallel Lives", 2 "Forest", "Plains"
  hand A: "Sprout", "Wake the Reflections"
  turn 1 A: cast "Sprout"
  turn 1 A: wait
  turn 1 A: cast "Wake the Reflections"
  run_to turn 1 end
  assert battlefield A contains 4 "Saproling"
}

scenario "token replacements: Parallel Lives doubles incubate's Incubator" {
  battlefield A: "Parallel Lives", "Injector Crocodile", 3 "Swamp"
  hand A: "Murder"
  turn 1 A: cast "Murder" targeting "Injector Crocodile"
  run_to turn 1 end
  assert battlefield A contains 2 "Incubator"
  assert counters oldest "Incubator" +1/+1 3
  assert counters newest "Incubator" +1/+1 3
}

scenario "token replacements: Worldwalker Helm adds a Map to an artifact token" {
  battlefield A: "Worldwalker Helm", 3 "Plains"
  hand A: "Glint-Sleeve Artisan"
  turn 1 A: cast "Glint-Sleeve Artisan"
  turn 1 A: decline "Glint-Sleeve Artisan"
  run_to turn 1 end
  assert battlefield A contains 1 "Servo"
  assert battlefield A contains 1 "Map"
}

scenario "token replacements: Worldwalker Helm ignores creature tokens that aren't artifacts" {
  battlefield A: "Worldwalker Helm", "Forest"
  hand A: "Sprout"
  turn 1 A: cast "Sprout"
  run_to turn 1 end
  assert battlefield A contains 1 "Saproling"
  assert battlefield A lacks "Map"
}

scenario "token replacements: Worldwalker Helm copies an artifact token, with a Map" {
  battlefield A: "Worldwalker Helm", 3 "Plains", 2 "Island"
  hand A: "Glint-Sleeve Artisan"
  turn 1 A: cast "Glint-Sleeve Artisan"
  turn 1 A: decline "Glint-Sleeve Artisan"
  turn 1 postcombat_main A: activate "Worldwalker Helm" targeting "Servo"
  run_to turn 1 end
  assert battlefield A contains 2 "Servo"
  assert battlefield A contains 2 "Map"
}

scenario "token replacements: Draconic Visitor turns Servos into Dragons" {
  battlefield A: "Draconic Visitor", 3 "Plains"
  hand A: "Glint-Sleeve Artisan"
  turn 1 A: cast "Glint-Sleeve Artisan"
  turn 1 A: decline "Glint-Sleeve Artisan"
  run_to turn 1 end
  assert battlefield A lacks "Servo"
  assert battlefield A contains 1 "Dragon"
  assert has "Dragon" flying
  assert power "Dragon" 5
}

scenario "token replacements: Draconic Visitor leaves nonartifact tokens alone" {
  battlefield A: "Draconic Visitor", "Forest"
  hand A: "Sprout"
  turn 1 A: cast "Sprout"
  run_to turn 1 end
  assert battlefield A contains 1 "Saproling"
  assert battlefield A lacks "Dragon"
}

scenario "token replacements: an unsolved Case of the Pilfered Proof adds no Clue" {
  battlefield A: "Case of the Pilfered Proof", "Forest"
  hand A: "Sprout"
  turn 1 A: cast "Sprout"
  run_to turn 1 end
  assert battlefield A contains 1 "Saproling"
  assert battlefield A lacks "Clue"
}

scenario "token replacements: Case of the Pilfered Proof's counter on an entering Detective" {
  battlefield A: "Case of the Pilfered Proof", 2 "Plains"
  hand A: "Seasoned Consultant"
  turn 1 A: cast "Seasoned Consultant"
  run_to turn 1 end
  assert counters "Seasoned Consultant" +1/+1 1
}

scenario "token replacements: solved, Case of the Pilfered Proof adds a Clue to each creation" {
  battlefield A: "Case of the Pilfered Proof", 3 "Seasoned Consultant", "Forest"
  hand A: "Sprout"
  run_to turn 3 precombat_main
  turn 3 A: cast "Sprout"
  run_to turn 3 end
  assert battlefield A contains 1 "Saproling"
  assert battlefield A contains 1 "Clue"
}

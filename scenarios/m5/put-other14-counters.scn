# "Until end of turn, if you would put one or more +1/+1 counters on a
# creature you control, put that many plus one +1/+1 counters on it
# instead." (Prairie Dog, put-other14).

scenario "Prairie Dog: the end-step counter becomes two, then one the next time" {
  battlefield A: "Prairie Dog", 5 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Prairie Dog"
  run_to turn 2 upkeep
  assert counters "Prairie Dog" +1/+1 2
  run_to turn 4 upkeep
  assert counters "Prairie Dog" +1/+1 3
}

scenario "Prairie Dog: no counter after a spell cast from hand" {
  battlefield A: "Prairie Dog", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting player B
  run_to turn 2 upkeep
  assert counters "Prairie Dog" +1/+1 0
}

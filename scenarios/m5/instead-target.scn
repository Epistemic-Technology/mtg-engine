# "If ..., instead <effect> target ..." with the condition's own target:
# only the targets of the version cast are chosen (CR 601.2c), one here.

scenario "Long River's Pull without the gift counters a creature spell" {
  battlefield A: 2 "Island"
  battlefield B: 2 "Forest"
  hand A: "Long River's Pull"
  hand B: "Grizzly Bears"
  start turn 1 B precombat_main
  turn 1 B: cast "Grizzly Bears"
  turn 1 A: cast "Long River's Pull" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert hand B count 0
}

scenario "Long River's Pull with the gift counters any spell, and they draw" {
  battlefield A: 2 "Island"
  battlefield B: "Mountain"
  hand A: "Long River's Pull"
  hand B: "Lightning Bolt"
  library B: 3 "Forest"
  start turn 1 B precombat_main
  turn 1 B: cast "Lightning Bolt" targeting player A
  turn 1 A: cast "Long River's Pull" gift targeting "Lightning Bolt" in response to "Lightning Bolt"
  run_to turn 1 postcombat_main
  assert life A 20
  assert graveyard B contains "Lightning Bolt"
  assert hand B contains "Forest"
}

scenario "Cruel Alliance exiles a small creature" {
  battlefield A: 3 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Cruel Alliance"
  start turn 1 A precombat_main
  turn 1 A: cast "Cruel Alliance" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile B contains "Grizzly Bears"
  assert life A 20
}

scenario "Cruel Alliance without teamwork can't exile a big creature" {
  battlefield A: 3 "Swamp"
  battlefield B: "Serra Angel"
  hand A: "Cruel Alliance"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Cruel Alliance" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Serra Angel"
}

scenario "Cruel Alliance with teamwork exiles any creature and gains 3 life" {
  battlefield A: 3 "Swamp", "Hill Giant"
  battlefield B: "Serra Angel"
  hand A: "Cruel Alliance"
  start turn 1 A precombat_main
  turn 1 A: cast "Cruel Alliance" teamwork targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert exile B contains "Serra Angel"
  assert life A 23
  assert tapped "Hill Giant"
}

scenario "Cruel Alliance without teamwork, creatures to tap available" {
  battlefield A: 3 "Swamp", "Hill Giant"
  battlefield B: "Grizzly Bears"
  hand A: "Cruel Alliance"
  start turn 1 A precombat_main
  turn 1 A: cast "Cruel Alliance" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile B contains "Grizzly Bears"
  assert untapped "Hill Giant"
  assert life A 20
}

# "You may pay any amount of {E}" (CR 107.14): the amount is chosen as
# the spell resolves, from 0 to the player's energy; "that much" after it
# is the amount paid.

scenario "Galvanic Discharge: three energy paid, three damage" {
  battlefield A: "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Galvanic Discharge"
  turn 1 A: cast "Galvanic Discharge" targeting "Hill Giant"
  run_to turn 1 end
  assert graveyard B contains "Hill Giant"
  assert energy A 0
}

scenario "Galvanic Discharge: energy from before adds to the damage" {
  energy A: 2
  battlefield A: "Mountain"
  battlefield B: "Serra Angel"
  hand A: "Galvanic Discharge"
  turn 1 A: cast "Galvanic Discharge" targeting "Serra Angel"
  run_to turn 1 end
  assert graveyard B contains "Serra Angel"
  assert energy A 0
}

scenario "Galvanic Discharge: paying two keeps one energy" {
  battlefield A: "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Galvanic Discharge"
  turn 1 A: cast "Galvanic Discharge" targeting "Hill Giant"
  turn 1 A: choose "2"
  run_to turn 1 end
  assert damage "Hill Giant" 2
  assert energy A 1
}

scenario "Aether Spike: the spell is countered unless its controller pays {1} for each {E} paid" {
  battlefield A: 2 "Forest"
  battlefield B: 2 "Island"
  hand A: "Grizzly Bears"
  hand B: "Aether Spike"
  turn 1 A: cast "Grizzly Bears"
  turn 1 B: cast "Aether Spike" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 1 end
  assert graveyard A contains "Grizzly Bears"
  assert energy B 0
}

scenario "Aether Spike: paid for, the spell resolves" {
  battlefield A: 4 "Forest"
  battlefield B: 2 "Island"
  hand A: "Grizzly Bears"
  hand B: "Aether Spike"
  turn 1 A: cast "Grizzly Bears"
  turn 1 B: cast "Aether Spike" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 1 end
  assert battlefield A contains "Grizzly Bears"
  assert tapped newest "Forest"
}

scenario "Aether Spike: paying no energy leaves nothing to pay" {
  battlefield A: 2 "Forest"
  battlefield B: 2 "Island"
  hand A: "Grizzly Bears"
  hand B: "Aether Spike"
  turn 1 A: cast "Grizzly Bears"
  turn 1 B: cast "Aether Spike" targeting "Grizzly Bears" in response to "Grizzly Bears"
  turn 1 B: choose "0"
  run_to turn 1 end
  assert battlefield A contains "Grizzly Bears"
  assert energy B 2
}

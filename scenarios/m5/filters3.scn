# Filter words and counts: historic (CR 700.6), devotion and chroma (CR
# 700.5), nonsnow, modified, outlaw, party, and counts of cards named ~.

scenario "historic: an artifact spell triggers Cabal Paladin" {
  battlefield A: "Cabal Paladin", "Mountain"
  hand A: "Silent Dart"
  turn 1 A: cast "Silent Dart"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "historic: a legendary spell triggers, a plain creature spell doesn't" {
  battlefield A: "Cabal Paladin", 5 "Mountain", 2 "Forest"
  hand A: "Zhao, the Seething Flame", "Grizzly Bears"
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Zhao, the Seething Flame"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert battlefield A contains "Zhao, the Seething Flame"
  assert life B 18
}

scenario "historic: Serra Disciple grows on an artifact creature spell" {
  battlefield A: "Serra Disciple"
  hand A: "Ornithopter"
  turn 1 A: cast "Ornithopter"
  run_to turn 1 postcombat_main
  assert power "Serra Disciple" 2
  assert toughness "Serra Disciple" 2
}

scenario "devotion: Aspect of Hydra counts green symbols, hybrid included" {
  battlefield A: "Nylea's Disciple", "Selesnya Guildmage", "Grizzly Bears", "Forest"
  hand A: "Aspect of Hydra"
  turn 1 A: cast "Aspect of Hydra" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  # {2}{G}{G} + {G/W}{G/W} + {1}{G}: devotion to green 5.
  assert power "Grizzly Bears" 7
  assert toughness "Grizzly Bears" 7
}

scenario "devotion: an opponent's permanents don't count" {
  battlefield A: "Grizzly Bears", "Forest"
  battlefield B: "Nylea's Disciple"
  hand A: "Aspect of Hydra"
  turn 1 A: cast "Aspect of Hydra" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 3
}

scenario "devotion: Gray Merchant drains by its own and other black symbols" {
  battlefield A: "Typhoid Rats", 5 "Swamp"
  hand A: "Gray Merchant of Asphodel"
  turn 1 A: cast "Gray Merchant of Asphodel"
  run_to turn 1 postcombat_main
  assert life B 17
  assert life A 23
}

scenario "devotion: Daybreak Chimera costs {X} less" {
  battlefield A: 3 "Soul Warden", 2 "Plains"
  hand A: "Daybreak Chimera"
  turn 1 A: cast "Daybreak Chimera"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Daybreak Chimera"
}

scenario "devotion: without enough devotion Daybreak Chimera can't be cast" {
  battlefield A: 2 "Soul Warden", 2 "Plains"
  hand A: "Daybreak Chimera"
  illegal turn 1 A: cast "Daybreak Chimera"
  run_to turn 1 postcombat_main
}

scenario "chroma: Heartlash Cinder counts red symbols among your permanents" {
  battlefield A: "Typhoid Rats", 2 "Mountain"
  hand A: "Heartlash Cinder"
  turn 1 A: cast "Heartlash Cinder"
  run_to turn 1 postcombat_main
  assert power "Heartlash Cinder" 2
  assert toughness "Heartlash Cinder" 1
}

scenario "nonsnow: Chill to the Bone can't target a snow creature" {
  battlefield A: 4 "Swamp"
  battlefield B: "Squall Drifter", "Grizzly Bears"
  hand A: "Chill to the Bone"
  illegal turn 1 A: cast "Chill to the Bone" targeting "Squall Drifter"
  run_to turn 1 postcombat_main
}

scenario "nonsnow: Chill to the Bone destroys a nonsnow creature" {
  battlefield A: 4 "Swamp"
  battlefield B: "Squall Drifter", "Grizzly Bears"
  hand A: "Chill to the Bone"
  turn 1 A: cast "Chill to the Bone" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "named ~: Growth Cycle grows with copies in your graveyard" {
  battlefield A: "Grizzly Bears", 2 "Forest"
  graveyard A: 2 "Growth Cycle"
  graveyard B: "Growth Cycle"
  hand A: "Growth Cycle"
  turn 1 A: cast "Growth Cycle" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 9
  assert toughness "Grizzly Bears" 9
}

scenario "named ~: Rune Snag's price grows with copies in each graveyard" {
  battlefield A: 2 "Island"
  battlefield B: 4 "Forest"
  graveyard B: "Rune Snag"
  hand A: "Rune Snag"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Rune Snag" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "named ~: with no copies Rune Snag asks only {2}" {
  battlefield A: 2 "Island"
  battlefield B: 4 "Forest"
  hand A: "Rune Snag"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Rune Snag" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

scenario "named ~: Pack Mastiff pumps each creature you control named Pack Mastiff" {
  battlefield A: 2 "Pack Mastiff", "Grizzly Bears", 2 "Mountain"
  turn 1 A: activate "Pack Mastiff"
  run_to turn 1 postcombat_main
  assert power oldest "Pack Mastiff" 3
  assert power newest "Pack Mastiff" 3
  assert power "Grizzly Bears" 2
}

scenario "modified: Akki Ember-Keeper sees a modified creature die" {
  battlefield A: "Akki Ember-Keeper", "Grizzly Bears" with 1 +1/+1, "Mountain"
  hand A: "Lightning Bolt"
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Spirit"
}

scenario "modified: an unmodified creature dying makes no Spirit" {
  battlefield A: "Akki Ember-Keeper", "Grizzly Bears", "Mountain"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A lacks "Spirit"
}

scenario "outlaw: Mine Raider makes a Treasure beside a Rogue" {
  battlefield A: "Zulaport Duelist", 3 "Mountain"
  hand A: "Mine Raider"
  turn 1 A: cast "Mine Raider"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Treasure"
}

scenario "outlaw: Mine Raider alone makes nothing" {
  battlefield A: 3 "Mountain"
  hand A: "Mine Raider"
  turn 1 A: cast "Mine Raider"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Treasure"
}

scenario "party: Shepherd of Heroes counts itself and a Rogue" {
  battlefield A: "Zulaport Duelist", 5 "Plains"
  hand A: "Shepherd of Heroes"
  turn 1 A: cast "Shepherd of Heroes"
  run_to turn 1 postcombat_main
  assert life A 24
}

scenario "sum: Hobbit's Sting counts creatures plus Foods" {
  battlefield A: "Grizzly Bears", "Food", 2 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Hobbit's Sting"
  turn 1 A: cast "Hobbit's Sting" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert damage "Hill Giant" 2
}

scenario "sum: Slash of Light counts creatures plus Equipment" {
  battlefield A: "Grizzly Bears", "Wall of Wood", 2 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Slash of Light"
  turn 1 A: cast "Slash of Light" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert damage "Hill Giant" 2
}

scenario "greatest mana value: Torrent of Fire" {
  battlefield A: "Craw Wurm", 5 "Mountain"
  hand A: "Torrent of Fire"
  turn 1 A: cast "Torrent of Fire" targeting player B
  run_to turn 1 postcombat_main
  assert life B 14
}

scenario "formidable: Sabertooth Outrider gains first strike with total power 8" {
  battlefield A: "Sabertooth Outrider", "Craw Wurm"
  start turn 2 A
  turn 2 A: attack "Sabertooth Outrider", "Craw Wurm"
  run_to turn 2 declare_blockers
  assert has "Sabertooth Outrider" first_strike
}

scenario "formidable: alone it doesn't" {
  battlefield A: "Sabertooth Outrider"
  start turn 2 A
  turn 2 A: attack "Sabertooth Outrider"
  run_to turn 2 declare_blockers
  assert has not "Sabertooth Outrider" first_strike
}

scenario "domain: Artillery Blast deals 1 plus basic land types" {
  battlefield A: "Plains", "Mountain"
  battlefield B: "Hill Giant" tapped
  hand A: "Artillery Blast"
  turn 1 A: cast "Artillery Blast" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

scenario "domain: Exploding Borders counts the land it fetched" {
  battlefield A: "Mountain", "Forest", "Island", "Plains"
  library A: "Swamp", "Plains"
  hand A: "Exploding Borders"
  turn 1 A: cast "Exploding Borders" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Swamp"
  assert life B 15
}

scenario "count with defender: Doorkeeper mills by defenders" {
  battlefield A: "Doorkeeper", "Wall of Wood", 3 "Island"
  turn 1 A: activate "Doorkeeper" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B count 2
}



scenario "dealt damage this turn: Wall of Resistance grows at the end step" {
  battlefield A: "Wall of Resistance", "Mountain"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting "Wall of Resistance"
  run_to turn 2 upkeep
  assert counters "Wall of Resistance" +0/+1 1
  assert toughness "Wall of Resistance" 4
}

scenario "dealt damage this turn: an undamaged Wall of Resistance doesn't" {
  battlefield A: "Wall of Resistance"
  run_to turn 2 upkeep
  assert counters "Wall of Resistance" +0/+1 0
}

scenario "Balduvian Rage pumps an attacker by X and draws next upkeep" {
  battlefield A: "Grizzly Bears", 4 "Mountain"
  hand A: "Balduvian Rage"
  start turn 2 A
  turn 2 A: attack "Grizzly Bears"
  turn 2 declare_attackers A: cast "Balduvian Rage" x 3 targeting "Grizzly Bears"
  run_to turn 3 draw
  assert life B 15
  assert hand A count 2
}

scenario "Gossamer Chains returns itself to stop an unblocked creature's damage" {
  battlefield A: "Gossamer Chains"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 declare_blockers A: activate "Gossamer Chains" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 20
  assert hand A contains "Gossamer Chains"
}

scenario "non-Warrior: Icewind Stalwart blinks a creature that isn't a Warrior" {
  battlefield A: "Grizzly Bears" with 1 +1/+1, "Sabertooth Outrider", 4 "Plains"
  hand A: "Icewind Stalwart"
  turn 1 A: cast "Icewind Stalwart"
  turn 1 A: trigger "Icewind Stalwart" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
}

scenario "non-Warrior: Icewind Stalwart can't blink a Warrior" {
  battlefield A: "Sabertooth Outrider" with 1 +1/+1, 4 "Plains"
  hand A: "Icewind Stalwart"
  turn 1 A: cast "Icewind Stalwart"
  run_to turn 1 postcombat_main
  assert counters "Sabertooth Outrider" +1/+1 1
}

scenario "look at the top X: Information Dealer counts Wizards" {
  battlefield A: "Information Dealer"
  turn 1 A: activate "Information Dealer"
  run_to turn 1 postcombat_main
  assert tapped "Information Dealer"
}

scenario "spell mastery: Kytheon's Tactics also gives vigilance" {
  battlefield A: "Grizzly Bears", 3 "Plains"
  graveyard A: 2 "Shock"
  hand A: "Kytheon's Tactics"
  turn 1 A: cast "Kytheon's Tactics"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert has "Grizzly Bears" vigilance
}

scenario "spell mastery: one instant isn't enough" {
  battlefield A: "Grizzly Bears", 3 "Plains"
  graveyard A: "Shock"
  hand A: "Kytheon's Tactics"
  turn 1 A: cast "Kytheon's Tactics"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert has not "Grizzly Bears" vigilance
}

scenario "spell mastery: Send to Sleep keeps the creatures tapped" {
  battlefield A: 2 "Island"
  battlefield B: "Grizzly Bears", "Hill Giant"
  graveyard A: 2 "Shock"
  hand A: "Send to Sleep"
  turn 1 A: cast "Send to Sleep" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 2 precombat_main
  assert tapped "Grizzly Bears"
  assert tapped "Hill Giant"
}

scenario "spell mastery: without it they untap" {
  battlefield A: 2 "Island"
  battlefield B: "Grizzly Bears"
  hand A: "Send to Sleep"
  turn 1 A: cast "Send to Sleep" targeting "Grizzly Bears"
  run_to turn 2 precombat_main
  assert untapped "Grizzly Bears"
}

scenario "threshold: Far Wanderings fetches three basic lands instead" {
  battlefield A: "Forest", 2 "Plains"
  graveyard A: 7 "Shock"
  library A: 4 "Forest"
  hand A: "Far Wanderings"
  turn 1 A: cast "Far Wanderings"
  run_to turn 1 postcombat_main
  assert battlefield A contains 4 "Forest"
}

scenario "threshold: without it Far Wanderings fetches one" {
  battlefield A: "Forest", 2 "Plains"
  library A: 4 "Forest"
  hand A: "Far Wanderings"
  turn 1 A: cast "Far Wanderings"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Forest"
}

scenario "kicked: Tribute to Urborg counts instants and sorceries in your graveyard" {
  battlefield A: 2 "Swamp", 2 "Island"
  battlefield B: "Craw Wurm"
  graveyard A: 2 "Shock"
  hand A: "Tribute to Urborg"
  turn 1 A: cast "Tribute to Urborg" kicked targeting "Craw Wurm"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Craw Wurm"
}

scenario "unkicked: Tribute to Urborg gives only -2/-2" {
  battlefield A: 2 "Swamp"
  battlefield B: "Craw Wurm"
  graveyard A: 2 "Shock"
  hand A: "Tribute to Urborg"
  turn 1 A: cast "Tribute to Urborg" targeting "Craw Wurm"
  run_to turn 1 postcombat_main
  assert toughness "Craw Wurm" 2
}

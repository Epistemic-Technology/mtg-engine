scenario "Levitating Statue: a noncreature spell adds a counter; {2} animates it" {
  battlefield A: "Levitating Statue", 3 "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait

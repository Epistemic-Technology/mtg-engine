  run_to turn 1 postcombat_main
  assert life B 15
  assert hand A contains "Forest"
}

scenario "Unchecked Growth: +4/+4, and trample only for a Spirit" {
  battlefield A: "Grizzly Bears", "Hunted Phantasm", 6 "Forest"
  hand A: "Unchecked Growth", "Unchecked Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Unchecked Growth" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Unchecked Growth" targeting "Hunted Phantasm"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 6
  assert has not "Grizzly Bears" trample
  assert power "Hunted Phantasm" 8
  assert has "Hunted Phantasm" trample
}

scenario "Vulshok War Boar: sacrificing an artifact keeps it" {
  battlefield A: 4 "Mountain", "Ornithopter"
  hand A: "Vulshok War Boar"
  start turn 1 A precombat_main
  turn 1 A: cast "Vulshok War Boar"
  turn 1 A: accept "Vulshok War Boar"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Vulshok War Boar"
  assert graveyard A contains "Ornithopter"
}

scenario "Vulshok War Boar: without an artifact it is sacrificed" {
  battlefield A: 4 "Mountain"
  hand A: "Vulshok War Boar"
  start turn 1 A precombat_main
  turn 1 A: cast "Vulshok War Boar"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Vulshok War Boar"
}

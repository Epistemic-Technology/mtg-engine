}

scenario "Headless Rider: a token Zombie dying doesn't" {
  battlefield A: "Headless Rider", "Zombie"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 1 A precombat_main
  turn 1 end B: cast "Shock" targeting "Zombie"
  run_to turn 2 upkeep
  assert battlefield A lacks "Zombie"
}

scenario "Headless Rider: itself dying makes a Zombie" {
  battlefield A: "Headless Rider"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 1 A precombat_main
  turn 1 end B: cast "Shock" targeting "Headless Rider"
  run_to turn 2 upkeep
  assert battlefield A contains "Zombie"
  assert power "Zombie" 2
}


scenario "Kenrith's Transformation: a vanilla green 3/3 Elk; draws a card" {
  battlefield A: 2 "Forest"
  battlefield B: "Serra Angel"
  hand A: "Kenrith's Transformation"
  library A: "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Kenrith's Transformation" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert power "Serra Angel" 3
  assert toughness "Serra Angel" 3
  assert has not "Serra Angel" flying
  assert is "Serra Angel" Elk
  assert is not "Serra Angel" Angel
  assert is "Serra Angel" green
  assert is not "Serra Angel" white
  assert hand A contains "Island"
}


# Cards the corpus line index wrote once it substituted P/T changes,
# articles, players, keywords, "equipped"/"enchanted", draw/discard/mill
# and trigger events, matched words and amounts together, and tried each
# candidate statement against the line (seventeenth wave).

scenario "Akki Raider: +1/+0 when any land dies" {
  battlefield A: "Akki Raider", 3 "Mountain"
  battlefield B: "Plains"
  hand A: "Stone Rain"
  start turn 1 A precombat_main
  turn 1 A: cast "Stone Rain" targeting "Plains"
  run_to turn 1 postcombat_main
  assert power "Akki Raider" 3
  run_to turn 2 upkeep
  assert power "Akki Raider" 2
}

scenario "Alpha Authority: hexproof, and one blocker at most" {
  battlefield A: "Grizzly Bears", "Alpha Authority" on "Grizzly Bears"
  battlefield B: "Hill Giant", "Wall of Wood", "Mountain"
  hand B: "Shock"
  illegal turn 1 precombat_main B: cast "Shock" targeting "Grizzly Bears"
  turn 1 declare_attackers A: attack "Grizzly Bears"
  turn 1 declare_blockers B: block "Grizzly Bears" with "Wall of Wood"
  illegal turn 1 declare_blockers B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert has "Grizzly Bears" hexproof
}

scenario "Altar of Shadows: destroy, then a charge counter; {B} for each at the first main phase" {
  battlefield A: "Altar of Shadows", 7 "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Mind Rot"
  start turn 1 A precombat_main
  turn 1 A: activate "Altar of Shadows" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert counters "Altar of Shadows" charge 1
}

scenario "Altar of Shadows: the charge counters' mana casts a spell" {
  battlefield A: "Altar of Shadows" with 3 charge
  hand A: "Mind Rot"
  hand B: "Forest", "Island"
  start turn 3 A upkeep
  turn 3 precombat_main A: cast "Mind Rot" targeting player B
  run_to turn 3 postcombat_main
  assert hand B count 0
}

scenario "Angrath's Ambusher: +2/+0 only with an Angrath planeswalker" {
  battlefield A: "Angrath's Ambusher"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Angrath's Ambusher" 2
}

scenario "Court Cleric: +1/+1 with an Ajani planeswalker" {
  battlefield A: "Court Cleric", "Ajani Goldmane"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Court Cleric" 2
  assert toughness "Court Cleric" 2
}

scenario "Court Cleric: no Ajani, no bonus" {
  battlefield A: "Court Cleric", "Garruk Wildspeaker"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Court Cleric" 1
}

scenario "Predatory Wurm: +2/+2 with a Garruk planeswalker" {
  battlefield A: "Predatory Wurm", "Garruk Wildspeaker"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Predatory Wurm" 6
  assert toughness "Predatory Wurm" 6
}

scenario "Aven Heartstabber: five mana values in the graveyard" {
  battlefield A: "Aven Heartstabber"
  graveyard A: "Memnite", "Llanowar Elves", "Grizzly Bears", "Divination", "Hill Giant"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Aven Heartstabber" 3
  assert has "Aven Heartstabber" deathtouch
}

scenario "Aven Heartstabber: four mana values aren't enough; dying mills two and draws" {
  battlefield A: "Aven Heartstabber"
  battlefield B: "Mountain"
  graveyard A: "Memnite", "Llanowar Elves", "Grizzly Bears", "Shock", "Hill Giant"
  library A: "Forest", "Island", "Swamp"
  hand B: "Shock"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Aven Heartstabber" 1
  turn 1 end B: cast "Shock" targeting "Aven Heartstabber"
  run_to turn 2 upkeep
  assert graveyard A contains "Forest"
  assert graveyard A contains "Island"
  assert hand A contains "Swamp"
}

scenario "Bonds of Mortality: draw on entering; opponents' creatures lose indestructible" {
  battlefield A: 3 "Forest", "Mountain"
  battlefield B: "Darksteel Myr"
  hand A: "Bonds of Mortality", "Lightning Bolt"
  library A: "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Bonds of Mortality"
  turn 1 A: wait
  turn 1 A: activate "Bonds of Mortality"
  turn 1 A: cast "Lightning Bolt" targeting "Darksteel Myr"
  run_to turn 1 postcombat_main
  assert hand A contains "Island"
  assert graveyard B contains "Darksteel Myr"
}

scenario "Coastal Piracy: combat damage to an opponent draws" {
  battlefield A: "Coastal Piracy", "Grizzly Bears"
  library A: "Island"
  turn 1 declare_attackers A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Island"
  assert life B 18
}

scenario "Darksteel Brute: becomes a 2/2 Beast until end of turn" {
  battlefield A: "Darksteel Brute", 3 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Darksteel Brute"
  run_to turn 1 postcombat_main
  assert is "Darksteel Brute" creature
  assert is "Darksteel Brute" Beast
  assert power "Darksteel Brute" 2
  run_to turn 2 upkeep
  assert is not "Darksteel Brute" creature
}

scenario "Darksteel Forge: artifacts you control survive destroy" {
  battlefield A: "Darksteel Forge", "Ornithopter"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 1 A precombat_main
  turn 1 end B: cast "Shock" targeting "Ornithopter"
  run_to turn 2 upkeep
  assert battlefield A contains "Ornithopter"
  assert has "Ornithopter" indestructible
}

scenario "Leonin Abunas: artifacts you control have hexproof" {
  battlefield A: "Leonin Abunas", "Ornithopter"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 1 A precombat_main
  illegal turn 1 end B: cast "Shock" targeting "Ornithopter"
  run_to turn 2 upkeep
  assert has "Ornithopter" hexproof
  assert has not "Leonin Abunas" hexproof
}

scenario "Dreamstealer: the player discards as many cards as the damage" {
  battlefield A: "Dreamstealer"
  hand B: "Forest", "Island", "Swamp"
  turn 1 declare_attackers A: attack "Dreamstealer"
  run_to turn 1 postcombat_main
  assert hand B count 2
}

scenario "Needle Specter: discards as many as the damage" {
  battlefield A: "Needle Specter", "Gruul War Plow"
  hand B: "Forest", "Island", "Swamp"
  turn 1 declare_attackers A: attack "Needle Specter"
  run_to turn 1 postcombat_main
  assert hand B count 2
}

scenario "Duergar Mine-Captain: attacking creatures get +1/+0" {
  battlefield A: "Duergar Mine-Captain", "Grizzly Bears", "Hill Giant", 2 "Mountain"
  turn 1 declare_attackers A: attack "Duergar Mine-Captain", "Grizzly Bears", "Hill Giant"
  turn 1 declare_attackers A: activate "Duergar Mine-Captain"
  run_to turn 1 declare_blockers
  assert power "Grizzly Bears" 3
  assert power "Hill Giant" 4
  assert power "Duergar Mine-Captain" 3
  run_to turn 1 postcombat_main
  assert life B 10
}

scenario "Duergar Mine-Captain: a creature that isn't attacking gets nothing" {
  battlefield A: "Duergar Mine-Captain", "Grizzly Bears", 2 "Mountain"
  turn 1 declare_attackers A: attack "Duergar Mine-Captain"
  turn 1 declare_attackers A: activate "Duergar Mine-Captain"
  run_to turn 1 declare_blockers
  assert power "Grizzly Bears" 2
}

scenario "Dusk Urchins: a -1/-1 counter on attacking; draws for each as it dies" {
  battlefield A: "Dusk Urchins" with 1 -1/-1
  library A: "Forest", "Island", "Swamp", "Plains"
  turn 1 declare_attackers A: attack "Dusk Urchins"
  run_to turn 1 postcombat_main
  assert counters "Dusk Urchins" -1/-1 2
  assert life B 18
}

scenario "Dusk Urchins: dying with two counters draws two" {
  battlefield A: "Dusk Urchins" with 2 -1/-1
  battlefield B: "Mountain"
  hand B: "Shock"
  library A: "Forest", "Island", "Swamp", "Plains"
  start turn 1 A precombat_main
  turn 1 end B: cast "Shock" targeting "Dusk Urchins"
  run_to turn 2 upkeep
  assert hand A count 2
}

scenario "Evangel of Synthesis: loot on entering; +1/+0 and menace after two draws" {
  battlefield A: "Island", "Swamp"
  hand A: "Evangel of Synthesis", "Mountain"
  library A: "Forest", "Swamp"
  start turn 3 A upkeep
  turn 3 precombat_main A: cast "Evangel of Synthesis"
  turn 3 precombat_main A: discard "Mountain"
  run_to turn 3 postcombat_main
  assert graveyard A contains "Mountain"
  assert power "Evangel of Synthesis" 3
  assert has "Evangel of Synthesis" menace
}

scenario "Evangel of Synthesis: one draw isn't enough" {
  battlefield A: "Island", "Swamp"
  hand A: "Evangel of Synthesis", "Mountain"
  library A: "Forest", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: cast "Evangel of Synthesis"
  run_to turn 1 postcombat_main
  assert power "Evangel of Synthesis" 2
  assert has not "Evangel of Synthesis" menace
}

scenario "Faerie Mastermind: an opponent's second draw draws you a card" {
  battlefield A: "Faerie Mastermind"
  battlefield B: 3 "Island"
  hand B: "Divination"
  library A: "Plains"
  start turn 2 B precombat_main
  turn 2 B: cast "Divination"
  run_to turn 2 postcombat_main
  assert hand A contains "Plains"
}

scenario "Faerie Mastermind: your own second draw doesn't" {
  battlefield A: "Faerie Mastermind", 3 "Island"
  hand A: "Divination"
  library A: "Plains", "Forest", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: cast "Divination"
  run_to turn 1 postcombat_main
  assert hand A count 2
}

scenario "Faerie Mastermind: {3}{U} each player draws" {
  battlefield A: "Faerie Mastermind", 4 "Island"
  library A: "Plains"
  library B: "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Faerie Mastermind"
  run_to turn 1 postcombat_main
  assert hand A contains "Plains"
  assert hand B contains "Forest"
}

scenario "Glacial Plating: +3/+3 for each age counter" {
  battlefield A: "Grizzly Bears", "Glacial Plating" on "Grizzly Bears" with 2 age
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 8
  assert toughness "Grizzly Bears" 8
}

scenario "Goblin Piledriver: +2/+0 for each other attacking Goblin" {
  battlefield A: "Goblin Piledriver", "Raging Goblin", "Goblin Guide", "Grizzly Bears"
  turn 1 declare_attackers A: attack "Goblin Piledriver", "Raging Goblin", "Goblin Guide", "Grizzly Bears"
  run_to turn 1 declare_blockers
  assert power "Goblin Piledriver" 5
  run_to turn 2 upkeep
  assert power "Goblin Piledriver" 1
}

scenario "Gruul War Plow: creatures you control have trample; becomes a 4/4 Juggernaut" {
  battlefield A: "Gruul War Plow", "Grizzly Bears", "Mountain", "Forest", "Plains"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Gruul War Plow"
  run_to turn 1 postcombat_main
  assert has "Grizzly Bears" trample
  assert has "Gruul War Plow" trample
  assert has not "Hill Giant" trample
  assert is "Gruul War Plow" Juggernaut
  assert power "Gruul War Plow" 4
}

scenario "Headless Rider: another nontoken Zombie dying makes a Zombie" {
  battlefield A: "Headless Rider", "Gravedigger"

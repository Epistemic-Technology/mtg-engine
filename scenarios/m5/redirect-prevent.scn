# Damage prevention and redirection forms: "If X is 5 or more, this spell
# can't be countered and the damage can't be prevented" (CR 101.2,
# 615.12), "Combat damage can't be prevented." (also stops protection's
# prevention, CR 702.16d), ...

# ---- a conditional "this spell can't be countered" ----

scenario "Banefire: with X 5 it can't be countered" {
  battlefield A: 6 "Mountain"
  battlefield B: 2 "Island"
  hand A: "Banefire"
  hand B: "Counterspell"
  turn 1 A: cast "Banefire" x 5 targeting player B
  turn 1 B: cast "Counterspell" targeting "Banefire" in response to "Banefire"
  run_to turn 1 postcombat_main
  assert life B 15
}

scenario "Banefire: with X 4 it is countered" {
  battlefield A: 5 "Mountain"
  battlefield B: 2 "Island"
  hand A: "Banefire"
  hand B: "Counterspell"
  turn 1 A: cast "Banefire" x 4 targeting player B
  turn 1 B: cast "Counterspell" targeting "Banefire" in response to "Banefire"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Banefire"
}

scenario "Banefire: with X 5 its damage can't be prevented" {
  battlefield A: 6 "Mountain"
  battlefield B: "Plains"
  hand A: "Banefire"
  hand B: "Mending Hands"
  turn 1 A: cast "Banefire" x 5 targeting player B
  turn 1 B: cast "Mending Hands" targeting player B in response to "Banefire"
  run_to turn 1 postcombat_main
  assert life B 15
}

scenario "Banefire: with X 4 its damage is prevented" {
  battlefield A: 5 "Mountain"
  battlefield B: "Plains"
  hand A: "Banefire"
  hand B: "Mending Hands"
  turn 1 A: cast "Banefire" x 4 targeting player B
  turn 1 B: cast "Mending Hands" targeting player B in response to "Banefire"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "Demonfire: hellbent, it can't be countered and the creature is exiled" {
  battlefield A: 4 "Mountain"
  battlefield B: 2 "Island", "Hill Giant"
  hand A: "Demonfire"
  hand B: "Counterspell"
  turn 1 A: cast "Demonfire" x 3 targeting "Hill Giant"
  turn 1 B: cast "Counterspell" targeting "Demonfire" in response to "Demonfire"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
}

scenario "Demonfire: with a card in hand it can be countered" {
  battlefield A: 4 "Mountain"
  battlefield B: 2 "Island", "Hill Giant"
  hand A: "Demonfire", "Shock"
  hand B: "Counterspell"
  turn 1 A: cast "Demonfire" x 3 targeting "Hill Giant"
  turn 1 B: cast "Counterspell" targeting "Demonfire" in response to "Demonfire"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert graveyard A contains "Demonfire"
}

scenario "Demonfire: with a card in hand its damage is prevented" {
  battlefield A: 4 "Mountain"
  battlefield B: "Plains"
  hand A: "Demonfire", "Shock"
  hand B: "Mending Hands"
  turn 1 A: cast "Demonfire" x 3 targeting player B
  turn 1 B: cast "Mending Hands" targeting player B in response to "Demonfire"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "Demonfire: hellbent, its damage can't be prevented" {
  battlefield A: 4 "Mountain"
  battlefield B: "Plains"
  hand A: "Demonfire"
  hand B: "Mending Hands"
  turn 1 A: cast "Demonfire" x 3 targeting player B
  turn 1 B: cast "Mending Hands" targeting player B in response to "Demonfire"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "Exquisite Firecraft: spell mastery, it can't be countered" {
  battlefield A: 3 "Mountain"
  battlefield B: 2 "Island"
  graveyard A: "Lightning Bolt", "Divination"
  hand A: "Exquisite Firecraft"
  hand B: "Counterspell"
  turn 1 A: cast "Exquisite Firecraft" targeting player B
  turn 1 B: cast "Counterspell" targeting "Exquisite Firecraft" in response to "Exquisite Firecraft"
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "Exquisite Firecraft: one instant in the graveyard, it is countered" {
  battlefield A: 3 "Mountain"
  battlefield B: 2 "Island"
  graveyard A: "Lightning Bolt", "Grizzly Bears"
  hand A: "Exquisite Firecraft"
  hand B: "Counterspell"
  turn 1 A: cast "Exquisite Firecraft" targeting player B
  turn 1 B: cast "Counterspell" targeting "Exquisite Firecraft" in response to "Exquisite Firecraft"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "Exquisite Firecraft: spell mastery doesn't stop prevention" {
  battlefield A: 3 "Mountain"
  battlefield B: "Plains"
  graveyard A: "Lightning Bolt", "Divination"
  hand A: "Exquisite Firecraft"
  hand B: "Mending Hands"
  turn 1 A: cast "Exquisite Firecraft" targeting player B
  turn 1 B: cast "Mending Hands" targeting player B in response to "Exquisite Firecraft"
  run_to turn 1 postcombat_main
  assert life B 20
}

# ---- "Combat damage can't be prevented." ----

scenario "Frenzied Baloth: Fog prevents nothing" {
  battlefield A: "Frenzied Baloth"
  battlefield B: "Forest"
  hand B: "Fog"
  turn 1 A: attack "Frenzied Baloth"
  turn 1 declare_blockers B: cast "Fog"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "Frenzied Baloth: protection from green doesn't prevent its combat damage" {
  battlefield A: "Frenzied Baloth"
  battlefield B: "Cerulean Wyvern"
  turn 1 A: attack "Frenzied Baloth"
  turn 1 B: block "Frenzied Baloth" with "Cerulean Wyvern"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Cerulean Wyvern"
}

scenario "Frenzied Baloth: noncombat damage is still prevented" {
  battlefield A: "Frenzied Baloth", "Mountain"
  battlefield B: "Plains"
  hand A: "Shock"
  hand B: "Mending Hands"
  turn 1 A: cast "Shock" targeting player B
  turn 1 B: cast "Mending Hands" targeting player B in response to "Shock"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "Frenzied Baloth: creature spells you control can't be countered" {
  battlefield A: "Frenzied Baloth", 2 "Forest"
  battlefield B: 2 "Island"
  hand A: "Grizzly Bears"
  hand B: "Counterspell"
  turn 1 A: cast "Grizzly Bears"
  turn 1 B: cast "Counterspell" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

scenario "Without Frenzied Baloth, Fog prevents combat damage" {
  battlefield A: "Grizzly Bears"
  battlefield B: "Forest"
  hand B: "Fog"
  turn 1 A: attack "Grizzly Bears"
  turn 1 declare_blockers B: cast "Fog"
  run_to turn 1 postcombat_main
  assert life B 20
}

# ---- "prevent that damage and ..." (CR 615.5) ----

scenario "Anti-Venom: damage to him becomes +1/+1 counters" {
  battlefield A: "Anti-Venom, Horrifying Healer"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting "Anti-Venom, Horrifying Healer"
  run_to turn 1 postcombat_main
  assert damage "Anti-Venom, Horrifying Healer" 0
  assert counters "Anti-Venom, Horrifying Healer" +1/+1 3
  assert power "Anti-Venom, Horrifying Healer" 8
}

scenario "Anti-Venom: cast, he returns a creature card from your graveyard" {
  battlefield A: 5 "Plains"
  graveyard A: "Hill Giant"
  hand A: "Anti-Venom, Horrifying Healer"
  turn 1 A: cast "Anti-Venom, Horrifying Healer"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
}

scenario "Anti-Venom: combat damage he is dealt is prevented too" {
  battlefield A: "Anti-Venom, Horrifying Healer"
  battlefield B: "Craw Wurm"
  start turn 2 B precombat_main
  turn 2 B: attack "Craw Wurm"
  turn 2 A: block "Craw Wurm" with "Anti-Venom, Horrifying Healer"
  run_to turn 2 postcombat_main
  assert counters "Anti-Venom, Horrifying Healer" +1/+1 6
  assert graveyard B contains "Craw Wurm"
}

scenario "Ironscale Hydra: a creature's combat damage gives one counter" {
  battlefield A: "Ironscale Hydra"
  battlefield B: "Craw Wurm"
  turn 1 A: attack "Ironscale Hydra"
  turn 1 B: block "Ironscale Hydra" with "Craw Wurm"
  run_to turn 1 postcombat_main
  assert damage "Ironscale Hydra" 0
  assert counters "Ironscale Hydra" +1/+1 1
}

scenario "Ironscale Hydra: a spell's damage isn't prevented" {
  battlefield A: "Ironscale Hydra"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting "Ironscale Hydra"
  run_to turn 1 postcombat_main
  assert damage "Ironscale Hydra" 3
  assert counters "Ironscale Hydra" +1/+1 0
}

scenario "Ugin's Conjurant: damage removes that many counters" {
  battlefield A: "Ugin's Conjurant" with 5 +1/+1
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting "Ugin's Conjurant"
  run_to turn 1 postcombat_main
  assert damage "Ugin's Conjurant" 0
  assert counters "Ugin's Conjurant" +1/+1 2
}

scenario "Ugin's Conjurant: more damage than counters, it dies" {
  battlefield A: "Ugin's Conjurant" with 2 +1/+1
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting "Ugin's Conjurant"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Ugin's Conjurant"
}

scenario "Oathsworn Knight: damage removes one counter" {
  battlefield A: "Oathsworn Knight" with 4 +1/+1
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting "Oathsworn Knight"
  run_to turn 1 postcombat_main
  assert damage "Oathsworn Knight" 0
  assert counters "Oathsworn Knight" +1/+1 3
}

scenario "Undergrowth Champion: without a counter, damage is dealt" {
  battlefield A: "Undergrowth Champion"
  battlefield B: "Mountain"
  hand B: "Shock"
  turn 1 B: cast "Shock" targeting "Undergrowth Champion"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Undergrowth Champion"
}

scenario "Undergrowth Champion: with a counter, the damage is prevented" {
  battlefield A: "Undergrowth Champion" with 1 +1/+1
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting "Undergrowth Champion"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Undergrowth Champion"
  assert damage "Undergrowth Champion" 0
  assert counters "Undergrowth Champion" +1/+1 0
}

scenario "Test of Faith: 3 damage prevented, three counters" {
  battlefield A: "Plains", "Plains", "Grizzly Bears"
  battlefield B: "Mountain", "Mountain"
  hand A: "Test of Faith"
  hand B: "Lightning Bolt", "Shock"
  turn 1 A: cast "Test of Faith" targeting "Grizzly Bears"
  turn 1 B: wait
  turn 1 B: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
  assert damage "Grizzly Bears" 0
}

scenario "Test of Faith: only the shield's 3 damage give counters" {
  battlefield A: "Plains", "Plains", "Hill Giant"
  battlefield B: "Mountain", "Mountain", "Mountain"
  hand A: "Test of Faith"
  hand B: "Lightning Bolt", "Shock"
  turn 1 A: cast "Test of Faith" targeting "Hill Giant"
  turn 1 B: wait
  turn 1 B: cast "Lightning Bolt" targeting "Hill Giant"
  turn 1 B: wait
  turn 1 B: cast "Shock" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 3
  assert damage "Hill Giant" 2
}

scenario "Brace for Impact: damage dealt before it resolves stays" {
  battlefield A: 5 "Plains", "Watchwolf"
  battlefield B: "Mountain"
  hand A: "Brace for Impact"
  hand B: "Shock"
  turn 1 A: cast "Brace for Impact" targeting "Watchwolf"
  turn 1 B: cast "Shock" targeting "Watchwolf" in response to "Brace for Impact"
  run_to turn 1 postcombat_main
  assert damage "Watchwolf" 2
  assert counters "Watchwolf" +1/+1 0
}

scenario "Brace for Impact: after it resolves, Bolt gives three counters" {
  battlefield A: 5 "Plains", "Watchwolf"
  battlefield B: "Mountain"
  hand A: "Brace for Impact"
  hand B: "Lightning Bolt"
  turn 1 A: cast "Brace for Impact" targeting "Watchwolf"
  turn 1 B: wait
  turn 1 B: cast "Lightning Bolt" targeting "Watchwolf"
  run_to turn 1 postcombat_main
  assert damage "Watchwolf" 0
  assert counters "Watchwolf" +1/+1 3
}

scenario "Brace for Impact: a monocolored creature can't be targeted" {
  battlefield A: 5 "Plains", "Grizzly Bears"
  hand A: "Brace for Impact"
  illegal turn 1 A: cast "Brace for Impact" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
}

scenario "Chant of Vitu-Ghazi: creatures' damage is prevented and gained as life" {
  battlefield A: 8 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Chant of Vitu-Ghazi"
  start turn 2 B precombat_main
  turn 2 B: attack "Hill Giant"
  turn 2 declare_blockers A: cast "Chant of Vitu-Ghazi"
  run_to turn 2 postcombat_main
  assert life A 23
}

scenario "Combust: it can't be countered and its damage can't be prevented" {
  battlefield A: 2 "Mountain"
  battlefield B: "Serra Angel", 2 "Island", "Plains"
  hand A: "Combust"
  hand B: "Counterspell", "Mending Hands"
  turn 1 A: cast "Combust" targeting "Serra Angel"
  turn 1 B: cast "Counterspell" targeting "Combust" in response to "Combust"
  turn 1 B: cast "Mending Hands" targeting "Serra Angel" in response to "Combust"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
}

scenario "Endure: no damage to you this turn" {
  battlefield A: 5 "Plains"
  battlefield B: "Mountain"
  hand A: "Endure"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting player A
  turn 1 A: cast "Endure" in response to "Lightning Bolt"
  run_to turn 1 postcombat_main
  assert life A 20
}

# ---- redirection (CR 614.9) ----

scenario "Palisade Giant: damage to you and your other permanents is dealt to it" {
  battlefield A: "Palisade Giant", "Grizzly Bears"
  battlefield B: 2 "Mountain"
  hand B: "Lightning Bolt", "Shock"
  turn 1 B: cast "Lightning Bolt" targeting player A
  turn 1 B: wait
  turn 1 B: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 20
  assert damage "Grizzly Bears" 0
  assert damage "Palisade Giant" 5
}

scenario "Palisade Giant: damage to itself stays" {
  battlefield A: "Palisade Giant"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting "Palisade Giant"
  run_to turn 1 postcombat_main
  assert damage "Palisade Giant" 3
}


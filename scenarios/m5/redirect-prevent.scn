# ---- "Damage isn't removed from this creature during cleanup steps." ----

scenario "Ancient Adamantoise: damage stays after cleanup" {
  battlefield A: "Ancient Adamantoise"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 B: cast "Lightning Bolt" targeting player A
  run_to turn 2 upkeep
  assert life A 20
  assert damage "Ancient Adamantoise" 3
}

scenario "Ancient Adamantoise: other creatures still heal at cleanup" {
  battlefield A: "Hill Giant"
  battlefield B: "Mountain"
  hand B: "Shock"
  turn 1 B: cast "Shock" targeting "Hill Giant"
  run_to turn 2 upkeep
  assert damage "Hill Giant" 0
}

scenario "Ancient Adamantoise: when it dies, it is exiled and ten tapped Treasures are made" {
  battlefield A: "Ancient Adamantoise"
  battlefield B: 6 "Swamp"
  hand B: "Murder"
  turn 1 B: cast "Murder" targeting "Ancient Adamantoise"
  run_to turn 1 postcombat_main
  assert exile A contains "Ancient Adamantoise"
  assert battlefield A contains 10 "Treasure"
  assert tapped A "Treasure"
}

# ---- "Prevent all combat damage ... except combat damage that would be dealt by ..." ----

scenario "Inspire Awe: an enchanted creature still deals combat damage" {
  battlefield A: "Grizzly Bears", "Holy Strength" on "Grizzly Bears", "Hill Giant"
  battlefield B: 4 "Forest"
  hand B: "Inspire Awe"
  turn 1 A: attack "Grizzly Bears", "Hill Giant"
  turn 1 declare_blockers B: cast "Inspire Awe"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "Inspire Awe: an enchantment creature still deals combat damage" {
  battlefield A: "Aegis of the Gods", "Hill Giant"
  battlefield B: 4 "Forest"
  hand B: "Inspire Awe"
  turn 1 A: attack "Aegis of the Gods", "Hill Giant"
  turn 1 declare_blockers B: cast "Inspire Awe"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "Inspire Awe: noncombat damage is not prevented" {
  battlefield A: "Mountain"
  battlefield B: 4 "Forest"
  hand A: "Shock"
  hand B: "Inspire Awe"
  turn 1 A: cast "Shock" targeting player B
  turn 1 B: cast "Inspire Awe" in response to "Shock"
  run_to turn 1 postcombat_main
  assert life B 18
}

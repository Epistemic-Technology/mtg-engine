# "You may choose new targets for that spell" (CR 115.7d), "the first
# instant or sorcery spell you cast each turn costs {3} less", "your first
# noncreature spell each turn", "a spell that's one or more colors".

scenario "new targets: Speedball's controller moves an opponent's Shock to the opponent's creature" {
  battlefield A: "Speedball, New Warrior"
  battlefield B: "Mountain", "Hill Giant"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Speedball, New Warrior"
  turn 2 precombat_main A: choose "Hill Giant"
  run_to turn 2 postcombat_main
  assert damage "Hill Giant" 2
  assert damage "Speedball, New Warrior" 0
  assert power "Speedball, New Warrior" 4
}

scenario "new targets: kept, Speedball takes the Shock as a 4/4" {
  battlefield A: "Speedball, New Warrior"
  battlefield B: "Mountain", "Hill Giant"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Speedball, New Warrior"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Speedball, New Warrior"
  assert damage "Speedball, New Warrior" 2
  assert damage "Hill Giant" 0
}

scenario "new targets: a spell targeting something else doesn't trigger Speedball" {
  battlefield A: "Speedball, New Warrior", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert power "Speedball, New Warrior" 2
}

scenario "first instant or sorcery each turn: Melek's {3} off the first, not the second" {
  battlefield A: "Melek, Reforged Researcher", 2 "Island"
  graveyard A: "Shock"
  hand A: "Divination", "Divination"
  turn 1 A: cast "Divination"
  turn 1 A: wait
  illegal turn 1 precombat_main A: cast "Divination"
  run_to turn 1 end
  assert graveyard A contains 1 "Divination"
}

scenario "first instant or sorcery each turn: a creature spell first doesn't use it up" {
  battlefield A: "Melek, Reforged Researcher", 4 "Island"
  graveyard A: "Shock"
  hand A: "Wind Drake", "Divination"
  turn 1 A: cast "Wind Drake"
  turn 1 A: wait
  turn 1 A: cast "Divination"
  run_to turn 1 end
  assert graveyard A contains "Divination"
  assert battlefield A contains "Wind Drake"
}

scenario "your first noncreature spell each turn: Plan for All Outcomes empowers Jace once" {
  battlefield A: "Plan for All Outcomes", 2 "Mountain"
  hand A: "Shock", "Lightning Bolt"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 end
  assert counters "Jace" loyalty 1
}

scenario "your first noncreature spell each turn: a creature spell doesn't" {
  battlefield A: "Plan for All Outcomes", 2 "Forest"
  hand A: "Grizzly Bears"
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 end
  assert battlefield A lacks "Jace"
}

scenario "a spell that's one or more colors: Ancient Cornucopia gains 1 life per color, once each turn" {
  battlefield A: "Ancient Cornucopia", 4 "Mountain"
  hand A: "Shock", "Lightning Bolt"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 end
  assert life A 21
}

scenario "a spell that's one or more colors: a colorless spell doesn't trigger it" {
  battlefield A: "Ancient Cornucopia", "Mountain"
  hand A: "Ornithopter"
  turn 1 A: cast "Ornithopter"
  run_to turn 1 end
  assert life A 20
}

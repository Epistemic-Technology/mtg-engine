# Modern cards whose Oracle wording the renderer now prints exactly: each
# scenario checks that the wording means what the card does.

scenario "The Royal Scions: +1 gives +2/+0, first strike, and trample" {
  battlefield A: "The Royal Scions", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "The Royal Scions" ability 2 targeting "Grizzly Bears"
  run_to turn 1 declare_attackers
  assert power "Grizzly Bears" 4
  assert has "Grizzly Bears" first_strike
  assert has "Grizzly Bears" trample
}

scenario "Jace, Memory Adept: -7 makes each target player draw twenty" {
  battlefield A: "Jace, Memory Adept" with 7 loyalty
  start turn 1 A precombat_main
  turn 1 A: activate "Jace, Memory Adept" ability 3 targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 20
}

scenario "Solar Blaze: each creature deals damage to itself equal to its power" {
  battlefield A: 2 "Plains", 2 "Mountain", "Grizzly Bears", "Wall of Stone"
  battlefield B: "Hill Giant", "Coral Merfolk"
  hand A: "Solar Blaze"
  start turn 1 A precombat_main
  turn 1 A: cast "Solar Blaze"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
  assert graveyard B contains "Coral Merfolk"
  assert battlefield A contains "Wall of Stone"
}

scenario "Elegant Entourage pumps a creature other than itself" {
  battlefield A: "Elegant Entourage", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  illegal turn 1 A: trigger "Elegant Entourage" targeting "Elegant Entourage"
  run_to turn 1 declare_attackers
  assert power "Grizzly Bears" 3
  assert has "Grizzly Bears" trample
  assert power "Elegant Entourage" 4
}

scenario "Stensia Masquerade: the Vampire that dealt damage gets the counter" {
  battlefield A: "Stensia Masquerade", "Vampire Interloper", "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Vampire Interloper", "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert counters "Vampire Interloper" +1/+1 1
  assert counters "Grizzly Bears" +1/+1 0
}

scenario "Indebted Samurai: a Samurai you control dies, a counter on this creature" {
  battlefield A: "Indebted Samurai", "Akki Ronin"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Akki Ronin"
  run_to turn 2 postcombat_main
  assert counters "Indebted Samurai" +1/+1 1
}

scenario "Archmage's Charm takes control for good" {
  battlefield A: 3 "Island"
  battlefield B: "Ornithopter"
  hand A: "Archmage's Charm"
  start turn 1 A precombat_main
  turn 1 A: cast "Archmage's Charm" mode 3 targeting "Ornithopter"
  run_to turn 3 precombat_main
  assert battlefield A contains "Ornithopter"
}

scenario "Obscura Charm returns a multicolored permanent card tapped" {
  battlefield A: "Plains", "Island", "Swamp"
  graveyard A: "Tattermunge Witch"
  hand A: "Obscura Charm"
  start turn 1 A precombat_main
  turn 1 A: cast "Obscura Charm" mode 1 targeting "Tattermunge Witch"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Tattermunge Witch"
  assert tapped "Tattermunge Witch"
}

scenario "Consuming Corruption: X damage and X life, X the Swamps you control" {
  battlefield A: 3 "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Consuming Corruption"
  life A 10
  start turn 1 A precombat_main
  turn 1 A: cast "Consuming Corruption" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert life A 13
}

scenario "Feral Lightning: the Elementals are exiled at the next end step" {
  battlefield A: 6 "Mountain"
  hand A: "Feral Lightning"
  start turn 1 A precombat_main
  turn 1 A: cast "Feral Lightning"
  run_to turn 1 postcombat_main
  assert battlefield A contains 3 "Elemental"
  run_to turn 2 upkeep
  assert battlefield A lacks "Elemental"
}

scenario "Meltdown destroys each artifact with mana value X or less" {
  battlefield A: 3 "Mountain"
  battlefield B: "Ornithopter", "Alpha Myr", "Myr Galvanizer"
  hand A: "Meltdown"
  start turn 1 A precombat_main
  turn 1 A: cast "Meltdown" x 2
  run_to turn 1 postcombat_main
  assert graveyard B contains "Ornithopter"
  assert graveyard B contains "Alpha Myr"
  assert battlefield B contains "Myr Galvanizer"
}

scenario "Consume the Meek destroys each creature with mana value 3 or less" {
  battlefield A: 5 "Swamp", "Grizzly Bears"
  battlefield B: "Hill Giant", "Savannah Lions"
  hand A: "Consume the Meek"
  start turn 1 A precombat_main
  turn 1 A: cast "Consume the Meek"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Savannah Lions"
  assert battlefield B contains "Hill Giant"
}

scenario "Culling Sun destroys each creature with mana value 3 or less" {
  battlefield A: 3 "Plains", 2 "Swamp", "Grizzly Bears"
  battlefield B: "Hill Giant", "Savannah Lions"
  hand A: "Culling Sun"
  start turn 1 A precombat_main
  turn 1 A: cast "Culling Sun"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Savannah Lions"
  assert battlefield B contains "Hill Giant"
}

scenario "End Hostilities destroys creatures and what's attached to them" {
  battlefield A: 5 "Plains", "Grizzly Bears", "Bonesplitter" on "Grizzly Bears", "Darksteel Relic"
  battlefield B: "Hill Giant", "Pacifism" on "Hill Giant"
  hand A: "End Hostilities"
  start turn 1 A precombat_main
  assert attached "Bonesplitter" to "Grizzly Bears"
  turn 1 A: cast "End Hostilities"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Bonesplitter"
  assert graveyard B contains "Pacifism"
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Darksteel Relic"
}

scenario "Gaze of Granite destroys each nonland permanent with mana value X or less" {
  battlefield A: 2 "Swamp", 2 "Forest"
  battlefield B: "Grizzly Bears", "Hill Giant", "Mountain"
  hand A: "Gaze of Granite"
  start turn 1 A precombat_main
  turn 1 A: cast "Gaze of Granite" x 1
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
  assert battlefield B contains "Mountain"
}

scenario "Granulate destroys each nonland artifact with mana value 4 or less" {
  battlefield A: 4 "Mountain"
  battlefield B: "Ornithopter", "Darksteel Relic", "Guardians of Koilos"
  hand A: "Granulate"
  start turn 1 A precombat_main
  turn 1 A: cast "Granulate"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Ornithopter"
  assert battlefield B contains "Darksteel Relic"
  assert battlefield B contains "Guardians of Koilos"
}

scenario "Chastise: you gain life equal to the destroyed attacker's power" {
  battlefield A: 4 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Chastise"
  start turn 2 B precombat_main
  turn 2 B: attack "Hill Giant"
  turn 2 declare_attackers A: cast "Chastise" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert life A 23
}

scenario "Public Execution: each other creature that player controls gets -2/-0" {
  battlefield A: 6 "Swamp", "Grizzly Bears"
  battlefield B: "Hill Giant", "Coral Merfolk"
  hand A: "Public Execution"
  start turn 1 A precombat_main
  turn 1 A: cast "Public Execution" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert power "Coral Merfolk" 0
  assert power "Grizzly Bears" 2
}

scenario "Eldrazi Obligator: steal, untap, and haste for the turn" {
  battlefield A: 4 "Wastes", "Mountain"
  battlefield B: "Hill Giant" tapped
  hand A: "Eldrazi Obligator"
  start turn 1 A precombat_main
  turn 1 A: cast "Eldrazi Obligator"
  turn 1 A: trigger "Eldrazi Obligator" targeting "Hill Giant"
  run_to turn 1 declare_attackers
  assert battlefield A contains "Hill Giant"
  assert untapped "Hill Giant"
  assert has "Hill Giant" haste
  run_to turn 2 upkeep
  assert battlefield B contains "Hill Giant"
}

scenario "Cloak and Dagger attaches itself to an entering Rogue" {
  battlefield A: "Cloak and Dagger", 2 "Island"
  hand A: "Merfolk Looter"
  start turn 1 A precombat_main
  turn 1 A: cast "Merfolk Looter"
  run_to turn 1 postcombat_main
  assert attached "Cloak and Dagger" to "Merfolk Looter"
  assert power "Merfolk Looter" 3
}

scenario "Hero's Blade attaches itself to an entering legendary creature" {
  battlefield A: "Hero's Blade", "Plains"
  hand A: "Isamaru, Hound of Konda"
  start turn 1 A precombat_main
  turn 1 A: cast "Isamaru, Hound of Konda"
  run_to turn 1 postcombat_main
  assert attached "Hero's Blade" to "Isamaru, Hound of Konda"
}

scenario "Hero's Blade ignores a nonlegendary creature" {
  battlefield A: "Hero's Blade", 2 "Forest"

scenario "Demogorgon's Clutches: discard two, mill two, lose 2 life" {
  battlefield A: 3 "Swamp"
  hand A: "Demogorgon's Clutches"
  hand B: "Grizzly Bears", "Hill Giant"
  library B: "Forest", "Island", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Demogorgon's Clutches" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B count 4

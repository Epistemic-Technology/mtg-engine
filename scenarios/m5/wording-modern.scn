scenario "Phalanx Tactics: +2/+1 to the target, +1/+1 to each other creature you control" {
  battlefield A: 2 "Plains", "Grizzly Bears", "Savannah Lions"
  battlefield B: "Hill Giant"
  hand A: "Phalanx Tactics"
  start turn 1 A precombat_main
  turn 1 A: cast "Phalanx Tactics" targeting "Grizzly Bears"

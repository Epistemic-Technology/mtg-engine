  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Keiga, the Tide Star"
  turn 2 A: trigger "Keiga, the Tide Star" targeting "Hill Giant"
  run_to turn 3 postcombat_main
  assert battlefield A contains "Hill Giant"
}

scenario "Guardian of Ghirapur blinks another creature you control" {

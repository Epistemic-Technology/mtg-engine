  turn 1 A: activate "Lord of the Accursed"
  run_to turn 1 postcombat_main
  assert has "Accursed Horde" menace
  assert has "Nim Devourer" menace
  assert has "Lord of the Accursed" menace
}

scenario "Judith: a nontoken creature you control dies, 1 damage" {
  battlefield A: "Judith, the Scourge Diva", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 2 A: trigger "Judith, the Scourge Diva" targeting player B
  run_to turn 2 postcombat_main
  assert life B 19
}

scenario "Judith dying itself triggers too" {
  battlefield A: "Judith, the Scourge Diva"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Judith, the Scourge Diva"
  turn 2 A: trigger "Judith, the Scourge Diva" targeting player B
  run_to turn 2 postcombat_main
  assert life B 19
}

scenario "Signature Slam: each modified creature you control bites" {
  battlefield A: 3 "Forest", "Grizzly Bears", "Centaur Courser" with 1 +1/+1, "Savannah Lions"

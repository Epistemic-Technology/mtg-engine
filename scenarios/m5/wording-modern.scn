}

scenario "Signature Slam: an unmodified creature doesn't bite" {
  battlefield A: 3 "Forest", "Grizzly Bears", "Savannah Lions"
  battlefield B: "Colossal Dreadmaw"
  hand A: "Signature Slam"
  start turn 1 A precombat_main
  turn 1 A: cast "Signature Slam" targeting "Grizzly Bears", "Colossal Dreadmaw"
  run_to turn 1 postcombat_main
  assert damage "Colossal Dreadmaw" 3

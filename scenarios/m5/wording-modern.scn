  battlefield B: "Hill Giant" tapped
  hand A: "Slave of Bolas"
  start turn 1 A precombat_main
  turn 1 A: cast "Slave of Bolas" targeting "Hill Giant"
  run_to turn 1 declare_attackers
  assert battlefield A contains "Hill Giant"
  assert untapped "Hill Giant"

}

scenario "Aether Snap removes all counters from all permanents and exiles tokens" {
  battlefield A: 5 "Swamp", "Grizzly Bears" with 2 +1/+1, "The Royal Scions"
  battlefield B: "Hill Giant" with 1 -1/-1
  hand A: "Aether Snap"
  start turn 1 A precombat_main
  turn 1 A: cast "Aether Snap"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
  assert counters "Hill Giant" -1/-1 0
  assert graveyard A contains "The Royal Scions"
}

scenario "Acolyte of the Inferno deals 2 damage to its blocker" {
  battlefield A: "Acolyte of the Inferno"
  battlefield B: "Coral Merfolk"
  start turn 2 A precombat_main
  turn 2 A: attack "Acolyte of the Inferno"
  turn 2 B: block "Acolyte of the Inferno" with "Coral Merfolk"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Coral Merfolk"
  assert battlefield A contains "Acolyte of the Inferno"
}

scenario "Evacuation returns all creatures to their owners' hands" {
  battlefield A: 5 "Island", "Grizzly Bears"
  battlefield B: "Hill Giant", "Ornithopter"
  hand A: "Evacuation"
  start turn 1 A precombat_main
  turn 1 A: cast "Evacuation"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand B contains "Hill Giant"
  assert hand B contains "Ornithopter"
}

scenario "Street Spasm can't target a flier" {
  battlefield A: 3 "Mountain"
  battlefield B: "Bog Imp", "Grizzly Bears"

  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Lumberknot" +1/+1 1
}

scenario "Unstable Footing kicked deals 5 damage" {
  battlefield A: 5 "Mountain"
  hand A: "Unstable Footing"
  start turn 1 A precombat_main
  turn 1 A: cast "Unstable Footing" kicked targeting player B
  run_to turn 1 postcombat_main
  assert life B 15
}

scenario "Josu Vess kicked makes eight Zombie Knights" {
  battlefield A: 10 "Swamp"
  hand A: "Josu Vess, Lich Knight"
  start turn 1 A precombat_main
  turn 1 A: cast "Josu Vess, Lich Knight" kicked
  run_to turn 1 postcombat_main
  assert battlefield A contains 8 "Zombie Knight"
  assert has newest A "Zombie Knight" menace
}

scenario "Josu Vess unkicked makes none" {
  battlefield A: 4 "Swamp"
  hand A: "Josu Vess, Lich Knight"
  start turn 1 A precombat_main
  turn 1 A: cast "Josu Vess, Lich Knight"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Zombie Knight"
}

scenario "Akoum Stonewaker: an Elemental with trample and haste until the end step" {
  battlefield A: "Akoum Stonewaker", 3 "Mountain"
  hand A: "Mountain"
  start turn 1 A precombat_main
  turn 1 A: play "Mountain"
  run_to turn 1 declare_attackers
  assert has "Elemental" trample
  assert has "Elemental" haste
  run_to turn 2 upkeep
  assert battlefield A lacks "Elemental"
}

scenario "Hidden Dragonslayer turned face up destroys a big creature" {
  battlefield A: 6 "Plains"
  battlefield B: "Colossal Dreadmaw", "Grizzly Bears"
  hand A: "Hidden Dragonslayer"
  start turn 1 A precombat_main
  turn 1 A: cast "Hidden Dragonslayer" face_down
  turn 1 A: wait
  turn 1 A: unmorph "Hidden Dragonslayer"
  illegal turn 1 A: trigger "Hidden Dragonslayer" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Colossal Dreadmaw"
}

scenario "Mortarpod: the equipped creature sacrifices itself to deal 1 damage" {
  battlefield A: "Grizzly Bears", "Mortarpod" on "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Grizzly Bears" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert life B 19
}

scenario "Myr Galvanizer untaps each other Myr you control" {
  battlefield A: "Myr Galvanizer", "Alpha Myr" tapped, "Copper Myr" tapped, "Grizzly Bears" tapped, "Wastes"
  start turn 1 A precombat_main
  turn 1 A: activate "Myr Galvanizer"
  run_to turn 1 postcombat_main
  assert untapped "Alpha Myr"
  assert untapped "Copper Myr"
  assert tapped "Grizzly Bears"
  assert tapped "Myr Galvanizer"
}

scenario "Lord of the Accursed: all Zombies gain menace, the opponent's too" {

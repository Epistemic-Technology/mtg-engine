# "Whenever you or a permanent you control becomes the target of a spell
# or ability an opponent controls" (`TriggerSpec::YouOrYoursTargeted`):
# once per spell or ability, however many of its targets are you or yours.

scenario "Leyline of Combustion: 2 damage to an opponent whose spell targets you" {
  battlefield A: "Leyline of Combustion"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  run_to turn 2 postcombat_main
  assert life B 18
  assert life A 18
}

scenario "Leyline of Combustion: once for a spell targeting you and your creature" {
  battlefield A: "Leyline of Combustion", "Grizzly Bears"
  battlefield B: 3 "Mountain"
  hand B: "Arc Lightning"
  start turn 2 B precombat_main
  turn 2 B: cast "Arc Lightning" targeting player A, "Grizzly Bears" dividing 1, 2
  run_to turn 2 postcombat_main
  assert life B 18
  assert life A 19
  assert graveyard A contains "Grizzly Bears"
}

scenario "Leyline of Combustion: an ability targeting your creature counts" {
  battlefield A: "Leyline of Combustion", "Hill Giant"
  battlefield B: "Prodigal Sorcerer"
  start turn 2 B precombat_main
  turn 2 B: activate "Prodigal Sorcerer" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert life B 18
}

scenario "Leyline of Combustion: your own spell doesn't trigger it" {
  battlefield A: "Leyline of Combustion", "Grizzly Bears", "Forest"
  hand A: "Giant Growth"
  start turn 2 A precombat_main
  turn 2 A: cast "Giant Growth" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 20
  assert life A 20
}

scenario "Leyline of Combustion: an opponent targeting their own creature doesn't trigger it" {
  battlefield A: "Leyline of Combustion"
  battlefield B: "Grizzly Bears", "Forest"
  hand B: "Giant Growth"
  start turn 2 B precombat_main
  turn 2 B: cast "Giant Growth" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 20
}

scenario "Unsettled Mariner counters a spell targeting you unless its controller pays 1" {
  battlefield A: "Unsettled Mariner"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Shock"
}

scenario "Unsettled Mariner: the opponent pays 1 and the Shock resolves" {
  battlefield A: "Unsettled Mariner"
  battlefield B: 2 "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Unsettled Mariner"
  # The runner accepts the payment (the first option).
  run_to turn 2 postcombat_main
  assert graveyard A contains "Unsettled Mariner"
}

scenario "Leyline of Combustion: once for a spell targeting two of your creatures" {
  battlefield A: "Leyline of Combustion", "Grizzly Bears", "Hill Giant"
  battlefield B: 3 "Mountain"
  hand B: "Arc Lightning"
  start turn 2 B precombat_main
  turn 2 B: cast "Arc Lightning" targeting "Grizzly Bears", "Hill Giant" dividing 2, 1
  run_to turn 2 postcombat_main
  assert life B 18
  assert graveyard A contains "Grizzly Bears"
  assert damage "Hill Giant" 1
}

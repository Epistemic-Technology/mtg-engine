# "This spell costs {1}{U} less to cast if it targets an instant or sorcery
# spell" (CR 601.2f, 118.7b): generic and colored mana off the cost.

scenario "colored target cost: Brush Off counters an instant for {1}{U}" {
  battlefield A: 2 "Island"
  battlefield B: "Mountain"
  hand A: "Brush Off"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 precombat_main A: cast "Brush Off" targeting "Shock"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Shock"
  assert graveyard A contains "Brush Off"
}

scenario "colored target cost: a creature spell costs the full {2}{U}{U}" {
  battlefield A: 2 "Island"
  battlefield B: 2 "Forest"
  hand A: "Brush Off"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  illegal turn 2 precombat_main A: cast "Brush Off" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

scenario "colored target cost: with four lands, a creature spell can be countered" {
  battlefield A: 4 "Island"
  battlefield B: 2 "Forest"
  hand A: "Brush Off"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 precombat_main A: cast "Brush Off" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

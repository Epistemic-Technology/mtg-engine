# Copying a spell or an ability (CR 707.10).

scenario "Social Snub copies itself while you control a creature" {
  battlefield A: "Plains", "Swamp", "Swamp", "Grizzly Bears", "Hill Giant"
  battlefield B: "Serra Angel", "Wind Drake"
  hand A: "Social Snub"
  turn 1 A: cast "Social Snub"
  run_to turn 1 end
  # Two resolutions: each player sacrifices twice; 2 life each way.
  assert battlefield A count 3
  assert battlefield B count 0
  assert life B 18
  assert life A 22
}

scenario "Social Snub: no creature, no copy" {
  battlefield A: "Plains", "Swamp", "Swamp"
  battlefield B: "Serra Angel", "Wind Drake"
  hand A: "Social Snub"
  turn 1 A: cast "Social Snub"
  run_to turn 1 end
  assert battlefield B count 1
  assert life B 19
}

scenario "Peter Parker's Camera copies an activated ability" {
  battlefield A: "Peter Parker's Camera" with 3 film, "Prodigal Sorcerer", 2 "Island"
  battlefield B: "Wind Drake"
  turn 1 A: activate "Prodigal Sorcerer" targeting player B
  turn 1 A: activate "Peter Parker's Camera" targeting "Prodigal Sorcerer"
  run_to turn 1 end
  assert life B 18
  assert counters "Peter Parker's Camera" film 2
}

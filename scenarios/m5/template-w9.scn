  assert battlefield A contains 2 "Cat"
  assert library A contains "White Sun's Zenith"
}

# ---- written by the template author after the eighth wave's merges ----

scenario "Celestus Sanctifier: one of the top two goes to the graveyard when it becomes night" {
  battlefield A: 3 "Plains"
  hand A: "Celestus Sanctifier"
  library A: "Grizzly Bears", "Hill Giant", "Plains", "Plains", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Celestus Sanctifier"
  run_to turn 3 precombat_main
  assert daynight night
  assert graveyard A count 1
}

scenario "Gruul Charm: you take back a permanent you own" {
  battlefield A: "Mountain", "Forest", 2 "Island", "Grizzly Bears"
  battlefield B: 3 "Island", "Hill Giant"
  hand A: "Gruul Charm"
  hand B: "Act of Treason"
  battlefield B: 3 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: cast "Gruul Charm" mode 2
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert battlefield B contains "Hill Giant"
  assert battlefield B count 7
}


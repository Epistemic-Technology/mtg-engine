# Renderer near-misses (wording-c, fifteenth wave): each card's amounts
# and targets.

# "Sacrifice this creature: You gain life equal to this creature's power."
# (Gristleback): the power as it last existed.
scenario "Gristleback: life equal to its power with a counter" {
  battlefield A: "Gristleback" with 1 +1/+1
  turn 1 A: activate "Gristleback"
  run_to turn 1 postcombat_main
  assert life A 23
  assert graveyard A contains "Gristleback"
}

# "{5}{B}{B}, Sacrifice this creature: Target player loses X life, where X
# is this creature's power." (Wall of Limbs).
scenario "Wall of Limbs: grows on life gain, then drains its power" {
  battlefield A: "Wall of Limbs" with 2 +1/+1, 7 "Swamp"
  hand A: "Healing Salve"
  battlefield A: "Plains"
  turn 1 A: cast "Healing Salve" mode 1 targeting player A
  turn 1 A: wait
  turn 1 A: activate "Wall of Limbs" targeting player B
  run_to turn 1 postcombat_main
  assert life A 23
  assert life B 17
  assert graveyard A contains "Wall of Limbs"
}

# "• Two-Weapon Fighting — Double target creature's power and toughness
# until end of turn. • Archery — This spell deals 5 damage to target
# creature with flying." (Choose Your Weapon).
scenario "Choose Your Weapon: Two-Weapon Fighting doubles" {
  battlefield A: "Grizzly Bears", 3 "Forest"
  hand A: "Choose Your Weapon"
  turn 1 A: cast "Choose Your Weapon" mode 1 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
}

scenario "Choose Your Weapon: Archery deals 5 to a flyer only" {
  battlefield A: 3 "Forest"
  battlefield B: "Air Elemental", "Hill Giant"
  hand A: "Choose Your Weapon"
  turn 1 A: cast "Choose Your Weapon" mode 2 targeting "Air Elemental"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Air Elemental"
  assert battlefield B contains "Hill Giant"
}

# "When an opponent casts a spell, sacrifice this enchantment and counter
# that spell." (Lunar Force).
scenario "Lunar Force: counters the opponent's spell and is sacrificed" {
  battlefield A: "Lunar Force"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B
  turn 2 B: cast "Shock" targeting player A
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Shock"
  assert graveyard A contains "Lunar Force"
}

scenario "Lunar Force: its controller's own spell is not countered" {
  battlefield A: "Lunar Force", "Mountain"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield A contains "Lunar Force"
}

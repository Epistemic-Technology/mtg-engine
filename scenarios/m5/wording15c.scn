# Renderer near-misses (wording-c, fifteenth wave): each card's amounts
# and targets.

# "Sacrifice this creature: You gain life equal to this creature's power."
# (Gristleback): the power as it last existed.
scenario "Gristleback: life equal to its power with a counter" {
  battlefield A: "Gristleback" with 1 +1/+1
  turn 1 A: activate "Gristleback"
  run_to turn 1 postcombat_main
  assert life A 23
  assert graveyard A contains "Gristleback"
}

# "{5}{B}{B}, Sacrifice this creature: Target player loses X life, where X
# is this creature's power." (Wall of Limbs).
scenario "Wall of Limbs: grows on life gain, then drains its power" {
  battlefield A: "Wall of Limbs" with 2 +1/+1, 7 "Swamp"
  hand A: "Healing Salve"
  battlefield A: "Plains"
  turn 1 A: cast "Healing Salve" mode 1 targeting player A
  turn 1 A: wait
  turn 1 A: activate "Wall of Limbs" targeting player B
  run_to turn 1 postcombat_main
  assert life A 23
  assert life B 17
  assert graveyard A contains "Wall of Limbs"
}

# "• Two-Weapon Fighting — Double target creature's power and toughness
# until end of turn. • Archery — This spell deals 5 damage to target
# creature with flying." (Choose Your Weapon).
scenario "Choose Your Weapon: Two-Weapon Fighting doubles" {
  battlefield A: "Grizzly Bears", 3 "Forest"
  hand A: "Choose Your Weapon"
  turn 1 A: cast "Choose Your Weapon" mode 1 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
}

scenario "Choose Your Weapon: Archery deals 5 to a flyer only" {
  battlefield A: 3 "Forest"
  battlefield B: "Air Elemental", "Hill Giant"
  hand A: "Choose Your Weapon"
  turn 1 A: cast "Choose Your Weapon" mode 2 targeting "Air Elemental"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Air Elemental"
  assert battlefield B contains "Hill Giant"
}

# "When an opponent casts a spell, sacrifice this enchantment and counter
# that spell." (Lunar Force).
scenario "Lunar Force: counters the opponent's spell and is sacrificed" {
  battlefield A: "Lunar Force"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B
  turn 2 B: cast "Shock" targeting player A
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Shock"
  assert graveyard A contains "Lunar Force"
}

scenario "Lunar Force: its controller's own spell is not countered" {
  battlefield A: "Lunar Force", "Mountain"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield A contains "Lunar Force"
}

# "{1}{W}: Creatures you control with defender can attack this turn as
# though they didn't have defender." (Wakestone Gargoyle).
scenario "Wakestone Gargoyle: defenders attack after the activation" {
  battlefield A: "Wakestone Gargoyle", "Wall of Limbs", 2 "Plains"
  turn 1 A: activate "Wakestone Gargoyle"
  turn 1 A: attack "Wakestone Gargoyle", "Wall of Limbs"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "Wakestone Gargoyle: without the activation it can't attack" {
  battlefield A: "Wakestone Gargoyle", 2 "Plains"
  illegal turn 1 A: attack "Wakestone Gargoyle"
  run_to turn 1 postcombat_main
  assert life B 20
}

# "Choose a number between 0 and 13. Each player sacrifices that many
# creatures of their choice." (By Invitation Only).
scenario "By Invitation Only: each player sacrifices the chosen number" {
  battlefield A: 5 "Plains", 3 "Grizzly Bears"
  battlefield B: 3 "Hill Giant"
  hand A: "By Invitation Only"
  turn 1 A: cast "By Invitation Only"
  turn 1 A: choose "2"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Grizzly Bears"
  assert battlefield B contains 1 "Hill Giant"
  assert graveyard B contains 2 "Hill Giant"
}

# "Create X 2/2 black Zombie Berserker creature tokens, where X is the
# number of nontoken creatures that died this turn." (Rise of the Dread
# Marn).
scenario "Rise of the Dread Marn: a token for each nontoken death" {
  battlefield A: "Mountain", 3 "Swamp", "Soldier"
  battlefield B: "Grizzly Bears", "Raging Goblin"
  hand A: "Shock", "Lightning Bolt", "Rise of the Dread Marn"
  battlefield A: "Mountain"
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting "Raging Goblin"
  turn 1 A: wait
  turn 1 A: cast "Rise of the Dread Marn"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Zombie Berserker"
}

# "When this enchantment enters, tap all red creatures. Red creatures
# don't untap during their controllers' untap steps." (Wrath of Marit
# Lage).
scenario "Wrath of Marit Lage: red creatures are tapped and stay tapped" {
  battlefield A: 5 "Island"
  battlefield B: "Raging Goblin", "Grizzly Bears" tapped
  hand A: "Wrath of Marit Lage"
  turn 1 A: cast "Wrath of Marit Lage"
  run_to turn 2 precombat_main
  assert tapped "Raging Goblin"
  assert untapped "Grizzly Bears"
}

# "Whenever a creature dealt damage by this creature this turn dies,
# return it to the battlefield under your control. That creature is a
# black Zombie in addition to its other colors and types." (Dread
# Slaver).
scenario "Dread Slaver: the blocked creature returns as a black Zombie" {
  battlefield A: "Dread Slaver"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Dread Slaver"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert is "Grizzly Bears" Zombie
  assert is "Grizzly Bears" Bear
  assert is "Grizzly Bears" black
  assert is "Grizzly Bears" green
}

# "Target player mills four cards. You draw a card for each creature card
# put into their graveyard this way." (Coerced Confession).
scenario "Coerced Confession: a card for each creature milled" {
  battlefield A: 5 "Swamp"
  hand A: "Coerced Confession"
  library B: "Grizzly Bears", "Forest", "Hill Giant", "Island", "Forest"
  turn 1 A: cast "Coerced Confession" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert library B count 1
  assert hand A count 2
}

# "When this creature enters, create a Treasure token. {1}{B}, Sacrifice
# another creature or a Treasure: Draw a card." (Skullport Merchant).
scenario "Skullport Merchant: a Treasure, sacrificed for a card" {
  battlefield A: 5 "Swamp"
  hand A: "Skullport Merchant"
  turn 1 A: cast "Skullport Merchant"
  turn 1 A: wait
  turn 1 A: activate "Skullport Merchant" sacrificing "Treasure"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Treasure"
  assert hand A count 1
}

scenario "Skullport Merchant: another creature pays too" {
  battlefield A: "Skullport Merchant", "Grizzly Bears", 2 "Swamp"
  turn 1 A: activate "Skullport Merchant" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 1
}

# "Mill X cards. Target player loses 2 life for each creature card put
# into your graveyard this way." (Liliana's Indignation).
scenario "Liliana's Indignation: 2 life for each creature milled" {
  battlefield A: 4 "Swamp"
  hand A: "Liliana's Indignation"
  library A: "Grizzly Bears", "Forest", "Hill Giant", "Island"
  turn 1 A: cast "Liliana's Indignation" x 3 targeting player B
  run_to turn 1 postcombat_main
  assert graveyard A contains "Forest"
  assert library A count 1
  assert life B 16
}

# "This creature and enchanted creature each get +X/+X, where X is the
# number of creature cards in all graveyards." (Nighthowler).
scenario "Nighthowler: bestowed, both get +X/+X" {
  battlefield A: 4 "Swamp", "Grizzly Bears"
  graveyard A: "Hill Giant"
  graveyard B: "Raging Goblin"
  hand A: "Nighthowler"
  turn 1 A: cast "Nighthowler" bestowed targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
}

scenario "Nighthowler: as a creature it counts the graveyards" {
  battlefield A: 3 "Swamp"
  graveyard A: "Hill Giant", "Grizzly Bears"
  hand A: "Nighthowler"
  turn 1 A: cast "Nighthowler"
  run_to turn 1 postcombat_main
  assert power "Nighthowler" 2
  assert toughness "Nighthowler" 2
}

# "Whenever you scry, if you control an Island, you may exile this card
# from your graveyard. If you do, draw a card." (Council's Deliberation).
scenario "Council's Deliberation: a scry draws from the graveyard" {
  battlefield A: "Island", "Mountain"
  graveyard A: "Council's Deliberation"
  hand A: "Magma Jet"
  turn 1 A: cast "Magma Jet" targeting player B
  run_to turn 1 postcombat_main
  assert exile A contains "Council's Deliberation"
  assert hand A count 1
}

scenario "Council's Deliberation: no Island, nothing happens" {
  battlefield A: 2 "Mountain"
  graveyard A: "Council's Deliberation"
  hand A: "Magma Jet"
  turn 1 A: cast "Magma Jet" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard A contains "Council's Deliberation"
  assert hand A count 0
}

# "Draw cards equal to the number of cards in your hand plus one."
# (Sea Gate Restoration).
scenario "Sea Gate Restoration: hand plus one" {
  battlefield A: 7 "Island"
  hand A: "Sea Gate Restoration", "Forest", "Forest"
  turn 1 A: cast "Sea Gate Restoration"
  run_to turn 1 postcombat_main
  assert hand A count 5
}

# "Then this creature deals X damage to each opponent, where X is the
# number of modified creatures you control other than this creature."
# (Thundering Raiju).
scenario "Thundering Raiju: counts the other modified creatures" {
  battlefield A: "Thundering Raiju" with 1 +1/+1, "Grizzly Bears", "Hill Giant" with 1 +1/+1
  turn 1 A: attack "Thundering Raiju"
  turn 1 A: trigger "Thundering Raiju" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert life B 14
}

# "Each creature that's a Barbarian, a Warrior, or a Berserker gets +2/+2
# and has haste." (Lovisa Coldeyes): any player's.
scenario "Lovisa Coldeyes: Berserkers and Warriors get +2/+2 and haste" {
  battlefield A: "Lovisa Coldeyes", "Grizzly Bears"
  battlefield B: "Raging Goblin", "Academy Raider"
  run_to turn 1 precombat_main
  assert power B "Raging Goblin" 3
  assert toughness B "Academy Raider" 3
  assert has "Academy Raider" haste
  assert power "Grizzly Bears" 2
  assert power "Lovisa Coldeyes" 3
  assert has not "Grizzly Bears" haste
}

# "Choose target creature you don't control. Each creature you control
# that's a Wolf or a Werewolf deals damage equal to its power to that
# creature." (Moonlight Hunt).
scenario "Moonlight Hunt: only the Wolves deal damage" {
  battlefield A: "Arlinn's Wolf", "Grizzly Bears", 2 "Forest"
  battlefield B: "Air Elemental"
  hand A: "Moonlight Hunt"
  turn 1 A: cast "Moonlight Hunt" targeting "Air Elemental"
  run_to turn 1 postcombat_main
  assert damage "Air Elemental" 3
  assert damage "Arlinn's Wolf" 0
  assert battlefield B contains "Air Elemental"
}

scenario "Moonlight Hunt: two Wolves kill the creature" {
  battlefield A: 2 "Arlinn's Wolf", 2 "Forest"
  battlefield B: "Hill Giant"
  hand A: "Moonlight Hunt"
  turn 1 A: cast "Moonlight Hunt" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

# "Target player draws cards equal to half the number of cards in their
# library and loses half their life. Round up each time." (Peer into the
# Abyss).
scenario "Peer into the Abyss: half the library and half the life, rounded up" {
  battlefield A: 7 "Swamp"
  hand A: "Peer into the Abyss"
  library B: "Forest", "Forest", "Forest", "Forest", "Forest"
  life B 15
  turn 1 A: cast "Peer into the Abyss" targeting player B
  run_to turn 1 postcombat_main
  assert hand B count 3
  assert library B count 2
  assert life B 7
}

# "Until end of turn, target creature gets +3/+3, up to one other target
# creature gets +2/+2, and up to one other target creature gets +1/+1.
# Those creatures gain vigilance until end of turn." (Arm the Cathars).
scenario "Arm the Cathars: three sizes and vigilance" {
  battlefield A: 3 "Plains", "Grizzly Bears", "Hill Giant", "Raging Goblin"
  hand A: "Arm the Cathars"
  turn 1 A: cast "Arm the Cathars" targeting "Grizzly Bears", "Hill Giant", "Raging Goblin"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 5
  assert power "Hill Giant" 5
  assert power "Raging Goblin" 2
  assert has "Raging Goblin" vigilance
  assert has "Grizzly Bears" vigilance
}

scenario "Arm the Cathars: one target only" {
  battlefield A: 3 "Plains", "Grizzly Bears"
  hand A: "Arm the Cathars"
  turn 1 A: cast "Arm the Cathars" targeting "Grizzly Bears", none, none
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 5
  assert has "Grizzly Bears" vigilance
}

# "Verazol enters with a +1/+1 counter on it for each mana spent to cast
# it." (Verazol, the Split Current).
scenario "Verazol: a counter for each mana spent" {
  battlefield A: 2 "Forest", 2 "Island"
  hand A: "Verazol, the Split Current"
  turn 1 A: cast "Verazol, the Split Current" x 2
  run_to turn 1 postcombat_main
  assert counters "Verazol, the Split Current" +1/+1 4
}

scenario "Verazol: two counters copy a kicked spell" {
  battlefield A: "Verazol, the Split Current" with 2 +1/+1, 5 "Mountain"
  hand A: "Burst Lightning"
  turn 1 A: cast "Burst Lightning" kicked targeting player B
  run_to turn 1 postcombat_main
  assert life B 12
  assert graveyard A contains "Verazol, the Split Current"
}

# "Each opponent sacrifices a creature of their choice. If you control a
# Liliana planeswalker, each opponent also discards a card." (Liliana's
# Triumph).
scenario "Liliana's Triumph: with a Liliana, a discard too" {
  battlefield A: 2 "Swamp", "Liliana, Death Wielder"
  battlefield B: "Grizzly Bears"
  hand A: "Liliana's Triumph"
  hand B: "Forest"
  turn 1 A: cast "Liliana's Triumph"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert graveyard B contains "Forest"
}

scenario "Liliana's Triumph: without one, only the sacrifice" {
  battlefield A: 2 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Liliana's Triumph"
  hand B: "Forest"
  turn 1 A: cast "Liliana's Triumph"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert hand B count 1
}

# "Whenever equipped creature attacks, you may return a land you control
# to its owner's hand. If you do, the creature gets +2/+2 until end of
# turn." (Slab Hammer).
scenario "Slab Hammer: a returned land pumps the attacker" {
  battlefield A: "Grizzly Bears", "Slab Hammer" on "Grizzly Bears", "Forest"
  turn 1 A: attack "Grizzly Bears"
  turn 1 A: choose "Forest"
  run_to turn 1 postcombat_main
  assert hand A contains "Forest"
  assert life B 16
}

scenario "Slab Hammer: declined, no pump" {
  battlefield A: "Grizzly Bears", "Slab Hammer" on "Grizzly Bears", "Forest"
  turn 1 A: attack "Grizzly Bears"
  turn 1 A: decline "Slab Hammer"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Forest"
  assert life B 18
}

# "This spell costs {1} less to cast if you control an artifact and {1}
# less to cast if you control an enchantment." (Assassin's Ink).
scenario "Assassin's Ink: both reductions" {
  battlefield A: 2 "Swamp", "Ornithopter", "Wrath of Marit Lage"
  battlefield B: "Grizzly Bears"
  hand A: "Assassin's Ink"
  turn 1 A: cast "Assassin's Ink" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "Assassin's Ink: one reduction is not enough with two lands" {
  battlefield A: 2 "Swamp", "Ornithopter"
  battlefield B: "Grizzly Bears"
  hand A: "Assassin's Ink"
  illegal turn 1 A: cast "Assassin's Ink" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

# "If a permanent would be put into a graveyard, exile it instead."
# (Samurai of the Pale Curtain).
scenario "Samurai of the Pale Curtain: a dying creature is exiled" {
  battlefield A: "Samurai of the Pale Curtain", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile B contains "Grizzly Bears"
  assert graveyard A contains "Shock"
}

# "Put a +1/+1 counter on target creature, two +1/+1 counters on another
# target creature, and three +1/+1 counters on a third target creature."
# (Incremental Growth).
scenario "Incremental Growth: one, two, and three counters" {
  battlefield A: 5 "Forest", "Grizzly Bears", "Hill Giant", "Raging Goblin"
  hand A: "Incremental Growth"
  turn 1 A: cast "Incremental Growth" targeting "Grizzly Bears", "Hill Giant", "Raging Goblin"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 2
  assert counters "Raging Goblin" +1/+1 3
}

# "Return target creature card from your graveyard to your hand. Target
# creature gets -X/-X until end of turn, where X is the toughness of the
# card returned this way." (Foul Renewal).
scenario "Foul Renewal: -X/-X by the returned card's toughness" {
  battlefield A: 4 "Swamp"
  battlefield B: "Hill Giant"
  graveyard A: "Grizzly Bears"
  hand A: "Foul Renewal"
  turn 1 A: cast "Foul Renewal" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert power "Hill Giant" 1
  assert toughness "Hill Giant" 1
}

# "When this creature enters, you may put a -1/-1 counter on target
# creature. {B}, Sacrifice this creature: Destroy target creature that has
# a -1/-1 counter on it." (Banewhip Punisher).
scenario "Banewhip Punisher: a counter, then the destruction" {
  battlefield A: 4 "Swamp"
  battlefield B: "Hill Giant", "Grizzly Bears"
  hand A: "Banewhip Punisher"
  turn 1 A: cast "Banewhip Punisher"
  turn 1 A: trigger "Banewhip Punisher" targeting "Hill Giant"
  turn 1 A: wait
  illegal turn 1 A: activate "Banewhip Punisher" targeting "Grizzly Bears"
  turn 1 A: activate "Banewhip Punisher" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield B contains "Grizzly Bears"
  assert graveyard A contains "Banewhip Punisher"
}

# "Landfall — Whenever a land you control enters, target creature gets
# +1/+1 until end of turn. Then if that creature has power 4 or greater,
# it gains first strike until end of turn." (Strider, Ranger of the
# North).
scenario "Strider: a 4-power creature gains first strike" {
  battlefield A: "Strider, Ranger of the North", "Hill Giant"
  hand A: "Forest"
  turn 1 A: play "Forest"
  turn 1 A: trigger "Strider, Ranger of the North" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 4
  assert has "Hill Giant" first_strike
}

scenario "Strider: a smaller creature doesn't" {
  battlefield A: "Strider, Ranger of the North", "Grizzly Bears"
  hand A: "Forest"
  turn 1 A: play "Forest"
  turn 1 A: trigger "Strider, Ranger of the North" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 3
  assert has not "Grizzly Bears" first_strike
}

# "Spell mastery — If there are two or more instant and/or sorcery cards
# in your graveyard, you may cast this spell as though it had flash."
# (Swift Reckoning).
scenario "Swift Reckoning: with spell mastery, cast on the opponent's turn" {
  battlefield A: "Plains", "Mountain"
  battlefield B: "Grizzly Bears" tapped
  graveyard A: "Shock", "Lightning Bolt"
  hand A: "Swift Reckoning"
  start turn 2 B precombat_main
  turn 2 A: cast "Swift Reckoning" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "Swift Reckoning: without it, not on the opponent's turn" {
  battlefield A: "Plains", "Mountain"
  battlefield B: "Grizzly Bears" tapped
  graveyard A: "Shock"
  hand A: "Swift Reckoning"
  start turn 2 B precombat_main
  illegal turn 2 A: cast "Swift Reckoning" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

# "Whenever this creature attacks, create a tapped and attacking 1/1 red
# Devil creature token with ..." (Pugnacious Pugilist).
scenario "Pugnacious Pugilist: an attacking Devil" {
  battlefield A: "Pugnacious Pugilist"
  turn 1 A: attack "Pugnacious Pugilist"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Devil"
  assert tapped "Devil"
  assert life B 15
}

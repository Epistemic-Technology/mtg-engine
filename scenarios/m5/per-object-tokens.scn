# One token for each object (CR 303.4f): "For each of those creatures,
# create a Monster Role token attached to it" makes one Aura token per
# legal object, each entering attached to its own.

scenario "per object: Become Brutes puts a Monster Role on each of two creatures" {
  battlefield A: 2 "Mountain", "Grizzly Bears", "Hill Giant"
  hand A: "Become Brutes"
  turn 1 A: cast "Become Brutes" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Monster"
  assert power "Grizzly Bears" 3
  assert power "Hill Giant" 4
  assert has "Grizzly Bears" trample
  assert has "Hill Giant" haste
}

scenario "per object: Become Brutes with one target makes one Role" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Become Brutes"
  turn 1 A: cast "Become Brutes" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Monster"
  assert power "Grizzly Bears" 3
  assert power "Hill Giant" 3
}

scenario "per object: a target gone before resolution gets no Role" {
  battlefield A: 3 "Mountain", "Grizzly Bears", "Hill Giant"
  hand A: "Become Brutes", "Shock"
  turn 1 A: cast "Become Brutes" targeting "Grizzly Bears", "Hill Giant"
  turn 1 A: cast "Shock" targeting "Grizzly Bears" in response to "Become Brutes"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains 1 "Monster"
  assert power "Hill Giant" 4
}

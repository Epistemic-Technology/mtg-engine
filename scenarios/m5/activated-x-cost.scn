# An activated ability with X in a non-mana cost ("Exile X artifact
# cards from your graveyard"): X is announced as it is activated (CR
# 601.2b, 602.2b) and that many cards are exiled to pay it.

scenario "Winter, Cursed Rider: X = 2 exiles two artifact cards and gives -2/-2" {
  battlefield A: "Winter, Cursed Rider", 2 "Island", 2 "Swamp", "Ornithopter"
  battlefield B: "Grizzly Bears", "Hill Giant"
  graveyard A: "Darksteel Relic", "Ornithopter", "Lightning Bolt"
  turn 1 A: activate "Winter, Cursed Rider" x 2
  run_to turn 1 postcombat_main
  assert exile A contains "Darksteel Relic"
  assert graveyard A contains "Lightning Bolt"
  assert graveyard B contains "Grizzly Bears"
  assert power "Hill Giant" 1
  assert toughness "Hill Giant" 1
  assert power "Winter, Cursed Rider" 3
  assert battlefield A contains "Ornithopter"
  assert tapped "Winter, Cursed Rider"
}

scenario "Winter, Cursed Rider: only artifact cards are exiled for X" {
  battlefield A: "Winter, Cursed Rider", 2 "Island", 2 "Swamp"
  battlefield B: "Hill Giant"
  graveyard A: "Lightning Bolt", "Darksteel Relic", "Grizzly Bears"
  turn 1 A: activate "Winter, Cursed Rider" x 1
  run_to turn 1 postcombat_main
  assert exile A contains "Darksteel Relic"
  assert graveyard A contains "Lightning Bolt"
  assert graveyard A contains "Grizzly Bears"
  assert power "Hill Giant" 2
}

scenario "Winter, Cursed Rider: the effect ends at end of turn" {
  battlefield A: "Winter, Cursed Rider", 2 "Island", 2 "Swamp"
  battlefield B: "Hill Giant"
  graveyard A: "Darksteel Relic"
  turn 1 A: activate "Winter, Cursed Rider" x 1
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 2
  run_to turn 2 upkeep
  assert power "Hill Giant" 3
}

scenario "Artifacts you control have ward: pay 2 life" {
  battlefield A: "Winter, Cursed Rider", "Ornithopter"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B
  turn 2 B: cast "Shock" targeting A "Ornithopter"
  run_to turn 2 postcombat_main
  assert life B 18
  assert graveyard A contains "Ornithopter"
}

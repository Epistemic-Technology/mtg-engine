# A discard in the cost of an ability activated from the graveyard is
# paid (CR 602.2b), and the ability is not offered without the cards.
scenario "Advanced Stitchwing: discards two cards to return" {
  battlefield A: 3 "Island"
  graveyard A: "Advanced Stitchwing"
  hand A: "Shock", "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: activate "Advanced Stitchwing" discarding "Shock"
  run_to turn 2 end
  assert battlefield A contains "Advanced Stitchwing"
  assert tapped "Advanced Stitchwing"
  assert hand A count 0
  assert graveyard A count 2
}

scenario "Advanced Stitchwing: not with one card in hand" {
  battlefield A: 3 "Island"
  graveyard A: "Advanced Stitchwing"
  hand A: "Shock"
  start turn 2 A precombat_main
  illegal turn 2 A: activate "Advanced Stitchwing" discarding "Shock"
  run_to turn 2 end
  assert graveyard A contains "Advanced Stitchwing"
  assert hand A count 1
}

scenario "Kraul Swarm: only a creature card pays" {
  battlefield A: 3 "Swamp"
  graveyard A: "Kraul Swarm"
  hand A: "Shock", "Grizzly Bears"
  start turn 2 A precombat_main
  illegal turn 2 A: activate "Kraul Swarm" discarding "Shock"
  turn 2 A: activate "Kraul Swarm" discarding "Grizzly Bears"
  run_to turn 2 end
  assert hand A contains "Kraul Swarm"
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 2
}

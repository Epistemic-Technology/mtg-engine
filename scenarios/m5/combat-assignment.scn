# Combat forms: "Each creature you control with a counter on it can't be
# blocked by more than one creature." (Michelangelo), "until end of turn,
# creatures you control with toughness greater than their power assign
# combat damage equal to their toughness rather than their power" (The
# Kingpin of Crime), "If Loot's power is negative, he assigns combat damage
# as though his power were positive." (CR 510.1a), and "can't attack or
# block unless it has an even number of counters on it" (Sab-Sunen).

scenario "Michelangelo: a creature with a counter can't be double-blocked" {
  battlefield A: "Michelangelo, Mutant BFF", "Grizzly Bears" with 1 +1/+1
  battlefield B: "Savannah Lions", "Raging Goblin"
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Savannah Lions"
  illegal turn 1 B: block "Grizzly Bears" with "Raging Goblin"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Raging Goblin"
  assert graveyard B contains "Savannah Lions"
}

scenario "Michelangelo: a creature without a counter can be double-blocked" {
  battlefield A: "Michelangelo, Mutant BFF", "Grizzly Bears"
  battlefield B: "Savannah Lions", "Raging Goblin"
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Savannah Lions"
  turn 1 B: block "Grizzly Bears" with "Raging Goblin"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
}

scenario "Michelangelo: entering creates a Mutagen" {
  battlefield A: 4 "Forest"
  hand A: "Michelangelo, Mutant BFF"
  turn 1 A: cast "Michelangelo, Mutant BFF"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Mutagen"
}

scenario "Kingpin: paying 2 life, a 1/5 deals 5" {
  battlefield A: "The Kingpin of Crime", "Grizzly Bears"
  turn 1 A: attack "The Kingpin of Crime", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 18
  assert life B 13
}

scenario "Kingpin: declining, it deals its power" {
  battlefield A: "The Kingpin of Crime"
  turn 1 A: attack "The Kingpin of Crime"
  turn 1 A: decline "The Kingpin of Crime"
  run_to turn 1 postcombat_main
  assert life A 20
  assert life B 19
}

scenario "Kingpin: the effect ends with the turn" {
  battlefield A: "The Kingpin of Crime"
  turn 1 A: attack "The Kingpin of Crime"
  turn 3 A: attack "The Kingpin of Crime"
  turn 3 A: decline "The Kingpin of Crime"
  run_to turn 3 declare_attackers
  assert life B 15
  run_to turn 3 postcombat_main
  assert life B 14
}

scenario "Loot: a -2/4 assigns 2 combat damage" {
  battlefield A: "Loot, the Anomaly"
  turn 1 A: attack "Loot, the Anomaly"
  run_to turn 1 postcombat_main
  assert power "Loot, the Anomaly" -2
  assert life B 18
}

scenario "Loot: sacrificing a creature at threshold makes him -4/4, 4 damage" {
  battlefield A: "Loot, the Anomaly", "Grizzly Bears"
  graveyard A: 7 "Plains"
  turn 1 A: activate "Loot, the Anomaly" sacrificing "Grizzly Bears"
  turn 1 A: attack "Loot, the Anomaly"
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "Loot: not without seven cards in the graveyard" {
  battlefield A: "Loot, the Anomaly", "Grizzly Bears"
  graveyard A: 6 "Plains"
  illegal turn 1 A: activate "Loot, the Anomaly" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

scenario "Loot: a Giant Growth makes him 1/7, 1 damage" {
  battlefield A: "Loot, the Anomaly", "Forest"
  hand A: "Giant Growth"
  turn 1 A: cast "Giant Growth" targeting "Loot, the Anomaly"
  turn 1 A: attack "Loot, the Anomaly"
  run_to turn 1 postcombat_main
  assert life B 19
}

scenario "Sab-Sunen: with no counters (even), it can attack" {
  battlefield A: "Sab-Sunen, Luxa Embodied"
  start turn 1 A begin_combat
  turn 1 A: attack "Sab-Sunen, Luxa Embodied"
  run_to turn 1 postcombat_main
  assert life B 14
}

scenario "Sab-Sunen: the first main phase's counter makes it odd: two cards, no attack" {
  battlefield A: "Sab-Sunen, Luxa Embodied"
  illegal turn 1 A: attack "Sab-Sunen, Luxa Embodied"
  run_to turn 1 postcombat_main
  assert counters "Sab-Sunen, Luxa Embodied" +1/+1 1
  assert hand A count 2
  assert life B 20
}

scenario "Sab-Sunen: a second counter makes it even again, and it draws nothing" {
  battlefield A: "Sab-Sunen, Luxa Embodied" with 1 +1/+1
  turn 1 A: attack "Sab-Sunen, Luxa Embodied"
  run_to turn 1 postcombat_main
  assert counters "Sab-Sunen, Luxa Embodied" +1/+1 2
  assert hand A count 0
  assert life B 12
}

scenario "Sab-Sunen: an odd number of counters can't block" {
  battlefield A: "Sab-Sunen, Luxa Embodied" with 1 stun
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  illegal turn 2 A: block "Grizzly Bears" with "Sab-Sunen, Luxa Embodied"
  run_to turn 2 postcombat_main
  assert life A 18
}

# Removing counters: "Remove a +1/+1 counter from a creature you control"
# as a cost (CR 118.3: from another creature than the source too), and
# "remove up to three counters from target permanent" (each of a kind the
# controller chooses, or stop).

scenario "Ray Fillet: the counter comes off another creature" {
  battlefield A: "Ray Fillet, Man Ray", "Grizzly Bears" with 2 +1/+1, 2 "Island"
  library A: "Forest", "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Ray Fillet, Man Ray"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Ray Fillet: no +1/+1 counter, no activation" {
  battlefield A: "Ray Fillet, Man Ray", "Grizzly Bears" with 1 -1/-1, 2 "Island"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Ray Fillet, Man Ray"
  run_to turn 1 postcombat_main
  assert hand A count 0
}

scenario "Ray Fillet makes a Mutagen" {
  battlefield A: 4 "Island"
  hand A: "Ray Fillet, Man Ray"
  start turn 1 A precombat_main
  turn 1 A: cast "Ray Fillet, Man Ray"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Mutagen"
}

scenario "Quillspike removes a -1/-1 counter from a creature you control" {
  battlefield A: "Quillspike", "Hill Giant" with 1 -1/-1, "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Quillspike"
  run_to turn 1 postcombat_main
  assert power "Quillspike" 4
  assert counters "Hill Giant" -1/-1 0
}

scenario "Bolrac-Clan Crusher takes the counter from its own" {
  battlefield A: "Bolrac-Clan Crusher" with 1 +1/+1
  start turn 1 A precombat_main
  turn 1 A: activate "Bolrac-Clan Crusher" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert counters "Bolrac-Clan Crusher" +1/+1 0
}

scenario "Sunstar Chaplain taps a creature" {
  battlefield A: "Sunstar Chaplain", "Grizzly Bears" with 1 +1/+1, 2 "Plains"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Sunstar Chaplain" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert tapped "Hill Giant"
  assert counters "Grizzly Bears" +1/+1 0
}

scenario "Korozda Gorgon shrinks a creature" {
  battlefield A: "Korozda Gorgon", "Grizzly Bears" with 1 +1/+1, 2 "Swamp"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Korozda Gorgon" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 2
}

scenario "Shapers of Nature puts and removes" {
  battlefield A: "Shapers of Nature", 4 "Forest", 3 "Island"
  library A: "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Shapers of Nature" targeting "Shapers of Nature"
  turn 1 A: wait
  turn 1 A: activate "Shapers of Nature" ability 2
  run_to turn 1 postcombat_main
  assert counters "Shapers of Nature" +1/+1 0
  assert hand A count 1
}

scenario "Glissa Sunslayer removes up to three counters" {
  battlefield A: "Glissa Sunslayer"
  battlefield B: "Hill Giant" with 4 +1/+1
  start turn 1 A precombat_main
  turn 1 A: attack "Glissa Sunslayer"
  turn 1 A: trigger "Glissa Sunslayer" mode 3 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 17
  assert counters "Hill Giant" +1/+1 1
}

scenario "Glissa Sunslayer: up to three, stopping after one" {
  battlefield A: "Glissa Sunslayer"
  battlefield B: "Hill Giant" with 4 +1/+1
  start turn 1 A precombat_main
  turn 1 A: attack "Glissa Sunslayer"
  turn 1 A: trigger "Glissa Sunslayer" mode 3 targeting "Hill Giant"
  turn 1 first_strike_damage A: choose "1"
  turn 1 first_strike_damage A: choose done
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 3
}

scenario "Ferropede may remove a counter on combat damage" {
  battlefield A: "Ferropede"
  battlefield B: "Hill Giant" with 2 +1/+1
  start turn 1 A precombat_main
  turn 1 A: attack "Ferropede"
  turn 1 A: trigger "Ferropede" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 19
  assert counters "Hill Giant" +1/+1 1
}

scenario "Thrull Parasite pays life to remove a counter" {
  battlefield A: "Thrull Parasite"
  battlefield B: "Hill Giant" with 2 +1/+1
  start turn 1 A precombat_main
  turn 1 A: activate "Thrull Parasite" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert life A 18
  assert counters "Hill Giant" +1/+1 1
}

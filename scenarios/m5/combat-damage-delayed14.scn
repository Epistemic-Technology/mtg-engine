# Delayed combat-damage triggers (fourteenth wave): about a chosen player
# ("deals combat damage to that player this turn") and from an activated
# ability.

scenario "Great Train Heist: combat damage to the chosen opponent this turn makes tapped Treasures" {
  battlefield A: 2 "Mountain", "Grizzly Bears", "Llanowar Elves"
  hand A: "Great Train Heist"
  turn 1 A: cast "Great Train Heist" mode 4 targeting player B
  turn 1 A: attack "Grizzly Bears", "Llanowar Elves"
  run_to turn 1 postcombat_main
  assert life B 17
  assert battlefield A contains 2 "Treasure"
  assert tapped oldest "Treasure"
  assert tapped newest "Treasure"
}

scenario "Great Train Heist: noncombat damage makes no Treasure, and the trigger ends with the turn" {
  battlefield A: 3 "Mountain", "Grizzly Bears"
  hand A: "Great Train Heist", "Shock"
  turn 1 A: cast "Great Train Heist" mode 4 targeting player B
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  turn 3 A: attack "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert life B 16
  assert battlefield A lacks "Treasure"
}

scenario "Great Train Heist: during your combat phase, untap and an additional combat phase" {
  battlefield A: 4 "Mountain", "Grizzly Bears"
  hand A: "Great Train Heist"
  turn 1 A: attack "Grizzly Bears"
  turn 1 end_combat A: cast "Great Train Heist" mode 1
  turn 1 declare_attackers combat 2 A: attack "Grizzly Bears"
  run_to turn 1 end
  assert life B 16
}

scenario "Great Train Heist: in a main phase, it untaps but adds no combat phase" {
  battlefield A: 4 "Mountain", "Grizzly Bears" tapped
  hand A: "Great Train Heist"
  turn 1 A: cast "Great Train Heist" mode 1
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 end
  assert life B 18
  assert turn 1
}

scenario "Flitterwing Nuisance: after its ability, each combat damage to a player draws a card" {
  battlefield A: "Flitterwing Nuisance" with 1 -1/-1, "Grizzly Bears", 3 "Island"
  turn 1 A: activate "Flitterwing Nuisance"
  turn 1 A: attack "Flitterwing Nuisance", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Flitterwing Nuisance" -1/-1 0
  assert life B 16
  assert hand A count 2
}

scenario "Flitterwing Nuisance: without the ability, no cards" {
  battlefield A: "Flitterwing Nuisance" with 1 -1/-1, 3 "Island"
  turn 1 A: attack "Flitterwing Nuisance"
  run_to turn 1 postcombat_main
  assert life B 19
  assert hand A count 0
}

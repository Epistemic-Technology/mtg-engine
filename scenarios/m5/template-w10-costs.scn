# Activated-ability costs the template author learned in the tenth wave:
# "Sacrifice another creature", "Exile this artifact", "Sacrifice ~",
# "Discard two cards", "Tap three untapped creatures you control", "Remove
# three quest counters from this enchantment and sacrifice it", and hybrid
# and Phyrexian mana symbols.

# "Sacrifice another creature".

scenario "Blazing Hellhound: sacrifice another creature, 1 damage to any target" {
  battlefield A: "Blazing Hellhound", "Grizzly Bears", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Blazing Hellhound" sacrificing "Grizzly Bears" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Blazing Hellhound"
}

scenario "Blazing Hellhound: not by sacrificing itself" {
  battlefield A: "Blazing Hellhound", "Mountain"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Blazing Hellhound" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "Hurler Cyclops: sacrifice another creature, 1 damage" {
  battlefield A: "Hurler Cyclops", "Grizzly Bears", "Mountain"
  battlefield B: "Llanowar Elves"
  start turn 1 A precombat_main
  turn 1 A: activate "Hurler Cyclops" sacrificing "Grizzly Bears" targeting "Llanowar Elves"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Llanowar Elves"
  assert graveyard A contains "Grizzly Bears"
}

scenario "Fleshtaker: +2/+2, and its sacrifice trigger gains 1 life" {
  battlefield A: "Fleshtaker", "Grizzly Bears", "Plains"
  library A: "Island", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Fleshtaker" sacrificing "Grizzly Bears"
  run_to turn 1 begin_combat
  assert power "Fleshtaker" 4
  assert toughness "Fleshtaker" 4
  assert life A 21
}

scenario "Denethor, Ruling Steward: drain 1, then a token at the end step" {
  battlefield A: "Denethor, Ruling Steward", "Grizzly Bears", 2 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Denethor, Ruling Steward" sacrificing "Grizzly Bears"
  run_to turn 1 cleanup
  assert life B 19
  assert life A 21
  assert battlefield A contains "Human Soldier"
}

scenario "Gobbling Ooze: a +1/+1 counter for another creature" {
  battlefield A: "Gobbling Ooze", "Grizzly Bears", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Gobbling Ooze" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Gobbling Ooze" +1/+1 1
}

scenario "Ravenous Harpy: a +1/+1 counter" {
  battlefield A: "Ravenous Harpy", "Grizzly Bears", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Ravenous Harpy" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Ravenous Harpy" +1/+1 1
  assert power "Ravenous Harpy" 2
}

scenario "Blood Host: a counter and 2 life" {
  battlefield A: "Blood Host", "Grizzly Bears", 2 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Blood Host" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Blood Host" +1/+1 1
  assert life A 22
}

scenario "Aron, Benalia's Ruin: a counter on each creature you control" {
  battlefield A: "Aron, Benalia's Ruin", "Grizzly Bears", "Llanowar Elves", "Plains", "Swamp"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Aron, Benalia's Ruin" sacrificing "Llanowar Elves"
  run_to turn 1 postcombat_main
  assert counters "Aron, Benalia's Ruin" +1/+1 1
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 0
  assert tapped "Aron, Benalia's Ruin"
}

scenario "Pitiless Pontiff: deathtouch and indestructible" {
  battlefield A: "Pitiless Pontiff", "Grizzly Bears", "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Pitiless Pontiff" sacrificing "Grizzly Bears"
  run_to turn 1 begin_combat
  assert has "Pitiless Pontiff" deathtouch
  assert has "Pitiless Pontiff" indestructible
}

scenario "Vampire Warlord: regenerates by sacrificing another creature" {
  battlefield A: "Vampire Warlord", "Grizzly Bears", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: activate "Vampire Warlord" sacrificing "Grizzly Bears"
  turn 1 begin_combat A: cast "Lightning Bolt" targeting "Vampire Warlord"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Vampire Warlord"
  assert tapped "Vampire Warlord"
}

scenario "Woe Strider: sacrifice the Goat to scry 1" {
  battlefield A: "Woe Strider", "Goat"
  library A: "Island", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Woe Strider" sacrificing "Goat"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Goat"
}

scenario "Qarsi High Priest: manifest the top card" {
  battlefield A: "Qarsi High Priest", "Grizzly Bears", 2 "Swamp"
  library A: "Hill Giant", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Qarsi High Priest" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert library A count 1
}

scenario "Fiend Artisan: X 2 finds a creature card with mana value 2 or less" {
  battlefield A: "Fiend Artisan", "Llanowar Elves", 3 "Swamp"
  library A: "Hill Giant", "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: activate "Fiend Artisan" x 2 sacrificing "Llanowar Elves"
  turn 2 A: choose "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert library A contains "Hill Giant"
  assert power "Fiend Artisan" 2
}

scenario "Wight of the Reliquary: a land card onto the battlefield tapped" {
  battlefield A: "Wight of the Reliquary", "Grizzly Bears"
  library A: "Forest", "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: activate "Wight of the Reliquary" sacrificing "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Forest"
  assert tapped "Forest"
  assert power "Wight of the Reliquary" 3
}

scenario "Razaketh, the Foulblooded: 2 life and another creature for any card" {
  battlefield A: "Razaketh, the Foulblooded", "Grizzly Bears"
  library A: "Forest", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: activate "Razaketh, the Foulblooded" sacrificing "Grizzly Bears"
  turn 1 A: choose "Lightning Bolt"
  run_to turn 1 postcombat_main
  assert hand A contains "Lightning Bolt"
  assert life A 18
}

scenario "Warren Soultrader: 1 life and another creature for a Treasure" {
  battlefield A: "Warren Soultrader", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Warren Soultrader" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Treasure"
  assert life A 19
}

scenario "Yawgmoth, Thran Physician: a -1/-1 counter and a card" {
  battlefield A: "Yawgmoth, Thran Physician", "Grizzly Bears"
  battlefield B: "Llanowar Elves"
  library A: "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Yawgmoth, Thran Physician" ability 1 sacrificing "Grizzly Bears" targeting "Llanowar Elves"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Llanowar Elves"
  assert hand A contains "Island"
  assert life A 19
}

scenario "Undercity Necrolisk: a counter and menace, as a sorcery" {
  battlefield A: "Undercity Necrolisk", "Grizzly Bears", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Undercity Necrolisk" sacrificing "Grizzly Bears"
  run_to turn 1 begin_combat
  assert counters "Undercity Necrolisk" +1/+1 1
  assert has "Undercity Necrolisk" menace
}

scenario "Yahenni, Undying Partisan: indestructible for another creature" {
  battlefield A: "Yahenni, Undying Partisan", "Grizzly Bears", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: activate "Yahenni, Undying Partisan" sacrificing "Grizzly Bears"
  turn 1 begin_combat A: cast "Lightning Bolt" targeting "Yahenni, Undying Partisan"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Yahenni, Undying Partisan"
}

scenario "Tymaret, the Murder King: 2 damage to target player" {
  battlefield A: "Tymaret, the Murder King", "Grizzly Bears", 2 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Tymaret, the Murder King" sacrificing "Grizzly Bears" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "Reaper of Flight Moonsilver: not without delirium" {
  battlefield A: "Reaper of Flight Moonsilver", "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Reaper of Flight Moonsilver" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Reaper of Flight Moonsilver" 3
}

scenario "Reaper of Flight Moonsilver: +2/+1 with delirium" {
  battlefield A: "Reaper of Flight Moonsilver", "Grizzly Bears"
  graveyard A: "Forest", "Lightning Bolt", "Ornithopter", "Divination"
  start turn 1 A precombat_main
  turn 1 A: activate "Reaper of Flight Moonsilver" sacrificing "Grizzly Bears"
  run_to turn 1 begin_combat
  assert power "Reaper of Flight Moonsilver" 5
  assert toughness "Reaper of Flight Moonsilver" 4
}

scenario "Shadow-Rite Priest: another Cleric for a black creature card" {
  battlefield A: "Shadow-Rite Priest", "Acolyte of Xathrid", 5 "Swamp"
  library A: "Grizzly Bears", "Black Knight"
  start turn 1 A precombat_main
  turn 1 A: activate "Shadow-Rite Priest" sacrificing "Acolyte of Xathrid"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Black Knight"
  assert library A contains "Grizzly Bears"
}

scenario "Shadow-Rite Priest: not another non-Cleric" {
  battlefield A: "Shadow-Rite Priest", "Grizzly Bears", 5 "Swamp"
  library A: "Black Knight"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Shadow-Rite Priest" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

# "Sacrifice another creature or artifact", "... or planeswalker",
# "... artifact or creature", "... permanent".

scenario "Dreadmalkin: two counters for another creature" {
  battlefield A: "Dreadmalkin", "Grizzly Bears", 3 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Dreadmalkin" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Dreadmalkin" +1/+1 2
}

scenario "Dreadmobile: another artifact for a counter" {
  battlefield A: "Dreadmobile", "Darksteel Relic", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Dreadmobile" sacrificing "Darksteel Relic"
  run_to turn 1 postcombat_main
  assert counters "Dreadmobile" +1/+1 1
  assert graveyard A contains "Darksteel Relic"
}

scenario "Stormclaw Rager: an artifact for a counter and a card" {
  battlefield A: "Stormclaw Rager", "Darksteel Relic", "Swamp"
  library A: "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Stormclaw Rager" sacrificing "Darksteel Relic"
  run_to turn 1 postcombat_main
  assert counters "Stormclaw Rager" +1/+1 1
  assert hand A contains "Island"
}

scenario "Compleated Huntmaster: incubate 3" {
  battlefield A: "Compleated Huntmaster", "Darksteel Relic", "Swamp"
  start turn 2 A precombat_main
  turn 2 A: activate "Compleated Huntmaster" sacrificing "Darksteel Relic"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Incubator"
  assert counters "Incubator" +1/+1 3
}

scenario "Pious Evangel: sacrifice another permanent to transform" {
  battlefield A: "Pious Evangel // Wayward Disciple", "Darksteel Relic", 2 "Plains"
  start turn 2 A precombat_main
  turn 2 A: activate "Pious Evangel" sacrificing "Darksteel Relic"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Wayward Disciple"
}

# "Exile this artifact", "Exile ~".

scenario "Brittle Effigy: exile it to exile target creature" {
  battlefield A: "Brittle Effigy", 4 "Island"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Brittle Effigy" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert exile A contains "Brittle Effigy"
}

scenario "Perilous Vault: exile all nonland permanents" {
  battlefield A: "Perilous Vault", 5 "Island", "Grizzly Bears"
  battlefield B: "Hill Giant", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Perilous Vault"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert exile A contains "Grizzly Bears"
  assert exile A contains "Perilous Vault"
  assert battlefield B contains "Forest"
}

scenario "Hanged Executioner: exile it to exile target creature" {
  battlefield A: "Hanged Executioner", 4 "Plains"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Hanged Executioner" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert exile A contains "Hanged Executioner"
}

scenario "Inquisitive Puppet: exile it for a Human" {
  battlefield A: "Inquisitive Puppet"
  start turn 1 A precombat_main
  turn 1 A: activate "Inquisitive Puppet"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Human"
  assert exile A contains "Inquisitive Puppet"
}

scenario "Nyx Weaver: exile it to return a card" {
  battlefield A: "Nyx Weaver", "Swamp", "Forest", "Island"
  graveyard A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: activate "Nyx Weaver" targeting "Lightning Bolt"
  run_to turn 1 postcombat_main
  assert hand A contains "Lightning Bolt"
  assert exile A contains "Nyx Weaver"
}

scenario "Cranial Archive: a player shuffles their graveyard in; draw a card" {
  battlefield A: "Cranial Archive", 2 "Island"
  graveyard B: "Hill Giant", "Forest"
  library A: "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Cranial Archive" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B count 0
  assert library B contains "Hill Giant"
  assert hand A contains "Island"
}

scenario "Crook of Condemnation: exile it to exile all graveyards" {
  battlefield A: "Crook of Condemnation", "Island"
  graveyard A: "Lightning Bolt"
  graveyard B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Crook of Condemnation" ability 2
  run_to turn 1 postcombat_main
  assert exile A contains "Lightning Bolt"
  assert exile B contains "Hill Giant"
}

scenario "Sentinel Totem: exile all graveyards" {
  battlefield A: "Sentinel Totem"
  graveyard B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Sentinel Totem"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert exile A contains "Sentinel Totem"
}

scenario "Abstergo Entertainment: a historic card back, then all graveyards exiled" {
  battlefield A: "Abstergo Entertainment", 3 "Island"
  graveyard A: "Darksteel Relic", "Lightning Bolt"
  graveyard B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Abstergo Entertainment" ability 2 targeting "Darksteel Relic"
  run_to turn 1 postcombat_main
  assert hand A contains "Darksteel Relic"
  assert exile A contains "Lightning Bolt"
  assert exile B contains "Hill Giant"
  assert exile A contains "Abstergo Entertainment"
}

# "Sacrifice ~" (the card's name).

scenario "Inventors' Fair: not with two artifacts" {
  battlefield A: "Inventors' Fair", 4 "Island", "Darksteel Relic", "Ornithopter"
  library A: "Sol Ring"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Inventors' Fair" ability 1
  run_to turn 1 postcombat_main
  assert library A contains "Sol Ring"
}

scenario "Inventors' Fair: an artifact card with three artifacts" {
  battlefield A: "Inventors' Fair", 4 "Island", "Darksteel Relic", "Ornithopter", "Memnite"
  library A: "Sol Ring", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Inventors' Fair" ability 1
  run_to turn 1 postcombat_main
  assert hand A contains "Sol Ring"
  assert graveyard A contains "Inventors' Fair"
}

scenario "Stone of Erech: exile target player's graveyard; draw a card" {
  battlefield A: "Stone of Erech", 2 "Island"
  graveyard B: "Hill Giant"
  library A: "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Stone of Erech" targeting player B
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert hand A contains "Island"
  assert graveyard A contains "Stone of Erech"
}

scenario "Hajar, Loyal Bodyguard: legendary creatures get +1/+0 and indestructible" {
  battlefield A: "Hajar, Loyal Bodyguard", "Yahenni, Undying Partisan", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Hajar, Loyal Bodyguard"
  run_to turn 1 begin_combat
  assert power "Yahenni, Undying Partisan" 3
  assert has "Yahenni, Undying Partisan" indestructible
  assert power "Grizzly Bears" 2
  assert graveyard A contains "Hajar, Loyal Bodyguard"
}

scenario "Kagemaro, First to Suffer: -X/-X for the cards in hand" {
  battlefield A: "Kagemaro, First to Suffer", "Swamp"
  battlefield B: "Grizzly Bears", "Hill Giant"
  hand A: "Island", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Kagemaro, First to Suffer"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert battlefield B contains "Hill Giant"
  assert power "Hill Giant" 1
}

# "Discard two cards", "Discard three cards".

scenario "Haunted Dead: discard two cards to return tapped" {
  battlefield A: 2 "Swamp"
  graveyard A: "Haunted Dead"
  hand A: "Island", "Forest"
  start turn 2 A precombat_main
  turn 2 A: activate "Haunted Dead"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Haunted Dead"
  assert tapped "Haunted Dead"
  assert hand A count 0
  assert battlefield A contains "Spirit"
}

scenario "Haunted Dead: not with one card in hand" {
  battlefield A: 2 "Swamp"
  graveyard A: "Haunted Dead"
  hand A: "Island"
  start turn 2 A precombat_main
  illegal turn 2 A: activate "Haunted Dead"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Haunted Dead"
}


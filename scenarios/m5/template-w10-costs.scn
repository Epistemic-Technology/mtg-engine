# "Tap three untapped creatures you control", "Tap two untapped artifacts
# you control".

scenario "Sandsower: three untapped creatures tap target creature" {
  battlefield A: "Sandsower", "Grizzly Bears", "Llanowar Elves"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Sandsower" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert tapped "Hill Giant"
  assert tapped "Grizzly Bears"
  assert tapped "Llanowar Elves"
  assert tapped "Sandsower"
}

scenario "Sandsower: not with two creatures" {
  battlefield A: "Sandsower", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Sandsower" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert untapped "Hill Giant"
}

scenario "Skaab Wrangler: three untapped creatures tap target creature" {
  battlefield A: "Skaab Wrangler", "Grizzly Bears", "Llanowar Elves"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Skaab Wrangler" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert tapped "Hill Giant"
}

scenario "Nullmage Shepherd: four untapped creatures destroy an artifact" {
  battlefield A: "Nullmage Shepherd", "Grizzly Bears", "Llanowar Elves", "Hill Giant"
  battlefield B: "Sol Ring"
  start turn 1 A precombat_main
  turn 1 A: activate "Nullmage Shepherd" targeting "Sol Ring"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Sol Ring"
  assert tapped "Hill Giant"
}

scenario "Root-Kin Ally: two untapped creatures for +2/+2" {
  battlefield A: "Root-Kin Ally", "Grizzly Bears", "Llanowar Elves"
  start turn 1 A precombat_main
  turn 1 A: activate "Root-Kin Ally"
  run_to turn 1 begin_combat
  assert power "Root-Kin Ally" 5
}

scenario "Altar Golem: five untapped creatures untap it" {
  battlefield A: "Altar Golem" tapped, "Grizzly Bears", "Llanowar Elves", "Hill Giant", "Savannah Lions", "Raging Goblin"
  start turn 1 A precombat_main
  turn 1 A: activate "Altar Golem"
  run_to turn 1 postcombat_main
  assert untapped "Altar Golem"
  assert tapped "Raging Goblin"
}

scenario "Skirsdag High Priest: a Demon after a creature died this turn" {
  battlefield A: "Skirsdag High Priest", "Grizzly Bears", "Llanowar Elves", "Mountain"
  battlefield B: "Savannah Lions"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Savannah Lions"
  turn 1 A: activate "Skirsdag High Priest"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Demon"
}

scenario "Skirsdag High Priest: not before a creature died" {
  battlefield A: "Skirsdag High Priest", "Grizzly Bears", "Llanowar Elves"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Skirsdag High Priest"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Demon"
}

scenario "Clock of Omens: two untapped artifacts untap target artifact" {
  battlefield A: "Clock of Omens", "Darksteel Relic", "Ornithopter", "Sol Ring" tapped
  start turn 1 A precombat_main
  turn 1 A: activate "Clock of Omens" targeting "Sol Ring"
  run_to turn 1 postcombat_main
  assert untapped "Sol Ring"
}

scenario "Ghirapur Aether Grid: two untapped artifacts, 1 damage" {
  battlefield A: "Ghirapur Aether Grid", "Darksteel Relic", "Ornithopter"
  start turn 1 A precombat_main
  turn 1 A: activate "Ghirapur Aether Grid" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert tapped "Ornithopter"
}

scenario "Ghirapur Aether Grid: not with one artifact" {
  battlefield A: "Ghirapur Aether Grid", "Darksteel Relic"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Ghirapur Aether Grid" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "Whirler Rogue: two Thopters make a creature unblockable" {
  battlefield A: "Whirler Rogue", 2 "1/1 colorless Thopter artifact creature with flying"
  battlefield B: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: activate "Whirler Rogue" targeting "Whirler Rogue"
  turn 2 A: attack "Whirler Rogue"
  illegal turn 2 B: block "Whirler Rogue" with "Hill Giant"
  run_to turn 2 postcombat_main
  assert life B 18
}

scenario "Shimmer Dragon: two untapped artifacts draw a card" {
  battlefield A: "Shimmer Dragon", "Darksteel Relic", "Ornithopter"
  library A: "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Shimmer Dragon"
  run_to turn 1 postcombat_main
  assert hand A contains "Island"
}

# "Remove three quest counters from this enchantment and sacrifice it".

scenario "Quest for the Gravelord: three quest counters for a 5/5 Zombie Giant" {
  battlefield A: "Quest for the Gravelord" with 3 quest
  start turn 1 A precombat_main
  turn 1 A: activate "Quest for the Gravelord"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Zombie Giant"
  assert power "Zombie Giant" 5
  assert graveyard A contains "Quest for the Gravelord"
}

scenario "Quest for the Gravelord: not with two counters" {
  battlefield A: "Quest for the Gravelord" with 2 quest
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Quest for the Gravelord"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Zombie Giant"
}

scenario "Soul Stair Expedition: two creature cards back to hand" {
  battlefield A: "Soul Stair Expedition" with 3 quest
  graveyard A: "Grizzly Bears", "Hill Giant", "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: activate "Soul Stair Expedition" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand A contains "Hill Giant"
  assert graveyard A contains "Soul Stair Expedition"
}

scenario "Zektar Shrine Expedition: a 7/1 Elemental with haste, exiled at the end step" {
  battlefield A: "Zektar Shrine Expedition" with 3 quest
  start turn 2 A precombat_main
  turn 2 A: activate "Zektar Shrine Expedition"
  turn 2 A: attack "Elemental"
  run_to turn 2 postcombat_main
  assert life B 13
  run_to turn 3 upkeep
  assert battlefield A lacks "Elemental"
}


scenario "Geralf's Masterpiece: not with two cards" {
  battlefield A: 4 "Island"
  graveyard A: "Geralf's Masterpiece"
  hand A: "Island", "Forest"
  start turn 2 A precombat_main
  illegal turn 2 A: activate "Geralf's Masterpiece"

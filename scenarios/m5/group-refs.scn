# "them", "they", "those creatures" after a group: the objects that group
# denoted earlier in the resolution (CR 608.2c), not a fresh group.

scenario "Broadcast Takeover: untap them is the stolen artifacts, not your lands" {
  battlefield A: 6 "Mountain"
  battlefield B: "Ornithopter" tapped, "Grizzly Bears" tapped
  hand A: "Broadcast Takeover"
  start turn 1 A precombat_main
  turn 1 A: cast "Broadcast Takeover"
  run_to turn 1 begin_combat
  assert battlefield A contains "Ornithopter"
  assert untapped "Ornithopter"
  assert has "Ornithopter" haste
  # The lands that paid for it stay tapped; the creature isn't an artifact.
  assert tapped "Grizzly Bears"
  assert battlefield B contains "Grizzly Bears"
  run_to turn 2 upkeep
  assert battlefield B contains "Ornithopter"
}

scenario "Broadcast Takeover: the Mountains it was cast with stay tapped" {
  battlefield A: 5 "Mountain"
  battlefield B: "Ornithopter" tapped
  hand A: "Broadcast Takeover"
  start turn 1 A precombat_main
  turn 1 A: cast "Broadcast Takeover"
  run_to turn 1 begin_combat
  assert tapped oldest "Mountain"
  assert tapped newest "Mountain"
}

scenario "Broadcast Takeover: the stolen artifact attacks" {
  battlefield A: 5 "Mountain"
  battlefield B: "Ornithopter" tapped
  hand A: "Broadcast Takeover"
  start turn 1 A precombat_main
  turn 1 A: cast "Broadcast Takeover"
  turn 1 A: attack "Ornithopter"
  run_to turn 1 postcombat_main
  assert tapped "Ornithopter"
}

scenario "Sandstorm Salvager: they gain trample is only the creature tokens" {
  battlefield A: "Sandstorm Salvager", "Grizzly Bears", 4 "Plains"
  hand A: "Raise the Alarm"
  start turn 1 A precombat_main
  turn 1 A: cast "Raise the Alarm"
  turn 1 A: wait
  turn 1 A: activate "Sandstorm Salvager"
  run_to turn 1 begin_combat
  assert counters oldest "Soldier" +1/+1 1
  assert has oldest "Soldier" trample
  assert has newest "Soldier" trample
  assert counters "Grizzly Bears" +1/+1 0
  assert has not "Grizzly Bears" trample
  assert has not "Sandstorm Salvager" trample
}

scenario "Essence of Antiquity: turned face up, creatures you control gain hexproof and untap" {
  battlefield A: "Grizzly Bears" tapped, 6 "Plains"
  battlefield B: "Memnite" tapped
  hand A: "Essence of Antiquity"
  start turn 1 A precombat_main
  turn 1 A: cast "Essence of Antiquity" face_down
  turn 1 postcombat_main A: unmorph "Essence of Antiquity"
  run_to turn 1 end
  assert untapped "Grizzly Bears"
  assert has "Grizzly Bears" hexproof
  assert tapped "Memnite"
  assert has not "Memnite" hexproof
}

scenario "Bounding Felidar: 1 life for each of those creatures" {
  battlefield A: "Bounding Felidar", "Grizzly Bears", 2 "Memnite"
  battlefield B: "Ornithopter"
  turn 1 A: activate "Bounding Felidar"
  turn 1 A: attack "Bounding Felidar"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters oldest "Memnite" +1/+1 1
  assert counters "Bounding Felidar" +1/+1 0
  assert counters "Ornithopter" +1/+1 0
  assert life A 23
}

scenario "Bounding Felidar: not saddled, no counters and no life" {
  battlefield A: "Bounding Felidar", "Grizzly Bears", 2 "Memnite"
  turn 1 A: attack "Bounding Felidar"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
  assert life A 20
}

scenario "The Ooze: a Mutagen for each +1/+1 counter on the creature that left" {
  battlefield A: "The Ooze", "Grizzly Bears" with 2 +1/+1, 2 "Swamp"
  hand A: "Doom Blade"
  start turn 1 A precombat_main
  turn 1 A: cast "Doom Blade" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert battlefield A contains 2 "Mutagen"
}

scenario "The Ooze: a creature without counters leaving makes none" {
  battlefield A: "The Ooze", "Grizzly Bears", 2 "Swamp"
  hand A: "Doom Blade"
  start turn 1 A precombat_main
  turn 1 A: cast "Doom Blade" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert battlefield A lacks "Mutagen"
}

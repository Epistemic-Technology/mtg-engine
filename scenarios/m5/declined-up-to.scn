# A declined "up to one" target keeps its slot, so the spell's later
# targets are still chosen (CR 601.2c). `none` declines a target in a
# `targeting` list.

scenario "Explosive Entry with no artifact still puts a counter on a creature" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  hand A: "Explosive Entry"
  turn 1 A: cast "Explosive Entry" targeting none, "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Explosive Entry declining the artifact while one is on the battlefield" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  battlefield B: "Ornithopter"
  hand A: "Explosive Entry"
  turn 1 A: cast "Explosive Entry" targeting none, "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert battlefield B contains "Ornithopter"
}

scenario "Explosive Entry declining both targets still resolves" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  battlefield B: "Ornithopter"
  hand A: "Explosive Entry"
  turn 1 A: cast "Explosive Entry" targeting none, none
  run_to turn 1 postcombat_main
  assert graveyard A contains "Explosive Entry"
  assert battlefield B contains "Ornithopter"
  assert counters "Grizzly Bears" +1/+1 0
}

scenario "Explosive Entry with both targets" {
  battlefield A: 2 "Mountain", "Grizzly Bears"
  battlefield B: "Ornithopter"
  hand A: "Explosive Entry"
  turn 1 A: cast "Explosive Entry" targeting "Ornithopter", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Ornithopter"
  assert counters "Grizzly Bears" +1/+1 1
}

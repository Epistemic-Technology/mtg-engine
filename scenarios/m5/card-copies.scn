# Copies of cards that aren't permanents (CR 707.2): a token that's a copy
# of a card in a graveyard or exile, a permanent becoming a copy of such a
# card, and a permanent entering as a copy of a card in a graveyard or of
# a land.

scenario "the scarab god: a 4/4 black Zombie copy of an exiled creature card" {
  battlefield A: "The Scarab God", 2 "Island", 2 "Swamp"
  graveyard B: "Serra Angel"
  turn 1 A: activate "The Scarab God" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert exile B contains "Serra Angel"
  assert battlefield A contains "Serra Angel"
  assert power A "Serra Angel" 4
  assert toughness A "Serra Angel" 4
  assert is A "Serra Angel" black
  assert is not A "Serra Angel" white
  assert is A "Serra Angel" Zombie
  assert is not A "Serra Angel" Angel
  assert has A "Serra Angel" flying
  assert has A "Serra Angel" vigilance
}

scenario "the scarab god: the card left the graveyard, no token" {
  battlefield A: "The Scarab God", 2 "Island", 2 "Swamp"
  battlefield B: "Swamp"
  graveyard B: "Serra Angel"
  hand B: "Coffin Purge"
  turn 1 A: activate "The Scarab God" targeting "Serra Angel"
  turn 1 B: cast "Coffin Purge" targeting "Serra Angel" in response to trigger "The Scarab God"
  run_to turn 1 postcombat_main
  assert battlefield A count 5
}

scenario "the scarab god: each opponent loses life and you scry for each Zombie" {
  battlefield A: "The Scarab God", "Gravecrawler", "Gravecrawler"
  life B 20
  run_to turn 1 draw
  assert life B 18
  run_to turn 3 draw
  assert life B 16
}

scenario "the scarab god: returns to its owner's hand at the next end step" {
  battlefield A: "The Scarab God"
  battlefield B: 2 "Mountain"
  hand B: "Lightning Bolt", "Lightning Bolt"
  turn 2 B: cast "Lightning Bolt" targeting "The Scarab God"
  turn 2 B: cast "Lightning Bolt" targeting "The Scarab God"
  run_to turn 2 cleanup
  assert hand A contains "The Scarab God"
}

scenario "god-pharaoh's gift: a 4/4 black Zombie copy of a creature card, with haste" {
  battlefield A: "God-Pharaoh's Gift"
  graveyard A: "Serra Angel", "Grizzly Bears"
  turn 1 A: accept "God-Pharaoh's Gift"
  turn 1 A: choose "Serra Angel"
  run_to turn 1 declare_attackers
  assert exile A contains "Serra Angel"
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Serra Angel"
  assert power A "Serra Angel" 4
  assert toughness A "Serra Angel" 4
  assert is A "Serra Angel" black
  assert is A "Serra Angel" Zombie
  assert has A "Serra Angel" flying
  assert has A "Serra Angel" haste
}

scenario "god-pharaoh's gift: declined, nothing is exiled" {
  battlefield A: "God-Pharaoh's Gift"
  graveyard A: "Serra Angel"
  turn 1 A: decline "God-Pharaoh's Gift"
  run_to turn 1 declare_attackers
  assert graveyard A contains "Serra Angel"
  assert battlefield A lacks "Serra Angel"
}

scenario "vesuva: enters tapped as a copy of a land on the battlefield" {
  battlefield B: "Mishra's Factory"
  hand A: "Vesuva"
  turn 1 A: play "Vesuva"
  turn 1 A: copy B "Mishra's Factory"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Mishra's Factory"
  assert battlefield A lacks "Vesuva"
  assert tapped A "Mishra's Factory"
  assert untapped B "Mishra's Factory"
}

scenario "vesuva: the copy's abilities work" {
  battlefield B: "Mishra's Factory"
  battlefield A: "Plains"
  hand A: "Vesuva"
  turn 1 A: play "Vesuva"
  turn 1 A: copy B "Mishra's Factory"
  turn 3 A: activate A "Mishra's Factory"
  run_to turn 3 postcombat_main
  assert is A "Mishra's Factory" creature
  assert power A "Mishra's Factory" 2
}

scenario "vesuva: copying nothing, it enters untapped as itself" {
  battlefield B: "Mishra's Factory"
  hand A: "Vesuva"
  turn 1 A: play "Vesuva"
  turn 1 A: copy nothing
  run_to turn 1 postcombat_main
  assert battlefield A contains "Vesuva"
  assert untapped "Vesuva"
}

scenario "echoing deeps: a tapped copy of a land card in a graveyard, and a Cave" {
  graveyard B: "Ghost Quarter"
  hand A: "Echoing Deeps"
  turn 1 A: play "Echoing Deeps"
  turn 1 A: copy "Ghost Quarter"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Ghost Quarter"
  assert graveyard B contains "Ghost Quarter"
  assert tapped A "Ghost Quarter"
  assert is A "Ghost Quarter" Cave
}

scenario "echoing deeps: a land on the battlefield can't be copied" {
  battlefield B: "Ghost Quarter"
  hand A: "Echoing Deeps"
  turn 1 A: play "Echoing Deeps"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Echoing Deeps"
  assert untapped "Echoing Deeps"
  assert is "Echoing Deeps" Cave
}

scenario "thespian's stage: becomes a copy of a land and keeps its ability" {
  battlefield A: "Thespian's Stage", 2 "Plains"
  battlefield B: "Mishra's Factory", "Ghost Quarter"
  turn 1 A: activate "Thespian's Stage" ability 2 targeting B "Mishra's Factory"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Mishra's Factory"
  assert battlefield A lacks "Thespian's Stage"
  turn 3 A: activate A "Mishra's Factory" ability 3 targeting "Ghost Quarter"
  run_to turn 3 postcombat_main
  assert battlefield A contains "Ghost Quarter"
  assert battlefield A lacks "Mishra's Factory"
}

scenario "clone returned from a graveyard still enters as a copy" {
  battlefield A: 4 "Swamp"
  battlefield B: "Serra Angel"
  graveyard A: "Clone"
  hand A: "Zombify"
  turn 1 A: cast "Zombify" targeting "Clone"
  turn 1 A: copy B "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Serra Angel"
  assert power A "Serra Angel" 4
  assert has A "Serra Angel" flying
}

scenario "likeness looter: becomes a copy of a creature card in your graveyard, with flying" {
  battlefield A: "Likeness Looter", 4 "Island"
  graveyard A: "Hill Giant"
  turn 1 A: activate "Likeness Looter" ability 2 x 4 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert battlefield A lacks "Likeness Looter"
  assert graveyard A contains "Hill Giant"
  assert power A "Hill Giant" 3
  assert toughness A "Hill Giant" 3
  assert has A "Hill Giant" flying
}

scenario "likeness looter: keeps the ability after copying" {
  battlefield A: "Likeness Looter", 6 "Island"
  graveyard A: "Hill Giant", "Grizzly Bears"
  turn 1 A: activate "Likeness Looter" ability 2 x 4 targeting "Hill Giant"
  turn 3 A: activate A "Hill Giant" x 2 targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert battlefield A lacks "Hill Giant"
  assert has A "Grizzly Bears" flying
}

scenario "lazav, familiar stranger: a crime, a counter, and a copy of an exiled creature card until end of turn" {
  battlefield A: "Lazav, Familiar Stranger", "Mountain"
  graveyard B: "Grizzly Bears", "Serra Angel"
  hand A: "Lightning Bolt"
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 A: accept "Lazav, Familiar Stranger"
  turn 1 A: choose "Serra Angel"
  turn 1 A: accept "Lazav, Familiar Stranger"
  run_to turn 1 postcombat_main
  assert exile B contains "Serra Angel"
  assert battlefield A contains "Serra Angel"
  assert power A "Serra Angel" 5
  assert toughness A "Serra Angel" 5
  assert has A "Serra Angel" flying
  run_to turn 2 upkeep
  assert battlefield A contains "Lazav, Familiar Stranger"
  assert power "Lazav, Familiar Stranger" 2
  assert toughness "Lazav, Familiar Stranger" 5
}

scenario "lazav, familiar stranger: a noncreature card exiled, no copy" {
  battlefield A: "Lazav, Familiar Stranger", "Mountain"
  graveyard B: "Lightning Bolt"
  hand A: "Lightning Bolt"
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 A: accept "Lazav, Familiar Stranger"
  run_to turn 1 postcombat_main
  assert exile B contains "Lightning Bolt"
  assert battlefield A contains "Lazav, Familiar Stranger"
  assert power "Lazav, Familiar Stranger" 2
}

scenario "lazav, familiar stranger: triggers only once each turn" {
  battlefield A: "Lazav, Familiar Stranger", 2 "Mountain"
  hand A: "Lightning Bolt", "Lightning Bolt"
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 A: decline "Lazav, Familiar Stranger"
  run_to turn 1 postcombat_main
  assert life B 14
  assert graveyard A contains 2 "Lightning Bolt"
  assert power "Lazav, Familiar Stranger" 2
}

scenario "nexus of becoming: draw, then a 3/3 Golem artifact creature copy of a card exiled from hand" {
  battlefield A: "Nexus of Becoming"
  hand A: "Darksteel Relic", "Lightning Bolt"
  library A: "Island"
  turn 1 A: accept "Nexus of Becoming"
  run_to turn 1 declare_attackers
  assert hand A contains "Island"
  assert hand A contains "Lightning Bolt"
  assert exile A contains "Darksteel Relic"
  assert battlefield A contains "Darksteel Relic"
  assert is A "Darksteel Relic" creature
  assert is A "Darksteel Relic" artifact
  assert is A "Darksteel Relic" Golem
  assert power A "Darksteel Relic" 3
  assert toughness A "Darksteel Relic" 3
  assert has A "Darksteel Relic" indestructible
}

scenario "nexus of becoming: a creature card keeps its types and is an artifact too" {
  battlefield A: "Nexus of Becoming"
  hand A: "Serra Angel", "Grizzly Bears"
  library A: "Island"
  turn 1 A: accept "Nexus of Becoming"
  turn 1 A: choose "Serra Angel"
  run_to turn 1 declare_attackers
  assert battlefield A contains "Serra Angel"
  assert is A "Serra Angel" Angel
  assert is A "Serra Angel" Golem
  assert is A "Serra Angel" artifact
  assert power A "Serra Angel" 3
  assert has A "Serra Angel" flying
}

scenario "nexus of becoming: an instant card can't be exiled" {
  battlefield A: "Nexus of Becoming"
  hand A: "Lightning Bolt"
  library A: "Island"
  run_to turn 1 declare_attackers
  assert hand A contains "Lightning Bolt"
  assert exile A count 0
}

scenario "ardyn, the usurper: a 5/5 black Demon copy with menace, lifelink, and haste" {
  battlefield A: "Ardyn, the Usurper"
  graveyard B: "Serra Angel"
  turn 1 A: trigger "Ardyn, the Usurper" targeting "Serra Angel"
  run_to turn 1 declare_attackers
  assert exile B contains "Serra Angel"
  assert battlefield A contains "Serra Angel"
  assert power A "Serra Angel" 5
  assert is A "Serra Angel" Demon
  assert is A "Serra Angel" black
  assert has A "Serra Angel" flying
  assert has A "Serra Angel" menace
  assert has A "Serra Angel" haste
  assert has A "Serra Angel" lifelink
}

scenario "ardyn, the usurper: no target, no token" {
  battlefield A: "Ardyn, the Usurper"
  run_to turn 1 declare_attackers
  assert battlefield A count 1
}

scenario "dimir doppelganger: exiles a creature card and becomes a copy, keeping the ability" {
  battlefield A: "Dimir Doppelganger", 3 "Island", 3 "Swamp"
  graveyard B: "Serra Angel", "Hill Giant"
  turn 1 A: activate "Dimir Doppelganger" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert exile B contains "Serra Angel"
  assert battlefield A contains "Serra Angel"
  assert battlefield A lacks "Dimir Doppelganger"
  assert power A "Serra Angel" 4
  turn 3 A: activate A "Serra Angel" targeting "Hill Giant"
  run_to turn 3 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert exile B contains "Hill Giant"
}

scenario "body double: enters as a copy of a creature card in a graveyard" {
  battlefield A: 5 "Island"
  battlefield B: "Grizzly Bears"
  graveyard B: "Serra Angel"
  hand A: "Body Double"
  turn 1 A: cast "Body Double"
  turn 1 A: copy "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Serra Angel"
  assert graveyard B contains "Serra Angel"
  assert power A "Serra Angel" 4
  assert has A "Serra Angel" flying
}

scenario "body double: a creature on the battlefield isn't offered" {
  battlefield A: 5 "Island"
  battlefield B: "Grizzly Bears"
  hand A: "Body Double"
  turn 1 A: cast "Body Double"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Body Double"
  assert battlefield A lacks "Grizzly Bears"
}

scenario "hour of eternity: a 4/4 black Zombie copy of each card exiled" {
  battlefield A: 7 "Island"
  graveyard A: "Serra Angel", "Hill Giant", "Grizzly Bears"
  hand A: "Hour of Eternity"
  turn 1 A: cast "Hour of Eternity" x 2 targeting "Serra Angel", "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile A contains "Serra Angel"
  assert exile A contains "Hill Giant"
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Serra Angel"
  assert battlefield A contains "Hill Giant"
  assert power A "Serra Angel" 4
  assert power A "Hill Giant" 4
  assert is A "Hill Giant" Zombie
  assert is A "Hill Giant" black
}

scenario "séance: a Spirit copy at the beginning of each upkeep, exiled at the end step" {
  battlefield A: "Séance"
  graveyard A: "Hill Giant"
  turn 1 upkeep A: accept "Séance"
  run_to turn 1 precombat_main
  assert exile A contains "Hill Giant"
  assert battlefield A contains "Hill Giant"
  assert is A "Hill Giant" Spirit
  assert is A "Hill Giant" Giant
  run_to turn 2 upkeep
  assert battlefield A lacks "Hill Giant"
}

scenario "offspring's revenge: a 1/1 copy with haste of a red, white, or black creature card" {
  battlefield A: "Offspring's Revenge"
  graveyard A: "Hill Giant"
  run_to turn 1 declare_attackers
  assert exile A contains "Hill Giant"
  assert battlefield A contains "Hill Giant"
  assert power A "Hill Giant" 1
  assert toughness A "Hill Giant" 1
  assert has A "Hill Giant" haste
}

scenario "offspring's revenge: a green creature card isn't a legal target" {
  battlefield A: "Offspring's Revenge"
  graveyard A: "Grizzly Bears"
  run_to turn 1 declare_attackers
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A count 1
}

scenario "shifting woodland: with delirium, a copy of a permanent card in your graveyard until end of turn" {
  battlefield A: "Shifting Woodland", "Forest", 3 "Forest"
  graveyard A: "Serra Angel", "Lightning Bolt", "Darksteel Relic", "Island"
  turn 1 A: activate "Shifting Woodland" targeting "Serra Angel"
  run_to turn 1 declare_attackers
  assert battlefield A contains "Serra Angel"
  assert graveyard A contains "Serra Angel"
  assert power A "Serra Angel" 4
  run_to turn 2 upkeep
  assert battlefield A contains "Shifting Woodland"
}

scenario "shifting woodland: without delirium it can't be activated" {
  battlefield A: "Shifting Woodland", 4 "Forest"
  graveyard A: "Serra Angel", "Hill Giant"
  illegal turn 1 A: activate "Shifting Woodland" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Shifting Woodland"
}

scenario "the cloning of shredder: a nonlegendary Mutant copy in each chapter of the card chapter I exiled" {
  battlefield A: 6 "Swamp"
  graveyard A: "Isamaru, Hound of Konda", "Grizzly Bears"
  hand A: "The Cloning of Shredder"
  turn 1 A: cast "The Cloning of Shredder"
  turn 1 A: trigger "The Cloning of Shredder" targeting "Isamaru, Hound of Konda"
  run_to turn 1 postcombat_main
  assert exile A contains "Isamaru, Hound of Konda"
  assert battlefield A contains 1 "Isamaru, Hound of Konda"
  assert is A "Isamaru, Hound of Konda" Mutant
  assert is A "Isamaru, Hound of Konda" Dog
  assert is not A "Isamaru, Hound of Konda" legendary
  run_to turn 3 postcombat_main
  assert battlefield A contains 2 "Isamaru, Hound of Konda"
  assert graveyard A contains "Grizzly Bears"
  run_to turn 5 postcombat_main
  assert battlefield A contains 3 "Isamaru, Hound of Konda"
  assert graveyard A contains "The Cloning of Shredder"
}

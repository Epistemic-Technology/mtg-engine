# "Change the target of target spell or ability with a single target"
# (CR 115.7a, 115.9a) and "target spell, activated ability, or triggered
# ability".

scenario "Bolt Bend moves a Lightning Bolt to another creature" {
  battlefield A: "Grizzly Bears", 4 "Mountain"
  battlefield B: "Hill Giant", "Mountain"
  hand A: "Bolt Bend"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 2 A: cast "Bolt Bend" targeting "Lightning Bolt" in response to "Lightning Bolt"
  turn 2 A: choose "Hill Giant"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Bolt Bend"
}

scenario "Bolt Bend can move the target to a player" {
  battlefield A: "Grizzly Bears", 4 "Mountain"
  battlefield B: "Mountain"
  hand A: "Bolt Bend"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 2 A: cast "Bolt Bend" targeting "Lightning Bolt" in response to "Lightning Bolt"
  turn 2 A: choose "player B"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert life B 17
}

scenario "Bolt Bend costs {3} less with a creature with power 4 or greater" {
  battlefield A: "Serra Angel", "Mountain"
  battlefield B: "Mountain"
  hand A: "Bolt Bend"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: cast "Bolt Bend" targeting "Lightning Bolt" in response to "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard A contains "Bolt Bend"
}

scenario "Bolt Bend can't target a spell with no target or two targets" {
  battlefield A: 4 "Mountain"
  battlefield B: 5 "Island", "Mountain", "Grizzly Bears", "Forest"
  hand A: "Bolt Bend"
  hand B: "Divination", "Chandra's Revolution"
  start turn 2 B precombat_main
  turn 2 B: cast "Divination"
  illegal turn 2 A: cast "Bolt Bend" targeting "Divination" in response to "Divination"
  turn 2 B: wait
  turn 2 B: cast "Chandra's Revolution" targeting "Grizzly Bears", "Forest"
  illegal turn 2 A: cast "Bolt Bend" targeting "Chandra's Revolution" in response to "Chandra's Revolution"
  run_to turn 2 postcombat_main
  assert hand A contains "Bolt Bend"
}

scenario "With no other legal target the target is unchanged" {
  battlefield A: "Grizzly Bears", 4 "Mountain"
  battlefield B: "Mountain"
  hand A: "Bolt Bend"
  hand B: "Murder", "Swamp"
  battlefield B: 2 "Swamp"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Grizzly Bears"
  turn 2 A: cast "Bolt Bend" targeting "Murder" in response to "Murder"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
}

scenario "Untimely Malfunction redirects an activated ability" {
  battlefield A: "Mountain", "Mountain"
  battlefield B: "Prodigal Sorcerer"
  hand A: "Untimely Malfunction"
  start turn 2 B precombat_main
  turn 2 B: activate "Prodigal Sorcerer" targeting player A
  turn 2 A: cast "Untimely Malfunction" mode 2 targeting "Prodigal Sorcerer" in response to trigger "Prodigal Sorcerer"
  turn 2 A: choose "player B"
  run_to turn 2 postcombat_main
  assert life A 20
  assert life B 19
}

scenario "Redirect Lightning pays 5 life or {2}" {
  battlefield A: "Grizzly Bears", "Mountain"
  battlefield B: "Hill Giant", "Mountain"
  hand A: "Redirect Lightning"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 2 A: cast "Redirect Lightning" targeting "Lightning Bolt" in response to "Lightning Bolt"
  turn 2 A: choose "Hill Giant"
  run_to turn 2 postcombat_main
  assert life A 15
  assert battlefield A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
}

scenario "Disallow counters an activated ability" {
  battlefield A: 3 "Island"
  battlefield B: "Prodigal Sorcerer"
  hand A: "Disallow"
  start turn 2 B precombat_main
  turn 2 B: activate "Prodigal Sorcerer" targeting player A
  turn 2 A: cast "Disallow" targeting "Prodigal Sorcerer" in response to trigger "Prodigal Sorcerer"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard A contains "Disallow"
}

scenario "Ertai Resurrected counters a spell and its controller draws" {
  battlefield A: 2 "Island", 2 "Swamp"
  battlefield B: "Mountain"
  hand A: "Ertai Resurrected"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: cast "Ertai Resurrected" in response to "Lightning Bolt"
  turn 2 A: trigger "Ertai Resurrected" mode 1 targeting "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Lightning Bolt"
  assert hand B count 1
}

scenario "Return the Favor copies only an instant or sorcery spell" {
  battlefield A: 2 "Mountain", "Mountain"
  battlefield B: 2 "Forest"
  hand A: "Return the Favor"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  illegal turn 2 A: cast "Return the Favor" mode 1 targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert hand A contains "Return the Favor"
}

scenario "Return the Favor copies a Lightning Bolt with a new target" {
  battlefield A: 3 "Mountain"
  battlefield B: "Mountain"
  hand A: "Return the Favor"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: cast "Return the Favor" mode 1 targeting "Lightning Bolt" in response to "Lightning Bolt"
  turn 2 A: choose "player B"
  run_to turn 2 postcombat_main
  assert life A 17
  assert life B 17
}

scenario "Swerve targets only spells" {
  battlefield A: "Island", "Mountain"
  battlefield B: "Prodigal Sorcerer"
  hand A: "Swerve"
  start turn 2 B precombat_main
  turn 2 B: activate "Prodigal Sorcerer" targeting player A
  illegal turn 2 A: cast "Swerve" targeting "Prodigal Sorcerer" in response to trigger "Prodigal Sorcerer"
  run_to turn 2 postcombat_main
  assert life A 19
  assert hand A contains "Swerve"
}

scenario "Reroute redirects an activated ability and draws" {
  battlefield A: 2 "Mountain"
  battlefield B: "Prodigal Sorcerer"
  hand A: "Reroute"
  start turn 2 B precombat_main
  turn 2 B: activate "Prodigal Sorcerer" targeting player A
  turn 2 A: cast "Reroute" targeting "Prodigal Sorcerer" in response to trigger "Prodigal Sorcerer"
  turn 2 A: choose "player B"
  run_to turn 2 postcombat_main
  assert life A 20
  assert life B 19
  assert hand A count 1
}

scenario "Reroute can't target a spell" {
  battlefield A: 2 "Mountain"
  battlefield B: "Mountain"
  hand A: "Reroute"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  illegal turn 2 A: cast "Reroute" targeting "Lightning Bolt" in response to "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert life A 17
}

scenario "Imp's Mischief: lose life equal to that spell's mana value" {
  battlefield A: "Grizzly Bears", 2 "Swamp"
  battlefield B: "Hill Giant", 2 "Swamp"
  hand A: "Imp's Mischief"
  hand B: "Murder"
  battlefield B: "Swamp"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Grizzly Bears"
  # Hill Giant is the only other legal target: no choice is asked.
  turn 2 A: cast "Imp's Mischief" targeting "Murder" in response to "Murder"
  run_to turn 2 postcombat_main
  assert life A 17
  assert battlefield A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
}

scenario "Willbender turned face up redirects a spell" {
  battlefield A: "Grizzly Bears", 5 "Island"
  battlefield B: "Hill Giant", "Mountain"
  hand A: "Willbender"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Willbender" face_down
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 2 precombat_main A: unmorph "Willbender"
  turn 2 A: trigger "Willbender" targeting "Lightning Bolt"
  turn 2 A: choose "Hill Giant"
  run_to turn 2 end
  assert battlefield A contains "Grizzly Bears"
  assert battlefield A contains "Willbender"
  assert graveyard B contains "Hill Giant"
}

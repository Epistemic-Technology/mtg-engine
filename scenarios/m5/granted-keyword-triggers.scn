# Triggered keywords (CR 702.108 prowess, 702.93 undying) given by a
# static ability or until end of turn trigger like printed ones.

scenario "Sokka, Tenacious Tactician: another Ally's granted prowess pumps it" {
  battlefield A: "Sokka, Tenacious Tactician", "Stonework Puma", "Mountain"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 begin_combat
  assert power "Stonework Puma" 3
  assert toughness "Stonework Puma" 3
  assert power "Sokka, Tenacious Tactician" 4
}

scenario "Bria, Riptide Rogue: other creatures' granted prowess pumps them" {
  battlefield A: "Bria, Riptide Rogue", "Grizzly Bears", "Mountain"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: trigger "Bria, Riptide Rogue" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert power "Grizzly Bears" 3
  assert power "Bria, Riptide Rogue" 4
}

scenario "Bria, Riptide Rogue: a creature spell doesn't pump" {
  battlefield A: "Bria, Riptide Rogue", "Grizzly Bears", 2 "Forest"
  hand A: "Grizzly Bears"
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 begin_combat
  assert power oldest "Grizzly Bears" 2
}

scenario "Undying Evil: granted undying returns the creature" {
  battlefield A: "Grizzly Bears", "Swamp", "Mountain"
  hand A: "Undying Evil", "Shock"
  turn 1 A: cast "Undying Evil" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert battlefield A contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 1
}

# Replacements of counters of any kind (CR 122.6, 614.1): "twice that
# many of each of those kinds", "that many plus one", including the
# counters a permanent enters with by its own rules (a planeswalker's
# loyalty, a Saga's lore counter).

scenario "Doubling Season: a +1/+1 counter put by an effect becomes two" {
  battlefield A: "Doubling Season", "Grizzly Bears", "Forest"
  hand A: "Battlegrowth"
  turn 1 A: cast "Battlegrowth" targeting "Grizzly Bears"
  run_to turn 1 end
  assert counters "Grizzly Bears" +1/+1 2
}

scenario "Doubling Season: an opponent's -1/-1 counter on its controller's creature is doubled too" {
  battlefield A: "Doubling Season", "Hill Giant"
  battlefield B: "Swamp"
  hand B: "Scar"
  start turn 2 B precombat_main
  turn 2 B: cast "Scar" targeting "Hill Giant"
  run_to turn 2 end
  assert counters "Hill Giant" -1/-1 2
}

scenario "Doubling Season: an opponent's permanent isn't affected" {
  battlefield A: "Doubling Season", "Forest"
  battlefield B: "Grizzly Bears"
  hand A: "Battlegrowth"
  turn 1 A: cast "Battlegrowth" targeting "Grizzly Bears"
  run_to turn 1 end
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Doubling Season: a planeswalker enters with twice its loyalty" {
  battlefield A: "Doubling Season", 4 "Island"
  hand A: "Jace Beleren"
  turn 1 A: cast "Jace Beleren"
  run_to turn 1 end
  assert counters "Jace Beleren" loyalty 6
}

scenario "Doubling Season: a Saga enters with two lore counters" {
  battlefield A: "Doubling Season", 2 "Forest"
  hand A: "Leaves from the Vine"
  library A: "Plains", "Plains", "Plains", "Plains"
  turn 1 A: cast "Leaves from the Vine"
  run_to turn 1 end
  assert counters "Leaves from the Vine" lore 2
  assert battlefield A contains "Food"
}

scenario "Doubling Season: tokens are doubled too" {
  battlefield A: "Doubling Season", 2 "Plains"
  hand A: "Raise the Alarm"
  turn 1 A: cast "Raise the Alarm"
  run_to turn 1 end
  assert battlefield A contains 4 "Soldier"
}

scenario "Loading Zone: counters on a creature are doubled, of any kind" {
  battlefield A: "Loading Zone", "Hill Giant", "Swamp", "Forest"
  hand A: "Scar", "Battlegrowth"
  turn 1 A: cast "Scar" targeting "Hill Giant"
  turn 1 A: wait
  turn 1 A: cast "Battlegrowth" targeting "Hill Giant"
  run_to turn 1 end
  # Two -1/-1 and two +1/+1 counters annihilate (CR 704.5q).
  assert counters "Hill Giant" -1/-1 0
  assert counters "Hill Giant" +1/+1 0
  assert power "Hill Giant" 3
}

scenario "Loading Zone: a planeswalker isn't a creature, Spacecraft, or Planet" {
  battlefield A: "Loading Zone", 4 "Island"
  hand A: "Jace Beleren"
  turn 1 A: cast "Jace Beleren"
  run_to turn 1 end
  assert counters "Jace Beleren" loyalty 3
}

scenario "Doc Samson: its controller's counters get one more" {
  battlefield A: "Doc Samson, Super Psychiatrist", "Grizzly Bears", "Forest"
  hand A: "Battlegrowth"
  turn 1 A: cast "Battlegrowth" targeting "Grizzly Bears"
  run_to turn 1 end
  assert counters "Grizzly Bears" +1/+1 2
}

scenario "Doc Samson: an opponent's -1/-1 counter isn't one its controller puts" {
  battlefield A: "Doc Samson, Super Psychiatrist", "Hill Giant"
  battlefield B: "Swamp"
  hand B: "Scar"
  start turn 2 B precombat_main
  turn 2 B: cast "Scar" targeting "Hill Giant"
  run_to turn 2 end
  assert counters "Hill Giant" -1/-1 1
}

scenario "Doc Samson: a planeswalker enters with one more loyalty" {
  battlefield A: "Doc Samson, Super Psychiatrist", 4 "Island"
  hand A: "Jace Beleren"
  turn 1 A: cast "Jace Beleren"
  run_to turn 1 end
  assert counters "Jace Beleren" loyalty 4
}

scenario "Doc Samson: tap for X mana of one color, X its power" {
  battlefield A: "Doc Samson, Super Psychiatrist"
  hand A: "Centaur Courser", "Grizzly Bears"
  turn 1 A: cast "Centaur Courser"
  illegal turn 1 A: cast "Grizzly Bears"
  run_to turn 1 end
  assert battlefield A contains "Centaur Courser"
}

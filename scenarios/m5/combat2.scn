# Combat rules: attacking with defender (CR 702.3b), granted and one-turn
# evasion (CR 509.1b), battalion and "whenever you attack" (CR 508.1m),
# "for each creature blocking it", "attacks and isn't blocked" (CR 509.1h),
# forced attacks and blocks (CR 508.1d, 509.1c), and attack restrictions
# judged on the whole declaration (CR 508.1c, 509.1c).

# ----- defender -----

scenario "defender: Krotiq Nestguard can't attack" {
  battlefield A: "Krotiq Nestguard"
  illegal turn 1 A: attack "Krotiq Nestguard"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "defender: Krotiq Nestguard's ability lets it attack this turn" {
  battlefield A: "Krotiq Nestguard", 3 "Forest"
  turn 1 A: activate "Krotiq Nestguard"
  turn 1 A: attack "Krotiq Nestguard"
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "defender: the ability lasts only this turn" {
  battlefield A: "Krotiq Nestguard", 3 "Forest"
  turn 1 A: activate "Krotiq Nestguard"
  illegal turn 3 A: attack "Krotiq Nestguard"
  run_to turn 3 postcombat_main
  assert life B 20
}

scenario "defender: Bristlepack Sentry attacks while you control a 4-power creature" {
  battlefield A: "Bristlepack Sentry", "Craw Wurm"
  turn 1 A: attack "Bristlepack Sentry"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "defender: Bristlepack Sentry can't attack without one" {
  battlefield A: "Bristlepack Sentry", "Grizzly Bears"
  illegal turn 1 A: attack "Bristlepack Sentry"
  run_to turn 1 postcombat_main
}

scenario "defender: Mechan Shieldmate attacks after an artifact entered this turn" {
  battlefield A: "Mechan Shieldmate"
  hand A: "Memnite"
  turn 1 A: cast "Memnite"
  turn 1 A: attack "Mechan Shieldmate"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "defender: Mechan Shieldmate can't attack otherwise" {
  battlefield A: "Mechan Shieldmate", "Memnite"
  illegal turn 1 A: attack "Mechan Shieldmate"
  run_to turn 1 postcombat_main
}

# ----- evasion -----

scenario "evasion: Invisibility's creature can't be blocked except by Walls" {
  battlefield A: "Grizzly Bears", "Invisibility" on "Grizzly Bears"
  battlefield B: "Hill Giant", "Wall of Wood"
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 B: block "Grizzly Bears" with "Hill Giant"
  turn 1 B: block "Grizzly Bears" with "Wall of Wood"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "evasion: Skirk Shaman is blocked only by artifact and/or red creatures" {
  battlefield A: "Skirk Shaman"
  battlefield B: "Grizzly Bears", "Raging Goblin"
  turn 1 A: attack "Skirk Shaman"
  illegal turn 1 B: block "Skirk Shaman" with "Grizzly Bears"
  turn 1 B: block "Skirk Shaman" with "Raging Goblin"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Raging Goblin"
}

scenario "evasion: Verdant Outrider can't be blocked by small creatures this turn" {
  battlefield A: "Verdant Outrider", 2 "Forest"
  battlefield B: "Grizzly Bears", "Hill Giant"
  turn 1 A: activate "Verdant Outrider"
  turn 1 A: attack "Verdant Outrider"
  illegal turn 1 B: block "Verdant Outrider" with "Grizzly Bears"
  turn 1 B: block "Verdant Outrider" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "evasion: Verdant Outrider's ability ends with the turn" {
  battlefield A: "Verdant Outrider", 2 "Forest"
  battlefield B: "Grizzly Bears"
  turn 1 A: activate "Verdant Outrider"
  turn 3 A: attack "Verdant Outrider"
  turn 3 B: block "Verdant Outrider" with "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert life B 20
}

scenario "evasion: Rocksteady's Boars can't be blocked by more than one creature" {
  battlefield A: "Rocksteady, Crash Courser"
  battlefield B: "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Rocksteady, Crash Courser"
  turn 1 B: block "Rocksteady, Crash Courser" with "Grizzly Bears"
  illegal turn 1 B: block "Rocksteady, Crash Courser" with "Savannah Lions"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Savannah Lions"
}

scenario "evasion: Firefright Mage's target can be blocked only by artifact and/or red creatures" {
  battlefield A: "Firefright Mage", "Grizzly Bears", 2 "Mountain"
  battlefield B: "Savannah Lions", "Raging Goblin", "Ornithopter"
  hand A: "Plains"
  turn 1 A: activate "Firefright Mage" discarding "Plains" targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 B: block "Grizzly Bears" with "Savannah Lions"
  turn 1 B: block "Grizzly Bears" with "Ornithopter"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Ornithopter"
}

scenario "evasion: Dust Corona's creature can't be blocked by fliers" {
  battlefield A: "Grizzly Bears", "Dust Corona" on "Grizzly Bears"
  battlefield B: "Air Elemental"
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 B: block "Grizzly Bears" with "Air Elemental"
  run_to turn 1 postcombat_main
  assert life B 16
}

# ----- attack triggers -----

scenario "battalion: Boros Elite and two others attack" {
  battlefield A: "Boros Elite", "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Boros Elite", "Grizzly Bears", "Savannah Lions"
  run_to turn 1 declare_blockers
  assert power "Boros Elite" 3
  assert toughness "Boros Elite" 3
}

scenario "battalion: Boros Elite and one other is not enough" {
  battlefield A: "Boros Elite", "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Boros Elite", "Grizzly Bears"
  run_to turn 1 declare_blockers
  assert power "Boros Elite" 1
}

scenario "battalion: Boros Elite staying home doesn't trigger" {
  battlefield A: "Boros Elite", "Grizzly Bears", "Savannah Lions", "Raging Goblin"
  turn 1 A: attack "Grizzly Bears", "Savannah Lions", "Raging Goblin"
  run_to turn 1 declare_blockers
  assert power "Boros Elite" 1
}

scenario "whenever you attack with three or more creatures: Seasoned Consultant" {
  battlefield A: "Seasoned Consultant", "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Grizzly Bears", "Savannah Lions", "Seasoned Consultant"
  run_to turn 1 declare_blockers
  assert power "Seasoned Consultant" 3
}

scenario "whenever you attack with three or more creatures: two is not enough" {
  battlefield A: "Seasoned Consultant", "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Grizzly Bears", "Savannah Lions"
  run_to turn 1 declare_blockers
  assert power "Seasoned Consultant" 1
}

scenario "whenever you attack: Most Valuable Slayer pumps one attacker once" {
  battlefield A: "Most Valuable Slayer", "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Grizzly Bears", "Savannah Lions"
  turn 1 A: trigger "Most Valuable Slayer" targeting "Grizzly Bears"
  run_to turn 1 declare_blockers
  assert power "Grizzly Bears" 3
  assert has "Grizzly Bears" first_strike
  assert power "Savannah Lions" 2
}

scenario "whenever you attack: not on the opponent's attack" {
  battlefield A: "Seasoned Consultant", "Grizzly Bears"
  battlefield B: "Grizzly Bears", "Savannah Lions", "Raging Goblin"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears", "Savannah Lions", "Raging Goblin"
  run_to turn 2 declare_blockers
  assert power "Seasoned Consultant" 1
}

scenario "for each other attacking Aurochs" {
  battlefield A: "Bull Aurochs", "Aurochs", "Grizzly Bears"
  turn 1 A: attack "Bull Aurochs", "Aurochs", "Grizzly Bears"
  run_to turn 1 declare_blockers
  # Each gets +1/+0 for the other Aurochs; the Bears don't count.
  assert power "Bull Aurochs" 3
  assert power "Aurochs" 3
}

scenario "for each other attacking creature: Rampaging Classmate" {
  battlefield A: "Rampaging Classmate", "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Rampaging Classmate", "Grizzly Bears", "Savannah Lions"
  run_to turn 1 declare_blockers
  assert power "Rampaging Classmate" 5
}

# ----- becomes blocked -----

scenario "for each creature blocking it: Elvish Berserker" {
  battlefield A: "Elvish Berserker"
  battlefield B: "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Elvish Berserker"
  turn 1 B: block "Elvish Berserker" with "Grizzly Bears"
  turn 1 B: block "Elvish Berserker" with "Savannah Lions"
  run_to turn 1 combat_damage
  assert power "Elvish Berserker" 3
  assert toughness "Elvish Berserker" 3
}

scenario "beyond the first: Jungle Wurm blocked by three" {
  battlefield A: "Jungle Wurm"
  battlefield B: "Grizzly Bears", "Savannah Lions", "Raging Goblin"
  turn 1 A: attack "Jungle Wurm"
  turn 1 B: block "Jungle Wurm" with "Grizzly Bears"
  turn 1 B: block "Jungle Wurm" with "Savannah Lions"
  turn 1 B: block "Jungle Wurm" with "Raging Goblin"
  run_to turn 1 combat_damage
  assert power "Jungle Wurm" 3
}

scenario "beyond the first: one blocker doesn't shrink Jungle Wurm" {
  battlefield A: "Jungle Wurm"
  battlefield B: "Grizzly Bears"
  turn 1 A: attack "Jungle Wurm"
  turn 1 B: block "Jungle Wurm" with "Grizzly Bears"
  run_to turn 1 combat_damage
  assert power "Jungle Wurm" 5
}

scenario "each creature blocking it: Battle-Scarred Goblin" {
  battlefield A: "Battle-Scarred Goblin"
  battlefield B: "Wall of Wood", "Raging Goblin", "Hill Giant"
  turn 1 A: attack "Battle-Scarred Goblin"
  turn 1 B: block "Battle-Scarred Goblin" with "Wall of Wood"
  turn 1 B: block "Battle-Scarred Goblin" with "Raging Goblin"
  run_to turn 1 postcombat_main
  # 1 damage from the trigger and 2 combat damage destroy the 0/3 Wall.
  assert graveyard B contains "Raging Goblin"
  assert graveyard B contains "Wall of Wood"
  assert damage "Hill Giant" 0
}

scenario "each creature blocking it gets -1/-1: Plague Wight" {
  battlefield A: "Plague Wight"
  battlefield B: "Raging Goblin"
  turn 1 A: attack "Plague Wight"
  turn 1 B: block "Plague Wight" with "Raging Goblin"
  run_to turn 1 combat_damage
  assert graveyard B contains "Raging Goblin"
  assert battlefield A contains "Plague Wight"
}

scenario "whenever a Beast becomes blocked, it gets +1/+1 for each blocker" {
  battlefield A: "Berserk Murlodont", "Silt Crawler"
  battlefield B: "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Silt Crawler"
  turn 1 B: block "Silt Crawler" with "Grizzly Bears"
  turn 1 B: block "Silt Crawler" with "Savannah Lions"
  run_to turn 1 combat_damage
  assert power "Silt Crawler" 5
  assert power "Berserk Murlodont" 3
}

scenario "attacks and isn't blocked: Swamp Mosquito" {
  battlefield A: "Swamp Mosquito"
  turn 1 A: attack "Swamp Mosquito"
  run_to turn 1 postcombat_main
  assert poison B 1
}

scenario "attacks and is blocked: no poison from Swamp Mosquito" {
  battlefield A: "Swamp Mosquito"
  battlefield B: "Giant Spider"
  turn 1 A: attack "Swamp Mosquito"
  turn 1 B: block "Swamp Mosquito" with "Giant Spider"
  run_to turn 1 postcombat_main
  assert poison B 0
}

# ----- forced combat -----

scenario "attacks this turn if able: Boiling Blood" {
  battlefield A: "Grizzly Bears", 3 "Mountain"
  hand A: "Boiling Blood"
  turn 1 A: cast "Boiling Blood" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "blocks this turn if able: Hunt Down" {
  battlefield A: "Grizzly Bears", "Savannah Lions", "Forest"
  battlefield B: "Hill Giant"
  hand A: "Hunt Down"
  turn 1 A: cast "Hunt Down" targeting B "Hill Giant", "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears", "Savannah Lions"
  illegal turn 1 B: block "Savannah Lions" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert life B 18
}

scenario "blocks this creature this turn if able: Rampant Elephant" {
  battlefield A: "Rampant Elephant", "Savannah Lions", "Forest"
  battlefield B: "Grizzly Bears"
  turn 1 A: activate "Rampant Elephant" targeting "Grizzly Bears"
  turn 1 A: attack "Rampant Elephant", "Savannah Lions"
  illegal turn 1 B: block "Savannah Lions" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life B 18
}

scenario "blocks if able: a requirement it can't meet is ignored" {
  battlefield A: "Rampant Elephant", "Forest"
  battlefield B: "Grizzly Bears"
  turn 1 A: activate "Rampant Elephant" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

# ----- attack restrictions -----

scenario "can't attack unless at least two other creatures attack: Orcish Conscripts" {
  battlefield A: "Orcish Conscripts", "Grizzly Bears"
  illegal turn 1 A: attack "Orcish Conscripts"
  run_to turn 1 postcombat_main
}

scenario "Orcish Conscripts attacks with two others" {
  battlefield A: "Orcish Conscripts", "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Orcish Conscripts", "Grizzly Bears", "Savannah Lions"
  run_to turn 1 postcombat_main
  assert life B 14
}

scenario "can't block unless at least two other creatures block: Orcish Conscripts" {
  battlefield A: "Hill Giant"
  battlefield B: "Orcish Conscripts", "Grizzly Bears"
  turn 1 A: attack "Hill Giant"
  illegal turn 1 B: block "Hill Giant" with "Orcish Conscripts"
  run_to turn 1 postcombat_main
}

scenario "Orcish Conscripts blocks with two others" {
  battlefield A: "Craw Wurm"
  battlefield B: "Orcish Conscripts", "Grizzly Bears", "Savannah Lions"
  turn 1 A: attack "Craw Wurm"
  turn 1 B: block "Craw Wurm" with "Orcish Conscripts"
  turn 1 B: block "Craw Wurm" with "Grizzly Bears"
  turn 1 B: block "Craw Wurm" with "Savannah Lions"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Craw Wurm"
}

scenario "can't attack unless a black or green creature also attacks: Scarred Puma" {
  battlefield A: "Scarred Puma", "Savannah Lions"
  illegal turn 1 A: attack "Scarred Puma"
  run_to turn 1 postcombat_main
}

scenario "Scarred Puma attacks with a black creature" {
  battlefield A: "Scarred Puma", "Typhoid Rats"
  turn 1 A: attack "Scarred Puma", "Typhoid Rats"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "can't attack unless there is a Mountain on the battlefield" {
  battlefield A: "Glacial Crasher"
  illegal turn 1 A: attack "Glacial Crasher"
  run_to turn 1 postcombat_main
}

scenario "Glacial Crasher attacks while the opponent has a Mountain" {
  battlefield A: "Glacial Crasher"
  battlefield B: "Mountain"
  turn 1 A: attack "Glacial Crasher"
  run_to turn 1 postcombat_main
  assert life B 15
}

scenario "can't attack unless defending player is poisoned" {
  battlefield A: "Chained Throatseeker"
  illegal turn 1 A: attack "Chained Throatseeker"
  run_to turn 1 postcombat_main
}

scenario "Chained Throatseeker attacks a poisoned player" {
  battlefield A: "Chained Throatseeker"
  poison B: 1
  turn 1 A: attack "Chained Throatseeker"
  run_to turn 1 postcombat_main
  assert poison B 6
}

scenario "can't attack unless you control more creatures than defending player" {
  battlefield A: "Mogg Toady"
  battlefield B: "Grizzly Bears"
  illegal turn 1 A: attack "Mogg Toady"
  run_to turn 1 postcombat_main
}

scenario "Mogg Toady attacks with more creatures" {
  battlefield A: "Mogg Toady", "Grizzly Bears"
  battlefield B: "Savannah Lions"
  turn 1 A: attack "Mogg Toady"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "can't attack unless an opponent has been dealt damage this turn" {
  battlefield A: "Bloodcrazed Goblin", "Mountain"
  hand A: "Lightning Bolt"
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 A: attack "Bloodcrazed Goblin"
  run_to turn 1 postcombat_main
  assert life B 15
}

scenario "Bloodcrazed Goblin can't attack otherwise" {
  battlefield A: "Bloodcrazed Goblin"
  illegal turn 1 A: attack "Bloodcrazed Goblin"
  run_to turn 1 postcombat_main
}

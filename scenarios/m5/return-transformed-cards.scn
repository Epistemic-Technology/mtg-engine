# Cards whose Saga's last chapter returns it transformed (CR 712.14a): the
# chapters, and the back face each becomes.

scenario "Era of Enlightenment's chapters, then Hand of Enlightenment" {
  battlefield A: "Era of Enlightenment" with 1 lore
  run_to turn 1 postcombat_main
  assert life A 22
  run_to turn 3 postcombat_main
  assert battlefield A contains "Hand of Enlightenment"
  assert has "Hand of Enlightenment" first_strike
}

scenario "Tales of Master Seshiro becomes Seshiro's Living Legacy" {
  battlefield A: "Tales of Master Seshiro" with 2 lore
  run_to turn 1 postcombat_main
  assert battlefield A contains "Seshiro's Living Legacy"
  assert power "Seshiro's Living Legacy" 5
  assert has "Seshiro's Living Legacy" vigilance
  assert has "Seshiro's Living Legacy" haste
}

scenario "Tales of Master Seshiro's counter and vigilance" {
  battlefield A: "Tales of Master Seshiro" with 1 lore, "Grizzly Bears"
  turn 1 A: trigger "Tales of Master Seshiro" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert has "Grizzly Bears" vigilance
}

scenario "The Modern Age becomes Vector Glider" {
  battlefield A: "The Modern Age" with 2 lore
  run_to turn 1 postcombat_main
  assert battlefield A contains "Vector Glider"
  assert has "Vector Glider" flying
  assert toughness "Vector Glider" 3
}

scenario "The Shattered States Era steals a creature until end of turn" {
  battlefield A: 5 "Mountain"
  battlefield B: "Grizzly Bears" tapped
  hand A: "The Shattered States Era"
  turn 1 A: cast "The Shattered States Era"
  turn 1 A: trigger "The Shattered States Era" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert untapped "Grizzly Bears"
  assert has "Grizzly Bears" haste
  run_to turn 2 upkeep
  assert battlefield B contains "Grizzly Bears"
}

scenario "The Shattered States Era becomes Nameless Conqueror" {
  battlefield A: "The Shattered States Era" with 2 lore
  run_to turn 1 postcombat_main
  assert battlefield A contains "Nameless Conqueror"
  assert has "Nameless Conqueror" trample
}

scenario "Behold the Unspeakable becomes a Vision as big as your hand" {
  battlefield A: "Behold the Unspeakable" with 2 lore
  hand A: "Forest", "Forest", "Forest"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Vision of the Unspeakable"
  assert power "Vision of the Unspeakable" 3
  assert has "Vision of the Unspeakable" trample
}

scenario "Behold the Unspeakable's second chapter with a small hand" {
  battlefield A: "Behold the Unspeakable" with 1 lore
  hand A: "Forest"
  run_to turn 1 postcombat_main
  assert hand A count 5
}

scenario "Behold the Unspeakable's second chapter with a big hand" {
  battlefield A: "Behold the Unspeakable" with 1 lore
  hand A: "Forest", "Forest"
  run_to turn 1 postcombat_main
  assert hand A count 4
}

scenario "Michiko's Reign of Truth becomes Portrait of Michiko" {
  battlefield A: "Michiko's Reign of Truth" with 2 lore, "Ornithopter"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Portrait of Michiko"
  assert power "Portrait of Michiko" 2
  assert toughness "Portrait of Michiko" 2
}

scenario "Teachings of the Kirin becomes Kirin-Touched Orochi" {
  battlefield A: "Teachings of the Kirin" with 2 lore
  run_to turn 1 postcombat_main
  assert battlefield A contains "Kirin-Touched Orochi"
  assert power "Kirin-Touched Orochi" 1
}

scenario "Smokebraider's mana casts an Elemental" {
  battlefield A: "Smokebraider", "Mountain"
  hand A: "Arc Runner"
  start turn 2 A precombat_main
  turn 2 A: activate "Smokebraider"
  turn 2 A: choose red
  turn 2 A: choose red
  turn 2 A: cast "Arc Runner"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Arc Runner"
}

scenario "Smokebraider's mana can't cast a non-Elemental" {
  battlefield A: "Smokebraider", "Mountain", "Mountain"
  hand A: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: activate "Smokebraider"
  turn 2 A: choose red
  turn 2 A: choose red
  illegal turn 2 A: cast "Hill Giant"
  run_to turn 2 postcombat_main
  assert hand A contains "Hill Giant"
}


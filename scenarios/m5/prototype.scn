# Prototype (CR 702.160a, 718): cast prototyped (`alternative`, the
# card's alternative cost), the spell and the permanent have the
# prototype's mana cost, power, and toughness, and that cost's colors (CR
# 718.3b); its abilities and types stay (CR 718.5); off the battlefield it
# is its card again (CR 718.4).

scenario "prototype: Blitz Automaton prototyped is a red 3/2 with haste" {
  battlefield A: 3 "Mountain"
  hand A: "Blitz Automaton"
  turn 1 A: cast "Blitz Automaton" alternative
  turn 1 A: attack "Blitz Automaton"
  run_to turn 1 postcombat_main
  assert power "Blitz Automaton" 3
  assert toughness "Blitz Automaton" 2
  assert is "Blitz Automaton" red
  assert is "Blitz Automaton" artifact
  assert life B 17
}

scenario "prototype: cast normally it is a colorless 6/4" {
  battlefield A: 7 "Mountain"
  hand A: "Blitz Automaton"
  turn 1 A: cast "Blitz Automaton"
  turn 1 A: attack "Blitz Automaton"
  run_to turn 1 postcombat_main
  assert power "Blitz Automaton" 6
  assert is not "Blitz Automaton" red
  assert life B 14
}

scenario "prototype: the prototype cost needs its colored mana" {
  battlefield A: 3 "Island"
  hand A: "Blitz Automaton"
  illegal turn 1 A: cast "Blitz Automaton" alternative
  run_to turn 1 postcombat_main
  assert hand A contains "Blitz Automaton"
}

scenario "prototype: a prototyped permanent's mana value is the prototype's" {
  battlefield A: 2 "Swamp"
  battlefield B: 2 "Swamp"
  hand A: "Goring Warplow"
  hand B: "Smother"
  turn 1 A: cast "Goring Warplow" alternative
  turn 1 postcombat_main B: cast "Smother" targeting "Goring Warplow"
  run_to turn 1 end
  assert graveyard A contains "Goring Warplow"
}

scenario "prototype: cast normally its mana value is the card's" {
  battlefield A: 6 "Swamp"
  battlefield B: 2 "Swamp"
  hand A: "Goring Warplow"
  hand B: "Smother"
  turn 1 A: cast "Goring Warplow"
  illegal turn 1 postcombat_main B: cast "Smother" targeting "Goring Warplow"
  run_to turn 1 end
  assert power "Goring Warplow" 5
  assert is not "Goring Warplow" black
  assert has "Goring Warplow" deathtouch
}

scenario "prototype: back in the hand it is the card again" {
  battlefield A: 2 "Swamp"
  battlefield B: 2 "Island"
  hand A: "Goring Warplow"
  hand B: "Unsummon"
  turn 1 A: cast "Goring Warplow" alternative
  turn 1 postcombat_main B: cast "Unsummon" targeting "Goring Warplow"
  run_to turn 1 end
  assert hand A contains "Goring Warplow"
}

scenario "prototype: Boulderbranch Golem gains life equal to its prototyped power" {
  battlefield A: 4 "Forest"
  hand A: "Boulderbranch Golem"
  turn 1 A: cast "Boulderbranch Golem" alternative
  run_to turn 1 postcombat_main
  assert life A 23
  assert power "Boulderbranch Golem" 3
  assert is "Boulderbranch Golem" green
}

scenario "prototype: Boulderbranch Golem cast normally gains 6" {
  battlefield A: 7 "Forest"
  hand A: "Boulderbranch Golem"
  turn 1 A: cast "Boulderbranch Golem"
  run_to turn 1 postcombat_main
  assert life A 26
}

scenario "prototype: Combat Thresher prototyped draws and has double strike" {
  battlefield A: 3 "Plains"
  hand A: "Combat Thresher"
  library A: "Island", "Forest"
  turn 1 A: cast "Combat Thresher" alternative
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert power "Combat Thresher" 1
  assert has "Combat Thresher" double_strike
}

scenario "prototype: Autonomous Assembler prototyped, and its counter ability" {
  battlefield A: 3 "Plains"
  hand A: "Autonomous Assembler"
  turn 1 A: cast "Autonomous Assembler" alternative
  turn 3 A: activate "Autonomous Assembler" targeting "Autonomous Assembler"
  run_to turn 3 postcombat_main
  assert power "Autonomous Assembler" 3
  assert toughness "Autonomous Assembler" 3
  assert has "Autonomous Assembler" vigilance
}

scenario "prototype: Rust Goliath prototyped is a 3/5 with reach and trample" {
  battlefield A: 5 "Forest"
  hand A: "Rust Goliath"
  turn 1 A: cast "Rust Goliath" alternative
  run_to turn 1 postcombat_main
  assert power "Rust Goliath" 3
  assert toughness "Rust Goliath" 5
  assert has "Rust Goliath" reach
  assert has "Rust Goliath" trample
}

scenario "prototype: Iron-Craw Crusher pumps by its prototyped power" {
  battlefield A: "Grizzly Bears", 4 "Forest"
  hand A: "Iron-Craw Crusher"
  turn 1 A: cast "Iron-Craw Crusher" alternative
  run_to turn 3 declare_attackers
  turn 3 A: attack "Iron-Craw Crusher", "Grizzly Bears"
  turn 3 A: trigger "Iron-Craw Crusher" targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert power "Grizzly Bears" 4
  assert life B 14
}

scenario "prototype: Frogmyr Enforcer's affinity reduces the prototype cost" {
  battlefield A: 4 "Mountain", 2 "Ornithopter"
  hand A: "Frogmyr Enforcer", "Lightning Bolt", "Shock"
  turn 1 A: cast "Frogmyr Enforcer" alternative
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert power "Frogmyr Enforcer" 2
  assert is "Frogmyr Enforcer" red
  assert life B 15
}

scenario "prototype: affinity makes the prototype castable with two lands" {
  battlefield A: 2 "Mountain", 2 "Ornithopter"
  hand A: "Frogmyr Enforcer"
  turn 1 A: cast "Frogmyr Enforcer" alternative
  run_to turn 1 postcombat_main
  assert battlefield A contains "Frogmyr Enforcer"
}

scenario "prototype: Fallaji Dragon Engine prototyped, firebreathing" {
  battlefield A: 5 "Mountain"
  hand A: "Fallaji Dragon Engine"
  turn 1 A: cast "Fallaji Dragon Engine" alternative
  turn 1 A: activate "Fallaji Dragon Engine"
  run_to turn 1 postcombat_main
  assert power "Fallaji Dragon Engine" 2
  assert has "Fallaji Dragon Engine" flying
}

scenario "prototype: Depth Charge Colossus prototyped doesn't untap" {
  battlefield A: 6 "Island"
  hand A: "Depth Charge Colossus"
  turn 1 A: cast "Depth Charge Colossus" alternative
  run_to turn 3 declare_attackers
  turn 3 A: attack "Depth Charge Colossus"
  run_to turn 5 precombat_main
  assert tapped "Depth Charge Colossus"
  assert life B 14
  assert power "Depth Charge Colossus" 6
}

scenario "prototype: Cradle Clearcutter adds mana equal to its prototyped power" {
  battlefield A: 3 "Forest"
  hand A: "Cradle Clearcutter", "Rural Recruit", "Craw Giant"
  turn 1 A: cast "Cradle Clearcutter" alternative
  illegal turn 3 A: cast "Craw Giant"
  turn 3 A: cast "Rural Recruit"
  run_to turn 3 postcombat_main
  assert battlefield A contains "Rural Recruit"
  assert tapped "Cradle Clearcutter"
}

scenario "prototype: Spotter Thopter scries by its power" {
  battlefield A: 4 "Island"
  hand A: "Spotter Thopter"
  library A: "Forest", "Plains", "Swamp"
  turn 1 A: cast "Spotter Thopter" alternative
  run_to turn 1 postcombat_main
  assert known A "Forest"
  assert known A "Plains"
  assert unknown A "Swamp"
  assert power "Spotter Thopter" 2
  assert has "Spotter Thopter" flying
}

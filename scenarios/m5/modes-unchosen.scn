# "Choose one that hasn't been chosen [this turn] —" (CR 700.2): a mode,
# once chosen for that object's ability, can't be chosen again (for "this
# turn", until the turn ends). A new object starts fresh (CR 400.7). With
# no mode left, a triggered ability is removed (Demonic Pact's rulings).

scenario "Demonic Pact: each mode once, then you lose the game" {
  battlefield A: "Demonic Pact"
  library A: 10 "Island"
  library B: 10 "Island"
  hand B: "Forest", "Mountain", "Plains"
  turn 1 upkeep A: trigger "Demonic Pact" mode 1 targeting player B
  turn 3 upkeep A: trigger "Demonic Pact" mode 2 targeting player B
  run_to turn 3 draw
  assert life B 16
  assert life A 24
  assert hand B count 2
  assert hand A count 1
  # The first mode left is the third: draw two cards.
  run_to turn 5 draw
  assert hand A count 4
  assert not game_over
  # Only "You lose the game." is left.
  run_to turn 7 draw
  assert winner B
}

scenario "Three Bowls of Porridge: the first mode left is the default" {
  battlefield A: "Three Bowls of Porridge", 6 "Plains"
  battlefield B: "Hill Giant", "Grizzly Bears"
  library A: 10 "Island"
  library B: 10 "Island"
  turn 1 A: activate "Three Bowls of Porridge" mode 1 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  # The first mode left is the second.
  turn 3 A: activate "Three Bowls of Porridge" targeting "Hill Giant"
  run_to turn 3 postcombat_main
  assert tapped "Hill Giant"
  turn 5 A: activate "Three Bowls of Porridge"
  run_to turn 5 postcombat_main
  assert life A 23
  assert graveyard A contains "Three Bowls of Porridge"
}

scenario "Three Bowls of Porridge: each mode once, the last sacrificing it" {
  battlefield A: "Three Bowls of Porridge", 6 "Plains"
  battlefield B: "Hill Giant", "Grizzly Bears", "Serra Angel"
  library A: 10 "Island"
  library B: 10 "Island"
  turn 1 A: activate "Three Bowls of Porridge" mode 1 targeting "Grizzly Bears"
  turn 3 A: activate "Three Bowls of Porridge" mode 2 targeting "Hill Giant"
  run_to turn 3 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert tapped "Hill Giant"
  assert untapped "Serra Angel"
  # Mode 3 is left: its activation sacrifices the bowls.
  turn 5 A: activate "Three Bowls of Porridge"
  run_to turn 5 postcombat_main
  assert untapped "Serra Angel"
  assert battlefield B contains "Serra Angel"
  assert life A 23
}

scenario "Breeches: a mode chosen one turn is open again the next" {
  battlefield A: "Breeches, Eager Pillager"
  battlefield B: "Grizzly Bears"
  library A: 10 "Island"
  library B: 10 "Island"
  turn 3 declare_attackers A: attack "Breeches, Eager Pillager"
  turn 3 declare_attackers A: trigger "Breeches, Eager Pillager" mode 1
  run_to turn 3 postcombat_main
  assert battlefield A contains 1 "Treasure"
  turn 5 declare_attackers A: attack "Breeches, Eager Pillager"
  turn 5 declare_attackers A: trigger "Breeches, Eager Pillager" mode 1
  run_to turn 5 postcombat_main
  assert battlefield A contains 2 "Treasure"
}

scenario "Breeches: two attacking Pirates, two different modes" {
  battlefield A: "Breeches, Eager Pillager", "Boarding Party"
  battlefield B: "Grizzly Bears"
  library A: 10 "Island"
  library B: 10 "Island"
  turn 3 declare_attackers A: attack "Breeches, Eager Pillager", "Boarding Party"
  turn 3 declare_attackers A: trigger "Breeches, Eager Pillager" mode 1
  turn 3 declare_attackers A: trigger "Breeches, Eager Pillager" mode 2 targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert battlefield A contains 1 "Treasure"
  assert life B 11
}

scenario "Breeches: the second Pirate's trigger can't take the first one's mode" {
  battlefield A: "Breeches, Eager Pillager", "Boarding Party"
  library A: 10 "Island"
  library B: 10 "Island"
  turn 3 declare_attackers A: attack "Breeches, Eager Pillager", "Boarding Party"
  turn 3 declare_attackers A: trigger "Breeches, Eager Pillager" mode 1
  # Unscripted, the second trigger takes the first mode left (the second),
  # not another Treasure.
  run_to turn 3 postcombat_main
  assert battlefield A contains 1 "Treasure"
}

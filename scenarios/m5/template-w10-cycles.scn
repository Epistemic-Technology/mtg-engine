# The tenth wave's template phrases for cycles and families: exert with a
# target (a reflexive trigger), the Ordeals, the Myojin, "you gain life
# equal to that creature's toughness".

# `exert:` with targets: "You may exert this creature as it attacks. When
# you do, target creature can't block this turn." (CR 701.43, 603.12).

scenario "Ahn-Crop Crasher: exerted, the target can't block" {
  battlefield A: "Ahn-Crop Crasher"
  battlefield B: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: attack "Ahn-Crop Crasher"
  turn 2 A: accept "Ahn-Crop Crasher"
  turn 2 A: trigger "Ahn-Crop Crasher" targeting "Hill Giant"
  illegal turn 2 B: block "Ahn-Crop Crasher" with "Hill Giant"
  run_to turn 2 postcombat_main
  assert life B 17
  run_to turn 4 precombat_main
  assert tapped "Ahn-Crop Crasher"
}

scenario "Ahn-Crop Crasher: not exerted, it untaps and the creature may block" {
  battlefield A: "Ahn-Crop Crasher"
  battlefield B: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: attack "Ahn-Crop Crasher"
  turn 2 A: decline "Ahn-Crop Crasher"
  turn 2 B: block "Ahn-Crop Crasher" with "Hill Giant"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Ahn-Crop Crasher"
}

scenario "Glorybringer: exerted, 4 damage to a non-Dragon creature" {
  battlefield A: "Glorybringer"
  battlefield B: "Serra Angel", "Shivan Dragon"
  start turn 2 A precombat_main
  turn 2 A: attack "Glorybringer"
  turn 2 A: accept "Glorybringer"
  turn 2 A: trigger "Glorybringer" targeting "Serra Angel"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert life B 16
  run_to turn 4 precombat_main
  assert tapped "Glorybringer"
}

scenario "Glorybringer: a Dragon can't be the target" {
  battlefield A: "Glorybringer"
  battlefield B: "Shivan Dragon"
  start turn 2 A precombat_main
  turn 2 A: attack "Glorybringer"
  turn 2 A: accept "Glorybringer"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Shivan Dragon"
  assert damage "Shivan Dragon" 0
}

scenario "Devoted Crop-Mate: exerted, a creature card with mana value 2 or less returns" {
  battlefield A: "Devoted Crop-Mate"
  graveyard A: "Grizzly Bears", "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: attack "Devoted Crop-Mate"
  turn 2 A: accept "Devoted Crop-Mate"
  turn 2 A: trigger "Devoted Crop-Mate" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard A contains "Hill Giant"
}

scenario "Devoted Crop-Mate: not a mana value 4 card" {
  battlefield A: "Devoted Crop-Mate"
  graveyard A: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: attack "Devoted Crop-Mate"
  turn 2 A: accept "Devoted Crop-Mate"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Hill Giant"
}

# The Ordeals: the counter goes on the enchanted creature; with three, the
# Aura is sacrificed and its own trigger happens.

scenario "Ordeal of Heliod: the third counter sacrifices it, 10 life" {
  battlefield A: "Grizzly Bears" with 2 +1/+1, "Ordeal of Heliod" on "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
  assert graveyard A contains "Ordeal of Heliod"
  assert life A 30
  assert life B 15
}

scenario "Ordeal of Heliod: one counter, the Aura stays" {
  battlefield A: "Grizzly Bears", "Ordeal of Heliod" on "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert battlefield A contains "Ordeal of Heliod"
  assert life A 20
}

scenario "Ordeal of Thassa: sacrificed, draw two cards" {
  battlefield A: "Grizzly Bears" with 2 +1/+1, "Ordeal of Thassa" on "Grizzly Bears"
  library A: "Island", "Forest", "Plains"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Ordeal of Thassa"
  assert hand A count 2
}

scenario "Ordeal of Purphoros: sacrificed, 3 damage to any target" {
  battlefield A: "Grizzly Bears" with 2 +1/+1, "Ordeal of Purphoros" on "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  turn 2 A: trigger "Ordeal of Purphoros" targeting "Hill Giant"
  run_to turn 2 end
  assert graveyard B contains "Hill Giant"
}

scenario "Ordeal of Erebos: sacrificed, target player discards two" {
  battlefield A: "Grizzly Bears" with 2 +1/+1, "Ordeal of Erebos" on "Grizzly Bears"
  hand B: "Island", "Forest"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  turn 2 A: trigger "Ordeal of Erebos" targeting player B
  run_to turn 2 end
  assert hand B count 0
}

# The Myojin: indestructible while it has a divinity counter.

scenario "Myojin of Cleansing Fire: cast from hand, indestructible; remove the counter to destroy the others" {
  battlefield A: 8 "Plains", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Myojin of Cleansing Fire"
  start turn 1 A precombat_main
  turn 1 A: cast "Myojin of Cleansing Fire"
  run_to turn 1 begin_combat
  assert counters "Myojin of Cleansing Fire" divinity 1
  assert has "Myojin of Cleansing Fire" indestructible
  turn 1 postcombat_main A: activate "Myojin of Cleansing Fire"
  run_to turn 1 end
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Myojin of Cleansing Fire"
  assert has not "Myojin of Cleansing Fire" indestructible
}

scenario "Myojin of Infinite Rage: put onto the battlefield, no counter, not indestructible" {
  battlefield A: "Myojin of Infinite Rage"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Myojin of Infinite Rage"
  run_to turn 1 postcombat_main
  assert has not "Myojin of Infinite Rage" indestructible
}

scenario "Myojin of Infinite Rage: destroy all lands" {
  battlefield A: "Myojin of Infinite Rage" with 1 divinity, "Mountain"
  battlefield B: "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Myojin of Infinite Rage"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Mountain"
  assert graveyard B contains "Forest"
}

scenario "Myojin of Seeing Winds: draw a card for each permanent you control" {
  battlefield A: "Myojin of Seeing Winds" with 1 divinity, 2 "Island"
  battlefield B: "Forest"
  library A: "Island", "Island", "Island", "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Myojin of Seeing Winds"
  run_to turn 1 postcombat_main
  assert hand A count 3
}

# "you gain life equal to that creature's toughness": the creature the
# trigger is about.

scenario "Proper Burial: a creature dies, its toughness in life" {
  battlefield A: "Proper Burial", "Hill Giant", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert life A 23
}

scenario "Proper Burial: an opponent's creature gives nothing" {
  battlefield A: "Proper Burial", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert life A 20
}

scenario "Trostani, Selesnya's Voice: another creature enters, its toughness in life" {
  battlefield A: "Trostani, Selesnya's Voice", 6 "Forest"
  hand A: "Craw Wurm"
  start turn 1 A precombat_main
  turn 1 A: cast "Craw Wurm"
  run_to turn 1 postcombat_main
  assert life A 24
}

scenario "Verdant Sun's Avatar: itself entering, 5 life" {
  battlefield A: 7 "Forest"
  hand A: "Verdant Sun's Avatar"
  start turn 1 A precombat_main
  turn 1 A: cast "Verdant Sun's Avatar"
  run_to turn 1 postcombat_main
  assert life A 25
}

scenario "Engulfing Slagwurm: blocked, destroys the blocker and gains its toughness" {
  battlefield A: "Engulfing Slagwurm"
  battlefield B: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: attack "Engulfing Slagwurm"
  turn 2 B: block "Engulfing Slagwurm" with "Hill Giant"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert life A 23
}

scenario "Abattoir Ghoul: a creature it damaged dies, its toughness in life" {
  battlefield A: "Abattoir Ghoul"
  battlefield B: "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: attack "Abattoir Ghoul"
  turn 2 B: block "Abattoir Ghoul" with "Hill Giant"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Abattoir Ghoul"
  assert life A 23
}

scenario "Doomgape: the sacrificed creature's toughness in life" {
  battlefield A: "Doomgape", "Hill Giant"
  start turn 2 A upkeep
  turn 2 upkeep A: choose "Hill Giant"
  run_to turn 2 precombat_main
  assert graveyard A contains "Hill Giant"
  assert life A 23
}

# Abilities and spells on the stack as targets (CR 115.1, 701.6): "target
# activated or triggered ability you don't control", "target triggered
# ability or colorless spell", "target activated ability, triggered
# ability, or legendary spell", "target instant spell, sorcery spell, or
# triggered ability".

scenario "Nimble Obstructionist: cycled, counter target triggered ability an opponent controls" {
  battlefield A: 3 "Island"
  battlefield B: "Fountain of Renewal"
  hand A: "Nimble Obstructionist"
  library A: "Plains"
  start turn 2 B
  turn 2 upkeep A: activate "Nimble Obstructionist"
  turn 2 upkeep A: trigger "Nimble Obstructionist" targeting "Fountain of Renewal"
  run_to turn 2 draw
  assert life B 20
  assert graveyard A contains "Nimble Obstructionist"
  assert hand A contains "Plains"
}

scenario "Nimble Obstructionist: a triggered ability you control is not a target" {
  battlefield A: 3 "Island", "Fountain of Renewal"
  hand A: "Nimble Obstructionist"
  turn 1 upkeep A: activate "Nimble Obstructionist"
  run_to turn 1 draw
  assert life A 21
}

scenario "Nimble Obstructionist: flash, flying 3/1" {
  battlefield A: 3 "Island"
  hand A: "Nimble Obstructionist"
  start turn 2 B
  turn 2 upkeep A: cast "Nimble Obstructionist"
  run_to turn 2 draw
  assert battlefield A contains "Nimble Obstructionist"
  assert has "Nimble Obstructionist" flying
  assert power "Nimble Obstructionist" 3
}

scenario "Consign to Memory: counter target triggered ability" {
  battlefield A: "Island"
  battlefield B: "Fountain of Renewal"
  hand A: "Consign to Memory"
  start turn 2 B
  turn 2 upkeep A: cast "Consign to Memory" targeting "Fountain of Renewal"
  run_to turn 2 draw
  assert life B 20
  assert graveyard A contains "Consign to Memory"
}

scenario "Consign to Memory: counter target colorless spell" {
  battlefield A: "Island"
  battlefield B: "Island"
  hand A: "Consign to Memory"
  hand B: "Ornithopter"
  start turn 2 B
  turn 2 B: cast "Ornithopter"
  turn 2 precombat_main A: cast "Consign to Memory" targeting "Ornithopter"
  run_to turn 2 end
  assert graveyard B contains "Ornithopter"
  assert battlefield B lacks "Ornithopter"
}

scenario "Consign to Memory: a colored spell is not a target" {
  battlefield A: "Island"
  battlefield B: 2 "Forest"
  hand A: "Consign to Memory"
  hand B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: cast "Grizzly Bears"
  illegal turn 2 precombat_main A: cast "Consign to Memory" targeting "Grizzly Bears"
  run_to turn 2 end
  assert battlefield B contains "Grizzly Bears"
}

scenario "Tale's End: counter target legendary spell" {
  battlefield A: 2 "Island"
  battlefield B: "Plains"
  hand A: "Tale's End"
  hand B: "Isamaru, Hound of Konda"
  start turn 2 B
  turn 2 B: cast "Isamaru, Hound of Konda"
  turn 2 precombat_main A: cast "Tale's End" targeting "Isamaru, Hound of Konda"
  run_to turn 2 end
  assert graveyard B contains "Isamaru, Hound of Konda"
}

scenario "Tale's End: a nonlegendary spell is not a target" {
  battlefield A: 2 "Island"
  battlefield B: 2 "Forest"
  hand A: "Tale's End"
  hand B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: cast "Grizzly Bears"
  illegal turn 2 precombat_main A: cast "Tale's End" targeting "Grizzly Bears"
  run_to turn 2 end
  assert battlefield B contains "Grizzly Bears"
}

scenario "Tale's End: counter target activated ability" {
  battlefield A: 2 "Island"
  battlefield B: "Prodigal Sorcerer"
  hand A: "Tale's End"
  start turn 2 B
  turn 2 B: activate "Prodigal Sorcerer" targeting player A
  turn 2 precombat_main A: cast "Tale's End" targeting "Prodigal Sorcerer"
  run_to turn 2 end
  assert life A 20
  assert tapped "Prodigal Sorcerer"
}

scenario "Spider-Sense: counter target instant spell" {
  battlefield A: 2 "Island"
  battlefield B: "Mountain"
  hand A: "Spider-Sense"
  hand B: "Lightning Bolt"
  start turn 2 B
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 precombat_main A: cast "Spider-Sense" targeting "Lightning Bolt"
  run_to turn 2 end
  assert life A 20
}

scenario "Spider-Sense: counter target triggered ability" {
  battlefield A: 2 "Island"
  battlefield B: "Fountain of Renewal"
  hand A: "Spider-Sense"
  start turn 2 B
  turn 2 upkeep A: cast "Spider-Sense" targeting "Fountain of Renewal"
  run_to turn 2 draw
  assert life B 20
}

scenario "Spider-Sense: an activated ability and a creature spell are not targets" {
  battlefield A: 2 "Island"
  battlefield B: "Prodigal Sorcerer", 2 "Forest"
  hand A: "Spider-Sense"
  hand B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: activate "Prodigal Sorcerer" targeting player A
  illegal turn 2 precombat_main A: cast "Spider-Sense" targeting "Prodigal Sorcerer"
  turn 2 B: cast "Grizzly Bears"
  illegal turn 2 precombat_main A: cast "Spider-Sense" targeting "Grizzly Bears"
  run_to turn 2 end
  assert life A 19
  assert battlefield B contains "Grizzly Bears"
}

# To the hand.

scenario "search to hand: Artificer's Intuition finds an artifact card with mana value 1 or less" {
  battlefield A: "Artificer's Intuition", "Island", "Island"
  hand A: "Ornithopter"
  library A: "Alpha Myr", "Memnite", "Island"
  turn 1 A: activate "Artificer's Intuition" discarding "Ornithopter"
  turn 1 A: choose "Memnite"
  run_to turn 1 postcombat_main
  assert hand A contains "Memnite"
  assert library A contains "Alpha Myr"
}

scenario "search to hand: Artificer's Intuition can't find mana value 2" {
  battlefield A: "Artificer's Intuition", "Island", "Island"
  hand A: "Ornithopter"
  library A: "Alpha Myr", "Island"
  turn 1 A: activate "Artificer's Intuition" discarding "Ornithopter"
  run_to turn 1 postcombat_main
  assert hand A lacks "Alpha Myr"
}


# "... reveal it, then shuffle and put that card on top": the Harbingers
# and Forerunners. The card is drawn on the next draw.

scenario "search to top: Boggart Harbinger" {
  battlefield A: 3 "Swamp"
  hand A: "Boggart Harbinger"
  library A: "Island", "Goblin Bully", "Island"
  turn 1 A: cast "Boggart Harbinger"
  turn 1 A: choose "Goblin Bully"
  run_to turn 3 precombat_main
  assert hand A contains "Goblin Bully"
}


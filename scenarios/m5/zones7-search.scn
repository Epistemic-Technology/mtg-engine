# Library searches the template author now writes (CR 701.19): any filter
# the language has ("a legendary creature card", "an artifact card with
# mana value 6 or greater", "a Forest or Island card"), with "reveal that
# card", to the hand, the battlefield, the graveyard, or the top of the
# library.

# Fetch lands: "{T}, Pay 1 life, Sacrifice this land: Search your library
# for a Forest or Island card, put it onto the battlefield, then shuffle."

scenario "search: Misty Rainforest finds a Forest or an Island" {
  battlefield A: "Misty Rainforest"
  library A: "Mountain", "Island", "Plains"
  turn 1 A: activate "Misty Rainforest"
  turn 1 A: choose "Island"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Island"
  assert graveyard A contains "Misty Rainforest"
  assert life A 19
}

scenario "search: Misty Rainforest can't find a Mountain" {
  battlefield A: "Misty Rainforest"
  library A: "Mountain", "Plains"
  turn 1 A: activate "Misty Rainforest"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Mountain"
  assert library A count 2
}


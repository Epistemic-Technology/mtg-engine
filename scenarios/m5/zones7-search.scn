scenario "search to battlefield: Planar Bridge finds a permanent card" {
  battlefield A: "Planar Bridge", 8 "Plains"
  library A: "Lightning Bolt", "Hill Giant", "Island"
  turn 1 A: activate "Planar Bridge"
  turn 1 A: choose "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
}

scenario "search to battlefield: Planar Bridge doesn't find an instant" {
  battlefield A: "Planar Bridge", 8 "Plains"
  library A: "Lightning Bolt", "Shock"
  turn 1 A: activate "Planar Bridge"
  run_to turn 1 postcombat_main
  assert library A count 2
}

scenario "search to battlefield: Quandrix Cultivator finds a basic Forest or Island" {
  battlefield A: 2 "Forest", 2 "Island"
  hand A: "Quandrix Cultivator"
  library A: "Mountain", "Island", "Plains"
  turn 1 A: cast "Quandrix Cultivator"
  turn 1 A: choose "Island"
  run_to turn 1 postcombat_main
  assert battlefield A contains 3 "Island"
}

scenario "search to battlefield: Reshape finds an artifact card with mana value X or less" {
  battlefield A: 3 "Island", "Ornithopter"
  hand A: "Reshape"
  library A: "Alpha Myr", "Memnite", "Island"
  turn 1 A: cast "Reshape" x 1 sacrificing "Ornithopter"
  turn 1 A: choose "Memnite"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Memnite"
  assert graveyard A contains "Ornithopter"
}

scenario "search to battlefield: Reshape's X limits the mana value" {
  battlefield A: 3 "Island", "Ornithopter"
  hand A: "Reshape"
  library A: "Alpha Myr", "Island"
  turn 1 A: cast "Reshape" x 1 sacrificing "Ornithopter"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Alpha Myr"
}

scenario "search to battlefield: Rocco finds a creature card with mana value X or less" {
  battlefield A: 2 "Mountain", 2 "Forest", "Plains"
  hand A: "Rocco, Cabaretti Caterer"
  library A: "Hill Giant", "Grizzly Bears", "Island"
  turn 1 A: cast "Rocco, Cabaretti Caterer" x 2
  turn 1 A: choose "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

scenario "search to battlefield: Rocco's X limits the mana value" {
  battlefield A: 2 "Mountain", 2 "Forest", "Plains"
  hand A: "Rocco, Cabaretti Caterer"
  library A: "Hill Giant", "Island"
  turn 1 A: cast "Rocco, Cabaretti Caterer" x 2
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Hill Giant"
}

scenario "search to battlefield: Shefet Monitor when cycled finds a Desert" {
  battlefield A: 4 "Forest"
  hand A: "Shefet Monitor"
  library A: "Island", "Desert", "Ornithopter"
  turn 1 A: activate "Shefet Monitor"
  turn 1 A: choose "Desert"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Desert"
  assert hand A count 1
}

scenario "search to battlefield: Wargate finds a permanent card with mana value X or less" {
  battlefield A: 2 "Forest", 2 "Plains", "Island"
  hand A: "Wargate"
  library A: "Hill Giant", "Grizzly Bears", "Island"
  turn 1 A: cast "Wargate" x 2
  turn 1 A: choose "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

scenario "search to battlefield: Wargate's X limits the mana value" {
  battlefield A: 2 "Forest", 2 "Plains", "Island"
  hand A: "Wargate"
  library A: "Hill Giant", "Island"
  turn 1 A: cast "Wargate" x 2
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Hill Giant"
}

scenario "search to battlefield: Whir of Invention finds an artifact card" {
  battlefield A: 4 "Island"
  hand A: "Whir of Invention"
  library A: "Alpha Myr", "Island", "Memnite"
  turn 1 A: cast "Whir of Invention" x 1
  turn 1 A: choose "Memnite"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Memnite"
}

scenario "search to battlefield: Whir of Invention's X limits the mana value" {
  battlefield A: 4 "Island"
  hand A: "Whir of Invention"
  library A: "Alpha Myr", "Island"
  turn 1 A: cast "Whir of Invention" x 1
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Alpha Myr"
}

scenario "search to battlefield: Zur finds an enchantment card with mana value 3 or less as it attacks" {
  battlefield A: "Zur the Enchanter"
  library A: "Island", "Bitterblossom", "Island"
  turn 1 A: attack "Zur the Enchanter"
  turn 1 A: choose "Bitterblossom"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Bitterblossom"
}

# To the graveyard.

scenario "search to graveyard: Unmarked Grave finds a nonlegendary card" {
  battlefield A: 2 "Swamp"
  hand A: "Unmarked Grave"
  library A: "Barktooth Warbeard", "Hill Giant", "Island"
  turn 1 A: cast "Unmarked Grave"
  turn 1 A: choose "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Hill Giant"
}

scenario "search to graveyard: Unmarked Grave doesn't find a legendary card" {
  battlefield A: 2 "Swamp"
  hand A: "Unmarked Grave"
  library A: "Barktooth Warbeard"
  turn 1 A: cast "Unmarked Grave"
  run_to turn 1 postcombat_main
  assert library A contains "Barktooth Warbeard"
}

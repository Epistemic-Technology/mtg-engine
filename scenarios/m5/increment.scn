# Increment (CR 702.191a): whenever you cast a spell, if the amount of
# mana spent to cast it is greater than this creature's power or its
# toughness, put a +1/+1 counter on this creature.

scenario "increment: more mana than its power gives a counter" {
  battlefield A: "Hungry Graffalon", 3 "Forest", "Mountain"
  hand A: "Hill Giant"
  library A: "Forest", "Forest"
  turn 1 A: cast "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hungry Graffalon" +1/+1 1
  assert power "Hungry Graffalon" 4
}

scenario "increment: no more than its power and toughness gives none" {
  battlefield A: "Hungry Graffalon", 3 "Forest"
  hand A: "Grizzly Bears", "Giant Growth"
  library A: "Forest", "Forest"
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Giant Growth" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Hungry Graffalon" +1/+1 0
}

scenario "increment: greater than either power or toughness is enough" {
  battlefield A: "Textbook Tabulator", "Mountain"
  hand A: "Shock"
  library A: "Island", "Island"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert counters "Textbook Tabulator" +1/+1 1
  assert power "Textbook Tabulator" 1
  assert toughness "Textbook Tabulator" 4
}

scenario "increment: each spell is judged against the creature as it is then" {
  battlefield A: "Textbook Tabulator", 2 "Mountain"
  hand A: "Shock", "Lightning Bolt"
  library A: "Island", "Island"
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert counters "Textbook Tabulator" +1/+1 1
}

scenario "increment: X counts as mana spent" {
  battlefield A: "Hungry Graffalon", 5 "Mountain"
  hand A: "Blaze"
  library A: "Island", "Island"
  turn 1 A: cast "Blaze" x 4 targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
  assert counters "Hungry Graffalon" +1/+1 1
}

scenario "increment: an opponent's spell doesn't count" {
  battlefield A: "Textbook Tabulator"
  battlefield B: "Mountain"
  hand B: "Shock"
  turn 1 B: cast "Shock" targeting player A
  run_to turn 1 postcombat_main
  assert life A 18
  assert counters "Textbook Tabulator" +1/+1 0
}

scenario "increment: a spell with no mana spent doesn't count" {
  battlefield A: "Textbook Tabulator"
  hand A: "Ornithopter"
  turn 1 A: cast "Ornithopter"
  run_to turn 1 postcombat_main
  assert counters "Textbook Tabulator" +1/+1 0
}

scenario "increment: Pensive Professor draws when it gets the counter" {
  battlefield A: "Pensive Professor", "Mountain"
  hand A: "Shock"
  library A: "Island", "Island"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert counters "Pensive Professor" +1/+1 1
  assert hand A count 1
}

scenario "increment: Topiary Lecturer adds {G} for its power" {
  battlefield A: "Topiary Lecturer" with 2 +1/+1, "Forest"
  hand A: "Giant Spider"
  library A: "Island", "Island"
  turn 1 A: cast "Giant Spider"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Giant Spider"
  assert tapped "Topiary Lecturer"
  assert counters "Topiary Lecturer" +1/+1 3
}

scenario "increment: Berta adds mana when counters land, and makes a Fractal" {
  battlefield A: "Berta, Wise Extrapolator", 3 "Forest", "Mountain"
  hand A: "Hill Giant"
  library A: "Island", "Island"
  turn 1 A: cast "Hill Giant"
  turn 1 A: wait
  turn 1 A: activate "Berta, Wise Extrapolator" x 1
  run_to turn 1 postcombat_main
  assert counters "Berta, Wise Extrapolator" +1/+1 1
  assert battlefield A contains "Fractal"
  assert power "Fractal" 1
}

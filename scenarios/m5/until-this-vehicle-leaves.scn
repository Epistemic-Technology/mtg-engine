# "Exile target ... until this Vehicle leaves the battlefield".

scenario "Detention Chariot exiles until it leaves" {
  battlefield A: 6 "Plains"
  battlefield B: "Hill Giant", 2 "Mountain"
  hand A: "Detention Chariot"
  hand B: "Shatter"
  start turn 1 A precombat_main
  turn 1 A: cast "Detention Chariot"
  turn 1 A: trigger "Detention Chariot" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  turn 2 B: cast "Shatter" targeting "Detention Chariot"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert graveyard A contains "Detention Chariot"
}

scenario "Detention Chariot: only an opponent's artifact or creature" {
  battlefield A: 6 "Plains", "Grizzly Bears"
  battlefield B: "Forest", "Bonesplitter"
  hand A: "Detention Chariot"
  start turn 1 A precombat_main
  turn 1 A: cast "Detention Chariot"
  illegal turn 1 A: trigger "Detention Chariot" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert exile B contains "Bonesplitter"
}

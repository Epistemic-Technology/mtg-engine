# Damage and combat riders: "If that creature or planeswalker would die
# this turn, exile it instead" (CR 700.4: a planeswalker dies too); "If a
# creature dealt damage by this creature this turn would die, exile it
# instead" (CR 614.6); "During turns other than yours, ..." for P/T and
# spell costs (CR 601.2f).

# ---- exile instead of dying ----

scenario "Fanged Flames: a planeswalker it damaged is exiled instead of dying" {
  battlefield A: 2 "Mountain"
  battlefield B: "Jace Beleren"
  hand A: "Fanged Flames"
  turn 1 A: cast "Fanged Flames" targeting "Jace Beleren"
  run_to turn 1 postcombat_main
  assert exile B contains "Jace Beleren"
  assert graveyard B lacks "Jace Beleren"
}

scenario "Scorching Dragonfire: a creature it damaged is exiled instead of dying" {
  battlefield A: 2 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Scorching Dragonfire"
  turn 1 A: cast "Scorching Dragonfire" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert graveyard B lacks "Hill Giant"
}

scenario "Flame-Blessed Bolt: a creature that survives stays" {
  battlefield A: "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Flame-Blessed Bolt"
  turn 1 A: cast "Flame-Blessed Bolt" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert damage "Hill Giant" 2
}

scenario "Frostwielder: a creature it damaged this turn is exiled when it dies" {
  battlefield A: "Frostwielder", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Shock"
  turn 1 A: activate "Frostwielder" targeting "Hill Giant"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert graveyard B lacks "Hill Giant"
}

scenario "Frostwielder: a creature it didn't damage dies as usual" {
  battlefield A: "Frostwielder", "Mountain"
  battlefield B: "Llanowar Elves"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting "Llanowar Elves"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Llanowar Elves"
}

scenario "Incendiary Oracle: a blocker it kills in combat is exiled" {
  battlefield A: "Incendiary Oracle"
  battlefield B: "Llanowar Elves"
  turn 1 A: attack "Incendiary Oracle"
  turn 1 B: block "Incendiary Oracle" with "Llanowar Elves"
  run_to turn 1 postcombat_main
  assert exile B contains "Llanowar Elves"
  assert graveyard B lacks "Llanowar Elves"
}

# ---- during turns other than yours ----

scenario "Mesa Lynx: +0/+2 during an opponent's turn, not its own" {
  battlefield A: "Mesa Lynx"
  start turn 1 A precombat_main
  run_to turn 1 precombat_main
  assert toughness "Mesa Lynx" 1
  run_to turn 2 precombat_main
  assert toughness "Mesa Lynx" 3
}

scenario "Geyser Drake: spells cost {1} less on an opponent's turn" {
  battlefield A: "Geyser Drake", "Island"
  hand A: "Think Twice"
  start turn 2 B precombat_main
  turn 2 end A: cast "Think Twice"
  run_to turn 3 upkeep
  assert graveyard A contains "Think Twice"
}

scenario "Naiad of Hidden Coves: no reduction on your own turn" {
  battlefield A: "Naiad of Hidden Coves", "Island"
  hand A: "Think Twice"
  illegal turn 1 A: cast "Think Twice"
  run_to turn 1 postcombat_main
}

# ---- riders on existing wordings ----

scenario "Plague Fiend: the damaged creature is destroyed unless its controller pays {2}" {
  battlefield A: "Plague Fiend"
  battlefield B: "Grizzly Bears"
  turn 1 A: attack "Plague Fiend"
  turn 1 B: block "Plague Fiend" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "Plague Fiend: paying {2} saves the creature" {
  battlefield A: "Plague Fiend"
  battlefield B: "Hill Giant", 2 "Forest"
  turn 1 A: attack "Plague Fiend"
  turn 1 B: block "Plague Fiend" with "Hill Giant"
  turn 1 combat_damage B: accept "Plague Fiend"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert tapped B "Forest"
}

scenario "Sarkhan's Rage: 2 damage to you without a Dragon" {
  battlefield A: 5 "Mountain"
  hand A: "Sarkhan's Rage"
  turn 1 A: cast "Sarkhan's Rage" targeting player B
  run_to turn 1 postcombat_main
  assert life B 15
  assert life A 18
}

# ---- one or more counters put on this creature ----

scenario "Knighted Myr: adapting puts a counter on it and it gains double strike" {
  battlefield A: "Knighted Myr", 3 "Plains"
  turn 1 A: activate "Knighted Myr"
  run_to turn 1 postcombat_main
  assert counters "Knighted Myr" +1/+1 1
  assert has "Knighted Myr" double_strike
}

scenario "Fetid Gargantua: two counters at once trigger it once" {
  battlefield A: "Fetid Gargantua", 3 "Swamp"
  library A: "Forest", "Forest", "Forest", "Forest"
  turn 1 A: activate "Fetid Gargantua"
  run_to turn 1 postcombat_main
  assert counters "Fetid Gargantua" +1/+1 2
  assert hand A count 2
  assert life A 18
}

scenario "Dreamdrinker Vampire: menace only once counters are put on it" {
  battlefield A: "Dreamdrinker Vampire", 2 "Swamp"
  run_to turn 1 precombat_main
  assert has not "Dreamdrinker Vampire" menace
  turn 1 A: activate "Dreamdrinker Vampire"
  run_to turn 1 postcombat_main
  assert has "Dreamdrinker Vampire" menace
}

scenario "Evolution Witness: adapt with counters already on it does nothing" {
  battlefield A: "Evolution Witness" with 1 +1/+1, 2 "Forest"
  graveyard A: "Grizzly Bears"
  turn 1 A: activate "Evolution Witness"
  run_to turn 1 postcombat_main
  assert counters "Evolution Witness" +1/+1 1
  assert graveyard A contains "Grizzly Bears"
}

scenario "Evolution Witness: adapting returns a permanent card" {
  battlefield A: "Evolution Witness", 2 "Forest"
  graveyard A: "Grizzly Bears"
  turn 1 A: activate "Evolution Witness"
  turn 1 A: trigger "Evolution Witness" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
}

# A target check written after the sentence: "Put a +1/+1 counter on
# target creature you control if it's legendary.", "... gets +2/+2 until
# end of turn if its power is 2." (the target as the sentence resolves).

scenario "if its power is 2: Savage Swipe pumps a 2-power creature, then it fights" {
  battlefield A: "Forest", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Savage Swipe"
  turn 1 A: cast "Savage Swipe" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
}

scenario "if its power is 2: no pump for another power" {
  battlefield A: "Forest", "Hill Giant"
  battlefield B: "Grizzly Bears"
  hand A: "Savage Swipe"
  turn 1 A: cast "Savage Swipe" targeting A "Hill Giant", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 3
}

scenario "if it's legendary: no counter on a nonlegendary creature" {
  battlefield A: 2 "Forest", "Hill Giant"
  battlefield B: "Grizzly Bears"
  hand A: "Ancient Animus"
  turn 1 A: cast "Ancient Animus" targeting "Hill Giant", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 0
  assert graveyard B contains "Grizzly Bears"
}

scenario "if its power is 4 or greater: Ent's Fury" {
  battlefield A: 2 "Forest", "Craw Wurm"
  battlefield B: "Hill Giant"
  hand A: "Ent's Fury"
  turn 1 A: cast "Ent's Fury" targeting "Craw Wurm", "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Craw Wurm" +1/+1 1
  assert power "Craw Wurm" 8
  assert graveyard B contains "Hill Giant"
}

scenario "if its power is 4 or greater: not a smaller creature" {
  battlefield A: 2 "Forest", "Grizzly Bears"
  battlefield B: "Llanowar Elves"
  hand A: "Ent's Fury"
  turn 1 A: cast "Ent's Fury" targeting "Grizzly Bears", "Llanowar Elves"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
  assert power "Grizzly Bears" 3
}

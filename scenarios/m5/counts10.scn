# Counts from the tenth wave: half a target player's library, the
# greatest mana value among a group or in a graveyard, "N or ...,
# whichever is greater", the triggering spell's colors, the damage dealt
# to a dying creature this turn, creatures that left the battlefield this
# turn, and "explores X times".

scenario "Kitsune's Technique: target opponent mills half their library, rounded up" {
  battlefield A: 6 "Island"
  hand A: "Kitsune's Technique"
  library B: "Forest", "Forest", "Forest", "Forest", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Kitsune's Technique" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B count 3
  assert library B count 2
}

scenario "Overture: target opponent mills half their library, rounded down" {
  battlefield A: 6 "Island"
  hand A: "Jidoor, Aristocratic Capital // Overture"
  library B: "Forest", "Forest", "Forest", "Forest", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Overture" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B count 2
  assert library B count 3
  assert exile A contains "Jidoor, Aristocratic Capital"
}

scenario "Jadelight Spelunker explores X times" {
  battlefield A: 3 "Forest"
  hand A: "Jadelight Spelunker"
  library A: "Forest", "Grizzly Bears", "Hill Giant", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Jadelight Spelunker" x 2
  run_to turn 1 postcombat_main
  assert hand A contains "Forest"
  assert graveyard A contains "Grizzly Bears"
  assert counters "Jadelight Spelunker" +1/+1 1
  assert library A count 2
}

scenario "Jadelight Spelunker with X 0 doesn't explore" {
  battlefield A: "Forest"
  hand A: "Jadelight Spelunker"
  library A: "Forest", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Jadelight Spelunker" x 0
  run_to turn 1 postcombat_main
  assert counters "Jadelight Spelunker" +1/+1 0
  assert library A count 2
}

scenario "Ramos gets a counter for each of the spell's colors" {
  battlefield A: "Ramos, Dragon Engine", "Mountain", "Plains", 3 "Island"
  hand A: "Lightning Helix", "Ornithopter", "Divination"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Helix" targeting player B
  turn 1 A: cast "Ornithopter"
  turn 1 A: cast "Divination"
  run_to turn 1 postcombat_main
  assert counters "Ramos, Dragon Engine" +1/+1 3
}

scenario "Tangled Colony makes a Rat for each damage dealt to it this turn" {
  battlefield A: "Tangled Colony", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Tangled Colony"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Tangled Colony"
  assert battlefield A count 4
}

scenario "Tangled Colony: two damage, two Rats" {
  battlefield A: "Tangled Colony", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Tangled Colony"
  run_to turn 1 postcombat_main
  assert battlefield A count 3
}

scenario "Kutzil's Flanker counts creatures that left under your control" {
  battlefield A: "Grizzly Bears", "Hill Giant", "Mountain", 3 "Plains"
  battlefield B: "Wind Drake"
  hand A: "Lightning Bolt", "Kutzil's Flanker"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Kutzil's Flanker"
  turn 1 A: trigger "Kutzil's Flanker" mode 1
  run_to turn 1 postcombat_main
  assert counters "Kutzil's Flanker" +1/+1 1
}

scenario "Kutzil's Flanker doesn't count an opponent's creature" {
  battlefield A: "Mountain", 3 "Plains"
  battlefield B: "Wind Drake"
  hand A: "Lightning Bolt", "Kutzil's Flanker"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Wind Drake"
  turn 1 A: wait
  turn 1 A: cast "Kutzil's Flanker"
  turn 1 A: trigger "Kutzil's Flanker" mode 1
  run_to turn 1 postcombat_main
  assert graveyard B contains "Wind Drake"
  assert counters "Kutzil's Flanker" +1/+1 0
}

scenario "Triumphant Chomp deals 2 with no bigger Dinosaur" {
  battlefield A: "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Triumphant Chomp"
  start turn 1 A precombat_main
  turn 1 A: cast "Triumphant Chomp" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert damage "Hill Giant" 2
}

scenario "Triumphant Chomp deals the greatest power among your Dinosaurs" {
  battlefield A: "Mountain", "Colossal Dreadmaw"
  battlefield B: "Serra Angel"
  hand A: "Triumphant Chomp"
  start turn 1 A precombat_main
  turn 1 A: cast "Triumphant Chomp" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
}

scenario "Wick's Patrol: -X/-X from the greatest mana value in your graveyard" {
  battlefield A: 4 "Swamp", 2 "Forest"
  battlefield B: "Colossal Dreadmaw"
  hand A: "Wick's Patrol"
  library A: "Serra Angel", "Grizzly Bears", "Forest", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Wick's Patrol"
  turn 1 A: trigger "Wick's Patrol" targeting "Colossal Dreadmaw"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Serra Angel"
  assert toughness "Colossal Dreadmaw" 1
  assert power "Colossal Dreadmaw" 1
}

scenario "Emissary Escort: the greatest mana value among other artifacts" {
  battlefield A: "Emissary Escort", "Juggernaut", "Ornithopter"
  start turn 1 A precombat_main
  assert power "Emissary Escort" 4
}

scenario "Emissary Escort doesn't count itself" {
  battlefield A: "Emissary Escort", "Ornithopter"
  start turn 1 A precombat_main
  assert power "Emissary Escort" 0
}

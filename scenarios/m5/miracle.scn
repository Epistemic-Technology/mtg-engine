# Miracle (CR 702.94a): the first card a player draws in a turn, if it has
# miracle, is revealed as it's drawn; its trigger lets its owner cast it
# for the miracle cost (the scenario runner always casts a card a trigger
# offers, with the engine's first targets).

scenario "miracle: drawn first in the draw step, cast for {R}" {
  battlefield A: "Mountain"
  library A: "Thunderous Wrath", "Island"
  start turn 3 A
  turn 3 draw A: wait
  turn 3 draw A: cast "Thunderous Wrath" targeting player B
  run_to turn 3 precombat_main
  assert life B 15
  assert graveyard A contains "Thunderous Wrath"
}

scenario "miracle: the second card drawn this turn isn't a miracle" {
  battlefield A: 3 "Island", "Mountain"
  hand A: "Divination"
  library A: "Island", "Thunderous Wrath", "Forest"
  turn 1 A: cast "Divination"
  run_to turn 1 postcombat_main
  assert hand A contains "Thunderous Wrath"
  assert life B 20
}

scenario "miracle: without the miracle mana, it stays in hand" {
  battlefield A: "Island"
  library A: "Thunderous Wrath", "Island"
  start turn 3 A
  run_to turn 3 precombat_main
  assert hand A contains "Thunderous Wrath"
  assert known B "Thunderous Wrath"
  assert life B 20
}

scenario "miracle: Banishing Stroke for {W}" {
  battlefield A: "Plains"
  battlefield B: "Hill Giant"
  library A: "Banishing Stroke", "Island"
  start turn 3 A
  turn 3 draw A: wait
  turn 3 draw A: cast "Banishing Stroke" targeting "Hill Giant"
  run_to turn 3 precombat_main
  assert library B contains "Hill Giant"
}

scenario "miracle: Vanishment puts a permanent on top" {
  battlefield A: "Island"
  battlefield B: "Hill Giant"
  library A: "Vanishment", "Island"
  start turn 3 A
  turn 3 draw A: wait
  turn 3 draw A: cast "Vanishment" targeting "Hill Giant"
  run_to turn 3 precombat_main
  assert library B contains "Hill Giant"
  assert battlefield B lacks "Hill Giant"
}

scenario "miracle: Devastation Tide bounces nonland permanents" {
  battlefield A: 2 "Island", "Grizzly Bears"
  battlefield B: "Hill Giant", "Forest"
  library A: "Devastation Tide", "Island"
  start turn 3 A
  turn 3 draw A: cast "Devastation Tide"
  run_to turn 3 precombat_main
  assert hand B contains "Hill Giant"
  assert hand A contains "Grizzly Bears"
  assert battlefield B contains "Forest"
}

scenario "miracle: Temporal Mastery takes an extra turn and is exiled" {
  battlefield A: 2 "Island", "Grizzly Bears"
  library A: "Temporal Mastery", "Island", "Island"
  start turn 3 A
  turn 3 draw A: cast "Temporal Mastery"
  turn 4 A: attack "Grizzly Bears"
  run_to turn 4 postcombat_main
  assert exile A contains "Temporal Mastery"
  assert life B 18
}

scenario "miracle: Blessings of Nature distributes four counters" {
  battlefield A: "Forest", "Grizzly Bears"
  library A: "Blessings of Nature", "Island"
  start turn 3 A
  turn 3 draw A: cast "Blessings of Nature" targeting "Grizzly Bears"
  run_to turn 3 precombat_main
  assert counters "Grizzly Bears" +1/+1 4
}

scenario "Tireless Provisioner: the second choice is a Treasure" {
  battlefield A: "Tireless Provisioner"
  hand A: "Forest"
  start turn 1 A precombat_main
  turn 1 A: play "Forest"
  turn 1 A: choose "2"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Treasure"
  assert battlefield A lacks "Food"
}


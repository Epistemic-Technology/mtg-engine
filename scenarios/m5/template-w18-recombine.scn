}

scenario "Sanctum of Stone Fangs: drains X at your first main phase, X the Shrines you control" {
  battlefield A: "Sanctum of Stone Fangs", "Sanctum of Fruitful Harvest"
  start turn 2 B precombat_main
  run_to turn 3 postcombat_main
  assert life B 18
  assert life A 22
}

scenario "Bilbo's Ring: attacking alone draws a card and loses 1 life" {
  battlefield A: "Bilbo's Ring" on "Grizzly Bears", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert life A 19
  assert life B 18
  assert has "Grizzly Bears" hexproof
}

scenario "Bilbo's Ring: attacking with another creature doesn't draw" {
  battlefield A: "Bilbo's Ring" on "Grizzly Bears", "Grizzly Bears", "Elite Vanguard"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears", "Elite Vanguard"
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert life A 20
}

scenario "Govern the Guildless: gain control of a monocolored creature" {
  battlefield A: 6 "Island"
  battlefield B: "Grizzly Bears"
  hand A: "Govern the Guildless"
  start turn 1 A precombat_main
  turn 1 A: cast "Govern the Guildless" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

scenario "Govern the Guildless: forecast in your upkeep makes a creature the colors you choose" {
  battlefield A: 2 "Island", "Grizzly Bears"
  hand A: "Govern the Guildless"
  start turn 2 B precombat_main
  turn 3 upkeep A: activate "Govern the Guildless" targeting "Grizzly Bears"
  turn 3 upkeep A: choose blue
  turn 3 upkeep A: choose done
  run_to turn 3 precombat_main
  assert is "Grizzly Bears" blue
  assert is not "Grizzly Bears" green
  assert hand A contains "Govern the Guildless"
}


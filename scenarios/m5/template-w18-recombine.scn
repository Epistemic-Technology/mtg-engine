scenario "Attended Healer: a Cat the first time you gain life each turn" {
  battlefield A: "Attended Healer", 2 "Plains"
  hand A: "Healing Salve", "Healing Salve"
  start turn 1 A precombat_main
  turn 1 A: cast "Healing Salve" mode 1 targeting player A
  turn 1 A: wait
  turn 1 A: cast "Healing Salve" mode 1 targeting player A
  run_to turn 1 postcombat_main
  assert life A 26
  assert battlefield A contains 1 "Cat"
}

scenario "Attended Healer: {2}{W} gives another Cleric lifelink" {

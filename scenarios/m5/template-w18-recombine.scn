}

scenario "Anax and Cymede: heroic gives creatures you control +1/+1 and trample" {
  battlefield A: "Anax and Cymede", "Grizzly Bears", "Forest"
  battlefield B: "Hill Giant"
  hand A: "Giant Growth"

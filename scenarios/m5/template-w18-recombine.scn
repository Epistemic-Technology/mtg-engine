# Cards the corpus line index writes by putting a trigger or cost one
# corpus line prints together with an effect another prints
# (`corpus_recombine`, eighteenth wave): only effects that read nothing
# from their trigger move.

scenario "Marsh Flitter: two Goblin Rogues; sacrificing a Goblin makes it a base 3/3 this turn" {
  battlefield A: 4 "Swamp"
  hand A: "Marsh Flitter"
  start turn 1 A precombat_main
  turn 1 A: cast "Marsh Flitter"
  turn 1 postcombat_main A: activate "Marsh Flitter" sacrificing "Goblin Rogue"
  run_to turn 1 end
  assert battlefield A contains 1 "Goblin Rogue"
  assert power "Marsh Flitter" 3
  assert toughness "Marsh Flitter" 3
  run_to turn 2 precombat_main
  assert power "Marsh Flitter" 1
}

scenario "Slaughter-Priest of Mogis: a sacrifice pumps it, and the cost's sacrifice gives first strike" {
  battlefield A: "Slaughter-Priest of Mogis", "Grizzly Bears", 2 "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Slaughter-Priest of Mogis" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Slaughter-Priest of Mogis" 4
  assert has "Slaughter-Priest of Mogis" first_strike
  run_to turn 2 precombat_main
  assert power "Slaughter-Priest of Mogis" 2
  assert has not "Slaughter-Priest of Mogis" first_strike
}

scenario "Hamlet Captain: attacking gives other Humans +1/+1" {
  battlefield A: "Hamlet Captain", "Elite Vanguard", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Hamlet Captain"
  run_to turn 1 postcombat_main
  assert power "Elite Vanguard" 3
  assert power "Grizzly Bears" 2
  assert power "Hamlet Captain" 2
  assert life B 18
}

scenario "Eater of Hope: {2}{B} and two other creatures destroy target creature" {
  battlefield A: "Eater of Hope", 2 "Grizzly Bears", 3 "Swamp"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Eater of Hope" ability 2 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains 2 "Grizzly Bears"
  assert battlefield A contains "Eater of Hope"
}

scenario "Eater of Hope: {B} and another creature regenerate it" {
  battlefield A: "Eater of Hope", "Grizzly Bears", "Swamp"
  battlefield B: 3 "Swamp"
  hand B: "Murder"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Eater of Hope"
  turn 2 A: activate "Eater of Hope" sacrificing "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Eater of Hope"
  assert graveyard A contains "Grizzly Bears"
}

scenario "Hopeful Initiate: removing two +1/+1 counters destroys an artifact or enchantment" {
  battlefield A: "Hopeful Initiate" with 2 +1/+1, 3 "Plains"
  battlefield B: "Ornithopter"
  start turn 1 A precombat_main
  turn 1 A: activate "Hopeful Initiate" targeting "Ornithopter"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Ornithopter"
  assert counters "Hopeful Initiate" +1/+1 0
}

scenario "Hopeful Initiate: one counter isn't enough" {
  battlefield A: "Hopeful Initiate" with 1 +1/+1, 3 "Plains"
  battlefield B: "Ornithopter"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Hopeful Initiate" targeting "Ornithopter"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Ornithopter"
}

scenario "Season of Growth: a spell targeting your creature draws a card" {
  battlefield A: "Season of Growth", "Grizzly Bears", "Forest"
  hand A: "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Giant Growth" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert power "Grizzly Bears" 5
}

scenario "Season of Growth: a spell targeting an opponent's creature doesn't" {
  battlefield A: "Season of Growth", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A count 0
}

scenario "Season of Growth: a creature entering scries 1" {
  battlefield A: "Season of Growth", 2 "Forest"
  hand A: "Grizzly Bears"
  library A: "Island", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: scry "Island"
  run_to turn 2 precombat_main
  assert hand A count 0
  assert library A contains "Island"
  run_to turn 3 precombat_main
  assert hand A contains "Swamp"
}

scenario "Kroxa and Kunoros: exiling five graveyard cards returns a creature card" {
  battlefield A: 3 "Mountain", "Plains", 2 "Swamp"
  hand A: "Kroxa and Kunoros"
  graveyard A: 5 "Forest", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Kroxa and Kunoros"
  turn 1 A: trigger "Kroxa and Kunoros" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert exile A contains 5 "Forest"
}

scenario "Kroxa and Kunoros: with fewer than five other cards, nothing returns" {
  battlefield A: 3 "Mountain", "Plains", 2 "Swamp"
  hand A: "Kroxa and Kunoros"
  graveyard A: 3 "Forest", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Kroxa and Kunoros"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Hill Giant"
}

scenario "Wingmate Roc: 1 life for each attacking creature" {
  battlefield A: "Wingmate Roc", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Wingmate Roc", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 22
  assert life B 15
}

scenario "Wingmate Roc: raid makes a 3/4 Bird" {
  battlefield A: "Grizzly Bears", 5 "Plains"
  hand A: "Wingmate Roc"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 postcombat_main A: cast "Wingmate Roc"
  run_to turn 1 end
  assert battlefield A contains "Bird"
  assert toughness "Bird" 4
  assert has "Bird" flying
}

scenario "Arwen Undómiel: scrying puts a +1/+1 counter on target creature" {
  battlefield A: "Arwen Undómiel", "Grizzly Bears", "Island"
  hand A: "Opt"
  start turn 1 A precombat_main
  turn 1 A: cast "Opt"
  turn 1 A: trigger "Arwen Undómiel" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Arwen Undómiel: {4}{G}{U} scries 2, and that scry triggers it" {
  battlefield A: "Arwen Undómiel", 3 "Forest", 3 "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Arwen Undómiel"
  turn 1 A: trigger "Arwen Undómiel" targeting "Arwen Undómiel"
  run_to turn 1 postcombat_main
  assert counters "Arwen Undómiel" +1/+1 1
}

scenario "Shrine of Boundless Growth: a counter at upkeep and for each green permanent spell" {
  battlefield A: "Shrine of Boundless Growth", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 3 A: cast "Grizzly Bears"
  run_to turn 3 postcombat_main

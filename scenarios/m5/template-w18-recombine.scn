}

scenario "Shrine of Boundless Growth: sacrificed, {C} for each charge counter" {
  battlefield A: "Shrine of Boundless Growth" with 4 charge
  hand A: "Juggernaut"
  start turn 1 A precombat_main
  turn 1 A: cast "Juggernaut"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Juggernaut"
  assert graveyard A contains "Shrine of Boundless Growth"
}


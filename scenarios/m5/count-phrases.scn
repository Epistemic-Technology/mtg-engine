# Counts the template author now writes from Oracle's words: "with mana
# value equal to the number of charge counters on this artifact" (the
# counters it had as it was sacrificed, CR 608.2h), "where X is your life
# total", "for each Elf you control", "unless its controller pays {X},
# where X is ...", "with the same name as that creature", and "those
# creatures" after a group.

scenario "Engineered Explosives: sacrificed with 2 counters, destroys mana value 2" {
  battlefield A: "Engineered Explosives" with 2 charge, 2 "Plains"
  battlefield B: "Grizzly Bears", "Mind Stone", "Hill Giant", "Forest"
  turn 1 A: activate "Engineered Explosives"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert graveyard B contains "Mind Stone"
  assert battlefield B contains "Hill Giant"
  assert battlefield B contains "Forest"
}

scenario "Ratchet Bomb: sacrificed with 4 counters, destroys mana value 4" {
  battlefield A: "Ratchet Bomb" with 4 charge
  battlefield B: "Grizzly Bears", "Hill Giant"
  turn 1 A: activate "Ratchet Bomb" ability 2
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Blast Zone: sacrificed with no counters, destroys mana value 0" {
  battlefield A: "Blast Zone", 3 "Plains"
  battlefield B: "Memnite", "Grizzly Bears"
  turn 1 A: activate "Blast Zone" ability 2
  run_to turn 1 postcombat_main
  assert graveyard B contains "Memnite"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Necroplasm: at end step, destroys creatures with mana value equal to its counters" {
  battlefield A: "Necroplasm" with 1 +1/+1
  battlefield B: "Grizzly Bears", "Llanowar Elves"
  start turn 1 A precombat_main
  run_to turn 1 cleanup
  assert graveyard B contains "Llanowar Elves"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Ajani, Wise Counselor: -9 puts counters equal to your life total" {
  battlefield A: "Ajani, Wise Counselor" with 9 loyalty, "Grizzly Bears"
  life A 12
  turn 1 A: activate "Ajani, Wise Counselor" ability 3 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 12
}

scenario "Immaculate Magistrate: a +1/+1 counter for each Elf you control" {
  battlefield A: "Immaculate Magistrate", "Llanowar Elves", "Elvish Mystic", "Grizzly Bears"
  battlefield B: "Llanowar Elves"
  turn 1 A: activate "Immaculate Magistrate" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
}

scenario "Thassa's Rebuff: unless its controller pays X, your devotion to blue" {
  battlefield A: 2 "Island", "Storm Crow", "Wind Drake"
  battlefield B: 4 "Mountain"
  hand B: "Shock"
  hand A: "Thassa's Rebuff"
  start turn 1 B precombat_main
  turn 1 B: cast "Shock" targeting player A
  turn 1 A: cast "Thassa's Rebuff" targeting "Shock"
  run_to turn 1 postcombat_main
  assert life A 18
}

scenario "Thassa's Rebuff: X too much to pay" {
  battlefield A: 2 "Island", "Storm Crow", "Wind Drake"
  battlefield B: 2 "Mountain"
  hand B: "Shock"
  hand A: "Thassa's Rebuff"
  start turn 1 B precombat_main
  turn 1 B: cast "Shock" targeting player A
  turn 1 A: cast "Thassa's Rebuff" targeting "Shock"
  run_to turn 1 postcombat_main
  assert life A 20
  assert graveyard B contains "Shock"
}

scenario "Homing Lightning: 4 damage to the target and each other creature with its name" {
  battlefield A: 4 "Mountain"
  battlefield B: "Hill Giant", "Hill Giant", "Grizzly Bears"
  hand A: "Homing Lightning"
  turn 1 A: cast "Homing Lightning" targeting oldest "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains 2 "Hill Giant"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Maelstrom Pulse: destroys the target and all other permanents with its name" {
  battlefield A: "Swamp", "Forest", "Island", "Grizzly Bears"
  battlefield B: "Grizzly Bears", "Hill Giant"
  hand A: "Maelstrom Pulse"
  turn 1 A: cast "Maelstrom Pulse" targeting B "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Grizzly Bears"
  assert battlefield B contains "Hill Giant"
}

scenario "Bile Blight: -3/-3 to the target and all others with its name" {
  battlefield A: 2 "Swamp", "Savannah Lions"
  battlefield B: "Savannah Lions", "Grizzly Bears"
  hand A: "Bile Blight"
  turn 1 A: cast "Bile Blight" targeting B "Savannah Lions"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Savannah Lions"
  assert graveyard B contains "Savannah Lions"
  assert battlefield B contains "Grizzly Bears"
}

scenario "Sever the Bloodline: exiles the target and all other creatures with its name" {
  battlefield A: 4 "Swamp"
  battlefield B: "Hill Giant", "Hill Giant", "Grizzly Bears"
  hand A: "Sever the Bloodline"
  turn 1 A: cast "Sever the Bloodline" targeting oldest "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains 2 "Hill Giant"
}

scenario "Izzet Staticaster: 1 damage to the target and each other creature with its name" {
  battlefield A: "Izzet Staticaster"
  battlefield B: "Llanowar Elves", "Llanowar Elves", "Grizzly Bears"
  turn 1 A: activate "Izzet Staticaster" targeting oldest "Llanowar Elves"
  run_to turn 1 postcombat_main
  assert graveyard B contains 2 "Llanowar Elves"
  assert damage "Grizzly Bears" 0
}

scenario "Domri, City Smasher: -8 counters, then those creatures gain trample" {
  battlefield A: "Domri, City Smasher" with 8 loyalty, "Grizzly Bears"
  battlefield B: "Savannah Lions"
  turn 1 A: activate "Domri, City Smasher" ability 3
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
  assert has "Grizzly Bears" trample
  assert has not "Savannah Lions" trample
}

scenario "Elspeth, Storm Slayer: 0, counters, then those creatures gain flying" {
  battlefield A: "Elspeth, Storm Slayer", "Grizzly Bears"
  battlefield B: "Savannah Lions"
  turn 1 A: activate "Elspeth, Storm Slayer" ability 2
  run_to turn 2 precombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert has "Grizzly Bears" flying
  assert has not "Savannah Lions" flying
}

scenario "Jeskai Ascendancy: a noncreature spell pumps and untaps creatures you control" {
  battlefield A: "Jeskai Ascendancy", "Grizzly Bears" tapped, "Mountain"
  battlefield B: "Savannah Lions" tapped
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert untapped "Grizzly Bears"
  assert power "Grizzly Bears" 3
  assert tapped "Savannah Lions"
}

scenario "Thundermaw Hellkite: 1 damage to fliers your opponents control, and taps them" {
  battlefield A: 5 "Mountain", "Storm Crow"
  battlefield B: "Wind Drake", "Grizzly Bears"
  hand A: "Thundermaw Hellkite"
  turn 1 A: cast "Thundermaw Hellkite"
  run_to turn 1 postcombat_main
  assert damage "Wind Drake" 1
  assert tapped "Wind Drake"
  assert untapped "Grizzly Bears"
  assert untapped "Storm Crow"
}

scenario "Go-Shintai of Boundless Vigor: a counter on a Shrine for each Shrine you control" {
  battlefield A: "Go-Shintai of Boundless Vigor", "Honden of Seeing Winds", "Forest"
  start turn 1 A precombat_main
  turn 1 end A: trigger "Go-Shintai of Boundless Vigor" targeting "Go-Shintai of Boundless Vigor"
  run_to turn 1 cleanup
  assert counters "Go-Shintai of Boundless Vigor" +1/+1 2
}

scenario "Briar Hydra: combat damage, counters equal to the basic land types" {
  battlefield A: "Briar Hydra", "Forest", "Island", "Grizzly Bears"
  turn 1 A: attack "Briar Hydra"
  turn 1 combat_damage A: trigger "Briar Hydra" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
}

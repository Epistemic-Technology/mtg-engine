# Alternative costs a permanent gives the spells its controller casts (CR
# 118.9): "You may pay {W}{U}{B}{R}{G} rather than pay the mana cost for
# spells you cast." (Leyline of Mutation), "You may collect evidence 10
# ..." (Conspiracy Unraveler), and "Once each turn, you may pay {0} rather
# than pay the mana cost for a spell you cast from exile." (Warped Space).
# `cast ... alternative` casts for it; X is 0; additional costs are still
# paid.

scenario "Leyline of Mutation: a creature for {W}{U}{B}{R}{G}" {
  battlefield A: "Leyline of Mutation", "Plains", "Island", "Swamp", "Mountain", "Forest"
  hand A: "Serra Angel"
  turn 1 A: cast "Serra Angel" alternative
  run_to turn 1 postcombat_main
  assert battlefield A contains "Serra Angel"
  assert tapped "Forest"
}

scenario "Leyline of Mutation: five colors needed, not five mana" {
  battlefield A: "Leyline of Mutation", 2 "Plains", "Island", "Swamp", "Mountain"
  hand A: "Serra Angel"
  illegal turn 1 A: cast "Serra Angel" alternative
  run_to turn 1 postcombat_main
  assert hand A contains "Serra Angel"
}

scenario "Leyline of Mutation: only its controller's spells" {
  battlefield B: "Leyline of Mutation"
  battlefield A: "Plains", "Island", "Swamp", "Mountain", "Forest"
  hand A: "Serra Angel"
  illegal turn 1 A: cast "Serra Angel" alternative
  run_to turn 1 postcombat_main
  assert hand A contains "Serra Angel"
}

scenario "Leyline of Mutation: the spell's targets and timing still count" {
  battlefield A: "Leyline of Mutation", "Plains", "Island", "Swamp", "Mountain", "Forest"
  battlefield B: "Hill Giant"
  hand A: "Murder"
  turn 1 A: cast "Murder" alternative targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

scenario "Conspiracy Unraveler: collect evidence 10 for a spell" {
  battlefield A: "Conspiracy Unraveler"
  graveyard A: "Serra Angel", "Hill Giant", "Grizzly Bears", "Lightning Bolt"
  hand A: "Divination"
  turn 1 A: cast "Divination" alternative
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert graveyard A contains "Divination"
  assert exile A contains "Serra Angel"
  assert exile A contains "Hill Giant"
  assert exile A contains "Grizzly Bears"
}

scenario "Conspiracy Unraveler: not with less than 10 in the graveyard" {
  battlefield A: "Conspiracy Unraveler"
  graveyard A: "Serra Angel", "Grizzly Bears", "Lightning Bolt"
  hand A: "Divination"
  illegal turn 1 A: cast "Divination" alternative
  run_to turn 1 postcombat_main
  assert hand A count 1
}

scenario "Warped Space: once each turn, a spell from exile for {0}" {
  battlefield A: "Warped Space", 2 "Mountain"
  library A: "Serra Angel", "Hill Giant", "Plains"
  hand A: "Reckless Impulse"
  turn 1 A: cast "Reckless Impulse"
  turn 1 A: wait
  turn 1 A: cast "Serra Angel" alternative
  illegal turn 1 A: cast "Hill Giant" alternative
  run_to turn 1 postcombat_main
  assert battlefield A contains "Serra Angel"
  assert exile A contains "Hill Giant"
}

scenario "Warped Space: not for a spell from the hand" {
  battlefield A: "Warped Space"
  hand A: "Serra Angel"
  illegal turn 1 A: cast "Serra Angel" alternative
  run_to turn 1 postcombat_main
  assert hand A contains "Serra Angel"
}

scenario "Warped Space: used again on a later turn" {
  battlefield A: "Warped Space", 2 "Mountain"
  library A: "Serra Angel", "Hill Giant", "Plains", "Plains"
  hand A: "Reckless Impulse"
  turn 1 A: cast "Reckless Impulse"
  turn 1 A: wait
  turn 1 A: cast "Serra Angel" alternative
  turn 3 A: cast "Hill Giant" alternative
  run_to turn 3 postcombat_main
  assert battlefield A contains "Serra Angel"
  assert battlefield A contains "Hill Giant"
}

scenario "Charred Foyer: the top card each upkeep, playable this turn" {
  battlefield A: "Charred Foyer"
  library A: "Hill Giant", "Plains"
  start turn 2 B precombat_main
  run_to turn 3 precombat_main
  assert exile A contains "Hill Giant"
}

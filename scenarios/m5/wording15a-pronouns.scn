# Pronoun and noun choices: "If it was a Soldier" after a target (Zephyr
# Sentinel), and others added with them.

scenario "Zephyr Sentinel: returning a Soldier puts a +1/+1 counter on it" {
  battlefield A: "Elite Vanguard", 2 "Island"
  hand A: "Zephyr Sentinel"
  turn 1 A: cast "Zephyr Sentinel"
  turn 1 A: trigger "Zephyr Sentinel" targeting "Elite Vanguard"
  run_to turn 1 postcombat_main
  assert hand A contains "Elite Vanguard"
  assert counters "Zephyr Sentinel" +1/+1 1
  assert power "Zephyr Sentinel" 3
}

scenario "Zephyr Sentinel: returning a non-Soldier puts no counter" {
  battlefield A: "Grizzly Bears", 2 "Island"
  hand A: "Zephyr Sentinel"
  turn 1 A: cast "Zephyr Sentinel"
  turn 1 A: trigger "Zephyr Sentinel" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert counters "Zephyr Sentinel" +1/+1 0
}

# "That artifact becomes a 0/0 Homunculus artifact creature with flying."
# (Kenku Artificer): a target artifact named "that artifact".
scenario "Kenku Artificer: a noncreature artifact becomes a 3/3 flier" {
  battlefield A: "Sol Ring", 3 "Island"
  hand A: "Kenku Artificer"
  turn 1 A: cast "Kenku Artificer"
  turn 1 A: trigger "Kenku Artificer" targeting "Sol Ring"
  run_to turn 1 postcombat_main
  assert counters "Sol Ring" +1/+1 3
  assert is "Sol Ring" creature
  assert is "Sol Ring" Homunculus
  assert power "Sol Ring" 3
  assert toughness "Sol Ring" 3
  assert has "Sol Ring" flying
}

scenario "Kenku Artificer: not a creature" {
  battlefield A: "Grizzly Bears", "Sol Ring", 3 "Island"
  hand A: "Kenku Artificer"
  turn 1 A: cast "Kenku Artificer"
  illegal turn 1 A: trigger "Kenku Artificer" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
}

# "When this Aura leaves the battlefield, destroy enchanted creature. That
# creature can't be regenerated." (Parallax Dementia).
scenario "Parallax Dementia: +3/+2, then fading destroys the creature" {
  battlefield A: 2 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Parallax Dementia"
  turn 1 A: cast "Parallax Dementia" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 5
  assert toughness "Grizzly Bears" 4
  assert counters "Parallax Dementia" fade 1
  run_to turn 3 precombat_main
  assert counters "Parallax Dementia" fade 0
  assert battlefield B contains "Grizzly Bears"
  run_to turn 5 precombat_main
  assert graveyard A contains "Parallax Dementia"
  assert graveyard B contains "Grizzly Bears"
}

# "Whenever this permanent is dealt damage, if it's a creature, sacrifice
# that many permanents." (Phyrexian Totem).
scenario "Phyrexian Totem: dealt 2 damage as a creature, sacrifice two permanents" {
  battlefield A: "Phyrexian Totem", 3 "Swamp", 2 "Plains"
  battlefield B: "Mountain"
  hand B: "Shock"
  turn 1 A: activate "Phyrexian Totem"
  turn 1 begin_combat B: cast "Shock" targeting "Phyrexian Totem"
  run_to turn 1 postcombat_main
  assert battlefield A count 4
  assert graveyard A contains "Phyrexian Totem"
}

scenario "Phyrexian Totem: becomes a 5/5 black trampler" {
  battlefield A: "Phyrexian Totem", 3 "Swamp"
  turn 1 A: activate "Phyrexian Totem"
  run_to turn 1 begin_combat
  assert power "Phyrexian Totem" 5
  assert toughness "Phyrexian Totem" 5
  assert has "Phyrexian Totem" trample
  assert is "Phyrexian Totem" black
  assert is "Phyrexian Totem" Horror
}

# "You may put that card into their graveyard." (Draugr Thought-Thief).
scenario "Draugr Thought-Thief: mill the target player's top card" {
  battlefield A: 3 "Island"
  hand A: "Draugr Thought-Thief"
  library B: "Grizzly Bears", "Forest"
  turn 1 A: cast "Draugr Thought-Thief"
  turn 1 A: trigger "Draugr Thought-Thief" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert library B contains "Forest"
}

scenario "Draugr Thought-Thief: declining leaves the card on top" {
  battlefield A: 3 "Island"
  hand A: "Draugr Thought-Thief"
  library B: "Grizzly Bears", "Forest"
  turn 1 A: cast "Draugr Thought-Thief"
  turn 1 A: trigger "Draugr Thought-Thief" targeting player B
  turn 1 A: decline "Draugr Thought-Thief"
  run_to turn 1 postcombat_main
  assert library B contains "Grizzly Bears"
  assert known A "Grizzly Bears"
}

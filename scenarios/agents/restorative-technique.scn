scenario "Restorative Technique: target player gains life, fetches a basic tapped, counter on creature" {
  battlefield A: 3 "Forest", "Grizzly Bears"
  hand A: "Restorative Technique"
  library B: "Swamp", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Restorative Technique" targeting player B, "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 22
  assert battlefield B contains "Swamp"
  assert tapped "Swamp"
  assert counters "Grizzly Bears" +1/+1 1
  assert graveyard A contains "Restorative Technique"
}

scenario "Restorative Technique: targeting yourself and no creature" {
  battlefield A: 3 "Forest"
  hand A: "Restorative Technique"
  library A: "Mountain", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Restorative Technique" targeting player A
  run_to turn 1 postcombat_main
  assert life A 22
  assert battlefield A contains 3 "Forest"
  assert battlefield A contains "Mountain"
}

scenario "dormant grove transforms when the creature reaches toughness 6" {
  battlefield A: "Dormant Grove", "Hill Giant" with 2 +1/+1
  turn 1 begin_combat A: trigger "Dormant Grove" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 3
  assert toughness "Hill Giant" 6
  assert battlefield A contains "Gnarled Grovestrider"
  assert has "Hill Giant" vigilance
  assert has "Gnarled Grovestrider" vigilance
}
scenario "dormant grove stays put when toughness is below 6" {
  battlefield A: "Dormant Grove", "Grizzly Bears"
  turn 1 begin_combat A: trigger "Dormant Grove" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert battlefield A contains "Dormant Grove"
  assert has not "Grizzly Bears" vigilance
}

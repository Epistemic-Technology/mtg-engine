scenario "Argivian Restoration returns an artifact card to the battlefield" {
  battlefield A: 4 "Island"
  hand A: "Argivian Restoration"
  graveyard A: "Assembly-Worker"
  start turn 1 A precombat_main
  turn 1 A: cast "Argivian Restoration" targeting "Assembly-Worker"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Assembly-Worker"
  assert graveyard A lacks "Assembly-Worker"
  assert graveyard A contains "Argivian Restoration"
}

scenario "Argivian Restoration can't return a nonartifact card" {
  battlefield A: 4 "Island"
  hand A: "Argivian Restoration"
  graveyard A: "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Argivian Restoration" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert hand A contains "Argivian Restoration"
}

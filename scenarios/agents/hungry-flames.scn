scenario "Hungry Flames hits a creature and a player" {
  battlefield A: 3 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Hungry Flames"
  start turn 2 A precombat_main
  turn 2 A: cast "Hungry Flames" targeting "Hill Giant", player B
  run_to turn 2 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert life B 18
}

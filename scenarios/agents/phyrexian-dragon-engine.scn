scenario "Phyrexian Dragon Engine unearthed discards the hand and draws three" {
  battlefield A: 5 "Mountain"
  graveyard A: "Phyrexian Dragon Engine"
  hand A: "Grizzly Bears", "Shock"
  library A: "Forest", "Island", "Swamp", "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Phyrexian Dragon Engine"
  run_to turn 1 postcombat_main
  assert hand A count 3
  assert hand A contains "Forest"
  assert hand A contains "Island"
  assert hand A contains "Swamp"
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Shock"
}

scenario "Phyrexian Dragon Engine cast from hand does not trigger" {
  battlefield A: 5 "Mountain"
  hand A: "Phyrexian Dragon Engine", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Phyrexian Dragon Engine"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand A count 1
}

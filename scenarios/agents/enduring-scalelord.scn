scenario "Enduring Scalelord grows when another creature gets a counter" {
  battlefield A: "Enduring Scalelord", "Grizzly Bears", "Forest"
  hand A: "Burst of Strength"
  turn 1 precombat_main A: cast "Burst of Strength" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Enduring Scalelord" +1/+1 1
}

scenario "Enduring Scalelord ignores counters on itself and opposing creatures" {
  battlefield A: "Enduring Scalelord", "Forest", "Forest"
  battlefield B: "Hill Giant"
  hand A: "Burst of Strength", "Burst of Strength"
  turn 1 precombat_main A: cast "Burst of Strength" targeting "Enduring Scalelord"
  turn 1 precombat_main A: cast "Burst of Strength" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Enduring Scalelord" +1/+1 1
  assert counters "Hill Giant" +1/+1 1
}

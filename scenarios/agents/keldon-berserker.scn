scenario "Keldon Berserker: +3/+0 when you control no untapped lands" {
  battlefield A: "Keldon Berserker", "Mountain" tapped
  start turn 2 A precombat_main
  turn 2 A: attack "Keldon Berserker"
  run_to turn 2 postcombat_main
  assert life B 15
  assert power "Keldon Berserker" 5
}

scenario "Keldon Berserker: no bonus with an untapped land" {
  battlefield A: "Keldon Berserker", "Mountain"
  start turn 2 A precombat_main
  turn 2 A: attack "Keldon Berserker"
  run_to turn 2 postcombat_main
  assert life B 18
  assert power "Keldon Berserker" 2
}

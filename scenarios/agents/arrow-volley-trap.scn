scenario "Arrow Volley Trap costs {1}{W} with four attackers and divides 5 damage" {
  battlefield A: 2 "Plains"
  battlefield B: "Grizzly Bears", "Wind Drake", "Hill Giant", "Serra Angel"
  hand A: "Arrow Volley Trap"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears", "Wind Drake", "Hill Giant", "Serra Angel"
  turn 2 declare_attackers A: cast "Arrow Volley Trap" alternative targeting "Grizzly Bears", "Wind Drake", "Hill Giant" dividing 2, 2, 1
  run_to turn 2 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert graveyard B contains "Grizzly Bears"
  assert graveyard B contains "Wind Drake"
  assert life A 13
  assert graveyard A contains "Arrow Volley Trap"
}

scenario "Arrow Volley Trap alternative cost needs four attackers" {
  battlefield A: 2 "Plains"
  battlefield B: 3 "Grizzly Bears"
  hand A: "Arrow Volley Trap"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"
  illegal turn 2 declare_attackers A: cast "Arrow Volley Trap" alternative targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert hand A contains "Arrow Volley Trap"
}

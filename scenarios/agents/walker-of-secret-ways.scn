scenario "walker looks at hand on combat damage" {
  battlefield A: "Walker of Secret Ways"
  hand B: "Lightning Bolt"
  turn 1 A: attack "Walker of Secret Ways"
  run_to turn 1 postcombat_main
  assert life B 19
  assert known A "Lightning Bolt"
}
scenario "walker bounces a ninja only on your turn" {
  battlefield A: "Walker of Secret Ways", 2 "Island"
  battlefield B: 2 "Island"
  start turn 2 B
  illegal turn 2 B: activate "Walker of Secret Ways" targeting "Walker of Secret Ways"
  turn 3 A: activate "Walker of Secret Ways" targeting "Walker of Secret Ways"
  run_to turn 3 postcombat_main
  assert hand A contains "Walker of Secret Ways"
  assert battlefield A lacks "Walker of Secret Ways"
}

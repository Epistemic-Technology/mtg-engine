scenario "Agent Venom draws and drains when another nontoken creature dies" {
  battlefield A: "Agent Venom", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  library A: "Island", "Forest"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 1
  assert life A 19
}

scenario "Agent Venom does not trigger on its own death" {
  battlefield A: "Agent Venom"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Agent Venom"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Agent Venom"
  assert hand A count 0
  assert life A 20
}

scenario "Pollenbright Wings flying and saprolings equal to damage" {
  battlefield A: "Grizzly Bears", "Pollenbright Wings" on "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert has "Grizzly Bears" flying
  assert life B 18
  assert battlefield A contains 2 "Saproling"
}
scenario "Pollenbright Wings no saprolings when blocked" {
  battlefield A: "Grizzly Bears", "Pollenbright Wings" on "Grizzly Bears"
  battlefield B: "Wind Drake"
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Wind Drake"
  run_to turn 1 postcombat_main
  assert life B 20
  assert battlefield A lacks "Saproling"
}

scenario "Glowcap Lantern's creature explores a land into hand when it attacks" {
  battlefield A: "Grizzly Bears", "Glowcap Lantern" on "Grizzly Bears"
  library A: "Forest", "Plains"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Forest"
  assert counters "Grizzly Bears" +1/+1 0
  assert life B 18
}

scenario "Glowcap Lantern's creature explores a nonland and gets a counter" {
  battlefield A: "Grizzly Bears", "Glowcap Lantern" on "Grizzly Bears"
  library A: "Hill Giant", "Plains"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert hand A count 0
  assert life B 17
}

scenario "Glowcap Lantern equips for 2" {
  battlefield A: "Grizzly Bears", "Glowcap Lantern", 2 "Forest"
  library A: "Hill Giant", "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Glowcap Lantern" targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Glowcap Lantern" to "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 1
}

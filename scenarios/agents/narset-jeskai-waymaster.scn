scenario "narset discards hand and draws one per spell cast" {
  battlefield A: "Narset, Jeskai Waymaster", 2 "Mountain"
  hand A: "Shock", "Lightning Bolt", "Hill Giant"
  library A: "Island", "Forest", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 2 upkeep
  assert graveyard A contains "Hill Giant"
  assert hand A count 2
  assert hand A contains "Island"
  assert hand A contains "Forest"
  assert life B 15
}

scenario "narset declined keeps the hand" {
  battlefield A: "Narset, Jeskai Waymaster"
  hand A: "Hill Giant"
  library A: "Island", "Forest", "Swamp"
  start turn 1 A precombat_main
  turn 1 end A: decline "Narset, Jeskai Waymaster"
  run_to turn 2 upkeep
  assert hand A count 1
  assert hand A contains "Hill Giant"
}

scenario "Pride without blessing" {
  battlefield A: "Grizzly Bears", "Hill Giant", "Plains", "Plains"
  battlefield B: "Serra Angel"
  hand A: "Pride of Conquerors"
  turn 1 A: cast "Pride of Conquerors"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 3
  assert toughness "Hill Giant" 4
  assert power B "Serra Angel" 4
}

scenario "Pride with blessing" {
  battlefield A: "Grizzly Bears", "Hill Giant", 2 "Plains", 6 "Forest"
  battlefield B: "Serra Angel"
  hand A: "Pride of Conquerors"
  turn 1 A: cast "Pride of Conquerors"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Hill Giant" 5
  assert power B "Serra Angel" 4
}

scenario "takes a Mount creature card from the top five" {
  battlefield A: 2 "Plains"
  hand A: "Frontier Seeker"
  library A: "Hill Giant", "Bulwark Ox", "Island", "Swamp", "Mountain", "Forest"
  turn 1 A: cast "Frontier Seeker"
  run_to turn 1 postcombat_main
  assert hand A contains "Bulwark Ox"
  assert hand A count 1
}

scenario "or a Plains card" {
  battlefield A: 2 "Plains"
  hand A: "Frontier Seeker"
  library A: "Hill Giant", "Island", "Plains", "Swamp", "Mountain", "Forest"
  turn 1 A: cast "Frontier Seeker"
  run_to turn 1 postcombat_main
  assert hand A contains "Plains"
  assert hand A count 1
}

scenario "a non-Mount creature card stays in the library" {
  battlefield A: 2 "Plains"
  hand A: "Frontier Seeker"
  library A: "Hill Giant", "Grizzly Bears", "Island", "Swamp", "Mountain", "Forest"
  turn 1 A: cast "Frontier Seeker"
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert library A contains "Hill Giant"
}

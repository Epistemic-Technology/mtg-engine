scenario "ezio chapter 1 destroys a tapped creature, chapter 2 gives attacking Assassins counters" {
  hand A: "The Revelations of Ezio"
  battlefield A: 3 "Swamp", "Hired Blade", "Grizzly Bears"
  battlefield B: "Hill Giant" tapped, "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "The Revelations of Ezio"
  turn 1 A: trigger "The Revelations of Ezio" targeting "Hill Giant"
  run_to turn 1 begin_combat
  assert graveyard B contains "Hill Giant"
  assert battlefield B contains "Serra Angel"
  turn 3 A: attack "Hired Blade", "Grizzly Bears"
  run_to turn 3 declare_blockers
  assert counters "Hired Blade" +1/+1 1
  assert counters "Grizzly Bears" +1/+1 0
  assert power "Hired Blade" 4
}
scenario "ezio chapter 3 returns an Assassin with an additional counter" {
  battlefield A: "The Revelations of Ezio" with 2 lore
  graveyard A: "Hired Blade", "Grizzly Bears"
  start turn 1 A
  turn 1 A: trigger "The Revelations of Ezio" targeting "Hired Blade"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hired Blade"
  assert counters "Hired Blade" +1/+1 1
  assert graveyard A contains "Grizzly Bears"
}

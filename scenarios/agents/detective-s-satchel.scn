scenario "enters: two Clues" {
  battlefield A: 2 "Island", 2 "Mountain"
  hand A: "Detective's Satchel"
  turn 1 precombat_main A: cast "Detective's Satchel"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Clue"
}
scenario "Thopter only after sacrificing an artifact this turn" {
  battlefield A: "Detective's Satchel", "Clue", 2 "Island"
  illegal turn 1 precombat_main A: activate "Detective's Satchel"
  turn 1 precombat_main A: activate "Clue"
  turn 1 precombat_main A: wait
  turn 1 postcombat_main A: activate "Detective's Satchel"
  run_to turn 1 end
  assert battlefield A contains 1 "Thopter"
  assert power "Thopter" 1
  assert has "Thopter" flying
  assert tapped "Detective's Satchel"
}

scenario "mirari chapter 1 returns an instant" {
  hand A: "The Mirari Conjecture"
  graveyard A: "Lightning Bolt", "Divination"
  battlefield A: 5 "Island"
  turn 1 precombat_main A: cast "The Mirari Conjecture"
  turn 1 precombat_main A: trigger "The Mirari Conjecture" targeting "Lightning Bolt"
  run_to turn 1 postcombat_main
  assert hand A contains "Lightning Bolt"
  assert hand A lacks "Divination"
}
scenario "mirari chapter 2 returns a sorcery" {
  battlefield A: "The Mirari Conjecture" with 1 lore
  graveyard A: "Lightning Bolt", "Divination"
  start turn 3 A
  turn 3 precombat_main A: trigger "The Mirari Conjecture" targeting "Divination"
  run_to turn 3 postcombat_main
  assert hand A contains "Divination"
  assert hand A lacks "Lightning Bolt"
}
scenario "mirari chapter 3 copies spells" {
  battlefield A: "The Mirari Conjecture" with 2 lore, 2 "Mountain"
  hand A: "Lightning Bolt"
  start turn 3 A
  turn 3 precombat_main A: wait
  turn 3 precombat_main A: cast "Lightning Bolt" targeting player B
  run_to turn 3 postcombat_main
  assert life B 14
  assert graveyard A contains "Lightning Bolt"
}

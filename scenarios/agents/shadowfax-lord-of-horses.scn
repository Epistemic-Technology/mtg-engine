scenario "a creature card with lesser power enters tapped and attacking" {
  battlefield A: "Shadowfax, Lord of Horses"
  hand A: "Hill Giant"
  turn 1 A: attack "Shadowfax, Lord of Horses"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert tapped "Hill Giant"
  assert life B 13
}

scenario "a creature card with equal power can't be put in" {
  battlefield A: "Shadowfax, Lord of Horses"
  hand A: "Serra Angel"
  turn 1 A: attack "Shadowfax, Lord of Horses"
  run_to turn 1 postcombat_main
  assert hand A contains "Serra Angel"
  assert life B 16
}

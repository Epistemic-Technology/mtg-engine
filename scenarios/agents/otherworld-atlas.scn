scenario "otherworld atlas puts a charge counter" {
  battlefield A: "Otherworld Atlas"
  start turn 1 A precombat_main
  turn 1 precombat_main A: activate "Otherworld Atlas" ability 1
  run_to turn 1 begin_combat
  assert counters "Otherworld Atlas" charge 1
  assert tapped "Otherworld Atlas"
}
scenario "otherworld atlas makes each player draw per charge counter" {
  battlefield A: "Otherworld Atlas" with 3 charge
  start turn 1 A precombat_main
  turn 1 precombat_main A: activate "Otherworld Atlas" ability 2
  run_to turn 1 begin_combat
  assert hand A count 3
  assert hand B count 3
}

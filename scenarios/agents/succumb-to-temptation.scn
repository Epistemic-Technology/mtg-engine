scenario "Succumb to Temptation draws two and loses 2 life" {
  battlefield A: 3 "Swamp"
  hand A: "Succumb to Temptation"
  library A: "Grizzly Bears", "Hill Giant", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Succumb to Temptation"
  run_to turn 1 postcombat_main
  assert life A 18
  assert hand A contains "Grizzly Bears"
  assert hand A contains "Hill Giant"
  assert hand A count 2
  assert graveyard A contains "Succumb to Temptation"
}

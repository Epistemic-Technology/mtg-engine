scenario "Haunted Screen: pay 1 life for red mana" {
  battlefield A: "Haunted Screen"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 end
  assert life B 18
  assert life A 19
}

scenario "Haunted Screen: {7} makes it a 7/7 Spirit, only once" {
  battlefield A: "Haunted Screen", 14 "Plains"
  start turn 2 A precombat_main
  turn 2 A: activate "Haunted Screen" ability 2
  turn 2 A: wait
  illegal turn 2 A: activate "Haunted Screen" ability 2
  run_to turn 2 end
  assert is "Haunted Screen" creature
  assert is "Haunted Screen" artifact
  assert is "Haunted Screen" Spirit
  assert power "Haunted Screen" 7
  assert counters "Haunted Screen" +1/+1 7
  assert life A 20
}

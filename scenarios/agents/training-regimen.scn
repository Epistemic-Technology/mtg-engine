scenario "Training Regimen counters a creature at combat, which gains trample" {
  battlefield A: "Training Regimen", "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Training Regimen" targeting "Grizzly Bears"
  run_to turn 1 declare_attackers
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
  assert has "Grizzly Bears" trample
  assert has not "Hill Giant" trample
}

scenario "Training Regimen does not trigger on the opponent's turn" {
  battlefield A: "Training Regimen", "Grizzly Bears"
  start turn 2 B precombat_main
  run_to turn 2 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
  assert has not "Grizzly Bears" trample
}

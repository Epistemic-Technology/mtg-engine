scenario "Blood Beckoning returns one creature card" {
  battlefield A: "Swamp"
  graveyard A: "Grizzly Bears", "Hill Giant"
  hand A: "Blood Beckoning"
  start turn 2 A precombat_main
  turn 2 A: cast "Blood Beckoning" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert hand A contains "Hill Giant"
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 1
}

scenario "Blood Beckoning kicked returns two creature cards" {
  battlefield A: 4 "Swamp"
  graveyard A: "Grizzly Bears", "Hill Giant", "Serra Angel"
  hand A: "Blood Beckoning"
  start turn 2 A precombat_main
  turn 2 A: cast "Blood Beckoning" kicked targeting "Grizzly Bears", "Hill Giant"
  run_to turn 2 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand A contains "Hill Giant"
  assert graveyard A contains "Serra Angel"
  assert hand A count 2
}

scenario "Driven gives trample and draw on combat damage" {
  battlefield A: "Grizzly Bears", "Forest", "Forest"
  hand A: "Driven // Despair"
  library A: "Island", "Swamp", "Plains"
  turn 1 precombat_main A: cast "Driven"
  turn 1 declare_attackers A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert has "Grizzly Bears" trample
  assert life B 18
  assert hand A count 1
}
scenario "Despair from graveyard gives menace and discard" {
  battlefield A: "Grizzly Bears", "Swamp", "Swamp"
  graveyard A: "Driven // Despair"
  hand B: "Forest", "Island"
  turn 1 precombat_main A: cast "Driven // Despair" from graveyard
  turn 1 declare_attackers A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert has "Grizzly Bears" menace
  assert life B 18
  assert hand B count 1
  assert exile A contains "Driven // Despair"
}

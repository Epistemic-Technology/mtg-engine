scenario "Court Hussar is sacrificed without white mana" {
  battlefield A: 3 "Island"
  hand A: "Court Hussar"
  library A: "Lightning Bolt", "Shock", "Giant Growth", "Murder"
  turn 1 precombat_main A: cast "Court Hussar"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Court Hussar"
  assert hand A count 1
  assert library A count 3
}
scenario "Court Hussar stays with white mana" {
  battlefield A: 2 "Island", "Plains"
  hand A: "Court Hussar"
  library A: "Lightning Bolt", "Shock", "Giant Growth", "Murder"
  turn 1 precombat_main A: cast "Court Hussar"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Court Hussar"
  assert has "Court Hussar" vigilance
  assert hand A count 1
}

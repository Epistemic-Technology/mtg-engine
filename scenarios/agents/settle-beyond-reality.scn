scenario "settle beyond reality: exile a creature you don't control" {
  battlefield A: 5 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Settle Beyond Reality"
  turn 1 A: cast "Settle Beyond Reality" mode 1 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
}

scenario "settle beyond reality: both modes, blinking your own creature" {
  battlefield A: 5 "Plains", "Grizzly Bears" with 1 +1/+1
  battlefield B: "Hill Giant"
  hand A: "Settle Beyond Reality"
  turn 1 A: cast "Settle Beyond Reality" mode 3 targeting "Hill Giant", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 0
  assert graveyard A contains "Settle Beyond Reality"
}


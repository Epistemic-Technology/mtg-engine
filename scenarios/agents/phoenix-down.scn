scenario "mode 1 returns a small creature tapped" {
  battlefield A: "Phoenix Down", 2 "Plains"
  graveyard A: "Grizzly Bears", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: activate "Phoenix Down" mode 1 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert tapped "Grizzly Bears"
  assert exile A contains "Phoenix Down"
}

scenario "mode 1 can't return mana value 5" {
  battlefield A: "Phoenix Down", 2 "Plains"
  graveyard A: "Serra Angel"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Phoenix Down" mode 1 targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Serra Angel"
}

scenario "mode 2 exiles a Zombie but not a Bear" {
  battlefield A: "Phoenix Down", 2 "Plains"
  battlefield B: "Gravedigger", "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Phoenix Down" mode 2 targeting "Grizzly Bears"
  turn 1 A: activate "Phoenix Down" mode 2 targeting "Gravedigger"
  run_to turn 1 postcombat_main
  assert exile B contains "Gravedigger"
  assert battlefield B contains "Grizzly Bears"
}

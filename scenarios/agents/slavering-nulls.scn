scenario "Slavering Nulls makes them discard with a Swamp" {
  battlefield A: "Slavering Nulls", "Swamp"
  hand B: "Grizzly Bears", "Forest"
  start turn 1 A
  turn 1 A: attack "Slavering Nulls"
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand B count 1
}

scenario "Slavering Nulls does nothing without a Swamp" {
  battlefield A: "Slavering Nulls", "Mountain"
  hand B: "Grizzly Bears", "Forest"
  start turn 1 A
  turn 1 A: attack "Slavering Nulls"
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand B count 2
}

scenario "Slavering Nulls may decline the discard" {
  battlefield A: "Slavering Nulls", "Swamp"
  hand B: "Grizzly Bears", "Forest"
  start turn 1 A
  turn 1 A: attack "Slavering Nulls"
  turn 1 A: decline "Slavering Nulls"
  run_to turn 1 postcombat_main
  assert hand B count 2
}

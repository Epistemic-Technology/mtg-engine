scenario "red spell gains 1 life" {
  battlefield A: "God-Pharaoh's Faithful", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life A 21
  assert life B 17
}
scenario "green spell gains nothing" {
  battlefield A: "God-Pharaoh's Faithful", "Forest"
  hand A: "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Giant Growth" targeting "God-Pharaoh's Faithful"
  run_to turn 1 postcombat_main
  assert life A 20
}

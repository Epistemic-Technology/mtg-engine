scenario "disturbed slumber: a land becomes a 4/4 Dinosaur that's still a land" {
  battlefield A: 2 "Forest", "Plains"
  hand A: "Disturbed Slumber"
  turn 1 A: cast "Disturbed Slumber" targeting "Plains"
  run_to turn 1 begin_combat
  assert is "Plains" creature
  assert is "Plains" land
  assert is "Plains" Dinosaur
  assert power "Plains" 4
  assert toughness "Plains" 4
  assert has "Plains" reach
  assert has "Plains" haste
}

scenario "disturbed slumber: it must be blocked if able" {
  battlefield A: 2 "Forest", "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Disturbed Slumber"
  turn 1 A: cast "Disturbed Slumber" targeting "Plains"
  turn 1 A: attack "Plains"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life B 20
}

scenario "disturbed slumber: the effect ends at end of turn" {
  battlefield A: 2 "Forest", "Plains"
  hand A: "Disturbed Slumber"
  turn 1 A: cast "Disturbed Slumber" targeting "Plains"
  run_to turn 2 upkeep
  assert is not "Plains" creature
}

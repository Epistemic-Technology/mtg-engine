scenario "The Chief Warg draws and loses life when you attack with a power 4 creature around" {
  battlefield A: "The Chief Warg", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: attack "The Chief Warg"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert life A 19
  assert life B 17
}

scenario "The Chief Warg does nothing without a power 4 creature" {
  battlefield A: "The Chief Warg", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert life A 20
  assert life B 18
}

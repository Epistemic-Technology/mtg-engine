scenario "casting a spell mills opponent until a land; P/T counts their graveyard" {
  battlefield A: "Consuming Aberration", "Mountain"
  hand A: "Lightning Bolt"
  library B: "Grizzly Bears", "Hill Giant", "Forest", "Island"
  graveyard B: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
  assert graveyard B contains "Forest"
  assert library B contains "Island"
  assert life B 17
  assert power "Consuming Aberration" 4
  assert toughness "Consuming Aberration" 4
}

scenario "Aberration with empty opposing graveyard is 0/0" {
  battlefield A: "Consuming Aberration", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert graveyard A contains "Consuming Aberration"
}

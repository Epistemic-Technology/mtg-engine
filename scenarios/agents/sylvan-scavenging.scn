scenario "Sylvan Scavenging puts a +1/+1 counter at end step" {
  battlefield A: "Sylvan Scavenging", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 end A: trigger "Sylvan Scavenging" targeting "Grizzly Bears"
  run_to turn 1 cleanup
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
}

scenario "Sylvan Scavenging does nothing on the opponent's end step" {
  battlefield A: "Sylvan Scavenging", "Grizzly Bears"
  start turn 2 B precombat_main
  run_to turn 2 cleanup
  assert counters "Grizzly Bears" +1/+1 0
}

scenario "Sylvan Scavenging second mode without a big creature makes nothing" {
  battlefield A: "Sylvan Scavenging"
  start turn 1 A precombat_main
  run_to turn 1 cleanup
  assert battlefield A lacks "Raccoon"
}

scenario "Sylvan Scavenging makes a Raccoon with a power 4 creature" {
  battlefield A: "Sylvan Scavenging", "Kalonian Behemoth"
  start turn 1 A precombat_main
  run_to turn 1 cleanup
  assert battlefield A contains "Raccoon"
  assert power "Raccoon" 3
  assert toughness "Raccoon" 3
  assert is "Raccoon" green
}

scenario "apprentice mills each opponent two and scries" {
  hand A: "Overwhelmed Apprentice"
  battlefield A: "Island"
  library A: "Forest", "Island", "Swamp"
  library B: "Mountain", "Mountain", "Mountain", "Mountain"
  turn 1 A: cast "Overwhelmed Apprentice"
  turn 1 A: scry "Forest"
  run_to turn 1 postcombat_main
  assert library B count 2
  assert graveyard B contains 2 "Mountain"
  assert library A count 3
  assert graveyard A lacks "Forest"
}
scenario "apprentice scry can bottom a card" {
  hand A: "Overwhelmed Apprentice"
  battlefield A: "Island"
  library A: "Forest", "Island", "Swamp"
  turn 1 A: cast "Overwhelmed Apprentice"
  turn 1 A: scry "Forest", "Island"
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert graveyard B count 2
}

scenario "Kjeldoran Guard pumps an attacker" {
  battlefield A: "Kjeldoran Guard", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 declare_blockers A: activate "Kjeldoran Guard" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 17
  assert tapped "Kjeldoran Guard"
  assert battlefield A contains "Kjeldoran Guard"
}

scenario "Kjeldoran Guard is sacrificed when the creature leaves" {
  battlefield A: "Kjeldoran Guard", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Hill Giant"
  turn 1 declare_blockers A: activate "Kjeldoran Guard" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Kjeldoran Guard"
}

scenario "Kjeldoran Guard can't be activated against snow lands" {
  battlefield A: "Kjeldoran Guard", "Grizzly Bears"
  battlefield B: "Snow-Covered Island"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 declare_blockers A: activate "Kjeldoran Guard" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "Kjeldoran Guard can't be activated outside combat" {
  battlefield A: "Kjeldoran Guard", "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Kjeldoran Guard" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert untapped "Kjeldoran Guard"
}

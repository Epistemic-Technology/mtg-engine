scenario "Mounted Archers blocks two attackers after activating" {
  battlefield A: "Mounted Archers", "Plains"
  battlefield B: "Llanowar Elves", "Wind Drake"
  start turn 2 B
  turn 2 B: attack "Llanowar Elves", "Wind Drake"
  turn 2 declare_attackers A: activate "Mounted Archers"
  turn 2 A: block "Llanowar Elves" with "Mounted Archers"
  turn 2 A: block "Wind Drake" with "Mounted Archers"
  turn 2 combat_damage A: assign "Mounted Archers" to "Llanowar Elves" 1, "Wind Drake" 1
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Llanowar Elves"
  assert graveyard A contains "Mounted Archers"
  assert battlefield B contains "Wind Drake"
}

scenario "Mounted Archers blocks only one attacker without activating" {
  battlefield A: "Mounted Archers", "Plains"
  battlefield B: "Llanowar Elves", "Wind Drake"
  start turn 2 B
  turn 2 B: attack "Llanowar Elves", "Wind Drake"
  turn 2 A: block "Llanowar Elves" with "Mounted Archers"
  illegal turn 2 A: block "Wind Drake" with "Mounted Archers"
  run_to turn 2 postcombat_main
  assert life A 18
}

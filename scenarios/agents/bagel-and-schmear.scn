scenario "Bagel and Schmear shares a counter and draws" {
  battlefield A: "Plains", "Bagel and Schmear", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Bagel and Schmear" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert hand A count 1
  assert graveyard A contains "Bagel and Schmear"
}

scenario "Bagel and Schmear nosh gains life and draws" {
  battlefield A: 2 "Swamp", "Bagel and Schmear"
  start turn 1 A precombat_main
  turn 1 A: activate "Bagel and Schmear" ability 2
  run_to turn 1 postcombat_main
  assert life A 23
  assert hand A count 1
}

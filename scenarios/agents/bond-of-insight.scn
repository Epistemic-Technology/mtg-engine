scenario "bond mills both players then returns two instants or sorceries and exiles itself" {
  hand A: "Bond of Insight"
  battlefield A: 4 "Island"
  graveyard A: "Shock", "Grizzly Bears"
  library A: "Lightning Bolt", "Forest", "Forest", "Forest", "Forest", "Forest"
  library B: "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"
  turn 1 A: cast "Bond of Insight"
  turn 1 A: choose "Lightning Bolt"
  turn 1 A: choose "Shock"
  run_to turn 1 postcombat_main
  assert library A count 2
  assert library B count 2
  assert hand A count 2
  assert hand A contains "Lightning Bolt"
  assert hand A contains "Shock"
  assert graveyard A contains "Grizzly Bears"
  assert exile A contains "Bond of Insight"
}

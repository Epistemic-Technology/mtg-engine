scenario "michelangelo: Mutagen on enter, counters plus one" {
  battlefield A: 3 "Forest", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Michelangelo, Weirdness to 11"
  start turn 1 A precombat_main
  turn 1 A: cast "Michelangelo, Weirdness to 11"
  turn 1 A: activate "Mutagen" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Mutagen"
  assert counters "Grizzly Bears" +1/+1 2
  assert power "Grizzly Bears" 4
}

scenario "michelangelo: opponent's creatures get no extra counter" {
  battlefield A: 3 "Forest", "Michelangelo, Weirdness to 11", "Mutagen"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Mutagen" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 1
}

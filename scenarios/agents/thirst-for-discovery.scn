scenario "Thirst for Discovery: discarding a basic land costs only one card" {
  battlefield A: 3 "Island"
  hand A: "Thirst for Discovery"
  library A: "Forest", "Grizzly Bears", "Hill Giant", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "Thirst for Discovery"
  turn 1 precombat_main A: discard "Forest"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Forest"
  assert hand A count 2
  assert hand A contains "Grizzly Bears"
}

scenario "Thirst for Discovery: without a basic land discard two cards" {
  battlefield A: 3 "Island"
  hand A: "Thirst for Discovery"
  library A: "Grizzly Bears", "Hill Giant", "Serra Angel", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Thirst for Discovery"
  run_to turn 1 postcombat_main
  assert hand A count 1
}

scenario "Thirst for Discovery: a nonbasic discard does not count" {
  battlefield A: 3 "Island"
  hand A: "Thirst for Discovery"
  library A: "Grizzly Bears", "Hill Giant", "Serra Angel", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Thirst for Discovery"
  turn 1 precombat_main A: discard "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 1
}

scenario "Broken Fall returns itself to hand to regenerate a blocker" {
  battlefield A: "Broken Fall", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Grizzly Bears"
  turn 2 declare_blockers A: activate "Broken Fall" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert tapped "Grizzly Bears"
  assert hand A contains "Broken Fall"
  assert battlefield A lacks "Broken Fall"
  assert life A 20
}

scenario "Without Broken Fall's shield the blocker dies" {
  battlefield A: "Broken Fall", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Broken Fall"
}

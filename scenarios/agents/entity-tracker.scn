scenario "Entity Tracker draws when an enchantment enters" {
  battlefield A: "Entity Tracker", "Plains"
  hand A: "Holy Strength"
  library A: "Island", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Holy Strength" targeting "Entity Tracker"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert hand A contains "Island"
}

scenario "Entity Tracker does not draw for a creature" {
  battlefield A: "Entity Tracker", "Forest", "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A count 0
}

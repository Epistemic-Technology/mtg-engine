scenario "stonybrook angler: tap target creature" {
  battlefield A: "Stonybrook Angler", 2 "Island"
  battlefield B: "Grizzly Bears"
  turn 1 A: activate "Stonybrook Angler" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert tapped "Grizzly Bears"
  assert tapped "Stonybrook Angler"
}

scenario "stonybrook angler: needs {1}{U}" {
  battlefield A: "Stonybrook Angler", "Island"
  battlefield B: "Grizzly Bears"
  illegal turn 1 A: activate "Stonybrook Angler"
  run_to turn 1 postcombat_main
  assert untapped "Grizzly Bears"
}

scenario "stegron discarded: target creature gets +3/+1 and becomes a dinosaur" {
  hand A: "Stegron the Dinosaur Man"
  battlefield A: 2 "Mountain", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Stegron the Dinosaur Man" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert graveyard A contains "Stegron the Dinosaur Man"
  assert power "Grizzly Bears" 5
  assert toughness "Grizzly Bears" 3
  assert is "Grizzly Bears" Dinosaur
  assert is "Grizzly Bears" Bear
  run_to turn 2 upkeep
  assert power "Grizzly Bears" 2
  assert is not "Grizzly Bears" Dinosaur
}

scenario "stegron's formula targets only creatures you control" {
  hand A: "Stegron the Dinosaur Man"
  battlefield A: 2 "Mountain"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Stegron the Dinosaur Man" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Stegron the Dinosaur Man"
}

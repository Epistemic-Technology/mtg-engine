scenario "days undoing resets hands and ends my turn" {
  hand A: "Day's Undoing", "Shock"
  graveyard A: "Hill Giant", "Grizzly Bears"
  hand B: "Serra Angel"
  graveyard B: "Murder"
  battlefield A: 3 "Island"
  library A: "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"
  turn 1 precombat_main A: cast "Day's Undoing"
  run_to turn 2 upkeep
  assert hand A count 7
  assert hand B count 7
  assert graveyard A count 0
  assert graveyard B count 0
  assert hand B count 7
  assert step upkeep
  assert turn 2
}

scenario "Infectious Bloodlust gives +2/+1 and haste" {
  battlefield A: "Grizzly Bears", "Infectious Bloodlust" on "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 declare_attackers
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 3
  assert has "Grizzly Bears" haste
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "Infectious Bloodlust fetches another copy when the creature dies" {
  battlefield A: "Grizzly Bears", "Infectious Bloodlust" on "Grizzly Bears"
  battlefield B: 1 "Mountain"
  hand B: "Lightning Bolt"
  library A: "Infectious Bloodlust", "Forest", "Forest"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Infectious Bloodlust"
  assert hand A contains "Infectious Bloodlust"
}

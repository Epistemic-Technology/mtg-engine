scenario "Thunderdrum Soloist deals 1 damage for a cheap instant" {
  battlefield A: "Thunderdrum Soloist", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "Thunderdrum Soloist deals 3 damage instead when five mana was spent" {
  battlefield A: "Thunderdrum Soloist", 5 "Mountain"
  hand A: "Blaze"
  start turn 1 A precombat_main
  turn 1 A: cast "Blaze" x 4 targeting player B
  run_to turn 1 postcombat_main
  assert life B 13
}

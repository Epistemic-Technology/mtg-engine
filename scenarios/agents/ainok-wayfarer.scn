scenario "Ainok Wayfarer takes a milled land into hand" {
  battlefield A: 2 "Forest"
  hand A: "Ainok Wayfarer"
  library A: "Shock", "Island", "Grizzly Bears", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Ainok Wayfarer"
  run_to turn 1 postcombat_main
  assert hand A contains "Island"
  assert graveyard A contains "Shock"
  assert graveyard A contains "Grizzly Bears"
  assert library A contains "Plains"
  assert counters "Ainok Wayfarer" +1/+1 0
}

scenario "Ainok Wayfarer gets a counter when it takes no land" {
  battlefield A: 2 "Forest"
  hand A: "Ainok Wayfarer"
  library A: "Shock", "Island", "Grizzly Bears", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Ainok Wayfarer"
  turn 1 A: decline "Ainok Wayfarer"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Island"
  assert counters "Ainok Wayfarer" +1/+1 1
  assert power "Ainok Wayfarer" 2
}

scenario "Ainok Wayfarer gets a counter when no land is milled" {
  battlefield A: 2 "Forest"
  hand A: "Ainok Wayfarer"
  library A: "Shock", "Murder", "Grizzly Bears", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Ainok Wayfarer"
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert counters "Ainok Wayfarer" +1/+1 1
}

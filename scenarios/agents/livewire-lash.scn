scenario "targeted by a spell deals 2 to any target" {
  battlefield A: "Livewire Lash", "Grizzly Bears", 3 "Forest"
  battlefield B: "Hill Giant"
  hand A: "Giant Growth"
  turn 1 precombat_main A: activate "Livewire Lash" targeting "Grizzly Bears"
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: cast "Giant Growth" targeting "Grizzly Bears"
  turn 1 precombat_main A: trigger "Grizzly Bears" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 7
  assert damage "Hill Giant" 2
}
scenario "pump only without a spell target" {
  battlefield A: "Livewire Lash", "Grizzly Bears", 2 "Forest"
  battlefield B: "Hill Giant"
  turn 1 precombat_main A: activate "Livewire Lash" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert damage "Hill Giant" 0
}

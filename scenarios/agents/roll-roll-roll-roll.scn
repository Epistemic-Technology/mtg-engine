scenario "Roll-Roll-Roll-Roll flickers a creature until the end step" {
  battlefield A: "Grizzly Bears" with 1 +1/+1, 3 "Island"
  hand A: "Roll-Roll-Roll-Roll"
  start turn 1 A precombat_main
  turn 1 A: cast "Roll-Roll-Roll-Roll"
  turn 1 A: trigger "Roll-Roll-Roll-Roll" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile A contains "Grizzly Bears"
  run_to turn 1 cleanup
  assert battlefield A contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 0
  assert counters "Roll-Roll-Roll-Roll" lore 1
}

scenario "Roll-Roll-Roll-Roll can flicker a land on chapter II" {
  battlefield A: "Roll-Roll-Roll-Roll" with 1 lore, "Forest" tapped
  start turn 3 A upkeep
  turn 3 A: trigger "Roll-Roll-Roll-Roll" targeting "Forest"
  run_to turn 3 end
  assert exile A contains "Forest"
  run_to turn 3 cleanup
  assert untapped "Forest"
  assert counters "Roll-Roll-Roll-Roll" lore 2
}

scenario "Roll-Roll-Roll-Roll: up to one, so it may exile nothing; the creature is back at the end step" {
  battlefield A: "Roll-Roll-Roll-Roll" with 1 lore, "Grizzly Bears"
  start turn 3 A upkeep
  turn 3 A: trigger "Roll-Roll-Roll-Roll" targeting none
  run_to turn 3 end
  assert battlefield A contains "Grizzly Bears"
  assert exile A lacks "Grizzly Bears"
}

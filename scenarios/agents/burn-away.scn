scenario "burn away exiles controller's graveyard when creature dies" {
  hand A: "Burn Away"
  battlefield A: 5 "Mountain"
  battlefield B: "Hill Giant"
  graveyard A: "Shock"
  graveyard B: "Lightning Bolt", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Burn Away" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert exile B contains "Lightning Bolt"
  assert exile B contains "Grizzly Bears"
  assert graveyard A contains "Shock"
  assert graveyard B count 0
}
scenario "burn away does nothing when creature survives" {
  hand A: "Burn Away"
  battlefield A: 5 "Mountain"
  battlefield B: "Hill Giant" with 4 +1/+1
  graveyard B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Burn Away" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Lightning Bolt"
}

scenario "Ruthless Negotiation from hand exiles a card, no draw" {
  battlefield A: "Swamp"
  hand A: "Ruthless Negotiation"
  hand B: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Ruthless Negotiation" targeting player B
  run_to turn 1 postcombat_main
  assert exile B contains "Shock"
  assert hand B count 0
  assert hand A count 0
  assert graveyard A contains "Ruthless Negotiation"
}

scenario "Ruthless Negotiation flashback also draws a card" {
  battlefield A: 5 "Swamp"
  graveyard A: "Ruthless Negotiation"
  hand B: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Ruthless Negotiation" from graveyard targeting player B
  run_to turn 1 postcombat_main
  assert exile B contains "Shock"
  assert hand A count 1
  assert exile A contains "Ruthless Negotiation"
}

scenario "Flopsie puts a counter on each creature you control" {
  battlefield A: "Grizzly Bears", 6 "Forest"
  battlefield B: "Hill Giant"
  hand A: "Flopsie, Bumi's Buddy"
  start turn 1 A precombat_main
  turn 1 A: cast "Flopsie, Bumi's Buddy"
  run_to turn 1 postcombat_main
  assert counters "Flopsie, Bumi's Buddy" +1/+1 1
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 0
  assert power "Grizzly Bears" 3
}

scenario "Flopsie's power-4 creatures can't be blocked by more than one creature" {
  battlefield A: "Flopsie, Bumi's Buddy"
  battlefield B: "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Flopsie, Bumi's Buddy"
  illegal turn 1 B: block "Flopsie, Bumi's Buddy" with "Grizzly Bears"
  illegal turn 1 B: block "Flopsie, Bumi's Buddy" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 16
}

scenario "Flopsie's attacker can still be blocked by one creature" {
  battlefield A: "Flopsie, Bumi's Buddy"
  battlefield B: "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Flopsie, Bumi's Buddy"
  turn 1 B: block "Flopsie, Bumi's Buddy" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Hill Giant"
}

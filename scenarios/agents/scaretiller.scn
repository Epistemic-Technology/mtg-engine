scenario "scaretiller: attacking taps it, put a land from hand onto the battlefield tapped" {
  battlefield A: "Scaretiller"
  hand A: "Forest"
  turn 1 A: attack "Scaretiller"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Forest"
  assert tapped "Forest"
  assert hand A count 0
}


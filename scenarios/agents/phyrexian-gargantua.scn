scenario "Phyrexian Gargantua draws two and loses 2 life on entering" {
  battlefield A: 6 "Swamp"
  hand A: "Phyrexian Gargantua"
  library A: "Hill Giant", "Forest", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Phyrexian Gargantua"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Phyrexian Gargantua"
  assert hand A contains "Hill Giant"
  assert hand A contains "Forest"
  assert hand A count 2
  assert life A 18
}

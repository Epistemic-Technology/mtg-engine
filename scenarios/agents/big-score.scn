scenario "Big Score discards, draws two, and makes two Treasures" {
  battlefield A: 4 "Mountain"
  hand A: "Big Score", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Big Score" discarding "Forest"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Forest"
  assert hand A count 2
  assert battlefield A contains 2 "Treasure"
}

scenario "Big Score needs a card to discard" {
  battlefield A: 4 "Mountain"
  hand A: "Big Score"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Big Score"
  run_to turn 1 postcombat_main
  assert hand A contains "Big Score"
}

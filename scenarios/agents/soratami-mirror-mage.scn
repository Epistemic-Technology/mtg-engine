scenario "Mirror-Mage bounces a creature for three lands" {
  battlefield A: "Soratami Mirror-Mage", 4 "Island"
  battlefield B: "Hill Giant"
  turn 1 A: activate "Soratami Mirror-Mage" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand B contains "Hill Giant"
  assert hand A count 3
  assert battlefield A contains 1 "Island"
}

scenario "Not enough lands" {
  battlefield A: "Soratami Mirror-Mage", 2 "Island"
  battlefield B: "Hill Giant"
  illegal turn 1 A: activate "Soratami Mirror-Mage" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Hill Giant"
}

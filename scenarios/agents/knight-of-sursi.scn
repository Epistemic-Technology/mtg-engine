scenario "Knight of Sursi: flanking shrinks a flying blocker" {
  battlefield A: "Knight of Sursi"
  battlefield B: "Wind Drake"
  start turn 2 A
  turn 2 A: attack "Knight of Sursi"
  turn 2 B: block "Knight of Sursi" with "Wind Drake"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Wind Drake"
  assert battlefield A contains "Knight of Sursi"
  assert damage "Knight of Sursi" 1
}

scenario "Knight of Sursi: suspended for {W}, cast after three upkeeps with haste" {
  battlefield A: "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Knight of Sursi"
  library A: 10 "Plains"
  library B: 10 "Island"
  turn 1 A: suspend "Knight of Sursi"
  turn 7 A: attack "Knight of Sursi"
  run_to turn 5 postcombat_main
  assert exile A contains "Knight of Sursi"
  run_to turn 7 postcombat_main
  assert battlefield A contains "Knight of Sursi"
  assert life B 18
}

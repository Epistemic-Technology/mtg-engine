scenario "zombie creature spells cost zero" {
  battlefield A: "Rooftop Storm"
  hand A: "Walking Corpse", "Grizzly Bears"
  turn 1 precombat_main A: cast "Walking Corpse" alternative
  turn 1 precombat_main A: wait
  illegal turn 1 precombat_main A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Walking Corpse"
}

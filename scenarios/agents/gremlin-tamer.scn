scenario "Gremlin Tamer: an enchantment entering under your control makes a Gremlin" {
  battlefield A: "Gremlin Tamer", 2 "Island"
  hand A: "Zephyr Charge"
  start turn 1 A precombat_main
  turn 1 A: cast "Zephyr Charge"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Gremlin"
  assert power "Gremlin" 1
}

scenario "Gremlin Tamer: a creature entering makes nothing" {
  battlefield A: "Gremlin Tamer", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Gremlin"
}

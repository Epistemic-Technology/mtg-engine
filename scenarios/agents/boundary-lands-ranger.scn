scenario "boundary lands ranger loots with a 4-power creature" {
  battlefield A: "Boundary Lands Ranger", "Serra Angel"
  hand A: "Hill Giant"
  library A: "Island", "Forest"
  start turn 1 A precombat_main
  turn 1 begin_combat A: discard "Hill Giant"
  run_to turn 1 declare_attackers
  assert graveyard A contains "Hill Giant"
  assert hand A contains "Island"
  assert hand A count 1
}

scenario "boundary lands ranger does nothing without a 4-power creature" {
  battlefield A: "Boundary Lands Ranger", "Grizzly Bears"
  hand A: "Hill Giant"
  library A: "Island", "Forest"
  start turn 1 A precombat_main
  run_to turn 1 declare_attackers
  assert hand A contains "Hill Giant"
  assert hand A count 1
}

scenario "Artificer's Epiphany keeps all cards with an artifact" {
  battlefield A: 3 "Island", "Abzan Banner"
  hand A: "Artificer's Epiphany", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Artificer's Epiphany"
  run_to turn 1 postcombat_main
  assert hand A count 3
  assert graveyard A contains "Artificer's Epiphany"
}

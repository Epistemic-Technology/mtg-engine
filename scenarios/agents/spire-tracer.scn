scenario "Spire Tracer can't be blocked by a ground creature" {
  battlefield A: "Spire Tracer"
  battlefield B: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Spire Tracer"
  illegal turn 2 B: block "Spire Tracer" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 19
}

scenario "Spire Tracer can be blocked by a creature with reach" {
  battlefield A: "Spire Tracer"
  battlefield B: "Giant Spider"
  start turn 2 A precombat_main
  turn 2 A: attack "Spire Tracer"
  turn 2 B: block "Spire Tracer" with "Giant Spider"
  run_to turn 2 postcombat_main
  assert life B 20
  assert graveyard A contains "Spire Tracer"
}

scenario "Spire Tracer can be blocked by a flier" {
  battlefield A: "Spire Tracer"
  battlefield B: "Wind Drake"
  start turn 2 A precombat_main
  turn 2 A: attack "Spire Tracer"
  turn 2 B: block "Spire Tracer" with "Wind Drake"
  run_to turn 2 postcombat_main
  assert life B 20
}

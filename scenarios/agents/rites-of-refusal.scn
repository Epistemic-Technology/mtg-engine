scenario "Rites of Refusal: one discard makes the spell cost {3} more" {
  battlefield A: 2 "Island"
  battlefield B: 2 "Forest", "Mountain"
  hand A: "Rites of Refusal", "Forest", "Island"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Rites of Refusal" targeting "Grizzly Bears"
  turn 2 A: choose "Forest"
  turn 2 A: choose done
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert graveyard A contains "Forest"
  assert hand A contains "Island"
}

scenario "Rites of Refusal: discarding nothing asks nothing extra" {
  battlefield A: 2 "Island"
  battlefield B: 2 "Forest"
  hand A: "Rites of Refusal"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Rites of Refusal" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

scenario "Rites of Refusal: {3} per card, so one discard can be paid for and two cannot" {
  battlefield A: 2 "Island"
  battlefield B: 5 "Forest"
  hand A: "Rites of Refusal", "Forest", "Island"
  hand B: "Grizzly Bears", "Hill Giant"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Rites of Refusal" targeting "Grizzly Bears"
  turn 2 A: choose "Forest"
  turn 2 A: choose done
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

scenario "Rites of Refusal: two discards cost {6}" {
  battlefield A: 2 "Island"
  battlefield B: 5 "Forest"
  hand A: "Rites of Refusal", "Forest", "Island"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Rites of Refusal" targeting "Grizzly Bears"
  turn 2 A: choose "Forest"
  turn 2 A: choose "Island"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "Skycoach Conductor enters prepared and All Aboard flickers a non-Pilot creature" {
  battlefield A: 4 "Island", "Grizzly Bears" with 1 +1/+1
  hand A: "Skycoach Conductor // All Aboard"
  start turn 1 A precombat_main
  turn 1 A: cast "Skycoach Conductor"
  turn 1 A: wait
  turn 1 A: cast "All Aboard" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Skycoach Conductor"
  assert battlefield A contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 0
  assert power "Grizzly Bears" 2
}

scenario "All Aboard can't target a Pilot" {
  battlefield A: 4 "Island"
  hand A: "Skycoach Conductor // All Aboard"
  start turn 1 A precombat_main
  turn 1 A: cast "Skycoach Conductor"
  turn 1 A: wait
  illegal turn 1 A: cast "All Aboard" targeting "Skycoach Conductor"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Skycoach Conductor"
}

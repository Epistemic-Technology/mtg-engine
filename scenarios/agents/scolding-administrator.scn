scenario "repartee adds a counter, then dying moves all counters" {
  battlefield A: "Scolding Administrator" with 2 +1/+1, "Grizzly Bears", 3 "Swamp"
  hand A: "Murder"
  turn 1 A: cast "Murder" targeting "Scolding Administrator"
  turn 1 A: trigger "Scolding Administrator" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Scolding Administrator"
  assert counters "Grizzly Bears" +1/+1 3
}
scenario "no counters, no trigger" {
  battlefield A: "Scolding Administrator", "Grizzly Bears"
  battlefield B: 3 "Swamp"
  hand B: "Murder"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Scolding Administrator"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Scolding Administrator"
  assert counters "Grizzly Bears" +1/+1 0
}

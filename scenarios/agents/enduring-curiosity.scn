scenario "Enduring Curiosity draws for each creature dealing combat damage" {
  battlefield A: "Enduring Curiosity", "Grizzly Bears"
  start turn 2 A
  turn 2 A: attack "Enduring Curiosity", "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 14
  assert hand A count 3
}

scenario "Enduring Curiosity returns as a noncreature enchantment and still draws" {
  battlefield A: "Enduring Curiosity", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 2 A
  turn 2 upkeep B: cast "Lightning Bolt" targeting "Enduring Curiosity"
  turn 2 A: attack "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Enduring Curiosity"
  assert is not "Enduring Curiosity" creature
  assert is "Enduring Curiosity" enchantment
  assert life B 18
  assert hand A count 2
}

scenario "The Last Ride shrinks by your life total when crewed" {
  life A 10
  battlefield A: "The Last Ride", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 begin_combat A: activate "The Last Ride"
  assert power "The Last Ride" 3
  assert toughness "The Last Ride" 3
  turn 1 A: attack "The Last Ride"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "The Last Ride dies when crewed with a high life total" {
  battlefield A: "The Last Ride", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 begin_combat A: activate "The Last Ride"
  run_to turn 1 postcombat_main
  assert graveyard A contains "The Last Ride"
}

scenario "The Last Ride draws a card for 2 life" {
  battlefield A: "The Last Ride", 3 "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "The Last Ride" ability 1
  run_to turn 1 postcombat_main
  assert life A 18
  assert hand A count 1
}

scenario "Tainted Indulgence draws two and discards a card" {
  battlefield A: "Island", "Swamp"
  hand A: "Tainted Indulgence"
  library A: "Forest", "Mountain", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Tainted Indulgence"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert graveyard A count 2
}

scenario "Tainted Indulgence skips the discard with five mana values" {
  battlefield A: "Island", "Swamp"
  hand A: "Tainted Indulgence"
  graveyard A: "Forest", "Wind Drake", "Hill Giant", "Serra Angel", "Grizzly Bears"
  library A: "Forest", "Mountain", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Tainted Indulgence"
  run_to turn 1 postcombat_main
  assert hand A count 2
}

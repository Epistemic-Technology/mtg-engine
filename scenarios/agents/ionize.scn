scenario "ionize: counters the spell and damages its controller for 2" {
  battlefield A: "Island", "Mountain", "Island"
  battlefield B: 3 "Forest"
  hand A: "Ionize"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Ionize" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life B 18
  assert life A 20
}

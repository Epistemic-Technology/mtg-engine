scenario "Showdown of the Skalds exiles four cards and plays one next turn" {
  battlefield A: "Mountain", "Plains", "Mountain", "Plains", "Grizzly Bears"
  library A: "Forest", "Hill Giant", "Mountain", "Island", "Swamp", "Swamp", "Swamp"
  hand A: "Showdown of the Skalds"
  start turn 1 A precombat_main
  turn 1 A: cast "Showdown of the Skalds"
  run_to turn 1 postcombat_main
  assert exile A contains "Forest"
  assert exile A contains "Hill Giant"
  assert exile A contains "Island"
  assert library A count 3
  turn 3 A: play "Forest"
  run_to turn 3 postcombat_main
  assert battlefield A contains "Forest"
}

scenario "Showdown of the Skalds chapter II puts a counter on a creature per spell cast" {
  battlefield A: "Showdown of the Skalds" with 1 lore, "Mountain", "Mountain", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Shock", "Shock"
  start turn 3 A upkeep
  turn 3 begin_combat A: cast "Shock" targeting B "Hill Giant"
  turn 3 begin_combat A: trigger "Showdown of the Skalds" targeting "Grizzly Bears"
  turn 3 begin_combat A: cast "Shock" targeting player B
  turn 3 begin_combat A: trigger "Showdown of the Skalds" targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
}

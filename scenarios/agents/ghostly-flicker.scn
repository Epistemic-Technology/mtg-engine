scenario "Ghostly Flicker blinks a creature and a land" {
  battlefield A: "Grizzly Bears" with 1 +1/+1, "Forest" tapped, 3 "Island"
  hand A: "Ghostly Flicker"
  start turn 2 A precombat_main
  turn 2 A: cast "Ghostly Flicker" targeting "Grizzly Bears", "Forest"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert battlefield A contains "Forest"
  assert counters "Grizzly Bears" +1/+1 0
  assert power "Grizzly Bears" 2
  assert untapped "Forest"
  assert graveyard A contains "Ghostly Flicker"
}

scenario "Ghostly Flicker can't target a creature you don't control" {
  battlefield A: "Grizzly Bears", 3 "Island"
  battlefield B: "Hill Giant"
  hand A: "Ghostly Flicker"
  start turn 2 A precombat_main
  illegal turn 2 A: cast "Ghostly Flicker" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Hill Giant"
}

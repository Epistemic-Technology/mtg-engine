scenario "Dispelling Exhale with a Dragon beheld asks for {4}" {
  battlefield A: "Shivan Dragon", 2 "Island"
  battlefield B: 5 "Forest"
  hand A: "Dispelling Exhale"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Dispelling Exhale" kicked targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert battlefield B lacks "Grizzly Bears"
  assert graveyard A contains "Dispelling Exhale"
}

scenario "Dispelling Exhale without beholding asks only {2}" {
  battlefield A: "Shivan Dragon", 2 "Island"
  battlefield B: 5 "Forest"
  hand A: "Dispelling Exhale"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  turn 2 A: cast "Dispelling Exhale" other_cost targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
  assert tapped B "Forest"
}

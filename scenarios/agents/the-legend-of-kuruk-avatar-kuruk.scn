scenario "Kuruk chapter I: scry 2 then draw a card" {
  battlefield A: 4 "Island"
  hand A: "The Legend of Kuruk"
  library A: "Hill Giant", "Serra Angel", "Forest"
  turn 1 A: cast "The Legend of Kuruk"
  run_to turn 1 postcombat_main
  assert counters "The Legend of Kuruk" lore 1
  assert hand A contains "Hill Giant"
  assert hand A count 1
}

scenario "Kuruk chapter III transforms into Avatar Kuruk" {
  battlefield A: "The Legend of Kuruk" with 2 lore
  run_to turn 1 postcombat_main
  assert battlefield A contains "Avatar Kuruk"
  assert is "Avatar Kuruk" creature
  assert power "Avatar Kuruk" 4
  assert toughness "Avatar Kuruk" 3
}

scenario "Avatar Kuruk makes a Spirit when you cast a spell" {
  battlefield A: "Avatar Kuruk", "Mountain"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield A contains "Spirit"
}

scenario "Avatar Kuruk exhaust takes an extra turn" {
  battlefield A: "Avatar Kuruk", 20 "Island"
  hand A: "Forest"
  turn 1 A: activate "Avatar Kuruk"
  turn 2 precombat_main A: play "Forest"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Forest"
  assert turn 2
}

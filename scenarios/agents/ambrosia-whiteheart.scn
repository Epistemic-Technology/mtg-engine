scenario "enters at instant speed and returns another permanent; landfall pumps until end of turn" {
  hand A: "Ambrosia Whiteheart", "Forest"
  battlefield A: "Grizzly Bears", 2 "Plains"
  start turn 2 B precombat_main
  turn 2 end A: cast "Ambrosia Whiteheart"
  turn 3 A: play "Forest"
  run_to turn 3 begin_combat
  assert hand A contains "Grizzly Bears"
  assert battlefield A contains "Ambrosia Whiteheart"
  assert power "Ambrosia Whiteheart" 3
  run_to turn 4 untap
  assert power "Ambrosia Whiteheart" 2
}

scenario "may decline the return" {
  hand A: "Ambrosia Whiteheart"
  battlefield A: 2 "Plains", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Ambrosia Whiteheart"
  turn 1 A: decline "Ambrosia Whiteheart"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert hand A count 0
}

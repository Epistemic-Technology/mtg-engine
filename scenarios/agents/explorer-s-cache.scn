scenario "Explorer's Cache moves a counter at sorcery speed" {
  battlefield A: "Explorer's Cache" with 2 +1/+1, "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Explorer's Cache" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Explorer's Cache" +1/+1 1
  assert counters "Grizzly Bears" +1/+1 1
  assert tapped "Explorer's Cache"
}

scenario "Explorer's Cache grows when a creature with a counter dies" {
  battlefield A: "Explorer's Cache" with 2 +1/+1, "Grizzly Bears" with 1 +1/+1
  battlefield B: "Mountain", "Mountain"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert counters "Explorer's Cache" +1/+1 3
}

scenario "Combat Research draws on combat damage; no bonus when not legendary" {
  battlefield A: "Grizzly Bears", "Combat Research" on "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 2
  assert life B 18
  assert hand A count 1
}

scenario "Combat Research gives a legendary creature +1/+1 and ward" {
  battlefield A: "Isamaru, Hound of Konda", "Combat Research" on "Isamaru, Hound of Konda"
  start turn 1 A
  turn 1 A: attack "Isamaru, Hound of Konda"
  run_to turn 1 postcombat_main
  assert power "Isamaru, Hound of Konda" 3
  assert toughness "Isamaru, Hound of Konda" 3
  assert life B 17
  assert hand A count 1
}

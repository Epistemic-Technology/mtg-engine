scenario "Moriok Replica draws two and loses 2 life" {
  battlefield A: "Moriok Replica", 2 "Swamp"
  library A: "Grizzly Bears", "Hill Giant", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Moriok Replica"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Moriok Replica"
  assert hand A contains "Grizzly Bears"
  assert hand A contains "Hill Giant"
  assert hand A count 2
  assert life A 18
}

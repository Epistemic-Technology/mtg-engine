scenario "ratadrabik copies a dying legend as a 2/2 black nonlegendary zombie" {
  battlefield A: "Ratadrabik of Urborg", "Isamaru, Hound of Konda"
  hand B: "Lightning Bolt"
  battlefield B: "Mountain"
  start turn 2 B precombat_main
  turn 2 precombat_main B: cast "Lightning Bolt" targeting "Isamaru, Hound of Konda"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Isamaru, Hound of Konda"
  assert battlefield A contains "Isamaru, Hound of Konda"
  assert is "Isamaru, Hound of Konda" black
  assert is "Isamaru, Hound of Konda" Zombie
  assert is not "Isamaru, Hound of Konda" legendary
  assert power "Isamaru, Hound of Konda" 2
}
scenario "ratadrabik gives zombies vigilance" {
  battlefield A: "Ratadrabik of Urborg", "Walking Corpse"
  start turn 1 A precombat_main
  assert has "Walking Corpse" vigilance
  assert has "Ratadrabik of Urborg" vigilance
}
scenario "ratadrabik ignores nonlegendary death" {
  battlefield A: "Ratadrabik of Urborg", "Grizzly Bears"
  hand B: "Lightning Bolt"
  battlefield B: "Mountain"
  start turn 2 B precombat_main
  turn 2 precombat_main B: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A lacks "Grizzly Bears"
}

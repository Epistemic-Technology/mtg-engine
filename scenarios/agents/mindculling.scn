scenario "Mindculling draws two and the opponent discards two" {
  battlefield A: 6 "Island"
  hand A: "Mindculling"
  hand B: "Forest", "Plains", "Swamp"
  library A: "Mountain", "Forest", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Mindculling" targeting player B
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert hand B count 1
  assert graveyard B count 2
  assert graveyard A contains "Mindculling"
}

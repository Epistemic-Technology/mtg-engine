scenario "Cargo Ship crewed by a 1-power creature attacks in the air" {
  battlefield A: "Cargo Ship", "Ornithopter", "Rat"
  start turn 2 A precombat_main
  turn 2 begin_combat A: activate "Cargo Ship"
  turn 2 A: attack "Cargo Ship"
  run_to turn 2 postcombat_main
  assert life B 18
  assert untapped "Cargo Ship"
  assert tapped "Rat"
  assert untapped "Ornithopter"
}

scenario "Cargo Ship's mana casts an artifact spell" {
  battlefield A: "Cargo Ship"
  hand A: "Implement of Ferocity"
  start turn 2 A precombat_main
  turn 2 A: cast "Implement of Ferocity"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Implement of Ferocity"
  assert tapped "Cargo Ship"
}

scenario "Cargo Ship's mana can't pay for a creature spell" {
  battlefield A: "Cargo Ship", "Forest"
  hand A: "Grizzly Bears"
  start turn 2 A precombat_main
  illegal turn 2 A: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert hand A contains "Grizzly Bears"
}

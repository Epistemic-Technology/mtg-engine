scenario "Voyage Home affinity for artifacts draws and gains" {
  battlefield A: 5 "Plains", 2 "Island"
  hand A: "Voyage Home"
  turn 1 precombat_main A: cast "Voyage Home"
  run_to turn 1 postcombat_main
  assert life A 23
  assert hand A count 3
}
scenario "Voyage Home unaffordable without enough lands" {
  battlefield A: 3 "Plains", 2 "Island"
  hand A: "Voyage Home"
  illegal turn 1 precombat_main A: cast "Voyage Home"
  run_to turn 1 postcombat_main
  assert life A 20
}

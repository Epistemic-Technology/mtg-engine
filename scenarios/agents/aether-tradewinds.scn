scenario "Aether Tradewinds bounces one of each side" {
  battlefield A: "Grizzly Bears", 3 "Island"
  battlefield B: "Hill Giant"
  hand A: "Aether Tradewinds"
  start turn 1 A precombat_main
  turn 1 A: cast "Aether Tradewinds" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand B contains "Hill Giant"
  assert battlefield B lacks "Hill Giant"
  assert graveyard A contains "Aether Tradewinds"
}

scenario "Aether Tradewinds needs a permanent you control first" {
  battlefield A: "Grizzly Bears", 3 "Island"
  battlefield B: "Hill Giant", "Serra Angel"
  hand A: "Aether Tradewinds"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Aether Tradewinds" targeting "Hill Giant", "Serra Angel"
  run_to turn 1 postcombat_main
  assert hand A contains "Aether Tradewinds"
}

scenario "Avarice Amulet equips, draws, and passes to opponent when creature dies" {
  battlefield A: "Avarice Amulet", "Grizzly Bears", 2 "Plains"
  library A: "Island", "Island", "Island"
  hand B: "Lightning Bolt"
  battlefield B: "Mountain"
  turn 1 precombat_main A: activate "Avarice Amulet" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert has "Grizzly Bears" vigilance
  turn 2 upkeep B: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 2 end
  assert graveyard A contains "Grizzly Bears"
  assert battlefield B contains "Avarice Amulet"
}
scenario "Avarice Amulet grants upkeep draw" {
  battlefield A: "Avarice Amulet", "Grizzly Bears", 2 "Plains"
  library A: "Island", "Forest", "Island"
  turn 1 precombat_main A: activate "Avarice Amulet" targeting "Grizzly Bears"
  run_to turn 3 precombat_main
  assert hand A count 2
}

scenario "spider-slayer: damage to a Spider destroys it" {
  battlefield A: "Spider-Slayer, Hatred Honed"
  battlefield B: "Giant Spider"
  start turn 1 A precombat_main
  turn 1 A: attack "Spider-Slayer, Hatred Honed"
  turn 1 B: block "Spider-Slayer, Hatred Honed" with "Giant Spider"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Giant Spider"
  assert graveyard A contains "Spider-Slayer, Hatred Honed"
}

scenario "spider-slayer: damage to a non-Spider does not destroy it" {
  battlefield A: "Spider-Slayer, Hatred Honed"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Spider-Slayer, Hatred Honed"
  turn 1 B: block "Spider-Slayer, Hatred Honed" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Hill Giant"
  assert damage "Hill Giant" 2
}

scenario "spider-slayer: exile from graveyard for two tapped flying Robots" {
  battlefield A: 6 "Plains"
  graveyard A: "Spider-Slayer, Hatred Honed"
  start turn 1 A precombat_main
  turn 1 A: activate "Spider-Slayer, Hatred Honed"
  run_to turn 1 begin_combat
  assert battlefield A contains 2 "Robot"
  assert tapped oldest "Robot"
  assert tapped newest "Robot"
  assert has oldest "Robot" flying
  assert exile A contains "Spider-Slayer, Hatred Honed"
}

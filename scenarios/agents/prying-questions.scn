scenario "prying questions: lose 3 and put a card from hand on top" {
  hand A: "Prying Questions"
  battlefield A: 2 "Swamp", "Swamp"
  hand B: "Grizzly Bears"
  library B: "Forest", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Prying Questions" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert hand B count 0
  assert library B count 3
  assert library B contains "Grizzly Bears"
}
scenario "prying questions with an empty hand only loses life" {
  hand A: "Prying Questions"
  battlefield A: 3 "Swamp"
  library B: "Forest", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Prying Questions" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert library B count 2
  assert hand B count 0
}

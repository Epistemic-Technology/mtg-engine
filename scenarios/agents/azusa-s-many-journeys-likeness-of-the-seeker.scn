scenario "azusa chapter 2 gains 3 life" {
  battlefield A: "Azusa's Many Journeys" with 1 lore
  start turn 3 A
  run_to turn 3 postcombat_main
  assert life A 23
}
scenario "azusa chapter 3 transforms into a 3/3" {
  battlefield A: "Azusa's Many Journeys" with 2 lore
  start turn 3 A
  run_to turn 3 postcombat_main
  assert is "Likeness of the Seeker" creature
  assert power "Likeness of the Seeker" 3
  assert toughness "Likeness of the Seeker" 3
  assert is "Likeness of the Seeker" green
}
scenario "likeness untaps up to three lands when blocked" {
  battlefield A: "Likeness of the Seeker", "Forest" tapped, "Island" tapped, "Plains" tapped, "Swamp" tapped
  battlefield B: "Grizzly Bears"
  start turn 3 A precombat_main
  turn 3 A: attack "Likeness of the Seeker"
  turn 3 B: block "Likeness of the Seeker" with "Grizzly Bears"
  run_to turn 3 combat_damage
  assert untapped "Forest"
  assert untapped "Island"
  assert untapped "Plains"
  assert tapped "Swamp"
}

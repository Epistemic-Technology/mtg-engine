scenario "Erudite Wizard: second card drawn in a turn adds a counter, only once" {
  battlefield A: "Erudite Wizard", 3 "Island"
  hand A: "Divination"
  start turn 3 A
  turn 3 A: cast "Divination"
  run_to turn 3 postcombat_main
  assert hand A count 3
  assert counters "Erudite Wizard" +1/+1 1
}

scenario "Erudite Wizard: a single draw does not trigger" {
  battlefield A: "Erudite Wizard", 3 "Island"
  start turn 3 A
  run_to turn 3 postcombat_main
  assert hand A count 1
  assert counters "Erudite Wizard" +1/+1 0
}

scenario "havengul skaab bounces another creature when it attacks" {
  battlefield A: "Havengul Skaab", "Grizzly Bears"
  start turn 2 A
  turn 2 A: attack "Havengul Skaab"
  run_to turn 2 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert battlefield A contains "Havengul Skaab"
  assert life B 16
}
scenario "havengul skaab alone returns nothing" {
  battlefield A: "Havengul Skaab"
  start turn 2 A
  turn 2 A: attack "Havengul Skaab"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Havengul Skaab"
  assert hand A count 1
  assert life B 16
}

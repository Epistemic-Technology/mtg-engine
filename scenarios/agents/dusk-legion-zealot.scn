scenario "Dusk Legion Zealot draws a card and loses 1 life" {
  battlefield A: 2 "Swamp"
  hand A: "Dusk Legion Zealot"
  library A: "Hill Giant", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Dusk Legion Zealot"
  run_to turn 1 postcombat_main
  assert hand A contains "Hill Giant"
  assert life A 19
}

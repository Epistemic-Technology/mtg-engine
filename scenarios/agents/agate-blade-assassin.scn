scenario "Agate-Blade Assassin drains on attack" {
  battlefield A: "Agate-Blade Assassin"
  start turn 2 A precombat_main
  turn 2 A: attack "Agate-Blade Assassin"
  run_to turn 2 postcombat_main
  assert life A 21
  assert life B 18
}

scenario "Agate-Blade Assassin drains even when blocked" {
  battlefield A: "Agate-Blade Assassin"
  battlefield B: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Agate-Blade Assassin"
  turn 2 B: block "Agate-Blade Assassin" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life A 21
  assert life B 19
  assert battlefield A contains "Agate-Blade Assassin"
}

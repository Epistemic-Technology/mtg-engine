scenario "Deathgreeter gains life when another creature dies" {
  battlefield A: "Deathgreeter", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert life A 21
}

scenario "Deathgreeter doesn't trigger on its own death" {
  battlefield A: "Deathgreeter", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Deathgreeter"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Deathgreeter"
  assert life A 20
}

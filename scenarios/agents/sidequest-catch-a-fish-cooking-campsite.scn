scenario "sidequest finds a creature, makes food, transforms; campsite pumps" {
  battlefield A: "Sidequest: Catch a Fish", "Grizzly Bears", 3 "Plains"
  library A: "Hill Giant", "Plains"
  start turn 1 A
  turn 1 precombat_main A: activate "Cooking Campsite" sacrificing "Food"
  run_to turn 1 postcombat_main
  assert hand A contains "Hill Giant"
  assert battlefield A contains "Cooking Campsite"
  assert battlefield A lacks "Food"
  assert counters "Grizzly Bears" +1/+1 1
  assert tapped "Cooking Campsite"
}

scenario "sidequest reveals a land: nothing happens" {
  battlefield A: "Sidequest: Catch a Fish"
  library A: "Forest", "Plains"
  start turn 1 A
  run_to turn 1 precombat_main
  assert hand A count 0
  assert battlefield A contains "Sidequest: Catch a Fish"
  assert battlefield A lacks "Food"
}

scenario "sidequest declined: no food, no transform" {
  battlefield A: "Sidequest: Catch a Fish"
  library A: "Hill Giant", "Plains"
  start turn 1 A
  turn 1 upkeep A: decline "Sidequest: Catch a Fish"
  run_to turn 1 precombat_main
  assert hand A count 0
  assert battlefield A contains "Sidequest: Catch a Fish"
  assert battlefield A lacks "Food"
}

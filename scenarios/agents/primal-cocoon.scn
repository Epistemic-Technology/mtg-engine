scenario "Primal Cocoon grows its creature each upkeep" {
  battlefield A: "Grizzly Bears", "Primal Cocoon" on "Grizzly Bears"
  start turn 1 A
  run_to turn 1 precombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert battlefield A contains "Primal Cocoon"
}

scenario "Primal Cocoon is sacrificed when its creature attacks" {
  battlefield A: "Grizzly Bears", "Primal Cocoon" on "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Primal Cocoon"
  assert counters "Grizzly Bears" +1/+1 1
  assert life B 17
}

scenario "Oltec Matterweaver makes a Gnome when a creature spell is cast" {
  battlefield A: "Oltec Matterweaver", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Gnome"
  assert battlefield A contains "Grizzly Bears"
}

scenario "Oltec Matterweaver ignores noncreature spells" {
  battlefield A: "Oltec Matterweaver", 3 "Swamp"
  battlefield B: "Grizzly Bears"
  hand A: "Murder"
  start turn 1 A precombat_main
  turn 1 A: cast "Murder" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Gnome"
}

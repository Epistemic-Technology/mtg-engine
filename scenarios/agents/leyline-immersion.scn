scenario "leyline immersion gives five mana for spells" {
  battlefield A: "Isamaru, Hound of Konda", "Leyline Immersion" on "Isamaru, Hound of Konda"
  hand A: "Serra Angel"
  turn 1 precombat_main A: activate "Isamaru, Hound of Konda"
  turn 1 precombat_main A: cast "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Serra Angel"
  assert tapped "Isamaru, Hound of Konda"
}
scenario "leyline immersion ward 2 counters a bolt that cannot pay" {
  battlefield A: "Isamaru, Hound of Konda", "Leyline Immersion" on "Isamaru, Hound of Konda"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  turn 1 precombat_main B: cast "Lightning Bolt" targeting "Isamaru, Hound of Konda"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Isamaru, Hound of Konda"
  assert graveyard B contains "Lightning Bolt"
}

scenario "nissa's judgment: only creatures with +1/+1 counters deal damage" {
  battlefield A: 5 "Forest", "Grizzly Bears", "Hill Giant"
  battlefield B: "Serra Angel"
  hand A: "Nissa's Judgment"
  turn 1 A: cast "Nissa's Judgment" targeting "Grizzly Bears", none, "Serra Angel"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert damage "Serra Angel" 3
  assert battlefield B contains "Serra Angel"
}

scenario "nissa's judgment: two supported creatures both deal damage" {
  battlefield A: 5 "Forest", "Grizzly Bears", "Hill Giant"
  battlefield B: "Serra Angel"
  hand A: "Nissa's Judgment"
  turn 1 A: cast "Nissa's Judgment" targeting "Grizzly Bears", "Hill Giant", "Serra Angel"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 1
  assert graveyard B contains "Serra Angel"
}

scenario "counters, vigilance and the Ring" {
  battlefield A: "Grizzly Bears", "Hill Giant", 4 "Plains"
  hand A: "Now for Wrath, Now for Ruin!"
  battlefield B: "Serra Angel"
  turn 1 precombat_main A: cast "Now for Wrath, Now for Ruin!"
  turn 1 declare_attackers A: attack "Grizzly Bears", "Hill Giant"
  run_to turn 1 end
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 1
  assert power "Grizzly Bears" 3
  assert untapped "Grizzly Bears"
  assert untapped "Hill Giant"
  assert tempted A 1
  assert life B 13
}

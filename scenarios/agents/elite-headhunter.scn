scenario "elite headhunter sacrifices another creature to shock" {
  battlefield A: "Elite Headhunter", "Grizzly Bears", 3 "Swamp"
  battlefield B: "Hill Giant", "Serra Angel"
  turn 1 precombat_main A: activate "Elite Headhunter" sacrificing "Grizzly Bears" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert damage "Hill Giant" 2
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Elite Headhunter"
}
scenario "elite headhunter can sacrifice an artifact, not itself" {
  battlefield A: "Elite Headhunter", "Wanderer's Twig", 3 "Swamp"
  battlefield B: "Serra Angel"
  turn 1 precombat_main A: activate "Elite Headhunter" sacrificing "Wanderer's Twig" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert damage "Serra Angel" 2
  assert graveyard A contains "Wanderer's Twig"
}
scenario "elite headhunter alone cannot activate" {
  battlefield A: "Elite Headhunter", 3 "Swamp"
  battlefield B: "Serra Angel"
  illegal turn 1 precombat_main A: activate "Elite Headhunter" targeting "Serra Angel"
  run_to turn 1 postcombat_main
}

scenario "a noncreature spell makes a Thopter that can attack at once" {
  battlefield A: "Saheeli, Jewel of Avishkar", "Forest"
  hand A: "Giant Growth"
  start turn 2 A precombat_main
  turn 2 A: cast "Giant Growth" targeting "Saheeli, Jewel of Avishkar"
  turn 2 A: attack "Thopter"
  run_to turn 2 postcombat_main
  assert battlefield A contains 1 "Thopter"
  assert has "Thopter" haste
  assert has "Thopter" flying
  assert life B 19
}

scenario "a creature spell makes no Thopter" {
  battlefield A: "Saheeli, Jewel of Avishkar", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains 0 "Thopter"
  assert battlefield A contains "Grizzly Bears"
}

scenario "Torment of Scarabs: loses 3 life with nothing to pay" {
  battlefield A: 4 "Swamp"
  hand A: "Torment of Scarabs"
  library B: "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Torment of Scarabs" targeting player B
  run_to turn 2 draw
  assert life B 17
}
scenario "Torment of Scarabs: sacrifice a nonland permanent instead" {
  battlefield A: 4 "Swamp"
  hand A: "Torment of Scarabs"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Torment of Scarabs" targeting player B
  turn 2 upkeep B: choose "1"
  turn 2 upkeep B: choose "Grizzly Bears"
  run_to turn 2 draw
  assert life B 20
  assert graveyard B contains "Grizzly Bears"
}
scenario "Torment of Scarabs: discard a card instead" {
  battlefield A: 4 "Swamp"
  hand A: "Torment of Scarabs"
  hand B: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Torment of Scarabs" targeting player B
  turn 2 upkeep B: discard "Shock"
  run_to turn 2 draw
  assert life B 20
  assert graveyard B contains "Shock"
}

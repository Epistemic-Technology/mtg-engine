scenario "Master of Diversion taps a defending creature when attacking" {
  battlefield A: "Master of Diversion"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Master of Diversion"
  turn 1 A: trigger "Master of Diversion" targeting "Hill Giant"
  run_to turn 1 declare_blockers
  assert tapped "Hill Giant"
}

scenario "Master of Diversion does not tap its controller's creatures" {
  battlefield A: "Master of Diversion", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Master of Diversion"
  run_to turn 1 postcombat_main
  assert untapped "Grizzly Bears"
}

scenario "Trickster's Stratagem tucks a creature and connives" {
  battlefield A: 4 "Island", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Trickster's Stratagem"
  library A: "Shock", "Island"
  library B: "Plains", "Plains", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Trickster's Stratagem" targeting "Hill Giant", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B lacks "Hill Giant"
  assert library B contains "Hill Giant"
  assert graveyard A contains "Shock"
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Trickster's Stratagem without a creature to connive" {
  battlefield A: 4 "Island"
  battlefield B: "Hill Giant"
  hand A: "Trickster's Stratagem"
  start turn 1 A precombat_main
  turn 1 A: cast "Trickster's Stratagem" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert library B contains "Hill Giant"
  assert hand A count 0
}

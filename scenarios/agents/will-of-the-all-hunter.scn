scenario "will of the all-hunter pumps a non-blocking creature" {
  battlefield A: "Grizzly Bears", "Plains", "Plains"
  hand A: "Will of the All-Hunter"
  turn 1 precombat_main A: cast "Will of the All-Hunter" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
  assert counters "Grizzly Bears" +1/+1 0
}
scenario "will of the all-hunter puts counters on a blocker instead" {
  battlefield A: "Plains", "Plains", "Hill Giant"
  battlefield B: "Grizzly Bears"
  hand A: "Will of the All-Hunter"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 declare_blockers A: block "Grizzly Bears" with "Hill Giant"
  turn 2 declare_blockers A: cast "Will of the All-Hunter" targeting "Hill Giant"
  run_to turn 2 end_combat
  assert counters "Hill Giant" +1/+1 2
  assert power "Hill Giant" 5
  assert toughness "Hill Giant" 5
  run_to turn 2 postcombat_main
  assert power "Hill Giant" 5
}
scenario "cycling" {
  battlefield A: "Plains", "Plains"
  hand A: "Will of the All-Hunter"
  turn 1 precombat_main A: activate "Will of the All-Hunter"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Will of the All-Hunter"
  assert hand A count 1
}

scenario "Commandeer takes a spell and its new target" {
  battlefield A: "Grizzly Bears", 7 "Island"
  battlefield B: "Hill Giant", "Mountain"
  hand A: "Commandeer"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 precombat_main B: cast "Lightning Bolt" targeting "Grizzly Bears"
  turn 2 precombat_main A: cast "Commandeer" targeting "Lightning Bolt" in response to "Lightning Bolt"
  turn 2 precombat_main A: choose "Hill Giant"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
  assert graveyard A contains "Commandeer"
}

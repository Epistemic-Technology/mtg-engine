scenario "Coalhauler Swine deals the damage it is dealt to each player" {
  battlefield A: "Coalhauler Swine", "Mountain"
  hand A: "Shock"
  start turn 2 A precombat_main
  turn 2 A: cast "Shock" targeting "Coalhauler Swine"
  run_to turn 2 postcombat_main
  assert life A 18
  assert life B 18
  assert battlefield A contains "Coalhauler Swine"
}

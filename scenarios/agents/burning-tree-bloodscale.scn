scenario "burning-tree bloodscale forces a block" {
  battlefield A: "Burning-Tree Bloodscale", 2 "Forest", "Mountain"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Burning-Tree Bloodscale" ability 2 targeting "Grizzly Bears"
  turn 1 A: attack "Burning-Tree Bloodscale"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Grizzly Bears"
  assert graveyard A contains "Burning-Tree Bloodscale"
}

scenario "burning-tree bloodscale stops a creature from blocking it" {
  battlefield A: "Burning-Tree Bloodscale", "Forest", 2 "Mountain"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Burning-Tree Bloodscale" ability 1 targeting "Grizzly Bears"
  turn 1 A: attack "Burning-Tree Bloodscale"
  illegal turn 1 B: block "Burning-Tree Bloodscale" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "burning-tree bloodscale bloodthirst" {
  battlefield A: 3 "Forest", 2 "Mountain"
  hand A: "Shock", "Burning-Tree Bloodscale"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: wait
  turn 1 A: cast "Burning-Tree Bloodscale"
  run_to turn 1 postcombat_main
  assert counters "Burning-Tree Bloodscale" +1/+1 1
  assert power "Burning-Tree Bloodscale" 3
}

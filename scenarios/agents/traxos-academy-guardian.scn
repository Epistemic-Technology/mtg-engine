scenario "traxos costs 2 less after a noncreature spell" {
  battlefield A: 3 "Island"
  battlefield B: "Grizzly Bears"
  hand A: "Shock", "Traxos, Academy Guardian"
  battlefield A: "Mountain"
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Traxos, Academy Guardian"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Traxos, Academy Guardian"
}

scenario "traxos can't be cast for 2 without a noncreature spell first" {
  battlefield A: 2 "Island"
  hand A: "Traxos, Academy Guardian"
  illegal turn 1 A: cast "Traxos, Academy Guardian"
  run_to turn 1 postcombat_main
  assert hand A contains "Traxos, Academy Guardian"
}

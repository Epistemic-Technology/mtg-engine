scenario "channeled force X=2" {
  battlefield A: "Island", "Mountain", "Plains", "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Channeled Force", 2 "Forest"
  turn 1 precombat_main A: cast "Channeled Force" x 2 discarding "Forest" targeting player A, "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert graveyard A contains 2 "Forest"
  assert graveyard B contains "Grizzly Bears"
}
scenario "channeled force no creature target, other player draws" {
  battlefield A: "Island", "Mountain", "Plains", "Plains"
  hand A: "Channeled Force", "Forest"
  turn 1 precombat_main A: cast "Channeled Force" x 1 discarding "Forest" targeting player B, none
  run_to turn 1 postcombat_main
  assert hand B count 1
  assert hand A count 0
}

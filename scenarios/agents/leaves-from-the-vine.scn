scenario "leaves from the vine chapter I mills three and makes a Food" {
  battlefield A: 2 "Forest"
  hand A: "Leaves from the Vine"
  library A: "Grizzly Bears", "Island", "Island", "Island", "Island"
  start turn 2 A precombat_main
  turn 2 A: cast "Leaves from the Vine"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains 2 "Island"
  assert battlefield A contains "Food"
  assert counters "Leaves from the Vine" lore 1
}

scenario "leaves from the vine chapter II counters up to two creatures" {
  battlefield A: "Leaves from the Vine" with 1 lore, "Grizzly Bears", "Hill Giant"
  start turn 3 A upkeep
  turn 3 A: trigger "Leaves from the Vine" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 3 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 1
}

scenario "leaves from the vine chapter III draws with a creature card in graveyard" {
  battlefield A: "Leaves from the Vine" with 2 lore
  graveyard A: "Grizzly Bears"
  library A: "Island", "Island", "Island"
  start turn 3 A upkeep
  run_to turn 3 postcombat_main
  assert hand A count 2
  assert graveyard A contains "Leaves from the Vine"
}

scenario "leaves from the vine chapter III draws nothing without one" {
  battlefield A: "Leaves from the Vine" with 2 lore
  graveyard A: "Shock"
  library A: "Island", "Island", "Island"
  start turn 3 A upkeep
  run_to turn 3 postcombat_main
  assert hand A count 1
}

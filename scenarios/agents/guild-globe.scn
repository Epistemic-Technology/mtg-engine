scenario "Guild Globe draws, then sacrifices for two mana" {
  battlefield A: 6 "Plains"
  hand A: "Guild Globe", "Hill Giant"
  library A: 3 "Island"
  turn 1 A: cast "Guild Globe"
  turn 1 A: wait
  turn 1 A: activate "Guild Globe"
  turn 1 A: choose red
  turn 1 A: cast "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert graveyard A contains "Guild Globe"
  assert battlefield A contains "Hill Giant"
}

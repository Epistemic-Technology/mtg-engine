scenario "Rope pumps and grants reach" {
  battlefield A: "Grizzly Bears", "Rope" on "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 begin_combat
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 4
  assert has "Grizzly Bears" reach
}

scenario "Rope: equipped creature can't be blocked by more than one creature" {
  battlefield A: "Grizzly Bears", "Rope" on "Grizzly Bears"
  battlefield B: "Hill Giant", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  illegal turn 1 B: block "Grizzly Bears" with "Hill Giant"
  illegal turn 1 B: block "Grizzly Bears" with "Serra Angel"
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "Rope sacrifices to draw" {
  battlefield A: "Rope", 2 "Island"
  start turn 1 A precombat_main
  turn 1 A: activate "Rope"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Rope"
  assert hand A count 1
}

scenario "Rope: a single blocker is still allowed" {
  battlefield A: "Grizzly Bears", "Rope" on "Grizzly Bears"
  battlefield B: "Hill Giant", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Hill Giant"
}

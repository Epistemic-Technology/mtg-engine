scenario "reflections of littjara copies a spell of the chosen type" {
  battlefield A: 5 "Island", 2 "Forest"
  hand A: "Reflections of Littjara", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Reflections of Littjara"
  turn 1 A: choose Bear
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Grizzly Bears"
}
scenario "reflections of littjara ignores other types" {
  battlefield A: 5 "Island", 2 "Forest"
  hand A: "Reflections of Littjara", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Reflections of Littjara"
  turn 1 A: choose Giant
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Grizzly Bears"
}

scenario "the turn it enters, it taps for {B}" {
  battlefield B: "Grizzly Bears"
  hand A: "Hidden Lair", "Disfigure"
  turn 1 A: play "Hidden Lair"
  turn 1 A: cast "Disfigure" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

scenario "later, without a basic land, only {C}" {
  battlefield A: "Hidden Lair"
  battlefield B: "Grizzly Bears"
  hand A: "Disfigure"
  illegal turn 1 A: cast "Disfigure" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

scenario "with a basic land, it taps for {B}" {
  battlefield A: "Hidden Lair", "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Disfigure"
  turn 1 A: cast "Disfigure" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
}

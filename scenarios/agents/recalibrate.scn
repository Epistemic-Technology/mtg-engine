scenario "Recalibrate bounces and draws after a discard" {
  battlefield A: 2 "Island", 2 "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Recalibrate", "Tormenting Voice", "Forest"
  library A: "Plains", "Plains", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: cast "Tormenting Voice" discarding "Forest"
  turn 1 A: wait
  turn 1 A: cast "Recalibrate" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand B contains "Hill Giant"
  assert graveyard A contains "Forest"
  assert hand A count 3
  assert hand A contains "Swamp"
}

scenario "Recalibrate without a discard only bounces" {
  battlefield A: 2 "Island"
  battlefield B: "Hill Giant"
  hand A: "Recalibrate"
  start turn 1 A precombat_main
  turn 1 A: cast "Recalibrate" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand B contains "Hill Giant"
  assert hand A count 0
}

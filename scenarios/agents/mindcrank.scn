scenario "opponent life loss mills that many" {
  battlefield A: "Mindcrank", "Mountain"
  hand A: "Lightning Bolt"
  library B: "Forest", "Forest", "Forest", "Forest", "Hill Giant", "Island"
  turn 1 precombat_main A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert graveyard B count 3
}
scenario "own life loss does not mill" {
  battlefield A: "Mindcrank", "Mountain"
  hand A: "Lightning Bolt"
  library A: "Forest", "Forest", "Forest", "Forest"
  turn 1 precombat_main A: cast "Lightning Bolt" targeting player A
  run_to turn 1 postcombat_main
  assert life A 17
  assert graveyard A lacks "Forest"
}

scenario "party of two looks at five and takes three" {
  hand A: "Skyclave Plunder"
  battlefield A: 5 "Island", "Abbey Matron", "Aether Adept"
  library A: "Forest", "Island", "Swamp", "Mountain", "Lightning Bolt", "Plains"
  turn 1 A: cast "Skyclave Plunder"
  turn 1 A: choose "Lightning Bolt"
  turn 1 A: choose "Forest"
  turn 1 A: choose "Island"
  run_to turn 1 postcombat_main
  assert hand A count 3
  assert hand A contains "Lightning Bolt"
  assert library A count 3
}

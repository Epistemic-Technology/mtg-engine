scenario "Servant of Volrath leaving sacrifices a creature" {
  battlefield A: "Servant of Volrath", "Grizzly Bears", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Servant of Volrath"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Servant of Volrath"
  assert graveyard A contains "Grizzly Bears"
}

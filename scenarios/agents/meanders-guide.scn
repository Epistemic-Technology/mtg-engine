scenario "Meanders Guide taps a Merfolk to reanimate a small creature" {
  battlefield A: "Meanders Guide", "Merfolk of the Pearl Trident"
  graveyard A: "Grizzly Bears", "Hill Giant"
  start turn 2 A
  turn 2 A: attack "Meanders Guide"
  turn 2 A: accept "Meanders Guide"
  illegal turn 2 declare_attackers A: trigger "Meanders Guide" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard A contains "Hill Giant"
  assert tapped "Merfolk of the Pearl Trident"
  assert life B 17
}

scenario "Meanders Guide with no other Merfolk returns nothing" {
  battlefield A: "Meanders Guide", "Hill Giant"
  graveyard A: "Grizzly Bears"
  start turn 2 A
  turn 2 A: attack "Meanders Guide"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert untapped "Hill Giant"
}

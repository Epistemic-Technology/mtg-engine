scenario "Swan Song counters an instant and gives its controller a Bird" {
  battlefield A: "Island"
  battlefield B: "Mountain"
  hand A: "Swan Song"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: cast "Swan Song" targeting "Lightning Bolt" in response to "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Lightning Bolt"
  assert battlefield B contains 1 "Bird"
  assert power "Bird" 2
  assert has "Bird" flying
}
scenario "Swan Song cannot counter a creature spell" {
  battlefield A: "Island"
  battlefield B: "Forest", "Forest"
  hand A: "Swan Song"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  illegal turn 2 A: cast "Swan Song" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Grizzly Bears"
}

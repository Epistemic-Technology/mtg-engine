scenario "Sorcerous Sight looks at a hand and draws a card" {
  battlefield A: "Island"
  hand A: "Sorcerous Sight"
  hand B: "Grizzly Bears"
  library A: "Hill Giant", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Sorcerous Sight" targeting player B
  run_to turn 1 postcombat_main
  assert hand A contains "Hill Giant"
  assert hand A count 1
  assert hand B contains "Grizzly Bears"
  assert graveyard A contains "Sorcerous Sight"
}

scenario "cankerbloom destroys an artifact" {
  battlefield A: "Cankerbloom", "Forest"
  battlefield B: "Sol Ring", "Hill Giant", "Pacifism" on "Hill Giant"
  turn 1 A: activate "Cankerbloom" mode 1 targeting "Sol Ring"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Sol Ring"
  assert graveyard A contains "Cankerbloom"
  assert battlefield B contains "Pacifism"
}
scenario "cankerbloom destroys an enchantment" {
  battlefield A: "Cankerbloom", "Forest"
  battlefield B: "Sol Ring", "Hill Giant", "Pacifism" on "Hill Giant"
  turn 1 A: activate "Cankerbloom" mode 2 targeting "Pacifism"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Pacifism"
  assert battlefield B contains "Sol Ring"
}
scenario "cankerbloom proliferates" {
  battlefield A: "Cankerbloom", "Forest", "Grizzly Bears" with 1 +1/+1
  turn 1 A: activate "Cankerbloom" mode 3
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
  assert graveyard A contains "Cankerbloom"
}

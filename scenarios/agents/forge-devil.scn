scenario "Forge Devil pings a creature and its controller" {
  battlefield A: "Mountain"
  battlefield B: "Llanowar Elves"
  hand A: "Forge Devil"
  start turn 2 A precombat_main
  turn 2 A: cast "Forge Devil"
  turn 2 A: trigger "Forge Devil" targeting "Llanowar Elves"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Llanowar Elves"
  assert life A 19
  assert battlefield A contains "Forge Devil"
}

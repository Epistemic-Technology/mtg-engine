scenario "Hoplite makes tokens equal to devotion to white" {
  hand A: "Reverent Hoplite"
  battlefield A: 5 "Plains", "Serra Angel"
  turn 1 precombat_main A: cast "Reverent Hoplite"
  run_to turn 1 postcombat_main
  assert battlefield A contains 3 "Human Soldier"
}
scenario "Hoplite with no other white permanents" {
  hand A: "Reverent Hoplite"
  battlefield A: 5 "Plains"
  turn 1 precombat_main A: cast "Reverent Hoplite"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Human Soldier"
}

scenario "a four-mana noncreature spell makes a Treasure" {
  battlefield A: "Prompto Argentum", 5 "Mountain"
  hand A: "Lava Axe"
  start turn 1 A precombat_main
  turn 1 A: cast "Lava Axe" targeting player B
  run_to turn 1 postcombat_main
  assert life B 15
  assert battlefield A contains 1 "Treasure"
}
scenario "a three-mana noncreature spell does not" {
  battlefield A: "Prompto Argentum", 3 "Island"
  hand A: "Divination"
  start turn 1 A precombat_main
  turn 1 A: cast "Divination"
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert battlefield A contains 0 "Treasure"
}
scenario "a four-mana creature spell does not" {
  battlefield A: "Prompto Argentum", 5 "Plains"
  hand A: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: cast "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield A contains 0 "Treasure"
  assert battlefield A contains "Serra Angel"
}

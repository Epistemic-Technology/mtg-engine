scenario "Blood Seeker: opponent's creature entering costs them 1 life" {
  battlefield A: "Blood Seeker"
  battlefield B: 2 "Forest"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 19
  assert life A 20
}

scenario "Blood Seeker: your own creature does not trigger it" {
  battlefield A: "Blood Seeker", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 20
  assert life B 20
}

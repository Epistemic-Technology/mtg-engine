scenario "Cirith Ungol Patrol sacrifices for a card and a Food" {
  battlefield A: "Swamp", "Cirith Ungol Patrol", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Cirith Ungol Patrol" sacrificing "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 1
  assert battlefield A contains "Food"
}

scenario "Cirith Ungol Patrol can't sacrifice itself" {
  battlefield A: "Swamp", "Cirith Ungol Patrol"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Cirith Ungol Patrol"
  run_to turn 1 postcombat_main
  assert hand A count 0
}

scenario "Voidforged Titan draws and drains after a nonland permanent left" {
  battlefield A: "Voidforged Titan", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 cleanup
  assert life A 19
  assert hand A count 1
}
scenario "Voidforged Titan does nothing otherwise" {
  battlefield A: "Voidforged Titan", "Mountain"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 cleanup
  assert life A 20
  assert hand A count 0
}

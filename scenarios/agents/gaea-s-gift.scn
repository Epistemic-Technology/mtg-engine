scenario "Gaea's Gift: counter, reach, trample, hexproof, indestructible" {
  battlefield A: 2 "Forest", "Grizzly Bears"
  battlefield B: "Mountain"
  hand A: "Gaea's Gift"
  hand B: "Shock"
  turn 1 A: cast "Gaea's Gift" targeting "Grizzly Bears"
  illegal turn 1 end B: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 end
  assert counters "Grizzly Bears" +1/+1 1
  assert has "Grizzly Bears" reach
  assert has "Grizzly Bears" trample
  assert has "Grizzly Bears" hexproof
  assert has "Grizzly Bears" indestructible
  run_to turn 2 upkeep
  assert has not "Grizzly Bears" trample
}

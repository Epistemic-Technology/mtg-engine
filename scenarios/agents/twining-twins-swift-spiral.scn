scenario "Swift Spiral blinks an opponent's creature until the end step" {
  battlefield A: "Plains", "Island"
  battlefield B: "Hill Giant"
  hand A: "Twining Twins // Swift Spiral"
  start turn 1 A precombat_main
  turn 1 A: cast "Swift Spiral" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert exile A contains "Twining Twins"
  run_to turn 1 cleanup
  assert battlefield B contains "Hill Giant"
  assert battlefield A lacks "Hill Giant"
}

scenario "Twining Twins cast from adventure exile has flying and vigilance" {
  battlefield A: 4 "Island", "Plains", "Island"
  hand A: "Twining Twins // Swift Spiral"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Swift Spiral" targeting "Grizzly Bears"
  turn 1 postcombat_main A: cast "Twining Twins"
  run_to turn 2 precombat_main
  assert battlefield A contains "Twining Twins"
  assert has "Twining Twins" flying
  assert has "Twining Twins" vigilance
  assert battlefield B contains "Grizzly Bears"
}

scenario "Swift Spiral can't target a token" {
  battlefield A: "Plains", "Island", "Thranduil, Sindarin Liege // Silvan Rally", "Forest"
  hand A: "Twining Twins // Swift Spiral", "Forest"
  start turn 1 A precombat_main
  turn 1 A: play "Forest"
  illegal turn 1 postcombat_main A: cast "Swift Spiral" targeting "Elf"
  run_to turn 1 end
  assert battlefield A contains "Elf"
}

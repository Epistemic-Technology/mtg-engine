scenario "Ivory Charm mode 1: all creatures get -2/-0" {
  battlefield A: "Plains", "Hill Giant"
  battlefield B: "Grizzly Bears"
  hand A: "Ivory Charm"
  turn 1 A: cast "Ivory Charm" mode 1
  run_to turn 1 end
  assert power "Hill Giant" 1
  assert power "Grizzly Bears" 0
  assert toughness "Grizzly Bears" 2
}

scenario "Ivory Charm mode 2: tap target creature" {
  battlefield A: "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Ivory Charm"
  turn 1 A: cast "Ivory Charm" mode 2 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert tapped "Grizzly Bears"
}

scenario "Ivory Charm mode 3: prevents the next 1 damage" {
  battlefield A: "Plains", "Grizzly Bears"
  battlefield B: "Mountain"
  hand A: "Ivory Charm"
  hand B: "Shock"
  turn 1 A: cast "Ivory Charm" mode 3 targeting "Grizzly Bears"
  turn 1 begin_combat B: cast "Shock" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 1
}

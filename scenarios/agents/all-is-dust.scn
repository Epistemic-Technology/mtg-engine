scenario "all is dust sacrifices colored permanents of each player only" {
  battlefield A: "Grizzly Bears", "Sol Ring", "Forest"
  battlefield B: "Hill Giant", "Sol Ring", "Mountain"
  hand A: "All Is Dust"
  battlefield A: 7 "Island"
  turn 1 precombat_main A: cast "All Is Dust"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Sol Ring"
  assert battlefield B contains "Sol Ring"
  assert battlefield A contains "Forest"
  assert battlefield B contains "Mountain"
}

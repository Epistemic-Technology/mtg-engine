scenario "gigantomancer sets base power and toughness to 7/7 until end of turn" {
  battlefield A: "Gigantomancer", "Grizzly Bears" with 1 +1/+1, 2 "Forest"
  start turn 1 A precombat_main
  turn 1 precombat_main A: activate "Gigantomancer" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert power "Grizzly Bears" 8
  assert toughness "Grizzly Bears" 8
  assert power "Gigantomancer" 1
  run_to turn 2 upkeep
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 3
}
scenario "gigantomancer targets only your creatures" {
  battlefield A: "Gigantomancer", "Forest"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  illegal turn 1 precombat_main A: activate "Gigantomancer" targeting B "Hill Giant"
  run_to turn 1 end
}

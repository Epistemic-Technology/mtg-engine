scenario "saddled Lagorin puts counters on a Mount and a Vehicle" {
  battlefield A: "Lagorin, Soul of Alacria", "Grizzly Bears", "Bulwark Ox", "Smuggler's Copter"
  turn 1 A: activate "Lagorin, Soul of Alacria" ability 1
  turn 1 A: attack "Lagorin, Soul of Alacria"
  turn 1 A: trigger "Lagorin, Soul of Alacria" targeting "Bulwark Ox", "Smuggler's Copter"
  run_to turn 1 postcombat_main
  assert counters "Bulwark Ox" +1/+1 1
  assert counters "Smuggler's Copter" +1/+1 1
  assert counters "Grizzly Bears" +1/+1 0
}

scenario "Lagorin can't target a creature that's neither a Mount nor a Vehicle" {
  battlefield A: "Lagorin, Soul of Alacria", "Grizzly Bears", "Hill Giant"
  turn 1 A: activate "Lagorin, Soul of Alacria" ability 1
  turn 1 A: attack "Lagorin, Soul of Alacria"
  illegal turn 1 A: trigger "Lagorin, Soul of Alacria" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 0
}

scenario "unsaddled Lagorin doesn't trigger" {
  battlefield A: "Lagorin, Soul of Alacria", "Bulwark Ox"
  turn 1 A: attack "Lagorin, Soul of Alacria"
  run_to turn 1 postcombat_main
  assert counters "Bulwark Ox" +1/+1 0
  assert life B 19
}

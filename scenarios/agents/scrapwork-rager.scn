scenario "Scrapwork Rager draws and drains as it enters" {
  battlefield A: 4 "Swamp"
  hand A: "Scrapwork Rager"
  start turn 1 A precombat_main
  turn 1 A: cast "Scrapwork Rager"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert life A 19
}

scenario "Scrapwork Rager unearths with haste and is exiled at end of turn" {
  battlefield A: 4 "Swamp"
  graveyard A: "Scrapwork Rager"
  start turn 1 A precombat_main
  turn 1 A: activate "Scrapwork Rager"
  turn 1 A: attack "Scrapwork Rager"
  run_to turn 1 postcombat_main
  assert life B 18
  assert life A 19
  assert hand A count 1
  run_to turn 2 upkeep
  assert exile A contains "Scrapwork Rager"
}

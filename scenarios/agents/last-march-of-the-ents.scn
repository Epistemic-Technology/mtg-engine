scenario "draws greatest toughness and puts creatures onto battlefield" {
  battlefield A: "Hill Giant", "Serra Angel", 8 "Forest"
  hand A: "Last March of the Ents"
  library A: "Grizzly Bears", "Wind Drake", "Island", "Island", "Island", "Island"
  turn 1 precombat_main A: cast "Last March of the Ents"
  turn 1 precombat_main A: choose "Grizzly Bears"
  turn 1 precombat_main A: choose "Wind Drake"
  run_to turn 1 begin_combat
  assert battlefield A contains 1 "Grizzly Bears"
  assert battlefield A contains 1 "Wind Drake"
  assert hand A count 2
  assert graveyard A contains "Last March of the Ents"
}
scenario "draw 4 with toughness 4, no creature chosen" {
  battlefield A: "Hill Giant", "Serra Angel", 8 "Forest"
  hand A: "Last March of the Ents"
  library A: "Grizzly Bears", "Wind Drake", "Island", "Island", "Island", "Island"
  turn 1 precombat_main A: cast "Last March of the Ents"
  turn 1 precombat_main A: choose done
  run_to turn 1 begin_combat
  assert hand A count 4
}

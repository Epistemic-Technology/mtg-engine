scenario "increasing savagery from hand: five counters" {
  battlefield A: "Grizzly Bears", 4 "Forest"
  hand A: "Increasing Savagery"
  start turn 1 A precombat_main
  turn 1 A: cast "Increasing Savagery" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 5
}
scenario "increasing savagery flashback: ten counters" {
  battlefield A: "Grizzly Bears", 7 "Forest"
  graveyard A: "Increasing Savagery"
  start turn 1 A precombat_main
  turn 1 A: cast "Increasing Savagery" from graveyard targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 10
  assert exile A contains "Increasing Savagery"
}

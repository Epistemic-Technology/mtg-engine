scenario "caradora searches for a vehicle" {
  battlefield A: 4 "Plains"
  hand A: "Caradora, Heart of Alacria"
  library A: "Forest", "Smuggler's Copter", "Forest"
  battlefield A: 2 "Forest"
  turn 1 A: cast "Caradora, Heart of Alacria"
  run_to turn 1 postcombat_main
  assert hand A contains "Smuggler's Copter"
}

scenario "caradora adds one more +1/+1 counter" {
  battlefield A: "Caradora, Heart of Alacria", "Sally Pride, Lioness Leader", "Grizzly Bears"
  turn 1 A: attack "Sally Pride, Lioness Leader"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
  assert counters "Caradora, Heart of Alacria" +1/+1 2
}

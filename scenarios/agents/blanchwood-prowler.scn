scenario "Blanchwood Prowler takes a milled land into hand" {
  battlefield A: 2 "Forest"
  hand A: "Blanchwood Prowler"
  library A: "Shock", "Island", "Grizzly Bears", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Blanchwood Prowler"
  run_to turn 1 postcombat_main
  assert hand A contains "Island"
  assert graveyard A contains "Shock"
  assert graveyard A contains "Grizzly Bears"
  assert library A contains "Plains"
  assert counters "Blanchwood Prowler" +1/+1 0
}

scenario "Blanchwood Prowler gets a counter when it takes no land" {
  battlefield A: 2 "Forest"
  hand A: "Blanchwood Prowler"
  library A: "Shock", "Island", "Grizzly Bears", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Blanchwood Prowler"
  turn 1 A: decline "Blanchwood Prowler"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Island"
  assert counters "Blanchwood Prowler" +1/+1 1
  assert power "Blanchwood Prowler" 2
}

scenario "Blanchwood Prowler gets a counter when no land is milled" {
  battlefield A: 2 "Forest"
  hand A: "Blanchwood Prowler"
  library A: "Shock", "Murder", "Grizzly Bears", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Blanchwood Prowler"
  run_to turn 1 postcombat_main
  assert hand A count 0
  assert counters "Blanchwood Prowler" +1/+1 1
}

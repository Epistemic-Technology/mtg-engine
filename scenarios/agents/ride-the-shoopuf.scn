scenario "Ride the Shoopuf landfall puts a counter on a creature" {
  battlefield A: "Ride the Shoopuf", "Grizzly Bears"
  hand A: "Forest"
  start turn 1 A precombat_main
  turn 1 A: play "Forest"
  turn 1 A: trigger "Ride the Shoopuf" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Ride the Shoopuf becomes a 7/7 Beast for good" {
  battlefield A: "Ride the Shoopuf", 7 "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Ride the Shoopuf"
  run_to turn 3 precombat_main
  assert is "Ride the Shoopuf" creature
  assert is "Ride the Shoopuf" enchantment
  assert is "Ride the Shoopuf" Beast
  assert power "Ride the Shoopuf" 7
  assert toughness "Ride the Shoopuf" 7
}

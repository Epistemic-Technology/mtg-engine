scenario "Septic Rats gets +1/+1 when defender is poisoned" {
  poison B: 1
  battlefield A: "Septic Rats"
  turn 1 A: attack "Septic Rats"
  run_to turn 1 declare_blockers
  assert power "Septic Rats" 3
  assert toughness "Septic Rats" 3
  run_to turn 1 postcombat_main
  assert poison B 4
}
scenario "Septic Rats no bonus against unpoisoned defender" {
  battlefield A: "Septic Rats"
  turn 1 A: attack "Septic Rats"
  run_to turn 1 declare_blockers
  assert power "Septic Rats" 2
  run_to turn 1 postcombat_main
  assert poison B 2
}

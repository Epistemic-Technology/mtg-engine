scenario "Karplusan Wolverine: becoming blocked deals 1 damage" {
  battlefield A: "Karplusan Wolverine"
  battlefield B: "Grizzly Bears"
  start turn 2 A
  turn 2 A: attack "Karplusan Wolverine"
  turn 2 B: block "Karplusan Wolverine" with "Grizzly Bears"
  turn 2 A: trigger "Karplusan Wolverine" targeting player B
  run_to turn 2 postcombat_main
  assert life B 19
  assert graveyard A contains "Karplusan Wolverine"
  assert damage "Grizzly Bears" 1
}

scenario "Karplusan Wolverine: unblocked, no trigger" {
  battlefield A: "Karplusan Wolverine"
  start turn 2 A
  turn 2 A: attack "Karplusan Wolverine"
  run_to turn 2 postcombat_main
  assert life B 19
}

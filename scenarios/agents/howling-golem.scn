scenario "Howling Golem attacking makes each player draw" {
  battlefield A: "Howling Golem"
  start turn 1 A precombat_main
  turn 1 A: attack "Howling Golem"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert hand B count 1
}

scenario "Howling Golem blocking makes each player draw" {
  battlefield A: "Grizzly Bears"
  battlefield B: "Howling Golem"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Howling Golem"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert hand B count 1
}

scenario "awareness makes a big creature small plus counters" {
  hand A: "Awakened Awareness"
  battlefield A: 4 "Island", "Serra Angel"
  turn 1 A: cast "Awakened Awareness" x 2 targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert attached "Awakened Awareness" to "Serra Angel"
  assert counters "Serra Angel" +1/+1 2
  assert power "Serra Angel" 3
  assert toughness "Serra Angel" 3
}
scenario "awareness on a small creature grows it" {
  hand A: "Awakened Awareness"
  battlefield A: 5 "Island"
  battlefield B: "Grizzly Bears"
  turn 1 A: cast "Awakened Awareness" x 3 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
}
scenario "awareness on a noncreature artifact only adds counters" {
  hand A: "Awakened Awareness"
  battlefield A: 3 "Island", "Mind Stone"
  turn 1 A: cast "Awakened Awareness" x 1 targeting "Mind Stone"
  run_to turn 1 postcombat_main
  assert counters "Mind Stone" +1/+1 1
  assert is not "Mind Stone" creature
}

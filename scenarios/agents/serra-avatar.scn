scenario "serra avatar power and toughness equal life" {
  life A 7
  battlefield A: "Serra Avatar"
  run_to turn 1 precombat_main
  assert power "Serra Avatar" 7
  assert toughness "Serra Avatar" 7
}
scenario "serra avatar is shuffled into library when it dies" {
  battlefield A: "Serra Avatar"
  battlefield B: 3 "Swamp"
  hand B: "Murder"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Serra Avatar"
  run_to turn 2 postcombat_main
  assert graveyard A lacks "Serra Avatar"
  assert library A contains "Serra Avatar"
  assert graveyard B contains "Murder"
}

scenario "wildwood scourge enters with X counters and grows with others' counters" {
  battlefield A: "Grizzly Bears", 4 "Forest"
  hand A: "Wildwood Scourge", "Battlegrowth"
  start turn 1 A precombat_main
  turn 1 A: cast "Wildwood Scourge" x 2
  turn 1 A: wait
  turn 1 A: cast "Battlegrowth" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Wildwood Scourge" +1/+1 3
  assert power "Wildwood Scourge" 3
}

scenario "wildwood scourge does not trigger on counters put on itself" {
  battlefield A: 4 "Forest"
  hand A: "Wildwood Scourge", "Battlegrowth"
  start turn 1 A precombat_main
  turn 1 A: cast "Wildwood Scourge" x 2
  turn 1 A: wait
  turn 1 A: cast "Battlegrowth" targeting "Wildwood Scourge"
  run_to turn 1 begin_combat
  assert counters "Wildwood Scourge" +1/+1 3
}

scenario "wildwood scourge ignores counters on another hydra" {
  battlefield A: "Bristling Hydra", 2 "Forest"
  energy A: 3
  hand A: "Wildwood Scourge"
  start turn 1 A precombat_main
  turn 1 A: cast "Wildwood Scourge" x 1
  turn 1 A: wait
  turn 1 A: activate "Bristling Hydra"
  run_to turn 1 begin_combat
  assert counters "Bristling Hydra" +1/+1 1
  assert counters "Wildwood Scourge" +1/+1 1
}

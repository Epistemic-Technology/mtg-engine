scenario "Song of Totentanz makes X Rats that can't block, and they have haste" {
  battlefield A: 4 "Mountain"
  hand A: "Song of Totentanz"
  start turn 1 A precombat_main
  turn 1 A: cast "Song of Totentanz" x 3
  turn 1 A: attack "Rat", "Rat", "Rat"
  run_to turn 1 postcombat_main
  assert battlefield A contains 3 "Rat"
  assert life B 17
}

scenario "Song of Totentanz Rats can't block" {
  battlefield A: 3 "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Song of Totentanz"
  start turn 1 A precombat_main
  turn 1 A: cast "Song of Totentanz" x 2
  turn 2 B: attack "Grizzly Bears"
  illegal turn 2 A: block "Grizzly Bears" with "Rat"
  run_to turn 2 postcombat_main
  assert life A 18
}

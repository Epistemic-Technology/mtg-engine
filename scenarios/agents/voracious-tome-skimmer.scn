scenario "Voracious Tome-Skimmer draws for a spell on an opponent's turn" {
  battlefield A: "Voracious Tome-Skimmer", "Mountain"
  hand A: "Lightning Bolt"
  start turn 2 B
  turn 2 upkeep A: cast "Lightning Bolt" targeting player B
  run_to turn 2 precombat_main
  assert life B 17
  assert life A 19
  assert hand A count 1
}

scenario "Voracious Tome-Skimmer's payment is optional" {
  battlefield A: "Voracious Tome-Skimmer", "Mountain"
  hand A: "Lightning Bolt"
  start turn 2 B
  turn 2 upkeep A: cast "Lightning Bolt" targeting player B
  turn 2 upkeep A: decline "Voracious Tome-Skimmer"
  run_to turn 2 precombat_main
  assert life A 20
  assert hand A count 0
}

scenario "Voracious Tome-Skimmer ignores spells on your own turn" {
  battlefield A: "Voracious Tome-Skimmer", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life A 20
  assert hand A count 0
  assert has "Voracious Tome-Skimmer" flying
}

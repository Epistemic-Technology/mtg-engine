scenario "Curry Favor drains for each Knight you control, then the Swordmaster is cast from exile" {
  battlefield A: 3 "Swamp", 2 "Sacred Knight"
  hand A: "Smitten Swordmaster"
  start turn 1 A precombat_main
  turn 1 A: cast "Curry Favor"
  turn 1 A: wait
  turn 1 A: cast "Smitten Swordmaster"
  run_to turn 1 end
  assert life A 22
  assert life B 18
  assert battlefield A contains "Smitten Swordmaster"
  assert has "Smitten Swordmaster" lifelink
}

scenario "Curry Favor with no Knights does nothing" {
  battlefield A: "Swamp"
  hand A: "Smitten Swordmaster"
  start turn 1 A precombat_main
  turn 1 A: cast "Curry Favor"
  run_to turn 1 end
  assert life A 20
  assert life B 20
  assert exile A contains "Smitten Swordmaster"
}

scenario "owner shuffles it into library" {
  battlefield A: "Cerulean Sphinx", "Island"
  library A: "Forest", "Forest"
  turn 1 precombat_main A: activate "Cerulean Sphinx"
  run_to turn 1 combat_damage
  assert battlefield A lacks "Cerulean Sphinx"
  assert graveyard A lacks "Cerulean Sphinx"
  assert library A contains "Cerulean Sphinx"
}

scenario "Aang's Defense pumps a blocker and draws a card" {
  battlefield A: "Grizzly Bears", "Plains"
  battlefield B: "Hill Giant"
  hand A: "Aang's Defense"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Grizzly Bears"
  turn 2 declare_blockers A: cast "Aang's Defense" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
  assert graveyard A contains "Aang's Defense"
  assert hand A count 1
}

scenario "Aang's Defense needs a blocking creature" {
  battlefield A: "Grizzly Bears", "Plains"
  hand A: "Aang's Defense"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Aang's Defense" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Aang's Defense"
}

scenario "stone spirit pumps toughness and grants firebreathing" {
  battlefield A: "Greater Stone Spirit", 4 "Mountain", "Hill Giant"
  turn 1 precombat_main A: activate "Greater Stone Spirit" targeting "Hill Giant"
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: activate "Hill Giant"
  run_to turn 1 postcombat_main
  assert toughness "Hill Giant" 5
  assert power "Hill Giant" 4
}
scenario "stone spirit not blocked by flyers" {
  battlefield A: "Greater Stone Spirit"
  battlefield B: "Wind Drake", "Hill Giant"
  turn 1 declare_attackers A: attack "Greater Stone Spirit"
  illegal turn 1 declare_blockers B: block "Greater Stone Spirit" with "Wind Drake"
  turn 1 declare_blockers B: block "Greater Stone Spirit" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
}

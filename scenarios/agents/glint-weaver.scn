scenario "Glint Weaver puts all three counters on one creature and gains its toughness" {
  battlefield A: "Hill Giant", 7 "Forest"
  hand A: "Glint Weaver"
  start turn 1 A precombat_main
  turn 1 A: cast "Glint Weaver"
  turn 1 A: trigger "Glint Weaver" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 3
  assert toughness "Hill Giant" 6
  assert life A 26
}

scenario "Glint Weaver counts only creatures you control" {
  battlefield A: "Grizzly Bears", "Craw Wurm", 7 "Forest"
  battlefield B: "Ancient Spider" with 2 +1/+1
  hand A: "Glint Weaver"
  start turn 1 A precombat_main
  turn 1 A: cast "Glint Weaver"
  turn 1 A: trigger "Glint Weaver" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
  assert counters "Glint Weaver" +1/+1 0
  assert life A 25
}

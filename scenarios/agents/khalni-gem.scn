scenario "Khalni Gem returns two lands when it enters" {
  battlefield A: 4 "Forest", "Island"
  hand A: "Khalni Gem"
  start turn 1 A precombat_main
  turn 1 A: cast "Khalni Gem"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Khalni Gem"
  assert hand A count 2
}

scenario "Khalni Gem taps for two mana of one color" {
  battlefield A: "Khalni Gem"
  hand A: "Shock", "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Shock" targeting player B
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 16
  assert tapped "Khalni Gem"
}

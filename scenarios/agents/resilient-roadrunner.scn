scenario "Resilient Roadrunner: haste, attacks the turn it arrives" {
  battlefield A: 2 "Mountain"
  hand A: "Resilient Roadrunner"
  start turn 1 A precombat_main
  turn 1 A: cast "Resilient Roadrunner"
  turn 1 A: attack "Resilient Roadrunner"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "Resilient Roadrunner: after its ability, a creature without haste can't block it" {
  battlefield A: "Resilient Roadrunner", 3 "Mountain"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Resilient Roadrunner"
  turn 1 A: attack "Resilient Roadrunner"
  illegal turn 1 B: block "Resilient Roadrunner" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
}

scenario "Resilient Roadrunner: without its ability it can be blocked" {
  battlefield A: "Resilient Roadrunner"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Resilient Roadrunner"
  turn 1 B: block "Resilient Roadrunner" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Resilient Roadrunner"
}

scenario "painful quandary: opponent with no cards loses 5 life" {
  battlefield A: "Painful Quandary"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  run_to turn 2 postcombat_main
  assert life B 15
  assert life A 18
}

scenario "painful quandary: opponent discards a card instead" {
  battlefield A: "Painful Quandary"
  battlefield B: "Mountain"
  hand B: "Shock", "Forest"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting player A
  turn 2 B: accept "Painful Quandary"
  run_to turn 2 postcombat_main
  assert life B 20
  assert graveyard B contains "Forest"
}

scenario "painful quandary: your own spells don't trigger it" {
  battlefield A: "Painful Quandary", "Mountain"
  hand A: "Shock"
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life A 20
  assert life B 18
}

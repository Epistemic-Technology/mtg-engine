scenario "Highway Robbery discards a card to draw two" {
  battlefield A: 2 "Mountain", "Forest"
  hand A: "Highway Robbery", "Grizzly Bears"
  library A: "Island", "Swamp", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Highway Robbery"
  turn 1 A: choose "1"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Forest"
  assert hand A count 2
  assert hand A contains "Island"
  assert hand A contains "Swamp"
}

scenario "Highway Robbery sacrifices a land to draw two" {
  battlefield A: 2 "Mountain", "Forest"
  hand A: "Highway Robbery", "Grizzly Bears"
  library A: "Island", "Swamp", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Highway Robbery"
  turn 1 A: choose "2"
  turn 1 A: choose "Forest"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Forest"
  assert hand A contains "Grizzly Bears"
  assert hand A count 3
}

scenario "Highway Robbery declined draws nothing" {
  battlefield A: 2 "Mountain"
  hand A: "Highway Robbery", "Grizzly Bears"
  library A: "Island", "Swamp", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Highway Robbery"
  turn 1 A: decline "Highway Robbery"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert graveyard A contains "Highway Robbery"
}

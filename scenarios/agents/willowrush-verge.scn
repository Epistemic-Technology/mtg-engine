scenario "Willowrush Verge makes green with a Forest" {
  battlefield A: "Willowrush Verge", "Forest"
  hand A: "Giant Growth", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
}

scenario "Willowrush Verge makes no green without a Forest or Island" {
  battlefield A: "Willowrush Verge", "Plains"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
}

scenario "Joined Researchers becomes prepared when an opponent has more cards" {
  battlefield A: "Joined Researchers // Secret Rendezvous", 3 "Plains"
  hand B: "Forest"
  turn 3 A: cast "Secret Rendezvous" targeting player B
  run_to turn 3 postcombat_main
  assert hand A count 4
  assert hand B count 5
}

scenario "Joined Researchers stays unprepared when no opponent has more cards" {
  battlefield A: "Joined Researchers // Secret Rendezvous", 3 "Plains"
  hand A: "Forest", "Forest"
  illegal turn 3 A: cast "Secret Rendezvous" targeting player B
  run_to turn 3 postcombat_main
}

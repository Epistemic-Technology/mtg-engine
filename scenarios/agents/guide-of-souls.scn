scenario "Guide of Souls gains life and energy when another creature enters" {
  battlefield A: "Guide of Souls", "Forest", "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 declare_attackers
  assert life A 21
  assert energy A 1
}

scenario "Guide of Souls pays three energy to make an attacker an Angel" {
  battlefield A: "Guide of Souls", "Grizzly Bears"
  energy A: 3
  start turn 1 A
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 declare_blockers
  assert energy A 0
  assert counters "Grizzly Bears" +1/+1 2
  assert counters "Grizzly Bears" flying 1
  assert has "Grizzly Bears" flying
  assert is "Grizzly Bears" Angel
  assert power "Grizzly Bears" 4
}

scenario "Guide of Souls needs three energy" {
  battlefield A: "Guide of Souls", "Grizzly Bears"
  energy A: 2
  start turn 1 A
  turn 1 A: attack "Guide of Souls"
  run_to turn 1 declare_blockers
  assert energy A 2
  assert counters "Guide of Souls" +1/+1 0
}

scenario "orgg can't attack past a power 3 untapped creature" {
  battlefield A: "Orgg"
  battlefield B: "Hill Giant"
  illegal turn 1 declare_attackers A: attack "Orgg"
  run_to turn 1 postcombat_main
  assert life B 20
}
scenario "orgg attacks past small creatures" {
  battlefield A: "Orgg"
  battlefield B: "Grizzly Bears", "Hill Giant" tapped
  turn 1 declare_attackers A: attack "Orgg"
  run_to turn 1 postcombat_main
  assert life B 14
}
scenario "orgg can't block power 3 but blocks power 2" {
  battlefield A: "Orgg"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  illegal turn 2 declare_blockers A: block "Hill Giant" with "Orgg"
  run_to turn 2 postcombat_main
  assert life A 17
}
scenario "orgg blocks a small creature" {
  battlefield A: "Orgg"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 declare_blockers A: block "Grizzly Bears" with "Orgg"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard B contains "Grizzly Bears"
}

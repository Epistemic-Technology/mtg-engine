scenario "bonders enclave draws only with a power 4 creature" {
  battlefield A: "Bonders' Enclave", 3 "Plains", "Hill Giant"
  library A: "Island", "Swamp"
  start turn 1 A precombat_main
  illegal turn 1 precombat_main A: activate "Bonders' Enclave"
  run_to turn 1 end
  assert hand A count 0
}
scenario "bonders enclave with power 4" {
  battlefield A: "Bonders' Enclave", 3 "Plains", "Serra Angel"
  library A: "Island", "Swamp"
  start turn 1 A precombat_main
  turn 1 precombat_main A: activate "Bonders' Enclave"
  run_to turn 1 end
  assert hand A count 1
  assert hand A contains "Island"
  assert tapped "Bonders' Enclave"
}

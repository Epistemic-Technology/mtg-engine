scenario "desertwalk: unblockable against a Desert, and Desert damage is prevented" {
  battlefield A: "Desert Nomads"
  battlefield B: "Desert", "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Desert Nomads"
  illegal turn 1 declare_blockers B: block "Desert Nomads" with "Grizzly Bears"
  turn 1 end_combat B: activate "Desert" targeting "Desert Nomads"
  run_to turn 1 postcombat_main
  assert life B 18
  assert damage "Desert Nomads" 0
  assert battlefield A contains "Desert Nomads"
}
scenario "without a Desert the Nomads can be blocked" {
  battlefield A: "Desert Nomads"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Desert Nomads"
  turn 1 B: block "Desert Nomads" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Desert Nomads"
  assert graveyard B contains "Grizzly Bears"
}
scenario "damage from a non-Desert source is not prevented" {
  battlefield A: "Desert Nomads"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Desert Nomads"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Desert Nomads"
}

scenario "enters: two Rats that can't block" {
  battlefield A: 4 "Mountain"
  hand A: "Redcap Gutter-Dweller"
  turn 1 precombat_main A: cast "Redcap Gutter-Dweller"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Rat"
  assert power newest A "Rat" 1
  assert has "Redcap Gutter-Dweller" menace
}
scenario "upkeep: sacrifice another creature for counter and impulse" {
  battlefield A: "Redcap Gutter-Dweller", "Grizzly Bears"
  library A: "Mountain", "Forest"
  turn 1 upkeep A: accept "Redcap Gutter-Dweller"
  turn 1 precombat_main A: play "Mountain"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert counters "Redcap Gutter-Dweller" +1/+1 1
  assert power "Redcap Gutter-Dweller" 4
  assert battlefield A contains "Mountain"
  assert exile A lacks "Mountain"
}
scenario "upkeep: decline does nothing" {
  battlefield A: "Redcap Gutter-Dweller", "Grizzly Bears"
  library A: "Mountain", "Forest"
  turn 1 upkeep A: decline "Redcap Gutter-Dweller"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert counters "Redcap Gutter-Dweller" +1/+1 0
}

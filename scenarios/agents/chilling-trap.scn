scenario "Chilling Trap shrinks an attacker and draws with a Wizard" {
  battlefield A: "Alabaster Mage", "Island"
  battlefield B: "Hill Giant"
  hand A: "Chilling Trap"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 declare_attackers A: cast "Chilling Trap" targeting "Hill Giant"
  run_to turn 2 combat_damage
  assert power "Hill Giant" -1
  assert hand A count 1
  run_to turn 2 postcombat_main
  assert life A 20
}

scenario "Chilling Trap draws nothing without a Wizard" {
  battlefield A: "Grizzly Bears", "Island"
  battlefield B: "Hill Giant"
  hand A: "Chilling Trap"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 declare_attackers A: cast "Chilling Trap" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert hand A count 0
  assert life A 20
}

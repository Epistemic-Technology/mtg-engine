scenario "treasure equal to damage from any creature" {
  battlefield A: "Old Gnawbone", "Grizzly Bears"
  start turn 1 A
  turn 1 declare_attackers A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield A contains 2 "Treasure"
}
scenario "damage to a creature makes nothing" {
  battlefield A: "Old Gnawbone", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 1 A
  turn 1 declare_attackers A: attack "Grizzly Bears"
  turn 1 declare_blockers B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Treasure"
}

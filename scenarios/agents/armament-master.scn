scenario "armament master pumps other Kor per Equipment attached" {
  battlefield A: "Armament Master", "Accorder's Shield" on "Armament Master", "Aeronaut's Wings" on "Armament Master", "Kor Soldier", "Grizzly Bears"
  run_to turn 1 precombat_main
  assert power "Kor Soldier" 5
  assert toughness "Kor Soldier" 5
  assert power "Grizzly Bears" 2
  assert power "Armament Master" 3
}
scenario "armament master with no Equipment gives nothing" {
  battlefield A: "Armament Master", "Kor Soldier"
  run_to turn 1 precombat_main
  assert power "Kor Soldier" 1
  assert power "Armament Master" 2
}

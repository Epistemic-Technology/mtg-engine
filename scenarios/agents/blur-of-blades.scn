scenario "Blur of Blades shrinks a creature and burns its controller" {
  battlefield A: 2 "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Blur of Blades"
  start turn 2 A precombat_main
  turn 2 A: cast "Blur of Blades" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert counters "Grizzly Bears" -1/-1 1
  assert power "Grizzly Bears" 1
  assert life B 18
  assert life A 20
}

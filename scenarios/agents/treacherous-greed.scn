scenario "Treacherous Greed sacrifices a creature that dealt damage" {
  battlefield A: "Grizzly Bears", "Plains", "Swamp", "Swamp"
  hand A: "Treacherous Greed"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 postcombat_main A: cast "Treacherous Greed" sacrificing "Grizzly Bears"
  run_to turn 1 end
  assert life B 15
  assert life A 23
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 3
}

scenario "Treacherous Greed needs a creature that dealt damage" {
  battlefield A: "Grizzly Bears", "Plains", "Swamp", "Swamp"
  hand A: "Treacherous Greed"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Treacherous Greed" sacrificing "Grizzly Bears"
  run_to turn 1 end
  assert battlefield A contains "Grizzly Bears"
}

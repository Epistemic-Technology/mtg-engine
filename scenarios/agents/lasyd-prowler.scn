scenario "Lasyd Prowler mills cards equal to lands you control" {
  battlefield A: 5 "Forest"
  hand A: "Lasyd Prowler"
  library A: "Forest", "Island", "Grizzly Bears", "Hill Giant", "Swamp", "Plains", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: cast "Lasyd Prowler"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Swamp"
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A lacks "Plains"
  assert library A contains "Plains"
}

scenario "Lasyd Prowler may decline to mill" {
  battlefield A: 5 "Forest"
  hand A: "Lasyd Prowler"
  library A: "Forest", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Lasyd Prowler"
  turn 1 A: decline "Lasyd Prowler"
  run_to turn 1 postcombat_main
  assert graveyard A lacks "Forest"
}

scenario "Lasyd Prowler renews for the number of land cards in your graveyard" {
  battlefield A: "Grizzly Bears", 2 "Forest"
  graveyard A: "Lasyd Prowler", "Island", "Swamp", "Mountain", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Lasyd Prowler" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
  assert exile A contains "Lasyd Prowler"
}

scenario "cost reduction, then solved by four spells, then draws" {
  battlefield A: "Case of the Ransacked Lab", 6 "Mountain", 2 "Island"
  hand A: 4 "Shock", "Divination"
  library A: "Forest", "Swamp", "Plains", "Island"
  turn 1 precombat_main A: cast "Shock" targeting player B
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: cast "Shock" targeting player B
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: cast "Shock" targeting player B
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: cast "Shock" targeting player B
  run_to turn 1 end
  assert life B 12
  assert hand A count 1
  turn 3 precombat_main A: cast "Divination"
  run_to turn 3 postcombat_main
  assert hand A count 4  # 1 + turn draw - Divination + Case draw + 2
}

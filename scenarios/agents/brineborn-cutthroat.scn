scenario "brineborn cutthroat: spell on opponent's turn adds a counter" {
  battlefield A: "Brineborn Cutthroat", "Mountain"
  hand A: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 precombat_main A: cast "Lightning Bolt" targeting player B
  run_to turn 2 end
  assert life B 17
  assert counters "Brineborn Cutthroat" +1/+1 1
  assert power "Brineborn Cutthroat" 3
}

scenario "brineborn cutthroat: spell on own turn does nothing" {
  battlefield A: "Brineborn Cutthroat", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 end
  assert life B 17
  assert counters "Brineborn Cutthroat" +1/+1 0
}

scenario "brineborn cutthroat: flash" {
  battlefield A: 2 "Island"
  hand A: "Brineborn Cutthroat"
  start turn 2 B precombat_main
  turn 2 precombat_main A: cast "Brineborn Cutthroat"
  run_to turn 2 end
  assert battlefield A contains "Brineborn Cutthroat"
  assert counters "Brineborn Cutthroat" +1/+1 0
}

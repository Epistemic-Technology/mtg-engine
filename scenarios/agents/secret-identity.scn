scenario "Secret Identity Conceal: a 1/1 Citizen with hexproof" {
  battlefield A: "Island", "Hill Giant"
  hand A: "Secret Identity"
  start turn 1 A precombat_main
  turn 1 A: cast "Secret Identity" mode 1 targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "Hill Giant" 1
  assert toughness "Hill Giant" 1
  assert has "Hill Giant" hexproof
  assert is "Hill Giant" Citizen
  assert is not "Hill Giant" Giant
}

scenario "Secret Identity Reveal: a 3/4 Hero with flying and vigilance, until end of turn" {
  battlefield A: "Island", "Grizzly Bears"
  hand A: "Secret Identity"
  start turn 1 A precombat_main
  turn 1 A: cast "Secret Identity" mode 2 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 4
  assert has "Grizzly Bears" flying
  assert has "Grizzly Bears" vigilance
  assert is "Grizzly Bears" Hero
  run_to turn 2 upkeep
  assert power "Grizzly Bears" 2
  assert has not "Grizzly Bears" flying
}

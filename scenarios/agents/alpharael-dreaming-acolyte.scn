scenario "Alpharael draws two then discards an artifact card" {
  battlefield A: "Island", "Swamp", "Plains"
  hand A: "Alpharael, Dreaming Acolyte", "Ornithopter"
  library A: "Forest", "Mountain", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Alpharael, Dreaming Acolyte"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Ornithopter"
  assert hand A count 2
  assert hand A contains "Forest"
  assert hand A contains "Mountain"
}

scenario "Alpharael has deathtouch only during your turn" {
  battlefield A: "Alpharael, Dreaming Acolyte"
  start turn 1 A precombat_main
  assert has "Alpharael, Dreaming Acolyte" deathtouch
  run_to turn 2 precombat_main
  assert has not "Alpharael, Dreaming Acolyte" deathtouch
}

scenario "Alpharael without an artifact card discards two" {
  battlefield A: "Island", "Swamp", "Plains"
  hand A: "Alpharael, Dreaming Acolyte", "Island"
  library A: "Forest", "Mountain", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Alpharael, Dreaming Acolyte"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert graveyard A count 2
}

scenario "avengers tower finds a hero" {
  battlefield A: "Avengers Tower", 4 "Plains"
  library A: "Island", "Guerrilla Gorilla", "Forest", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Avengers Tower"
  run_to turn 1 begin_combat
  assert hand A contains "Guerrilla Gorilla"
  assert hand A count 1
  assert tapped "Avengers Tower"
}

scenario "avengers tower colored mana casts a hero spell" {
  battlefield A: "Avengers Tower", "Plains"
  hand A: "Guerrilla Gorilla"
  start turn 1 A precombat_main
  turn 1 A: cast "Guerrilla Gorilla"
  run_to turn 1 begin_combat
  assert battlefield A contains "Guerrilla Gorilla"
}

scenario "avengers tower colored mana can't cast a non-hero spell" {
  battlefield A: "Avengers Tower", "Plains"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Grizzly Bears"
  run_to turn 1 begin_combat
  assert hand A contains "Grizzly Bears"
}

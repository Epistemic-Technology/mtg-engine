scenario "Enigma Drake: power equals instant and sorcery cards in your graveyard" {
  battlefield A: "Enigma Drake"
  graveyard A: "Lightning Bolt", "Divination", "Grizzly Bears", "Forest"
  graveyard B: "Shock", "Murder"
  start turn 1 A precombat_main
  run_to turn 1 begin_combat
  assert power "Enigma Drake" 2
  assert toughness "Enigma Drake" 4
  assert has "Enigma Drake" flying
}

scenario "Enigma Drake: grows as an instant goes to the graveyard" {
  battlefield A: "Enigma Drake", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert power "Enigma Drake" 1
  assert life B 17
}

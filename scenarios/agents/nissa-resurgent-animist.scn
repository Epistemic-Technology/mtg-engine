scenario "nissa second landfall finds an elf" {
  battlefield A: "Nissa, Resurgent Animist", 2 "Forest"
  hand A: "Forest", "Rampant Growth"
  library A: "Plains", "Hill Giant", "Llanowar Elves", "Grizzly Bears"
  turn 1 precombat_main A: play "Forest"
  turn 1 precombat_main A: cast "Rampant Growth"
  run_to turn 1 postcombat_main
  assert hand A contains "Llanowar Elves"
  assert battlefield A contains "Plains"
}
scenario "nissa first landfall only adds mana" {
  battlefield A: "Nissa, Resurgent Animist"
  hand A: "Forest"
  library A: "Hill Giant", "Llanowar Elves"
  turn 1 precombat_main A: play "Forest"
  run_to turn 1 postcombat_main
  assert hand A count 0
}

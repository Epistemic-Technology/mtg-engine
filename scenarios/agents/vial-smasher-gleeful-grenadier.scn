scenario "Vial Smasher pings when an outlaw enters" {
  battlefield A: "Vial Smasher, Gleeful Grenadier", "Mountain"
  hand A: "Ali Baba"
  start turn 1 A precombat_main
  turn 1 A: cast "Ali Baba"
  run_to turn 1 postcombat_main
  assert life B 19
}

scenario "Vial Smasher ignores non-outlaws" {
  battlefield A: "Vial Smasher, Gleeful Grenadier", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
}

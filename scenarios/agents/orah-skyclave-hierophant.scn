scenario "Orah dies and returns a lesser Cleric" {
  battlefield A: "Orah, Skyclave Hierophant"
  graveyard A: "Abuna Acolyte", "Heliod's Pilgrim"
  battlefield B: "Swamp", "Swamp", "Swamp"
  hand B: "Murder"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Orah, Skyclave Hierophant"
  turn 2 A: trigger "Orah, Skyclave Hierophant" targeting "Abuna Acolyte"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Orah, Skyclave Hierophant"
  assert battlefield A contains "Abuna Acolyte"
  assert graveyard A contains "Heliod's Pilgrim"
}

scenario "Another Cleric dies" {
  battlefield A: "Orah, Skyclave Hierophant", "Heliod's Pilgrim"
  graveyard A: "Abuna Acolyte"
  battlefield B: "Swamp", "Swamp", "Swamp"
  hand B: "Murder"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Heliod's Pilgrim"
  turn 2 A: trigger "Orah, Skyclave Hierophant" targeting "Abuna Acolyte"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Orah, Skyclave Hierophant"
  assert battlefield A contains "Abuna Acolyte"
}

scenario "Equal mana value is not returned" {
  battlefield A: "Orah, Skyclave Hierophant"
  graveyard A: "Orah, Skyclave Hierophant"
  battlefield B: "Swamp", "Swamp", "Swamp"
  hand B: "Murder"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Orah, Skyclave Hierophant"
  run_to turn 2 postcombat_main
  assert graveyard A contains 2 "Orah, Skyclave Hierophant"
}

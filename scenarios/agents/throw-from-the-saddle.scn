scenario "throw from the saddle: +1/+1 until end of turn, then deals damage equal to its power" {
  battlefield A: "Grizzly Bears", 2 "Forest"
  battlefield B: "Hill Giant"
  hand A: "Throw from the Saddle"
  turn 1 A: cast "Throw from the Saddle" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 begin_combat
  assert power "Grizzly Bears" 3
  assert counters "Grizzly Bears" +1/+1 0
  assert graveyard B contains "Hill Giant"
  assert damage "Grizzly Bears" 0
  run_to turn 2 upkeep
  assert power "Grizzly Bears" 2
}

scenario "throw from the saddle: a Mount gets a +1/+1 counter instead" {
  battlefield A: "Gloryheath Lynx", 2 "Forest"
  battlefield B: "Serra Angel"
  hand A: "Throw from the Saddle"
  turn 1 A: cast "Throw from the Saddle" targeting "Gloryheath Lynx", "Serra Angel"
  run_to turn 1 begin_combat
  assert counters "Gloryheath Lynx" +1/+1 1
  assert power "Gloryheath Lynx" 3
  assert damage "Serra Angel" 3
  run_to turn 2 upkeep
  assert power "Gloryheath Lynx" 3
}

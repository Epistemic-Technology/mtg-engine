scenario "crystal's chosen makes four heroes and counters everything" {
  battlefield A: 7 "Plains", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "The Crystal's Chosen"
  turn 1 A: cast "The Crystal's Chosen"
  run_to turn 1 postcombat_main
  assert battlefield A contains 4 "Hero"
  assert power newest A "Hero" 2
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 0
}

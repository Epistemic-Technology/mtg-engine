scenario "Ghalta costs X less where X is the greatest power among your creatures" {
  battlefield A: "Hill Giant", "Grizzly Bears", 6 "Forest"
  hand A: "Ghalta the Unstoppable"
  start turn 1 A precombat_main
  turn 1 A: cast "Ghalta the Unstoppable"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Ghalta the Unstoppable"
  assert has "Ghalta the Unstoppable" trample
  assert has "Hill Giant" trample
  assert has "Grizzly Bears" trample
}

scenario "Ghalta's reduction is only the greatest power, not the total" {
  battlefield A: "Hill Giant", "Grizzly Bears", 5 "Forest"
  hand A: "Ghalta the Unstoppable"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Ghalta the Unstoppable"
  run_to turn 1 postcombat_main
  assert hand A contains "Ghalta the Unstoppable"
}

scenario "Ghalta doesn't give trample to opponents' creatures" {
  battlefield A: "Ghalta the Unstoppable"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert has not B "Grizzly Bears" trample
}

scenario "shinka gatekeeper deals damage it is dealt to its controller" {
  battlefield A: "Shinka Gatekeeper"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Shinka Gatekeeper"
  run_to turn 2 postcombat_main
  assert life A 18
  assert graveyard A contains "Shinka Gatekeeper"
  assert life B 20
}

scenario "shinka gatekeeper blocked combat damage hurts its controller" {
  battlefield A: "Shinka Gatekeeper"
  battlefield B: "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Shinka Gatekeeper"
  turn 1 B: block "Shinka Gatekeeper" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 18
  assert life B 20
  assert graveyard B contains "Grizzly Bears"
}

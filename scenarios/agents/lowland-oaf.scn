scenario "Lowland Oaf pumps a Goblin, which is sacrificed at end step" {
  battlefield A: "Lowland Oaf", "Raging Goblin"
  start turn 2 A precombat_main
  turn 2 A: activate "Lowland Oaf" targeting "Raging Goblin"
  run_to turn 2 declare_attackers
  assert power "Raging Goblin" 2
  assert has "Raging Goblin" flying
  assert tapped "Lowland Oaf"
  run_to turn 3 upkeep
  assert graveyard A contains "Raging Goblin"
}

scenario "Lowland Oaf can't target a non-Goblin" {
  battlefield A: "Lowland Oaf", "Grizzly Bears"
  start turn 2 A precombat_main
  illegal turn 2 A: activate "Lowland Oaf" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert untapped "Lowland Oaf"
}

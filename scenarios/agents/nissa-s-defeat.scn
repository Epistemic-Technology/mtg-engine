scenario "nissa's defeat on a Nissa draws" {
  battlefield A: 3 "Forest"
  battlefield B: "Nissa, Vital Force"
  hand A: "Nissa's Defeat"
  library A: "Grizzly Bears", "Hill Giant"
  turn 1 A: cast "Nissa's Defeat" targeting "Nissa, Vital Force"
  run_to turn 1 postcombat_main
  assert battlefield B lacks "Nissa, Vital Force"
  assert hand A count 1
}
scenario "nissa's defeat on a Forest does not draw" {
  battlefield A: 3 "Forest"
  battlefield B: "Forest"
  hand A: "Nissa's Defeat"
  turn 1 A: cast "Nissa's Defeat" targeting B "Forest"
  run_to turn 1 postcombat_main
  assert battlefield B lacks "Forest"
  assert hand A count 0
}
scenario "nissa's defeat cannot target a non-green creature or a blue planeswalker" {
  battlefield A: 3 "Forest"
  battlefield B: "Hill Giant", "Jace Beleren"
  hand A: "Nissa's Defeat"
  illegal turn 1 A: cast "Nissa's Defeat" targeting "Hill Giant"
  illegal turn 1 A: cast "Nissa's Defeat" targeting "Jace Beleren"
  run_to turn 1 postcombat_main
}

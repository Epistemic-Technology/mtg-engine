scenario "Talas Explorer looks at target opponent's hand as it enters" {
  battlefield A: 2 "Island"
  hand A: "Talas Explorer"
  hand B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Talas Explorer"
  turn 1 A: trigger "Talas Explorer" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Talas Explorer"
  assert stack count 0
  assert hand B contains "Grizzly Bears"
}

scenario "Talas Explorer has flying" {
  battlefield A: "Talas Explorer"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert has "Talas Explorer" flying
}

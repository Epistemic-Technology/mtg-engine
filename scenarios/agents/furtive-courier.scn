scenario "Furtive Courier loots when it attacks and can be blocked normally" {
  battlefield A: "Furtive Courier"
  battlefield B: "Grizzly Bears"
  hand A: "Forest"
  library A: "Island", "Swamp"
  start turn 2 A precombat_main
  turn 2 A: attack "Furtive Courier"
  turn 2 declare_attackers A: discard "Forest"
  turn 2 B: block "Furtive Courier" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert hand A contains "Island"
  assert hand A count 1
  assert graveyard A contains "Forest"
  assert graveyard B contains "Grizzly Bears"
  assert life B 20
}

scenario "Furtive Courier can't be blocked after you sacrifice an artifact" {
  battlefield A: "Furtive Courier", "Mind Stone", "Plains"
  battlefield B: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: activate "Mind Stone"
  turn 2 A: attack "Furtive Courier"
  illegal turn 2 B: block "Furtive Courier" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Mind Stone"
  assert life B 17
}

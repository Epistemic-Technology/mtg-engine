scenario "deals 2 plus Lessons in graveyard" {
  hand A: "Combustion Technique"
  graveyard A: "Zuko's Exile", "Shared Roots", "Grizzly Bears"
  battlefield A: 2 "Mountain"
  battlefield B: "Acid Web Spider"
  start turn 1 A precombat_main
  turn 1 A: cast "Combustion Technique" targeting "Acid Web Spider"
  run_to turn 1 postcombat_main
  assert damage "Acid Web Spider" 4
  assert battlefield B contains "Acid Web Spider"
}

scenario "a creature it kills is exiled instead" {
  hand A: "Combustion Technique"
  battlefield A: 2 "Mountain"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Combustion Technique" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile B contains "Grizzly Bears"
  assert graveyard B lacks "Grizzly Bears"
}

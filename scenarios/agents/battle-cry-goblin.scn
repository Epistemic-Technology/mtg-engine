scenario "Battle Cry Goblin pumps Goblins" {
  battlefield A: "Battle Cry Goblin", "Mountain", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Battle Cry Goblin"
  run_to turn 1 begin_combat
  assert power "Battle Cry Goblin" 3
  assert has "Battle Cry Goblin" haste
}

scenario "Battle Cry Goblin pack tactics makes an attacking Goblin" {
  battlefield A: "Battle Cry Goblin", "Hill Giant", "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Battle Cry Goblin", "Hill Giant", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Goblin"
  assert life B 12
}

scenario "Battle Cry Goblin no token below six power" {
  battlefield A: "Battle Cry Goblin", "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Battle Cry Goblin", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Battle Cry Goblin"
  assert life B 16
}

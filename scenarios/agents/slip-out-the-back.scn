scenario "slip out the back counter and phase out" {
  battlefield A: "Grizzly Bears", "Island"
  hand A: "Slip Out the Back"
  turn 1 A: cast "Slip Out the Back" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Grizzly Bears"
  run_to turn 3 precombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
}

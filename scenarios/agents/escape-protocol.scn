scenario "escape protocol blinks a creature after cycling" {
  battlefield A: "Escape Protocol", "Grizzly Bears" with 2 +1/+1, 3 "Plains"
  hand A: "Angelsong"
  turn 1 A: activate "Angelsong"
  turn 1 A: trigger "Escape Protocol" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
  assert battlefield A contains "Grizzly Bears"
  assert hand A count 1
}
scenario "escape protocol declined" {
  battlefield A: "Escape Protocol", "Grizzly Bears" with 2 +1/+1, 3 "Plains"
  hand A: "Angelsong"
  turn 1 A: activate "Angelsong"
  turn 1 A: decline "Escape Protocol"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
}

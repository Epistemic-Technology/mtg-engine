scenario "Defend the Rider makes a permanent hexproof and indestructible" {
  battlefield A: "Grizzly Bears", "Forest", "Mountain"
  battlefield B: 3 "Swamp"
  hand A: "Defend the Rider", "Shock"
  hand B: "Murder"
  start turn 1 A precombat_main
  turn 1 A: cast "Defend the Rider" mode 1 targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting "Grizzly Bears"
  illegal turn 1 postcombat_main B: cast "Murder" targeting "Grizzly Bears"
  run_to turn 1 end
  assert battlefield A contains "Grizzly Bears"
  assert damage "Grizzly Bears" 2
  assert hand B contains "Murder"
}

scenario "Defend the Rider creates a Pilot" {
  battlefield A: "Forest"
  hand A: "Defend the Rider"
  start turn 1 A precombat_main
  turn 1 A: cast "Defend the Rider" mode 2
  run_to turn 1 postcombat_main
  assert battlefield A contains "Pilot"
  assert power "Pilot" 1
  assert toughness "Pilot" 1
}

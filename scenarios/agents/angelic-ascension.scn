scenario "angelic ascension exiles and gives its controller an angel" {
  battlefield A: 2 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Angelic Ascension"
  turn 1 A: cast "Angelic Ascension" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert battlefield B lacks "Hill Giant"
  assert battlefield B contains 1 "Angel"
  assert power "Angel" 4
  assert toughness "Angel" 4
  assert has "Angel" flying
  assert battlefield A lacks "Angel"
}

scenario "Boomerang Basics on your own permanent draws a card" {
  battlefield A: "Island", "Grizzly Bears"
  hand A: "Boomerang Basics"
  start turn 1 A precombat_main
  turn 1 A: cast "Boomerang Basics" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand A count 2
}

scenario "Boomerang Basics on an opponent's permanent doesn't draw" {
  battlefield A: "Island"
  battlefield B: "Hill Giant"
  hand A: "Boomerang Basics"
  start turn 1 A precombat_main
  turn 1 A: cast "Boomerang Basics" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand B contains "Hill Giant"
  assert hand A count 0
}

scenario "Boomerang Basics can't target a land" {
  battlefield A: "Island"
  battlefield B: "Forest"
  hand A: "Boomerang Basics"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Boomerang Basics" targeting "Forest"
  run_to turn 1 postcombat_main
}

scenario "Meriadoc Brandybuck makes a Food when Halflings attack" {
  battlefield A: "Meriadoc Brandybuck"
  start turn 1 A
  turn 1 A: attack "Meriadoc Brandybuck"
  run_to turn 1 postcombat_main
  assert battlefield A contains 1 "Food"
}

scenario "Meriadoc Brandybuck ignores non-Halflings" {
  battlefield A: "Meriadoc Brandybuck", "Grizzly Bears"
  start turn 1 A
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains 0 "Food"
}

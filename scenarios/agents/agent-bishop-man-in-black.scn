scenario "agent bishop: counters on two target creatures at beginning of combat" {
  battlefield A: "Agent Bishop, Man in Black", "Grizzly Bears"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Agent Bishop, Man in Black" targeting "Grizzly Bears", "Agent Bishop, Man in Black"
  run_to turn 1 declare_attackers
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Agent Bishop, Man in Black" +1/+1 1
  assert counters "Hill Giant" +1/+1 0
  assert power "Grizzly Bears" 3
}

scenario "agent bishop: one target, and not on the opponent's turn" {
  battlefield A: "Agent Bishop, Man in Black"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Agent Bishop, Man in Black" targeting "Hill Giant"
  run_to turn 2 declare_attackers
  assert counters "Hill Giant" +1/+1 1
  assert counters "Agent Bishop, Man in Black" +1/+1 0
}

scenario "Aid from the Cowl puts a revealed permanent onto the battlefield after revolt" {
  battlefield A: "Aid from the Cowl", "Ashnod's Altar", "Grizzly Bears"
  library A: "Hill Giant", "Forest"
  turn 1 precombat_main A: activate "Ashnod's Altar" sacrificing "Grizzly Bears"
  run_to turn 1 cleanup
  assert battlefield A contains "Hill Giant"
  assert graveyard A contains "Grizzly Bears"
}

scenario "Aid from the Cowl bottoms a revealed nonpermanent" {
  battlefield A: "Aid from the Cowl", "Ashnod's Altar", "Grizzly Bears"
  library A: "Lightning Bolt", "Forest"
  turn 1 precombat_main A: activate "Ashnod's Altar" sacrificing "Grizzly Bears"
  run_to turn 1 cleanup
  assert library A contains "Lightning Bolt"
  assert hand A count 0
  assert graveyard A lacks "Lightning Bolt"
}

scenario "Aid from the Cowl does nothing without revolt" {
  battlefield A: "Aid from the Cowl", "Grizzly Bears"
  library A: "Hill Giant", "Forest"
  run_to turn 1 cleanup
  assert battlefield A lacks "Hill Giant"
}

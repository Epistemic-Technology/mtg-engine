scenario "Psychic Strike counters a spell and its controller mills 2" {
  battlefield A: "Mountain"
  battlefield B: 2 "Island", "Swamp"
  hand A: "Lightning Bolt"
  hand B: "Psychic Strike"
  library A: "Plains", "Island", "Swamp", "Mountain", "Forest", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 B: cast "Psychic Strike" targeting "Lightning Bolt" in response to "Lightning Bolt"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Lightning Bolt"
  assert graveyard A count 3
  assert library A count 4
  assert graveyard B contains "Psychic Strike"
}

scenario "Psychic Strike has no spell to target on an empty stack" {
  battlefield B: 2 "Island", "Swamp"
  hand B: "Psychic Strike"
  start turn 1 B precombat_main
  illegal turn 1 B: cast "Psychic Strike" targeting auto
  run_to turn 1 postcombat_main
  assert hand B contains "Psychic Strike"
}

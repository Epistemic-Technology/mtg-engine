scenario "Serra Redeemer puts two counters on a small creature entering" {
  battlefield A: "Serra Redeemer", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
  assert power "Grizzly Bears" 4
  assert counters "Serra Redeemer" +1/+1 0
}

scenario "Serra Redeemer ignores a creature with power 3 or more" {
  battlefield A: "Serra Redeemer", 4 "Mountain"
  hand A: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Hill Giant" +1/+1 0
}

scenario "Serra Redeemer ignores an opponent's creature" {
  battlefield A: "Serra Redeemer"
  battlefield B: 2 "Forest"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
}

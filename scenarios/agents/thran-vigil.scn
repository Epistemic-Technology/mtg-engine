scenario "a creature card leaving the graveyard on your turn puts a counter on target creature" {
  battlefield A: "Thran Vigil", "Grizzly Bears", 4 "Forest"
  graveyard A: "Hill Giant"
  hand A: "Elven Cache"
  turn 1 A: cast "Elven Cache" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Hill Giant"
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "a land card leaving does nothing" {
  battlefield A: "Thran Vigil", "Grizzly Bears", 4 "Forest"
  graveyard A: "Island"
  hand A: "Elven Cache"
  turn 1 A: cast "Elven Cache" targeting "Island"
  run_to turn 1 postcombat_main
  assert hand A contains "Island"
  assert counters "Grizzly Bears" +1/+1 0
}

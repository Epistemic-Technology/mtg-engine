scenario "Paramecia Coloniex mills three on entering" {
  battlefield A: 2 "Swamp"
  hand A: "Paramecia Coloniex"
  library A: "Plains", "Island", "Forest", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: cast "Paramecia Coloniex"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Plains"
  assert graveyard A contains "Forest"
  assert library A contains "Mountain"
  assert library A lacks "Island"
}

scenario "Paramecia Coloniex dies, exiles itself, and stacks a creature card" {
  battlefield A: "Paramecia Coloniex", "Mountain"
  hand A: "Lightning Bolt"
  graveyard A: "Grizzly Bears"
  library A: "Plains", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Paramecia Coloniex"
  turn 1 A: trigger "Paramecia Coloniex" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile A contains "Paramecia Coloniex"
  assert graveyard A lacks "Grizzly Bears"
  run_to turn 3 precombat_main
  assert hand A contains "Grizzly Bears"
}

scenario "Paramecia Coloniex declined stays in the graveyard" {
  battlefield A: "Paramecia Coloniex", "Mountain"
  hand A: "Lightning Bolt"
  graveyard A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Paramecia Coloniex"
  turn 1 A: decline "Paramecia Coloniex"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Paramecia Coloniex"
  assert graveyard A contains "Grizzly Bears"
}

scenario "kami of terrible secrets: with an artifact and an enchantment, draw and gain 1" {
  battlefield A: 4 "Swamp", "Ornithopter", "Pacifism" on "Hill Giant"
  battlefield B: "Hill Giant"
  hand A: "Kami of Terrible Secrets"
  turn 1 A: cast "Kami of Terrible Secrets"
  run_to turn 1 postcombat_main
  assert life A 21
  assert hand A count 1
}

scenario "kami of terrible secrets: an artifact alone isn't enough" {
  battlefield A: 4 "Swamp", "Ornithopter"
  hand A: "Kami of Terrible Secrets"
  turn 1 A: cast "Kami of Terrible Secrets"
  run_to turn 1 postcombat_main
  assert life A 20
  assert hand A count 0
}

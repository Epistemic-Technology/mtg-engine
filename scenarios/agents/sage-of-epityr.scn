scenario "Sage of Epityr looks at the top four cards" {
  battlefield A: "Island"
  hand A: "Sage of Epityr"
  library A: "Forest", "Island", "Plains", "Swamp", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: cast "Sage of Epityr"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Sage of Epityr"
  assert library A count 5
  assert hand A count 0
}

scenario "Daru Spiritualist saves a targeted Cleric from Shock" {
  battlefield A: "Daru Spiritualist"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Daru Spiritualist"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Daru Spiritualist"
  assert toughness "Daru Spiritualist" 3
  assert damage "Daru Spiritualist" 2
}

scenario "Daru Spiritualist does not help non-Clerics" {
  battlefield A: "Daru Spiritualist", "Grizzly Bears"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert toughness "Daru Spiritualist" 1
}

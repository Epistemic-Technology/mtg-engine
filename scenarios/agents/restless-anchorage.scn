scenario "becomes a 2/3 flyer, attacks, makes a Map" {
  battlefield A: "Restless Anchorage", 2 "Plains", "Island"
  turn 1 precombat_main A: activate "Restless Anchorage" ability 2
  turn 1 declare_attackers A: attack "Restless Anchorage"
  run_to turn 1 postcombat_main
  assert is "Restless Anchorage" creature
  assert is "Restless Anchorage" land
  assert power "Restless Anchorage" 2
  assert toughness "Restless Anchorage" 3
  assert has "Restless Anchorage" flying
  assert is "Restless Anchorage" white
  assert is "Restless Anchorage" blue
  assert is "Restless Anchorage" "Bird"
  assert life B 18
  assert battlefield A contains 1 "Map"
}

scenario "Pest Problem makes two Rats that can't block, then the Trainee is cast from exile" {
  battlefield A: 5 "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Ratcatcher Trainee // Pest Problem"
  start turn 2 A precombat_main
  turn 2 A: cast "Pest Problem"
  turn 2 main2 A: cast "Ratcatcher Trainee"
  turn 3 B: attack "Grizzly Bears"
  illegal turn 3 A: block "Grizzly Bears" with "Rat"
  run_to turn 3 postcombat_main
  assert battlefield A contains 2 "Rat"
  assert battlefield A contains "Ratcatcher Trainee"
  assert life A 18
}

scenario "Ratcatcher Trainee has first strike during its controller's turn" {
  battlefield A: "Ratcatcher Trainee // Pest Problem"
  battlefield B: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Ratcatcher Trainee"
  turn 2 B: block "Ratcatcher Trainee" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Ratcatcher Trainee"
  assert graveyard B contains "Grizzly Bears"
}

scenario "Ratcatcher Trainee lacks first strike on the opponent's turn" {
  battlefield A: "Ratcatcher Trainee // Pest Problem"
  battlefield B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Ratcatcher Trainee"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Ratcatcher Trainee"
  assert graveyard B contains "Grizzly Bears"
}

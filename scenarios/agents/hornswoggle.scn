scenario "Hornswoggle counters a creature spell and makes a Treasure" {
  battlefield A: 3 "Island"
  hand A: "Hornswoggle"
  hand B: "Grizzly Bears"
  battlefield B: 2 "Forest"
  start turn 2 B precombat_main
  turn 2 precombat_main B: cast "Grizzly Bears"
  turn 2 precombat_main A: cast "Hornswoggle" targeting "Grizzly Bears" in response to "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert battlefield A contains "Treasure"
}
scenario "Hornswoggle cannot target a noncreature spell" {
  battlefield A: 3 "Island"
  hand A: "Hornswoggle"
  hand B: "Shock"
  battlefield B: "Mountain"
  start turn 2 B precombat_main
  turn 2 precombat_main B: cast "Shock" targeting player A
  illegal turn 2 precombat_main A: cast "Hornswoggle" targeting "Shock" in response to "Shock"
  run_to turn 2 postcombat_main
  assert life A 18
}

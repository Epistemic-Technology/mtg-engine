scenario "Countermand counters a spell and its controller mills 4" {
  battlefield A: "Mountain"
  battlefield B: 4 "Island"
  hand A: "Lightning Bolt"
  hand B: "Countermand"
  library A: "Plains", "Island", "Swamp", "Mountain", "Forest", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 B: cast "Countermand" targeting "Lightning Bolt" in response to "Lightning Bolt"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Lightning Bolt"
  assert graveyard A count 5
  assert library A count 2
  assert graveyard B contains "Countermand"
}

scenario "Countermand has no spell to target on an empty stack" {
  battlefield B: 4 "Island"
  hand B: "Countermand"
  start turn 1 B precombat_main
  illegal turn 1 B: cast "Countermand" targeting auto
  run_to turn 1 postcombat_main
  assert hand B contains "Countermand"
}

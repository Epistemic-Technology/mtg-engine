scenario "inspired: untapping and paying {2}{W} makes two Soldier enchantment creatures" {
  battlefield A: "God-Favored General" tapped, 3 "Plains"
  run_to turn 1 precombat_main
  assert battlefield A contains 2 "Soldier"
}

scenario "inspired: with no mana to pay, no tokens" {
  battlefield A: "God-Favored General" tapped
  run_to turn 1 precombat_main
  assert battlefield A contains 0 "Soldier"
}

scenario "Papercraft Decoy pays 2 to draw when it leaves" {
  battlefield A: "Papercraft Decoy", 3 "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Papercraft Decoy"
  turn 1 A: accept "Papercraft Decoy"
  run_to turn 1 postcombat_main
  assert hand A count 1
}

scenario "Papercraft Decoy declined draws nothing" {
  battlefield A: "Papercraft Decoy", 3 "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Papercraft Decoy"
  turn 1 A: decline "Papercraft Decoy"
  run_to turn 1 postcombat_main
  assert hand A count 0
}

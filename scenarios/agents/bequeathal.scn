scenario "Bequeathal draws two when enchanted creature dies" {
  battlefield A: "Grizzly Bears", "Bequeathal" on "Grizzly Bears", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Bequeathal"
  assert hand A count 2
}

scenario "Bequeathal on an opponent's creature draws for its controller" {
  battlefield A: "Mountain"
  battlefield B: "Grizzly Bears"
  battlefield A: "Bequeathal" on "Grizzly Bears"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert hand B count 0
}

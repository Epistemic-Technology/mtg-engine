scenario "prophet drains for the revealed card's mana value" {
  battlefield A: "Twilight Prophet", 9 "Forest"
  library A: "Hill Giant", "Plains", "Plains"
  start turn 2 B precombat_main
  run_to turn 3 postcombat_main
  assert hand A contains "Hill Giant"
  assert hand A count 2
  assert life B 16
  assert life A 24
}
scenario "no blessing no trigger" {
  battlefield A: "Twilight Prophet", 8 "Forest"
  library A: "Hill Giant", "Plains", "Plains"
  start turn 2 B precombat_main
  run_to turn 3 postcombat_main
  assert hand A count 1
  assert life B 20
  assert life A 20
}

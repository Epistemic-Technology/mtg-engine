scenario "verdant rebirth returns the dying creature to hand and draws" {
  battlefield A: "Grizzly Bears", "Forest", "Forest", "Mountain"
  hand A: "Verdant Rebirth", "Lightning Bolt"
  library A: "Island"
  turn 1 precombat_main A: cast "Verdant Rebirth" targeting "Grizzly Bears"
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A lacks "Grizzly Bears"
  assert hand A contains "Grizzly Bears"
  assert hand A contains "Island"
  assert hand A count 2
  assert graveyard A contains "Verdant Rebirth"
}
scenario "without rebirth the creature stays dead" {
  battlefield A: "Grizzly Bears", "Mountain"
  hand A: "Lightning Bolt"
  turn 1 precombat_main A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
}

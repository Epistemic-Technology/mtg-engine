scenario "Virtue of Courage exiles that many cards and they can be played" {
  battlefield A: "Virtue of Courage", 2 "Mountain"
  hand A: "Shock"
  library A: "Forest", "Hill Giant", "Plains"
  turn 1 precombat_main A: cast "Shock" targeting player B
  turn 1 precombat_main A: play "Forest"
  run_to turn 1 postcombat_main
  assert life B 18
  assert exile A contains "Hill Giant"
  assert battlefield A contains "Forest"
  assert library A lacks "Hill Giant"
  assert library A lacks "Forest"
  assert library A contains "Plains"
}

scenario "Virtue of Courage does not trigger on combat damage and Embereth Blaze is an adventure" {
  battlefield A: "Virtue of Courage", "Grizzly Bears", 2 "Mountain"
  hand A: "Virtue of Courage // Embereth Blaze"
  library A: "Forest", "Hill Giant", "Plains"
  turn 1 declare_attackers A: attack "Grizzly Bears"
  turn 1 postcombat_main A: cast "Embereth Blaze" targeting player B
  run_to turn 1 end
  assert life B 16
  assert exile A contains "Virtue of Courage"
  assert exile A contains "Forest"
  assert exile A contains "Hill Giant"
  assert library A contains "Plains"
}

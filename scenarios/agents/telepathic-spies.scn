scenario "Telepathic Spies looks at target opponent's hand as it enters" {
  battlefield A: 3 "Island"
  hand A: "Telepathic Spies"
  hand B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Telepathic Spies"
  turn 1 A: trigger "Telepathic Spies" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Telepathic Spies"
  assert stack count 0
  assert hand B contains "Grizzly Bears"
}

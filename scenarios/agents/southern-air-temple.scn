scenario "Southern Air Temple counts Shrines as it enters" {
  battlefield A: "Grizzly Bears", "Honden of Seeing Winds", 4 "Plains"
  hand A: "Southern Air Temple"
  start turn 1 A precombat_main
  turn 1 A: cast "Southern Air Temple"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
  assert power "Grizzly Bears" 4
}

scenario "Southern Air Temple grows the team when another Shrine enters" {
  battlefield A: "Grizzly Bears", "Southern Air Temple", 6 "Island"
  hand A: "Honden of Seeing Winds"
  start turn 1 A precombat_main
  turn 1 A: cast "Honden of Seeing Winds"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Terrific Team-Up: two creatures each get +1/+0 and deal damage; costs {2} less with a mana value 4 permanent" {
  battlefield A: "Grizzly Bears", "Hill Giant", 2 "Forest"
  battlefield B: "Serra Angel"
  hand A: "Terrific Team-Up"
  start turn 1 A precombat_main
  turn 1 A: cast "Terrific Team-Up" targeting "Serra Angel", "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert power "Grizzly Bears" 3
  assert power "Hill Giant" 4
  assert toughness "Hill Giant" 3
}

scenario "Terrific Team-Up: one creature deals damage equal to its boosted power" {
  battlefield A: "Grizzly Bears", 4 "Forest"
  battlefield B: "Serra Angel"
  hand A: "Terrific Team-Up"
  start turn 1 A precombat_main
  turn 1 A: cast "Terrific Team-Up" targeting "Serra Angel", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Serra Angel"
  assert damage "Serra Angel" 3
  assert damage "Grizzly Bears" 0
}

scenario "Terrific Team-Up: full cost without a mana value 4 permanent" {
  battlefield A: "Grizzly Bears", 2 "Forest"
  battlefield B: "Serra Angel"
  hand A: "Terrific Team-Up"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Terrific Team-Up" targeting "Serra Angel", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Terrific Team-Up"
}

scenario "orb of dreams makes all permanents enter tapped" {
  battlefield A: "Orb of Dreams", "Forest"
  hand A: "Forest", "Grizzly Bears"
  hand B: "Island"
  turn 1 precombat_main A: play "Forest"
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Forest"
  assert tapped newest A "Forest"
}
scenario "orb of dreams taps opponent permanents" {
  battlefield A: "Orb of Dreams"
  hand B: "Island"
  start turn 2 B precombat_main
  turn 2 precombat_main B: play "Island"
  run_to turn 2 postcombat_main
  assert tapped "Island"
}

scenario "Redrock Sentinel sacrifices a land to draw and make a Treasure" {
  battlefield A: "Redrock Sentinel", 2 "Plains", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Redrock Sentinel" sacrificing "Forest"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Forest"
  assert hand A count 1
  assert battlefield A contains "Treasure"
  assert tapped "Redrock Sentinel"
}

scenario "Redrock Sentinel has defender" {
  battlefield A: "Redrock Sentinel"
  start turn 1 A precombat_main
  illegal turn 1 A: attack "Redrock Sentinel"
  run_to turn 1 postcombat_main
  assert life B 20
}

scenario "dies gives opponent two treasures" {
  battlefield A: "Wanted Scoundrels", 2 "Mountain"
  hand A: "Lightning Bolt"
  turn 1 precombat_main A: cast "Lightning Bolt" targeting "Wanted Scoundrels"
  turn 1 precombat_main A: trigger "Wanted Scoundrels" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard A contains "Wanted Scoundrels"
  assert battlefield B contains 2 "Treasure"
  assert battlefield A lacks "Treasure"
}

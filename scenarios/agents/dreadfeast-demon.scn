scenario "end step: sacrifice a non-Demon, then a token copy of the Demon" {
  battlefield A: "Dreadfeast Demon", "Grizzly Bears"
  start turn 1 A
  run_to turn 1 cleanup
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains 2 "Dreadfeast Demon"
}

scenario "no non-Demon creature to sacrifice: no copy" {
  battlefield A: "Dreadfeast Demon"
  start turn 1 A
  run_to turn 1 cleanup
  assert battlefield A contains 1 "Dreadfeast Demon"
}

scenario "a second Demon is not a legal sacrifice" {
  battlefield A: "Dreadfeast Demon", "Dreadfeast Demon"
  start turn 1 A
  run_to turn 1 cleanup
  assert battlefield A contains 2 "Dreadfeast Demon"
  assert graveyard A count 0
}

scenario "glorious sunrise pump mode" {
  battlefield A: "Glorious Sunrise", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Glorious Sunrise" mode 1
  run_to turn 1 declare_attackers
  assert power "Grizzly Bears" 3
  assert has "Grizzly Bears" trample
}
scenario "glorious sunrise mana mode" {
  battlefield A: "Glorious Sunrise", "Forest"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Glorious Sunrise" mode 2 targeting "Forest"
  run_to turn 1 declare_attackers
  assert untapped "Forest"
  assert stack count 0
}
scenario "glorious sunrise draw mode with big creature" {
  battlefield A: "Glorious Sunrise", "Hill Giant"
  library A: "Island", "Island", "Island"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Glorious Sunrise" mode 3
  run_to turn 1 declare_attackers
  assert hand A count 1
}
scenario "glorious sunrise draw mode without big creature" {
  battlefield A: "Glorious Sunrise", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Glorious Sunrise" mode 3
  run_to turn 1 declare_attackers
  assert hand A count 0
}
scenario "glorious sunrise life mode" {
  battlefield A: "Glorious Sunrise"
  start turn 1 A precombat_main
  turn 1 begin_combat A: trigger "Glorious Sunrise" mode 4
  run_to turn 1 declare_attackers
  assert life A 23
}

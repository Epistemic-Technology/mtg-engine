scenario "shell exiles a spell that targets you then casts it free" {
  battlefield A: "Shell of the Last Kappa", 6 "Plains"
  hand B: "Lightning Bolt"
  battlefield B: "Mountain"
  start turn 2 B
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: activate "Shell of the Last Kappa" ability 1 targeting "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert life A 20
  assert exile B contains "Lightning Bolt"
  assert graveyard B lacks "Lightning Bolt"
  turn 3 A: activate "Shell of the Last Kappa" ability 2
  turn 3 A: wait
  turn 3 A: cast "Lightning Bolt" targeting player B
  run_to turn 3 postcombat_main
  assert life B 17
  assert graveyard A contains "Shell of the Last Kappa"
  assert exile B lacks "Lightning Bolt"
}
scenario "shell cannot exile a spell that does not target you" {
  battlefield A: "Shell of the Last Kappa", 3 "Plains", "Grizzly Bears"
  hand B: "Lightning Bolt"
  battlefield B: "Mountain"
  start turn 2 B
  turn 2 B: cast "Lightning Bolt" targeting "Grizzly Bears"
  illegal turn 2 A: activate "Shell of the Last Kappa" ability 1 targeting "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grizzly Bears"
}

scenario "Dragon Mage: combat damage makes each player discard their hand and draw seven" {
  battlefield A: "Dragon Mage"
  hand A: "Shock", "Murder"
  hand B: "Lightning Bolt", "Giant Growth", "Divination"
  start turn 3 A precombat_main
  turn 3 A: attack "Dragon Mage"
  run_to turn 3 postcombat_main
  assert life B 15
  assert hand A count 7
  assert hand B count 7
  assert graveyard A contains "Shock"
  assert graveyard A contains "Murder"
  assert graveyard B contains "Lightning Bolt"
  assert graveyard B contains "Divination"
  assert hand A lacks "Shock"
}

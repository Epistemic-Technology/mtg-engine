scenario "waste not creature and land discards" {
  battlefield A: "Waste Not", 3 "Swamp"
  hand A: "Mind Rot"
  hand B: "Grizzly Bears", "Forest"
  turn 1 precombat_main A: cast "Mind Rot" targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert graveyard B contains "Forest"
  assert battlefield A contains 1 "Zombie"
  assert hand A count 0
}
scenario "waste not noncreature nonland discards draw" {
  battlefield A: "Waste Not", 3 "Swamp"
  hand A: "Mind Rot"
  hand B: "Shock", "Giant Growth"
  turn 1 precombat_main A: cast "Mind Rot" targeting player B
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert battlefield A lacks "Zombie"
}

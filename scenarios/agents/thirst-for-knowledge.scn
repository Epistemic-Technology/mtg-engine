scenario "discard one artifact card" {
  battlefield A: 3 "Island"
  hand A: "Thirst for Knowledge"
  library A: "Ornithopter", "Forest", "Plains", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: cast "Thirst for Knowledge"
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert graveyard A contains "Ornithopter"
  assert hand A contains "Forest"
  assert hand A contains "Plains"
}

scenario "no artifact: discard two" {
  battlefield A: 3 "Island"
  hand A: "Thirst for Knowledge"
  library A: "Grizzly Bears", "Forest", "Plains", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: cast "Thirst for Knowledge"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert library A count 1
}

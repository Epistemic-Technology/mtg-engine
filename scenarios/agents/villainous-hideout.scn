scenario "colored mana casts a Villain spell" {
  battlefield A: "Villainous Hideout", "Plains"
  hand A: "Common Crook"
  start turn 1 A precombat_main
  turn 1 A: cast "Common Crook"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Common Crook"
}

scenario "colored mana can't cast a non-Villain spell" {
  battlefield A: "Villainous Hideout", "Plains"
  hand A: "Llanowar Elves"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Llanowar Elves"
  run_to turn 1 postcombat_main
  assert hand A contains "Llanowar Elves"
}

scenario "target Villain connives at sorcery speed" {
  battlefield A: "Villainous Hideout", 3 "Plains", "Common Crook"
  library A: "Grizzly Bears", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Villainous Hideout" targeting "Common Crook"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert counters "Common Crook" +1/+1 1
  assert tapped "Villainous Hideout"
}

scenario "connive can't target a non-Villain" {
  battlefield A: "Villainous Hideout", 3 "Plains", "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Villainous Hideout" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A count 0
}

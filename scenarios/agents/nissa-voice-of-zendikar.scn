scenario "Nissa plus makes a Plant" {
  battlefield A: "Nissa, Voice of Zendikar"
  start turn 1 A precombat_main
  turn 1 A: activate "Nissa, Voice of Zendikar" ability 1
  run_to turn 1 begin_combat
  assert battlefield A contains "Plant"
  assert counters "Nissa, Voice of Zendikar" loyalty 4
}

scenario "Nissa minus two pumps each creature" {
  battlefield A: "Nissa, Voice of Zendikar", "Grizzly Bears", "Hill Giant"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: activate "Nissa, Voice of Zendikar" ability 2
  run_to turn 1 begin_combat
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 1
  assert counters "Serra Angel" +1/+1 0
  assert counters "Nissa, Voice of Zendikar" loyalty 1
}

scenario "Nissa ultimate gains and draws lands-many" {
  battlefield A: "Nissa, Voice of Zendikar" with 7 loyalty, "Forest", "Forest", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Nissa, Voice of Zendikar" ability 3
  run_to turn 1 begin_combat
  assert life A 23
  assert hand A count 3
}

scenario "Starfield Shepherd warped finds a one-drop creature, then is exiled" {
  battlefield A: 2 "Plains"
  hand A: "Starfield Shepherd"
  library A: "Hill Giant", "Savannah Lions", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Starfield Shepherd" warped
  run_to turn 1 postcombat_main
  assert battlefield A contains "Starfield Shepherd"
  assert hand A contains "Savannah Lions"
  assert library A contains "Hill Giant"
  run_to turn 2 upkeep
  assert exile A contains "Starfield Shepherd"
}

scenario "Starfield Shepherd can't find a big creature" {
  battlefield A: 2 "Plains"
  hand A: "Starfield Shepherd"
  library A: "Hill Giant", "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Starfield Shepherd" warped
  run_to turn 1 postcombat_main
  assert library A contains "Hill Giant"
  assert hand A count 0
}

scenario "Starfield Shepherd finds a basic Plains" {
  battlefield A: 5 "Plains"
  hand A: "Starfield Shepherd"
  library A: "Island", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Starfield Shepherd"
  run_to turn 1 postcombat_main
  assert hand A contains "Plains"
  assert library A contains "Island"
}

scenario "Eriette's Tempting Apple steals, untaps, and hastes a creature" {
  battlefield A: 4 "Plains"
  battlefield B: "Hill Giant" tapped
  hand A: "Eriette's Tempting Apple"
  start turn 1 A precombat_main
  turn 1 A: cast "Eriette's Tempting Apple"
  turn 1 A: trigger "Eriette's Tempting Apple" targeting "Hill Giant"
  turn 1 A: attack "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 17
  assert battlefield A contains "Hill Giant"
  run_to turn 2 upkeep
  assert battlefield B contains "Hill Giant"
}

scenario "Eriette's Tempting Apple sacrifices for 3 life" {
  battlefield A: "Eriette's Tempting Apple", 2 "Plains"
  life A 10
  start turn 1 A precombat_main
  turn 1 A: activate "Eriette's Tempting Apple" ability 1
  run_to turn 1 postcombat_main
  assert life A 13
  assert graveyard A contains "Eriette's Tempting Apple"
}

scenario "Eriette's Tempting Apple sacrifices to drain an opponent" {
  battlefield A: "Eriette's Tempting Apple", 2 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Eriette's Tempting Apple" ability 2 targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert life A 20
  assert graveyard A contains "Eriette's Tempting Apple"
}

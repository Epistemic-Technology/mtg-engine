scenario "Blood Clock: pay life or return a permanent, for the active player" {
  battlefield A: "Blood Clock"
  battlefield B: "Grizzly Bears"
  start turn 2 B upkeep
  turn 2 upkeep B: decline "Blood Clock"
  run_to turn 2 precombat_main
  assert hand B count 2
  assert life B 20
  assert not game_over
}
scenario "Blood Clock: paying 2 life keeps the permanent" {
  battlefield A: "Blood Clock"
  battlefield B: "Grizzly Bears"
  start turn 2 B upkeep
  turn 2 upkeep B: accept "Blood Clock"
  run_to turn 2 precombat_main
  assert life B 18
  assert battlefield B contains "Grizzly Bears"
}

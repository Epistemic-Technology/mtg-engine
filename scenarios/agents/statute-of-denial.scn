scenario "statute of denial without a blue creature only counters" {
  battlefield A: 4 "Island"
  battlefield B: "Mountain"
  hand A: "Statute of Denial", "Forest"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting player A
  turn 2 A: cast "Statute of Denial" targeting "Lightning Bolt"
  run_to turn 2 postcombat_main
  assert life A 20
  assert hand A contains "Forest"
  assert hand A count 1
}

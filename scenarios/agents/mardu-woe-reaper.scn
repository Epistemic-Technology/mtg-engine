scenario "woe-reaper exiles on own entry and gains 1" {
  battlefield A: "Plains"
  hand A: "Mardu Woe-Reaper"
  graveyard B: "Grizzly Bears"
  turn 1 A: cast "Mardu Woe-Reaper"
  turn 1 A: trigger "Mardu Woe-Reaper" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 21
  assert graveyard B lacks "Grizzly Bears"
  assert exile B contains "Grizzly Bears"
}
scenario "woe-reaper does not trigger for a non-warrior" {
  battlefield A: "Mardu Woe-Reaper", "Forest", "Forest"
  hand A: "Grizzly Bears"
  graveyard B: "Hill Giant"
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 20
  assert graveyard B contains "Hill Giant"
}
scenario "woe-reaper triggers for another warrior" {
  battlefield A: "Mardu Woe-Reaper", "Plains"
  hand A: "Mardu Woe-Reaper"
  graveyard B: "Hill Giant", "Serra Angel"
  turn 1 A: cast "Mardu Woe-Reaper"
  turn 1 A: trigger "Mardu Woe-Reaper" targeting "Hill Giant"
  turn 1 A: trigger "Mardu Woe-Reaper" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert life A 22
  assert exile B contains "Hill Giant"
  assert exile B contains "Serra Angel"
}

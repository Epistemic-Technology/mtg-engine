scenario "Bramblewood Paragon: another Warrior enters with a +1/+1 counter and has trample" {
  battlefield A: "Bramblewood Paragon", 3 "Mountain"
  hand A: "Academy Raider"
  turn 1 A: cast "Academy Raider"
  run_to turn 1 end
  assert counters "Academy Raider" +1/+1 1
  assert power "Academy Raider" 2
  assert has "Academy Raider" trample
  assert has not "Bramblewood Paragon" trample
}

scenario "Bramblewood Paragon: a non-Warrior enters without a counter" {
  battlefield A: "Bramblewood Paragon", 2 "Forest"
  hand A: "Grizzly Bears"
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 end
  assert counters "Grizzly Bears" +1/+1 0
  assert has not "Grizzly Bears" trample
}

scenario "Lat-Nam Adept: second card drawn in a turn adds a counter, only once" {
  battlefield A: "Lat-Nam Adept", 3 "Island"
  hand A: "Divination"
  start turn 3 A
  turn 3 A: cast "Divination"
  run_to turn 3 postcombat_main
  assert hand A count 3
  assert counters "Lat-Nam Adept" +1/+1 1
}

scenario "Lat-Nam Adept: a single draw does not trigger" {
  battlefield A: "Lat-Nam Adept", 3 "Island"
  start turn 3 A
  run_to turn 3 postcombat_main
  assert hand A count 1
  assert counters "Lat-Nam Adept" +1/+1 0
}

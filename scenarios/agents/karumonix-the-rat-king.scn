scenario "enters finds rats" {
  hand A: "Karumonix, the Rat King"
  battlefield A: 3 "Swamp"
  library A: "Forest", "Bog Rats", "Island", "Burglar Rat", "Plains", "Mountain"
  start turn 1 A precombat_main
  turn 1 precombat_main A: cast "Karumonix, the Rat King"
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert hand A contains "Bog Rats"
  assert hand A contains "Burglar Rat"
}
scenario "other rats have toxic" {
  battlefield A: "Karumonix, the Rat King", "Bog Rats"
  start turn 1 A
  turn 1 declare_attackers A: attack "Bog Rats"
  run_to turn 1 postcombat_main
  assert poison B 1
}
scenario "karumonix itself deals toxic" {
  battlefield A: "Karumonix, the Rat King"
  start turn 1 A
  turn 1 declare_attackers A: attack "Karumonix, the Rat King"
  run_to turn 1 postcombat_main
  assert poison B 1
  assert life B 17
}

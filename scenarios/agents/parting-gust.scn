scenario "no gift: flicker, back with a +1/+1 counter at end step" {
  battlefield A: 2 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Parting Gust"
  start turn 1 A precombat_main
  turn 1 A: cast "Parting Gust" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert exile B contains "Grizzly Bears"
  run_to turn 2 upkeep
  assert battlefield B contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 1
  assert battlefield B lacks "Fish"
}

scenario "gift promised: opponent gets a tapped Fish, creature stays exiled" {
  battlefield A: 2 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Parting Gust"
  start turn 1 A precombat_main
  turn 1 A: cast "Parting Gust" gift targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Fish"
  assert tapped "Fish"
  run_to turn 2 upkeep
  assert exile B contains "Grizzly Bears"
  assert battlefield B lacks "Grizzly Bears"
}

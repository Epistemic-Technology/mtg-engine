scenario "Stingerquill Charm mode 1: 3 damage to any target" {
  battlefield A: "Swamp", "Mountain"
  hand A: "Stingerquill Charm"
  turn 1 A: cast "Stingerquill Charm" mode 1 targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
}

scenario "Stingerquill Charm mode 2: first strike and deathtouch" {
  battlefield A: "Swamp", "Mountain", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Stingerquill Charm"
  turn 1 A: cast "Stingerquill Charm" mode 2 targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert battlefield A contains "Grizzly Bears"
  run_to turn 2 upkeep
  assert has not "Grizzly Bears" deathtouch
}

scenario "Stingerquill Charm mode 3: Cadet with haste attacks" {
  battlefield A: "Swamp", "Mountain"
  hand A: "Stingerquill Charm"
  turn 1 A: cast "Stingerquill Charm" mode 3
  turn 1 A: attack "Cadet"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Cadet"
  assert power "Cadet" 2
  assert life B 18
}

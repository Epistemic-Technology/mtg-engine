scenario "attack trigger flickers a creature, returning it tapped under its owner's control" {
  battlefield A: "The Mighty Thor, Jane Foster"
  battlefield B: "Grizzly Bears" with 2 +1/+1
  start turn 1 A precombat_main
  turn 1 A: attack "The Mighty Thor, Jane Foster"
  turn 1 declare_attackers A: trigger "The Mighty Thor, Jane Foster" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Grizzly Bears"
  assert tapped "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 0
  assert life B 17
}

scenario "an Equipment entering draws a card" {
  battlefield A: "The Mighty Thor, Jane Foster", "Plains"
  hand A: "Bonesplitter"
  start turn 1 A precombat_main
  turn 1 A: cast "Bonesplitter"
  run_to turn 1 postcombat_main
  assert hand A count 1
}

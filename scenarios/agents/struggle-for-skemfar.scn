scenario "Struggle for Skemfar puts a counter then fights" {
  battlefield A: "Hill Giant", 4 "Forest"
  battlefield B: "Grizzly Bears"
  hand A: "Struggle for Skemfar"
  start turn 2 A precombat_main
  turn 2 A: cast "Struggle for Skemfar" targeting "Hill Giant", "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert counters "Hill Giant" +1/+1 1
  assert power "Hill Giant" 4
  assert damage "Hill Giant" 2
  assert graveyard B contains "Grizzly Bears"
}

scenario "Struggle for Skemfar with no second target only adds the counter" {
  battlefield A: "Grizzly Bears", 4 "Forest"
  battlefield B: "Hill Giant"
  hand A: "Struggle for Skemfar"
  start turn 2 A precombat_main
  turn 2 A: cast "Struggle for Skemfar" targeting "Grizzly Bears", none
  run_to turn 2 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert damage "Grizzly Bears" 0
  assert damage "Hill Giant" 0
}

scenario "Struggle for Skemfar foretold and cast for {G}" {
  battlefield A: "Hill Giant", 2 "Forest"
  battlefield B: "Grizzly Bears"
  hand A: "Struggle for Skemfar"
  start turn 2 A precombat_main
  turn 2 A: foretell "Struggle for Skemfar"
  turn 4 A: cast "Struggle for Skemfar" targeting "Hill Giant", "Grizzly Bears"
  run_to turn 4 postcombat_main
  assert counters "Hill Giant" +1/+1 1
  assert graveyard B contains "Grizzly Bears"
  assert untapped newest A "Forest"
}

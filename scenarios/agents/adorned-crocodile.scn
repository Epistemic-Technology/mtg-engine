scenario "Adorned Crocodile leaves a Zombie Druid when it dies" {
  battlefield A: "Adorned Crocodile"
  battlefield B: "Mountain"
  hand B: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 B: cast "Lightning Bolt" targeting "Adorned Crocodile"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Adorned Crocodile"
  assert battlefield A contains "Zombie Druid"
  assert power "Zombie Druid" 2
}

scenario "Adorned Crocodile renews from the graveyard" {
  battlefield A: "Swamp", "Grizzly Bears"
  graveyard A: "Adorned Crocodile"
  start turn 1 A precombat_main
  turn 1 A: activate "Adorned Crocodile" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert exile A contains "Adorned Crocodile"
}

scenario "Adorned Crocodile renews only as a sorcery" {
  battlefield A: "Grizzly Bears"
  battlefield B: "Swamp"
  graveyard B: "Adorned Crocodile"
  start turn 1 A precombat_main
  illegal turn 1 precombat_main B: activate "Adorned Crocodile" targeting A "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Adorned Crocodile"
}

scenario "slivers are indestructible, others are not" {
  battlefield A: "Sliver Hivelord", "Muscle Sliver", "Grizzly Bears", 2 "Mountain"
  hand A: "Lightning Bolt", "Murder"
  turn 1 precombat_main A: cast "Lightning Bolt" targeting "Sliver Hivelord"
  run_to turn 1 combat_damage
  assert battlefield A contains "Sliver Hivelord"
  assert has "Muscle Sliver" indestructible
  assert has "Sliver Hivelord" indestructible
  assert has not "Grizzly Bears" indestructible
}

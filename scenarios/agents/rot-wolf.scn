scenario "rot wolf draws when a creature it damaged dies" {
  battlefield A: "Rot Wolf" with 1 +1/+1
  battlefield B: "Grizzly Bears"
  hand A: "Forest"
  library A: "Island", "Plains"
  start turn 1 A
  turn 1 A: attack "Rot Wolf"
  turn 1 B: block "Rot Wolf" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert battlefield A contains "Rot Wolf"
  assert hand A count 2
}
scenario "rot wolf no draw when other creature dies" {
  battlefield A: "Rot Wolf", "Hill Giant"
  battlefield B: "Grizzly Bears"
  hand A: "Lightning Bolt", "Mountain"
  battlefield A: "Mountain"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Grizzly Bears"
  assert hand A count 1
}

scenario "Chart a Course draws two and discards one without attacking" {
  battlefield A: 2 "Island"
  hand A: "Chart a Course"
  library A: "Hill Giant", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Chart a Course"
  turn 1 precombat_main A: discard "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert hand A contains "Forest"
  assert graveyard A contains "Hill Giant"
}

scenario "Chart a Course keeps both cards after attacking" {
  battlefield A: 2 "Island", "Grizzly Bears"
  hand A: "Chart a Course"
  library A: "Hill Giant", "Forest"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 postcombat_main A: cast "Chart a Course"
  run_to turn 1 end
  assert hand A count 2
  assert life B 18
}

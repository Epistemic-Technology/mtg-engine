scenario "argent mutation makes a creature an artifact and draws" {
  battlefield A: "Island", 2 "Plains"
  battlefield B: "Hill Giant"
  hand A: "Argent Mutation"
  turn 1 precombat_main A: cast "Argent Mutation" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert is "Hill Giant" artifact
  assert is "Hill Giant" creature
  assert hand A count 1
  run_to turn 2 upkeep
  assert is not "Hill Giant" artifact
}

scenario "Wall of Vapor takes no damage from the creature it blocks" {
  battlefield A: "Wall of Vapor"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Wall of Vapor"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Wall of Vapor"
  assert damage "Wall of Vapor" 0
  assert life A 20
}

scenario "Wall of Vapor still dies to a spell while blocking" {
  battlefield A: "Wall of Vapor"
  battlefield B: "Hill Giant", "Mountain"
  hand B: "Shock"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Wall of Vapor"
  turn 2 declare_blockers B: cast "Shock" targeting "Wall of Vapor"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Wall of Vapor"
}

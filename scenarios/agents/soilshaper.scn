scenario "spirit spell animates a land" {
  battlefield A: "Soilshaper", 3 "Swamp"
  battlefield B: "Plains"
  hand A: "Kami of the Waning Moon"
  turn 1 precombat_main A: cast "Kami of the Waning Moon"
  turn 1 precombat_main A: trigger "Soilshaper" targeting B "Plains"
  run_to turn 1 begin_combat
  assert is "Plains" creature
  assert is "Plains" land
  assert power "Plains" 3
  assert toughness "Plains" 3
}
scenario "nonspirit spell does nothing" {
  battlefield A: "Soilshaper", "Forest", "Island"
  battlefield B: "Plains"
  hand A: "Grizzly Bears"
  turn 1 precombat_main A: cast "Grizzly Bears"
  run_to turn 1 begin_combat
  assert is not "Plains" creature
}

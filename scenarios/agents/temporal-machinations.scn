scenario "temporal machinations bounces and draws with an artifact" {
  battlefield A: 3 "Island", "Ornithopter"
  battlefield B: "Hill Giant"
  hand A: "Temporal Machinations"
  turn 1 A: cast "Temporal Machinations" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand B contains "Hill Giant"
  assert hand A count 1
}

scenario "temporal machinations bouncing your only artifact draws nothing" {
  battlefield A: 3 "Island", "Ornithopter"
  hand A: "Temporal Machinations"
  turn 1 A: cast "Temporal Machinations" targeting "Ornithopter"
  run_to turn 1 postcombat_main
  assert hand A contains "Ornithopter"
  assert hand A count 1
}

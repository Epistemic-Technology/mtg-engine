scenario "Suicidal Charge shrinks and forces opposing creatures to attack" {
  battlefield A: "Suicidal Charge"
  battlefield B: "Grizzly Bears", "Hill Giant"
  start turn 2 B upkeep
  turn 2 upkeep A: activate "Suicidal Charge"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Suicidal Charge"
  assert power "Grizzly Bears" 1
  assert power "Hill Giant" 2
  assert life A 17
  assert tapped "Grizzly Bears"
  assert tapped "Hill Giant"
}

scenario "Suicidal Charge gives only opposing creatures -1/-1" {
  battlefield A: "Suicidal Charge"
  battlefield B: "Grizzly Bears"
  battlefield B: "Wind Drake"
  start turn 1 A precombat_main
  turn 1 A: activate "Suicidal Charge"
  run_to turn 1 postcombat_main
  assert toughness "Grizzly Bears" 1
  assert toughness "Wind Drake" 1
}

scenario "Wharf Infiltrator loots and a discarded creature makes a Horror for {2}" {
  battlefield A: "Wharf Infiltrator", 2 "Island"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 declare_attackers A: attack "Wharf Infiltrator"
  turn 1 combat_damage A: discard "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 19
  assert graveyard A contains "Grizzly Bears"
  assert battlefield A contains "Eldrazi Horror"
  assert hand A count 1
}

scenario "Wharf Infiltrator: a noncreature discard makes no Horror" {
  battlefield A: "Wharf Infiltrator", 2 "Island"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 declare_attackers A: attack "Wharf Infiltrator"
  turn 1 combat_damage A: discard "Shock"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Shock"
  assert battlefield A lacks "Eldrazi Horror"
}

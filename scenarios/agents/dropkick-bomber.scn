scenario "lord bonus; the bombed Goblin flies, hits, and is sacrificed" {
  battlefield A: "Dropkick Bomber", "Mons's Goblin Raiders", "Mountain"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Dropkick Bomber" targeting "Mons's Goblin Raiders"
  turn 1 A: attack "Mons's Goblin Raiders"
  run_to turn 1 declare_blockers
  assert power "Mons's Goblin Raiders" 2
  assert has "Mons's Goblin Raiders" flying
  assert power "Dropkick Bomber" 2
  run_to turn 1 postcombat_main
  assert life B 18
  assert graveyard A contains "Mons's Goblin Raiders"
  assert battlefield A contains "Dropkick Bomber"
}

scenario "can't target itself" {
  battlefield A: "Dropkick Bomber", "Mountain"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Dropkick Bomber" targeting "Dropkick Bomber"
  run_to turn 1 postcombat_main
  assert has not "Dropkick Bomber" flying
}

scenario "the granted ability ends with the turn" {
  battlefield A: "Dropkick Bomber", "Mons's Goblin Raiders", "Mountain"
  start turn 1 A precombat_main
  turn 1 A: activate "Dropkick Bomber" targeting "Mons's Goblin Raiders"
  run_to turn 3 precombat_main
  turn 3 A: attack "Mons's Goblin Raiders"
  run_to turn 3 postcombat_main
  assert life B 18
  assert battlefield A contains "Mons's Goblin Raiders"
  assert has not "Mons's Goblin Raiders" flying
}

scenario "go ninja go mode 1: blink a creature you control" {
  battlefield A: "Grizzly Bears" with 2 +1/+1, "Mountain", "Plains"
  hand A: "Go Ninja Go"
  turn 1 A: cast "Go Ninja Go" mode 1 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 0
  assert power "Grizzly Bears" 2
}

scenario "go ninja go mode 2: damage equal to greatest power among your creatures" {
  battlefield A: "Hill Giant", "Grizzly Bears", "Mountain", "Plains"
  battlefield B: "Serra Angel"
  hand A: "Go Ninja Go"
  turn 1 A: cast "Go Ninja Go" mode 2 targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert damage "Serra Angel" 3
  assert battlefield B contains "Serra Angel"
}

scenario "go ninja go both modes" {
  battlefield A: "Grizzly Bears" with 1 +1/+1, "Mountain", "Plains"
  battlefield B: "Hill Giant"
  hand A: "Go Ninja Go"
  turn 1 A: cast "Go Ninja Go" mode 3 targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
  assert damage "Hill Giant" 2
}

scenario "April draws as many cards as the combat damage, then discards one" {
  battlefield A: "April, Reporter of the Weird"
  library A: "Island", "Forest", "Mountain", "Swamp"
  start turn 2 A precombat_main
  turn 2 A: attack "April, Reporter of the Weird"
  run_to turn 2 postcombat_main
  assert life B 18
  assert hand A count 1
  assert graveyard A count 1
  assert library A count 2
}

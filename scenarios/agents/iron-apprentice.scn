scenario "iron apprentice moves its counters when it dies" {
  battlefield A: "Iron Apprentice" with 2 +1/+1
  battlefield B: "Mountain"
  battlefield A: "Grizzly Bears"
  hand B: "Lightning Bolt"
  start turn 2 B precombat_main
  turn 2 B: cast "Lightning Bolt" targeting "Iron Apprentice"
  turn 2 A: trigger "Iron Apprentice" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Iron Apprentice"
  assert counters "Grizzly Bears" +1/+1 2
  assert power "Grizzly Bears" 4
}
scenario "iron apprentice enters with a counter" {
  battlefield A: "Mountain"
  hand A: "Iron Apprentice"
  battlefield A: "Island"
  turn 1 A: cast "Iron Apprentice"
  run_to turn 1 postcombat_main
  assert counters "Iron Apprentice" +1/+1 1
  assert power "Iron Apprentice" 1
}

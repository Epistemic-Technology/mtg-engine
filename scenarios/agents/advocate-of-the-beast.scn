scenario "Advocate of the Beast puts a counter on a Beast you control at your end step" {
  battlefield A: "Advocate of the Beast", "Axebane Beast"
  start turn 1 A precombat_main
  run_to turn 2 untap
  assert counters "Axebane Beast" +1/+1 1
  assert power "Axebane Beast" 4
  assert counters "Advocate of the Beast" +1/+1 0
}

scenario "Advocate of the Beast cannot target an opponent's Beast" {
  battlefield A: "Advocate of the Beast"
  battlefield B: "Axebane Beast"
  start turn 1 A precombat_main
  run_to turn 2 untap
  assert counters "Axebane Beast" +1/+1 0
}

scenario "Advocate of the Beast does nothing without a Beast" {
  battlefield A: "Advocate of the Beast", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 2 untap
  assert counters "Grizzly Bears" +1/+1 0
  assert counters "Advocate of the Beast" +1/+1 0
}

scenario "Orchard Spirit can't be blocked by a ground creature" {
  battlefield A: "Orchard Spirit"
  battlefield B: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Orchard Spirit"
  illegal turn 2 B: block "Orchard Spirit" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 18
}

scenario "Orchard Spirit can be blocked by a creature with reach" {
  battlefield A: "Orchard Spirit"
  battlefield B: "Giant Spider"
  start turn 2 A precombat_main
  turn 2 A: attack "Orchard Spirit"
  turn 2 B: block "Orchard Spirit" with "Giant Spider"
  run_to turn 2 postcombat_main
  assert life B 20
  assert graveyard A contains "Orchard Spirit"
}

scenario "Orchard Spirit can be blocked by a flier" {
  battlefield A: "Orchard Spirit"
  battlefield B: "Wind Drake"
  start turn 2 A precombat_main
  turn 2 A: attack "Orchard Spirit"
  turn 2 B: block "Orchard Spirit" with "Wind Drake"
  run_to turn 2 postcombat_main
  assert life B 20
}

scenario "Hostile Takeover shrinks one, grows another, then sweeps" {
  battlefield A: "Island", "Swamp", "Mountain", 2 "Plains", "Grizzly Bears"
  battlefield B: "Serra Angel"
  hand A: "Hostile Takeover"
  start turn 1 A precombat_main
  turn 1 precombat_main A: cast "Hostile Takeover" targeting "Serra Angel", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
  assert damage "Grizzly Bears" 3
}

scenario "Hostile Takeover with no targets still deals 3 to each creature" {
  battlefield A: "Island", "Swamp", "Mountain", 2 "Plains", "Grizzly Bears"
  hand A: "Hostile Takeover"
  start turn 1 A precombat_main
  turn 1 precombat_main A: cast "Hostile Takeover"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
}

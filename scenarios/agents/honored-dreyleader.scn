scenario "Honored Dreyleader enters with a counter per other Squirrel and Food" {
  battlefield A: "Grizzly Bears", "Food", "Squirrel Mob", 3 "Forest"
  battlefield B: "Squirrel Mob"
  hand A: "Honored Dreyleader"
  start turn 1 A precombat_main
  turn 1 A: cast "Honored Dreyleader"
  run_to turn 1 postcombat_main
  assert counters "Honored Dreyleader" +1/+1 2
  assert power "Honored Dreyleader" 3
  assert has "Honored Dreyleader" trample
}

scenario "Honored Dreyleader grows as another Squirrel and a Food enter" {
  battlefield A: "Honored Dreyleader", 2 "Forest"
  hand A: "Bakersbane Duo", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Bakersbane Duo"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Food"
  assert counters "Honored Dreyleader" +1/+1 2
  assert power "Honored Dreyleader" 3
}

scenario "Fynn gives two poison per deathtouch creature that deals combat damage to a player" {
  battlefield A: "Fynn, the Fangbearer", "Typhoid Rats", "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Fynn, the Fangbearer", "Typhoid Rats", "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 16
  assert poison B 4
}

scenario "Fynn ignores creatures without deathtouch" {
  battlefield A: "Fynn, the Fangbearer", "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 18
  assert poison B 0
}

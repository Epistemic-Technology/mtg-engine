scenario "valentin exiles and makes a pest when paid" {
  battlefield A: "Valentin, Dean of the Vein", 5 "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Murder"
  turn 1 precombat_main A: cast "Murder" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert graveyard B lacks "Hill Giant"
  assert battlefield A contains "Pest"
}
scenario "valentin without paying makes no pest" {
  battlefield A: "Valentin, Dean of the Vein", 3 "Swamp"
  battlefield B: "Hill Giant"
  hand A: "Murder"
  turn 1 precombat_main A: cast "Murder" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert exile B contains "Hill Giant"
  assert not game_over
  assert battlefield A contains 0 "Pest"
}
scenario "lisette pumps team on lifegain" {
  battlefield A: 5 "Forest", "Braidwood Cup", "Grizzly Bears"
  hand A: "Valentin, Dean of the Vein // Lisette, Dean of the Root"
  turn 1 precombat_main A: cast "Lisette, Dean of the Root"
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: activate "Braidwood Cup"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Lisette, Dean of the Root" +1/+1 1
  assert has "Grizzly Bears" trample
}

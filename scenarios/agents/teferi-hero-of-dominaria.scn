scenario "plus one draws and untaps lands at end step" {
  battlefield A: "Teferi, Hero of Dominaria", "Island" tapped, "Plains" tapped
  start turn 1 A precombat_main
  hand A: "Plains"
  turn 1 precombat_main A: activate "Teferi, Hero of Dominaria" ability 1
  run_to turn 1 postcombat_main
  assert hand A count 2
  assert counters "Teferi, Hero of Dominaria" loyalty 5
  assert tapped "Island"
  run_to turn 2 upkeep
  assert untapped "Plains"
  assert untapped "Island"
}
scenario "minus three tucks third from top" {
  battlefield A: "Teferi, Hero of Dominaria"
  battlefield B: "Hill Giant"
  library B: "Forest", "Island", "Swamp", "Mountain"
  turn 1 precombat_main A: activate "Teferi, Hero of Dominaria" ability 2 targeting "Hill Giant"
  run_to turn 1 combat_damage
  assert battlefield B lacks "Hill Giant"
  assert counters "Teferi, Hero of Dominaria" loyalty 1
}
scenario "emblem exiles on draw" {
  battlefield A: "Teferi, Hero of Dominaria" with 8 loyalty
  battlefield B: "Hill Giant"
  turn 1 precombat_main A: activate "Teferi, Hero of Dominaria" ability 3
  run_to turn 2 upkeep
  assert battlefield A lacks "Teferi, Hero of Dominaria"
  assert battlefield B contains "Hill Giant"
  turn 3 draw A: trigger "Teferi, Hero of Dominaria emblem" targeting B "Hill Giant"
  run_to turn 3 precombat_main
  assert battlefield B lacks "Hill Giant"
}

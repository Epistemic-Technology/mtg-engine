scenario "Personify flickers a creature and makes a Shapeshifter" {
  battlefield A: "Grizzly Bears" with 2 +1/+1, 2 "Plains"
  hand A: "Personify"
  start turn 1 A precombat_main
  turn 1 A: cast "Personify" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 0
  assert power "Grizzly Bears" 2
  assert battlefield A contains "Shapeshifter"
  assert is "Shapeshifter" "Goblin"
  assert graveyard A contains "Personify"
}

scenario "Personify can't target an opponent's creature" {
  battlefield A: 2 "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Personify"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Personify" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Personify"
}

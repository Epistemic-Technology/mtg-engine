scenario "Izzet Keyrune becomes a 2/1 and loots on combat damage" {
  battlefield A: "Izzet Keyrune", "Island", "Mountain", "Forest"
  hand A: "Plains"
  library A: "Swamp", "Swamp"
  start turn 1 A precombat_main
  turn 1 A: activate "Izzet Keyrune" ability 2
  turn 1 declare_attackers A: attack "Izzet Keyrune"
  run_to turn 1 postcombat_main
  assert life B 18
  assert is "Izzet Keyrune" creature
  assert is "Izzet Keyrune" blue
  assert is "Izzet Keyrune" red
  assert power "Izzet Keyrune" 2
  assert toughness "Izzet Keyrune" 1
  assert graveyard A contains "Plains"
  assert hand A count 1
}
scenario "Izzet Keyrune taps for red" {
  battlefield A: "Izzet Keyrune"
  hand A: "Lightning Bolt"
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 end
  assert life B 17
}

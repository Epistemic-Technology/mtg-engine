scenario "an opponent's noncreature spell draws A a card; a creature spell does not" {
  battlefield A: "Nezahal, Primal Tide"
  battlefield B: "Forest", "Forest"
  hand B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert hand A count 0
  assert life A 20
}

scenario "shock draws" {
  battlefield A: "Nezahal, Primal Tide"
  battlefield B: "Mountain"
  hand B: "Shock"
  turn 1 B: cast "Shock" targeting player A
  run_to turn 1 postcombat_main
  assert hand A count 1
  assert life A 18
}

scenario "discard three: exile, then back tapped at the next end step" {
  battlefield A: "Nezahal, Primal Tide"
  hand A: "Island", "Plains", "Swamp"
  turn 1 A: activate "Nezahal, Primal Tide"
  run_to turn 1 postcombat_main
  assert exile A contains "Nezahal, Primal Tide"
  assert graveyard A count 3
  run_to turn 1 cleanup
  assert battlefield A contains "Nezahal, Primal Tide"
  assert tapped "Nezahal, Primal Tide"
}

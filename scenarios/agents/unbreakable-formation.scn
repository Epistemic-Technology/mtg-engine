scenario "addendum in main phase" {
  battlefield A: 3 "Plains", "Grizzly Bears", "Hill Giant"
  battlefield B: "Wind Drake"
  hand A: "Unbreakable Formation"
  turn 1 precombat_main A: cast "Unbreakable Formation"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 1
  assert counters "Wind Drake" +1/+1 0
  assert has "Grizzly Bears" indestructible
  assert has "Hill Giant" vigilance
  assert has not "Wind Drake" indestructible
}
scenario "no addendum outside main phase" {
  battlefield A: 3 "Plains", "Grizzly Bears", "Hill Giant"
  hand A: "Unbreakable Formation"
  turn 1 begin_combat A: cast "Unbreakable Formation"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 0
  assert has "Grizzly Bears" indestructible
  assert has not "Hill Giant" vigilance
}

scenario "Revival returns a small creature" {
  hand A: "Revival // Revenge"
  battlefield A: 2 "Plains"
  graveyard A: "Grizzly Bears", "Serra Angel"
  turn 1 precombat_main A: cast "Revival" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard A contains "Serra Angel"
}
scenario "Revival cannot target mana value above 3" {
  hand A: "Revival // Revenge"
  battlefield A: 2 "Plains"
  graveyard A: "Serra Angel"
  illegal turn 1 precombat_main A: cast "Revival" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Serra Angel"
}
scenario "Revenge doubles my life and halves theirs rounded up" {
  life A 15
  life B 15
  hand A: "Revival // Revenge"
  battlefield A: 4 "Plains", "Swamp", "Plains"
  turn 1 precombat_main A: cast "Revenge" targeting player B
  run_to turn 1 postcombat_main
  assert life A 30
  assert life B 7
}

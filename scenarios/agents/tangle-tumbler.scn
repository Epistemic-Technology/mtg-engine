scenario "tangle tumbler puts a counter on a creature" {
  battlefield A: "Tangle Tumbler", "Grizzly Bears", 3 "Plains"
  start turn 1 A precombat_main
  turn 1 A: activate "Tangle Tumbler" ability 1 targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert counters "Grizzly Bears" +1/+1 1
  assert tapped "Tangle Tumbler"
}

scenario "tangle tumbler animates by tapping two tokens" {
  battlefield A: "Tangle Tumbler", 2 "Plains"
  hand A: "Raise the Alarm"
  start turn 1 A precombat_main
  turn 1 A: cast "Raise the Alarm"
  turn 1 A: wait
  turn 1 A: activate "Tangle Tumbler" ability 2
  turn 1 A: attack "Tangle Tumbler"
  run_to turn 1 postcombat_main
  assert life B 14
  assert untapped "Tangle Tumbler"
  assert is "Tangle Tumbler" creature
}

scenario "tangle tumbler can't animate with one token" {
  battlefield A: "Tangle Tumbler", "Treasure", "Grizzly Bears"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Tangle Tumbler" ability 2
  run_to turn 1 begin_combat
  assert is not "Tangle Tumbler" creature
}

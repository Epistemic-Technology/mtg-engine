scenario "Speak Secrets mills four and takes an instant or sorcery" {
  battlefield A: 2 "Island"
  hand A: "Most Decrepit Old Bird // Speak Secrets"
  library A: "Forest", "Shock", "Divination", "Hill Giant", "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Speak Secrets"
  turn 1 A: choose "Divination"
  run_to turn 1 postcombat_main
  assert hand A contains "Divination"
  assert hand A count 1
  assert graveyard A contains "Shock"
  assert graveyard A contains "Forest"
  assert graveyard A contains "Hill Giant"
  assert exile A contains "Most Decrepit Old Bird"
}

scenario "Most Decrepit Old Bird gets +1/+1 with threshold" {
  battlefield A: "Most Decrepit Old Bird // Speak Secrets"
  graveyard A: 7 "Forest"
  battlefield B: "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Most Decrepit Old Bird" 2
  assert toughness "Most Decrepit Old Bird" 2
  assert has "Most Decrepit Old Bird" flying
}

scenario "Most Decrepit Old Bird is 1/1 without threshold" {
  battlefield A: "Most Decrepit Old Bird // Speak Secrets"
  graveyard A: 6 "Forest"
  start turn 1 A precombat_main
  run_to turn 1 postcombat_main
  assert power "Most Decrepit Old Bird" 1
}

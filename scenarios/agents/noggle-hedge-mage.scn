scenario "two islands: tap two permanents" {
  battlefield A: 2 "Island", "Mountain"
  battlefield B: "Grizzly Bears", "Hill Giant"
  hand A: "Noggle Hedge-Mage"
  turn 1 precombat_main A: cast "Noggle Hedge-Mage"
  turn 1 precombat_main A: trigger "Noggle Hedge-Mage" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert tapped "Grizzly Bears"
  assert tapped "Hill Giant"
  assert life B 20
}
scenario "two mountains: 2 damage to player" {
  battlefield A: 2 "Mountain", "Island"
  battlefield B: "Grizzly Bears"
  hand A: "Noggle Hedge-Mage"
  turn 1 precombat_main A: cast "Noggle Hedge-Mage"
  turn 1 precombat_main A: trigger "Noggle Hedge-Mage" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert untapped "Grizzly Bears"
}
scenario "one of each: nothing" {
  battlefield A: "Island", "Mountain", "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Noggle Hedge-Mage"
  turn 1 precombat_main A: cast "Noggle Hedge-Mage"
  run_to turn 1 postcombat_main
  assert life B 20
  assert untapped "Grizzly Bears"
}

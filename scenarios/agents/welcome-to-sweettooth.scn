scenario "Welcome to Sweettooth chapter I makes a Human" {
  battlefield A: 2 "Forest"
  hand A: "Welcome to Sweettooth"
  start turn 1 A precombat_main
  turn 1 A: cast "Welcome to Sweettooth"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Human"
  assert counters "Welcome to Sweettooth" lore 1
}

scenario "Welcome to Sweettooth chapter II makes a Food" {
  battlefield A: "Welcome to Sweettooth" with 1 lore
  start turn 3 A upkeep
  run_to turn 3 postcombat_main
  assert battlefield A contains "Food"
}

scenario "Welcome to Sweettooth chapter III counts Foods plus one" {
  battlefield A: "Welcome to Sweettooth" with 2 lore, "Grizzly Bears", 2 "Food"
  start turn 3 A upkeep
  turn 3 A: trigger "Welcome to Sweettooth" targeting "Grizzly Bears"
  run_to turn 3 postcombat_main
  assert counters "Grizzly Bears" +1/+1 3
  assert graveyard A contains "Welcome to Sweettooth"
}

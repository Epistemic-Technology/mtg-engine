scenario "Grave Peril is sacrificed when a nonblack creature enters" {
  battlefield A: "Grave Peril"
  battlefield B: 2 "Forest"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Grave Peril"
}

scenario "Grave Peril ignores black creatures" {
  battlefield A: "Grave Peril"
  battlefield B: 2 "Swamp"
  hand B: "Typhoid Rats"
  start turn 2 B precombat_main
  turn 2 B: cast "Typhoid Rats"
  run_to turn 2 postcombat_main
  assert battlefield B contains "Typhoid Rats"
  assert battlefield A contains "Grave Peril"
}

scenario "Grave Peril: sacrificed, it destroys the entering nonblack creature" {
  battlefield A: "Grave Peril"
  battlefield B: 2 "Forest"
  hand B: "Grizzly Bears"
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 end
  assert graveyard A contains "Grave Peril"
  assert graveyard B contains "Grizzly Bears"
}

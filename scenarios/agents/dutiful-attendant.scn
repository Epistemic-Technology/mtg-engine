scenario "Dutiful Attendant returns another creature card" {
  battlefield A: "Dutiful Attendant", "Mountain"
  graveyard A: "Hill Giant"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Dutiful Attendant"
  turn 1 A: trigger "Dutiful Attendant" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Hill Giant"
  assert graveyard A contains "Dutiful Attendant"
}

scenario "Dutiful Attendant cannot return itself" {
  battlefield A: "Dutiful Attendant", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Dutiful Attendant"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Dutiful Attendant"
  assert hand A count 0
}

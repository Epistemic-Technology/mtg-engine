scenario "Blade of the Bloodchief grows the equipped creature when a creature dies" {
  battlefield A: "Blade of the Bloodchief", "Grizzly Bears", "Hill Giant", 4 "Swamp"
  hand A: "Murder"
  start turn 1 A
  turn 1 A: activate "Blade of the Bloodchief" targeting "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Murder" targeting "Hill Giant"
  run_to turn 1 combat_damage
  assert attached "Blade of the Bloodchief" to "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Blade of the Bloodchief gives a Vampire two counters" {
  battlefield A: "Blade of the Bloodchief", "Barony Vampire", "Hill Giant", 4 "Swamp"
  hand A: "Murder"
  start turn 1 A
  turn 1 A: activate "Blade of the Bloodchief" targeting "Barony Vampire"
  turn 1 A: wait
  turn 1 A: cast "Murder" targeting "Hill Giant"
  run_to turn 1 combat_damage
  assert counters "Barony Vampire" +1/+1 2
}

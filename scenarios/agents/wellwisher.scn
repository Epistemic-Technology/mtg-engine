scenario "Wellwisher gains 1 life for each Elf on the battlefield" {
  life A 10
  battlefield A: "Wellwisher", 2 "Llanowar Elves"
  battlefield B: "Llanowar Elves", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Wellwisher"
  run_to turn 1 postcombat_main
  assert life A 14
  assert tapped "Wellwisher"
}

scenario "Midnight Mangler is a creature on the opponent's turn and blocks" {
  battlefield A: "Midnight Mangler"
  battlefield B: "Grizzly Bears"
  start turn 2 B
  turn 2 B: attack "Grizzly Bears"
  turn 2 A: block "Grizzly Bears" with "Midnight Mangler"
  run_to turn 2 postcombat_main
  assert is "Midnight Mangler" creature
  assert is "Midnight Mangler" artifact
  assert is "Midnight Mangler" Vehicle
  assert life A 20
  assert graveyard B contains "Grizzly Bears"
  assert damage "Midnight Mangler" 2
}

scenario "Midnight Mangler is not a creature on its controller's turn" {
  battlefield A: "Midnight Mangler"
  start turn 2 A
  illegal turn 2 A: attack "Midnight Mangler"
  run_to turn 2 postcombat_main
  assert is not "Midnight Mangler" creature
  assert life B 20
}

scenario "Midnight Mangler crewed on its controller's turn attacks" {
  battlefield A: "Midnight Mangler", "Grizzly Bears"
  start turn 2 A
  turn 2 begin_combat A: activate "Midnight Mangler"
  turn 2 A: attack "Midnight Mangler"
  run_to turn 2 postcombat_main
  assert life B 17
  assert tapped "Grizzly Bears"
}

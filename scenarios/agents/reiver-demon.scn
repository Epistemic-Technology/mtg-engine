scenario "Reiver Demon destroys nonartifact nonblack creatures when cast" {
  battlefield A: 8 "Swamp", "Grizzly Bears", "Drudge Skeletons"
  hand A: "Reiver Demon"
  battlefield B: "Serra Angel", "Drudge Skeletons", "Juggernaut"
  turn 1 precombat_main A: cast "Reiver Demon"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Serra Angel"
  assert battlefield B contains "Drudge Skeletons"
  assert battlefield A contains "Drudge Skeletons"
  assert battlefield B contains "Juggernaut"
  assert battlefield A contains "Reiver Demon"
}

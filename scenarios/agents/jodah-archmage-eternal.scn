scenario "jodah: a spell may be cast for WUBRG instead of its mana cost" {
  battlefield A: "Jodah, Archmage Eternal", "Plains", "Island", "Swamp", "Mountain", "Forest"
  hand A: "Serra Angel"
  turn 1 A: cast "Serra Angel" alternative
  run_to turn 1 postcombat_main
  assert battlefield A contains "Serra Angel"
  assert untapped "Jodah, Archmage Eternal"
}

scenario "jodah: the alternative cost needs all five colors" {
  battlefield A: "Jodah, Archmage Eternal", 4 "Plains", 2 "Island"
  hand A: "Hill Giant"
  illegal turn 1 A: cast "Hill Giant" alternative
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Hill Giant"
}

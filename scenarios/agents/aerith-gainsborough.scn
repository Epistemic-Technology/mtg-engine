scenario "lifelink damage gains life and grows Aerith" {
  battlefield A: "Aerith Gainsborough"
  start turn 1 A precombat_main
  turn 1 A: attack "Aerith Gainsborough"
  run_to turn 1 postcombat_main
  assert life A 22
  assert life B 18
  assert counters "Aerith Gainsborough" +1/+1 1
}

scenario "dying spreads its counters to each legendary creature you control" {
  battlefield A: "Aerith Gainsborough" with 3 +1/+1, "Isamaru, Hound of Konda", "Grizzly Bears"
  hand B: "Murder"
  battlefield B: 3 "Swamp"
  start turn 1 A precombat_main
  turn 1 B: cast "Murder" targeting "Aerith Gainsborough"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Aerith Gainsborough"
  assert counters "Isamaru, Hound of Konda" +1/+1 3
  assert counters "Grizzly Bears" +1/+1 0
}

scenario "Deftblade Elite prevents combat damage to and by it" {
  battlefield A: "Deftblade Elite", 2 "Plains"
  battlefield B: "Hill Giant"
  start turn 2 B
  turn 2 B: attack "Hill Giant"
  turn 2 A: block "Hill Giant" with "Deftblade Elite"
  turn 2 declare_blockers A: activate "Deftblade Elite"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Deftblade Elite"
  assert damage "Hill Giant" 0
  assert damage "Deftblade Elite" 0
  assert life A 20
}

scenario "Deftblade Elite provokes a blocker" {
  battlefield A: "Deftblade Elite"
  battlefield B: "Grizzly Bears" tapped
  start turn 2 A
  turn 2 declare_attackers A: attack "Deftblade Elite"
  turn 2 declare_attackers A: trigger "Deftblade Elite" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert graveyard A contains "Deftblade Elite"
  assert damage "Grizzly Bears" 1
  assert life B 20
}

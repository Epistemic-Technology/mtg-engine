scenario "Jolt untaps a land and draws next upkeep" {
  battlefield A: 3 "Island", "Forest" tapped
  hand A: "Jolt"
  library A: 3 "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Jolt" targeting "Forest"
  turn 1 A: accept "Jolt"
  turn 1 A: decline "Jolt"
  run_to turn 1 end
  assert untapped "Forest"
  assert hand A count 0
  run_to turn 2 draw
  assert hand A count 1
}

scenario "Jolt taps a creature" {
  battlefield A: 3 "Island"
  battlefield B: "Grizzly Bears"
  hand A: "Jolt"
  library A: 3 "Plains"
  start turn 1 A precombat_main
  turn 1 A: cast "Jolt" targeting "Grizzly Bears"
  run_to turn 1 end
  assert tapped "Grizzly Bears"
}

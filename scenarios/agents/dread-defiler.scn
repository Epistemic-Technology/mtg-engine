scenario "dread defiler drains life equal to the exiled creature's power" {
  battlefield A: "Dread Defiler", "Wastes", 3 "Swamp"
  graveyard A: "Hill Giant", "Lightning Bolt"
  turn 1 precombat_main A: activate "Dread Defiler" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert exile A contains "Hill Giant"
  assert graveyard A lacks "Hill Giant"
}
scenario "dread defiler needs a creature card in the graveyard" {
  battlefield A: "Dread Defiler", "Wastes", 3 "Swamp"
  graveyard A: "Lightning Bolt"
  illegal turn 1 precombat_main A: activate "Dread Defiler" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
}
scenario "dread defiler is colorless" {
  battlefield A: "Dread Defiler"
  assert is not "Dread Defiler" black
}

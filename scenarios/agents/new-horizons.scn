scenario "New Horizons puts a counter on a creature as it enters" {
  battlefield A: 3 "Forest", "Swamp", "Grizzly Bears"
  hand A: "New Horizons"
  start turn 1 A precombat_main
  turn 1 A: cast "New Horizons" targeting "Swamp"
  turn 1 A: trigger "New Horizons" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "New Horizons" to "Swamp"
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
}

scenario "Enchanted land taps for two mana of one color" {
  battlefield A: "Plains", 3 "Mountain", "New Horizons" on "Plains"
  hand A: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: activate "Plains"
  turn 1 A: choose white
  turn 1 A: cast "Serra Angel"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Serra Angel"
}

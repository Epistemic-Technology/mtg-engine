scenario "Judge of Currents: an attacking Merfolk becoming tapped gains 1 life" {
  battlefield A: "Judge of Currents", "Coral Merfolk"
  start turn 1 A precombat_main
  turn 1 A: attack "Coral Merfolk"
  run_to turn 1 postcombat_main
  assert tapped "Coral Merfolk"
  assert life B 18
  assert life A 21
}

scenario "Judge of Currents: it triggers on itself too" {
  battlefield A: "Judge of Currents", "Coral Merfolk"
  start turn 1 A precombat_main
  turn 1 A: attack "Judge of Currents", "Coral Merfolk"
  run_to turn 1 postcombat_main
  assert life B 17
  assert life A 22
}

scenario "Judge of Currents: a non-Merfolk attacking does not trigger" {
  battlefield A: "Judge of Currents", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert life A 20
}

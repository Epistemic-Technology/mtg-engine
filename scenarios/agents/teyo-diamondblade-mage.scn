scenario "teyo gives a creature deathtouch and a +1/+1 counter" {
  battlefield A: 4 "Swamp", "Grizzly Bears", "Jace Beleren"
  hand A: "Teyo, Diamondblade Mage"
  turn 1 A: cast "Teyo, Diamondblade Mage"
  turn 1 A: trigger "Teyo, Diamondblade Mage" targeting "Grizzly Bears"
  run_to turn 1 begin_combat
  assert has "Grizzly Bears" deathtouch
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
  assert counters "Jace Beleren" loyalty 3
  run_to turn 2 upkeep
  assert has not "Grizzly Bears" deathtouch
}

scenario "teyo puts a loyalty counter on a planeswalker" {
  battlefield A: 4 "Swamp", "Grizzly Bears", "Jace Beleren"
  hand A: "Teyo, Diamondblade Mage"
  turn 1 A: cast "Teyo, Diamondblade Mage"
  turn 1 A: trigger "Teyo, Diamondblade Mage" targeting "Jace Beleren"
  run_to turn 1 begin_combat
  assert counters "Jace Beleren" loyalty 4
  assert counters "Grizzly Bears" +1/+1 0
  assert has not "Grizzly Bears" deathtouch
}

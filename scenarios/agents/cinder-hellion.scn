scenario "cinder hellion deals 2 to the opponent on entering" {
  battlefield A: 5 "Mountain"
  hand A: "Cinder Hellion"
  turn 1 A: cast "Cinder Hellion"
  turn 1 A: trigger "Cinder Hellion" targeting player B
  run_to turn 1 postcombat_main
  assert life B 18
  assert life A 20
  assert battlefield A contains "Cinder Hellion"
}
scenario "cinder hellion tramples over a blocker" {
  battlefield A: "Cinder Hellion"
  battlefield B: "Grizzly Bears"
  start turn 2 A
  turn 2 A: attack "Cinder Hellion"
  turn 2 B: block "Cinder Hellion" with "Grizzly Bears"
  turn 2 A: assign "Cinder Hellion" to "Grizzly Bears" 2, player B 2
  run_to turn 2 postcombat_main
  assert life B 18
  assert graveyard B contains "Grizzly Bears"
}

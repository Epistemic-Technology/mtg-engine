scenario "Troll Negotiations: two counters, then the creature fights" {
  battlefield A: "Grizzly Bears", 4 "Forest"
  hand A: "Troll Negotiations"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Troll Negotiations" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
  assert power "Grizzly Bears" 4
  assert damage "Grizzly Bears" 3
  assert battlefield A contains "Grizzly Bears"
  assert graveyard B contains "Hill Giant"
}

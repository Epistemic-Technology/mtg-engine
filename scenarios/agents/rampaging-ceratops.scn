scenario "rampaging ceratops can't be blocked by one creature" {
  battlefield A: "Rampaging Ceratops"
  battlefield B: "Grizzly Bears", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Rampaging Ceratops"
  illegal turn 1 B: block "Rampaging Ceratops" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert life B 15
}

scenario "rampaging ceratops can be blocked by three creatures" {
  battlefield A: "Rampaging Ceratops"
  battlefield B: 3 "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Rampaging Ceratops"
  turn 1 B: block "Rampaging Ceratops" with "Grizzly Bears"
  turn 1 B: block "Rampaging Ceratops" with "Grizzly Bears"
  turn 1 B: block "Rampaging Ceratops" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Rampaging Ceratops"
}

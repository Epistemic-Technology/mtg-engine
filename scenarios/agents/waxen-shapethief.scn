scenario "flash in as a copy of own artifact" {
  battlefield A: "Ornithopter", 4 "Island"
  battlefield B: "Hill Giant"
  hand A: "Waxen Shapethief"
  start turn 2 B precombat_main
  turn 2 A: cast "Waxen Shapethief"
  turn 2 A: copy "Ornithopter"
  run_to turn 2 postcombat_main
  assert battlefield A contains 2 "Ornithopter"
  assert battlefield A lacks "Waxen Shapethief"
}

scenario "can't copy opponent's creature" {
  battlefield A: 4 "Island"
  battlefield B: "Hill Giant"
  hand A: "Waxen Shapethief"
  start turn 1 A precombat_main
  turn 1 A: cast "Waxen Shapethief"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Hill Giant"
  assert graveyard A contains "Waxen Shapethief"
}

scenario "cycling" {
  battlefield A: 2 "Island"
  hand A: "Waxen Shapethief"
  library A: "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Waxen Shapethief"
  run_to turn 1 postcombat_main
  assert hand A contains "Forest"
  assert graveyard A contains "Waxen Shapethief"
}

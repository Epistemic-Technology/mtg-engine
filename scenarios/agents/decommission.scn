scenario "Decommission without revolt only destroys" {
  battlefield A: "Plains", "Plains", "Plains"
  battlefield B: "Chromatic Star"
  hand A: "Decommission"
  turn 1 precombat_main A: cast "Decommission" targeting "Chromatic Star"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Chromatic Star"
  assert life A 20
}
scenario "Decommission with revolt gains 3 life" {
  battlefield A: "Plains", "Plains", "Plains", "Mountain", "Grizzly Bears"
  battlefield B: "Chromatic Star"
  hand A: "Decommission", "Shock"
  turn 1 precombat_main A: cast "Shock" targeting "Grizzly Bears"
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: cast "Decommission" targeting "Chromatic Star"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard B contains "Chromatic Star"
  assert life A 23
}

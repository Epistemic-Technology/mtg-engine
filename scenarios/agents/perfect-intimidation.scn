scenario "Perfect Intimidation with both modes" {
  battlefield A: 4 "Swamp"
  battlefield B: "Grizzly Bears" with 2 +1/+1
  hand A: "Perfect Intimidation"
  hand B: "Shock", "Murder", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Perfect Intimidation" mode 3 targeting player B, "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand B count 1
  assert exile B count 2
  assert counters "Grizzly Bears" +1/+1 0
  assert power "Grizzly Bears" 2
}

scenario "Perfect Intimidation with only the counter mode" {
  battlefield A: 4 "Swamp"
  battlefield B: "Grizzly Bears" with 1 -1/-1
  hand A: "Perfect Intimidation"
  hand B: "Shock"
  start turn 1 A precombat_main
  turn 1 A: cast "Perfect Intimidation" mode 2 targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand B count 1
  assert toughness "Grizzly Bears" 2
}

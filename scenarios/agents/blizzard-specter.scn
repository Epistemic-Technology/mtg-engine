scenario "specter mode one bounces the opponent's only permanent" {
  battlefield A: "Blizzard Specter"
  battlefield B: "Hill Giant"
  hand B: "Shock"
  turn 1 declare_attackers A: attack "Blizzard Specter"
  turn 1 combat_damage A: trigger "Blizzard Specter" mode 1
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand B contains "Hill Giant"
  assert hand B count 2
}
scenario "specter mode two makes the opponent discard" {
  battlefield A: "Blizzard Specter"
  battlefield B: "Hill Giant"
  hand B: "Shock"
  turn 1 declare_attackers A: attack "Blizzard Specter"
  turn 1 combat_damage A: trigger "Blizzard Specter" mode 2
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield B contains "Hill Giant"
  assert graveyard B contains "Shock"
  assert hand B count 0
}

scenario "Mercurial Chemister deals damage equal to discarded mana value" {
  battlefield A: "Mercurial Chemister", "Mountain"
  battlefield B: "Hill Giant", "Serra Angel"
  hand A: "Grizzly Bears", "Forest"
  turn 1 precombat_main A: activate "Mercurial Chemister" ability 2 discarding "Grizzly Bears" targeting "Hill Giant"
  run_to turn 1 end
  assert damage "Hill Giant" 2
  assert graveyard A contains "Grizzly Bears"
}
scenario "Discarded land is 0" {
  battlefield A: "Mercurial Chemister", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Forest"
  turn 1 precombat_main A: activate "Mercurial Chemister" ability 2 discarding "Forest" targeting "Hill Giant"
  run_to turn 1 end
  assert damage "Hill Giant" 0
  assert graveyard A contains "Forest"
}
scenario "Chemister draws two" {
  battlefield A: "Mercurial Chemister", "Island"
  library A: "Forest", "Plains", "Swamp"
  turn 1 precombat_main A: activate "Mercurial Chemister" ability 1
  run_to turn 1 end
  assert hand A count 2
  assert hand A contains "Forest"
  assert hand A contains "Plains"
}

scenario "Steampath Charger deals 1 damage to target player when it dies" {
  battlefield A: "Steampath Charger"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Steampath Charger"
  turn 2 A: trigger "Steampath Charger" targeting player B
  run_to turn 2 postcombat_main
  assert graveyard A contains "Steampath Charger"
  assert life B 19
}

scenario "Steampath Charger with offspring makes a 1/1 copy" {
  battlefield A: 4 "Mountain"
  hand A: "Steampath Charger"
  start turn 1 A precombat_main
  turn 1 A: cast "Steampath Charger" kicked
  run_to turn 1 postcombat_main
  assert battlefield A contains 2 "Steampath Charger"
}

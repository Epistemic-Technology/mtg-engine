scenario "Shrewd Storyteller: tapped after attacking, a counter in the second main phase" {
  battlefield A: "Shrewd Storyteller", "Grizzly Bears"
  start turn 2 A
  turn 2 A: attack "Shrewd Storyteller"
  turn 2 postcombat_main A: trigger "Shrewd Storyteller" targeting "Grizzly Bears"
  run_to turn 2 end
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
  assert life B 17
}

scenario "Shrewd Storyteller: untapped, no trigger" {
  battlefield A: "Shrewd Storyteller", "Grizzly Bears"
  start turn 2 A
  run_to turn 2 end
  assert counters "Grizzly Bears" +1/+1 0
  assert counters "Shrewd Storyteller" +1/+1 0
}

scenario "Shatter Assumptions mode 1 discards colorless nonland cards" {
  battlefield A: 3 "Swamp"
  hand A: "Shatter Assumptions"
  hand B: "Ornithopter", "Terminate", "Forest", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Shatter Assumptions" mode 1 targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Ornithopter"
  assert hand B contains "Terminate"
  assert hand B contains "Forest"
  assert hand B contains "Grizzly Bears"
  assert hand B count 3
}

scenario "Shatter Assumptions mode 2 discards multicolored cards" {
  battlefield A: 3 "Swamp"
  hand A: "Shatter Assumptions"
  hand B: "Ornithopter", "Terminate", "Forest", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Shatter Assumptions" mode 2 targeting player B
  run_to turn 1 postcombat_main
  assert graveyard B contains "Terminate"
  assert hand B contains "Ornithopter"
  assert hand B count 3
}

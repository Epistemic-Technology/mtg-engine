scenario "tergrid's shadow each player sacrifices two" {
  battlefield A: 5 "Swamp", "Grizzly Bears", "Hill Giant", "Serra Angel"
  battlefield B: "Wind Drake", "Grizzly Bears", "Serra Angel"
  hand A: "Tergrid's Shadow"
  turn 1 precombat_main A: cast "Tergrid's Shadow"
  turn 1 precombat_main A: choose "Grizzly Bears"
  turn 1 precombat_main A: choose "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert graveyard A contains "Hill Giant"
  assert battlefield A contains "Serra Angel"
  assert battlefield B contains 1 "Serra Angel"
}
scenario "tergrid's shadow foretold" {
  battlefield A: 6 "Swamp", "Grizzly Bears", "Hill Giant"
  battlefield B: "Wind Drake", "Grizzly Bears"
  hand A: "Tergrid's Shadow"
  turn 1 precombat_main A: foretell "Tergrid's Shadow"
  turn 3 precombat_main A: cast "Tergrid's Shadow"
  run_to turn 3 postcombat_main
  assert graveyard B contains "Wind Drake"
  assert graveyard B contains "Grizzly Bears"
  assert graveyard A contains "Hill Giant"
}

scenario "discard on attack pumps target attacker, then impulse draws" {
  battlefield A: "Inti, Seneschal of the Sun", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Shock"
  library A: "Mountain", "Plains"
  start turn 1 A precombat_main
  turn 1 A: attack "Inti, Seneschal of the Sun", "Grizzly Bears"
  turn 1 declare_attackers A: trigger "Inti, Seneschal of the Sun" targeting "Grizzly Bears"
  run_to turn 1 declare_blockers
  assert counters "Grizzly Bears" +1/+1 1
  assert has "Grizzly Bears" trample
  assert has not "Inti, Seneschal of the Sun" trample
  assert graveyard A contains "Shock"
  assert exile A contains "Mountain"
  turn 1 postcombat_main A: play "Mountain"
  run_to turn 1 end
  assert battlefield A contains "Mountain"
  assert life B 15
}

scenario "declining to discard does nothing" {
  battlefield A: "Inti, Seneschal of the Sun", "Grizzly Bears"
  hand A: "Shock"
  library A: "Mountain", "Plains"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  turn 1 declare_attackers A: decline "Inti, Seneschal of the Sun"
  run_to turn 1 end
  assert counters "Grizzly Bears" +1/+1 0
  assert hand A contains "Shock"
  assert library A contains "Mountain"
  assert life B 18
}

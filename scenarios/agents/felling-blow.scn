scenario "Felling Blow counters then bites" {
  battlefield A: 3 "Forest", "Grizzly Bears"
  battlefield B: "Hill Giant"
  hand A: "Felling Blow"
  start turn 1 A precombat_main
  turn 1 A: cast "Felling Blow" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert graveyard B contains "Hill Giant"
  assert damage "Grizzly Bears" 0
}

scenario "Felling Blow can't target your own creature second" {
  battlefield A: 3 "Forest", "Grizzly Bears", "Hill Giant"
  hand A: "Felling Blow"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Felling Blow" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Felling Blow"
}

scenario "sacrificing an artifact adds a counter and {R} that pays for Shock" {
  battlefield A: "Crime Novelist", "Abzan Banner", "Plains", "Swamp", "Forest"
  hand A: "Shock"
  start turn 1 A precombat_main
  turn 1 A: activate "Abzan Banner"
  turn 1 A: wait
  turn 1 A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert counters "Crime Novelist" +1/+1 1
  assert power "Crime Novelist" 2
  assert life B 18
}

scenario "a Treasure sacrificed for mana also triggers it" {
  battlefield A: "Crime Novelist", "Treasure", "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert counters "Crime Novelist" +1/+1 1
}

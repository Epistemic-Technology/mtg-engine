scenario "See the Truth from hand takes one card" {
  battlefield A: "Island", "Island"
  hand A: "See the Truth"
  library A: "Grizzly Bears", "Hill Giant", "Serra Angel", "Wind Drake"
  start turn 1 A precombat_main
  turn 1 A: cast "See the Truth"
  turn 1 A: choose "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand A contains "Hill Giant"
  assert hand A count 1
  assert library A count 3
}

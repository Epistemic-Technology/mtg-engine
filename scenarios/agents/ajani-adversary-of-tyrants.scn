scenario "Ajani plus one puts counters on two creatures" {
  battlefield A: "Ajani, Adversary of Tyrants", "Grizzly Bears", "Hill Giant", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: activate "Ajani, Adversary of Tyrants" ability 1 targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 combat_damage
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 1
  assert counters "Serra Angel" +1/+1 0
  assert counters "Ajani, Adversary of Tyrants" loyalty 5
}

scenario "Ajani minus two returns a cheap creature" {
  battlefield A: "Ajani, Adversary of Tyrants"
  graveyard A: "Grizzly Bears", "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: activate "Ajani, Adversary of Tyrants" ability 2 targeting "Grizzly Bears"
  run_to turn 1 combat_damage
  assert battlefield A contains "Grizzly Bears"
  assert graveyard A contains "Serra Angel"
  assert counters "Ajani, Adversary of Tyrants" loyalty 2
  illegal turn 1 A: activate "Ajani, Adversary of Tyrants" ability 2 targeting "Serra Angel"
}

scenario "Ajani ultimate makes three Cats each end step" {
  battlefield A: "Ajani, Adversary of Tyrants" with 7 loyalty
  start turn 1 A precombat_main
  turn 1 A: activate "Ajani, Adversary of Tyrants" ability 3
  run_to turn 2 upkeep
  assert battlefield A contains 3 "Cat"
  run_to turn 3 upkeep
  assert battlefield A contains 3 "Cat"
}

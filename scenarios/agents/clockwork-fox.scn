scenario "Clockwork Fox leaving the battlefield draws two and opponent one" {
  battlefield A: "Clockwork Fox", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Clockwork Fox"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Clockwork Fox"
  assert hand A count 2
  assert hand B count 1
}

scenario "bigger hand gives +2/+2 and flying" {
  battlefield A: "Secretkeeper"
  hand A: "Forest", "Plains", "Island"
  hand B: "Forest"
  assert power "Secretkeeper" 4
  assert toughness "Secretkeeper" 4
  assert has "Secretkeeper" flying
}
scenario "equal hands give nothing" {
  battlefield A: "Secretkeeper"
  hand A: "Forest"
  hand B: "Forest"
  assert power "Secretkeeper" 2
  assert has not "Secretkeeper" flying
}

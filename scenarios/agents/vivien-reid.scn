scenario "Vivien Reid +1 finds a creature" {
  battlefield A: "Vivien Reid"
  library A: "Shock", "Grizzly Bears", "Shock", "Lightning Bolt", "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: activate "Vivien Reid" ability 1
  run_to turn 1 postcombat_main
  assert hand A contains "Grizzly Bears"
  assert hand A count 1
  assert counters "Vivien Reid" loyalty 6
  assert library A count 4
}

scenario "Vivien Reid -3 can't hit a creature without flying" {
  battlefield A: "Vivien Reid"
  battlefield B: "Serra Angel", "Hill Giant"
  start turn 1 A precombat_main
  illegal turn 1 A: activate "Vivien Reid" ability 2 targeting "Hill Giant"
  run_to turn 1 postcombat_main
}

scenario "Vivien Reid -3 destroys a flyer works" {
  battlefield A: "Vivien Reid"
  battlefield B: "Serra Angel"
  start turn 1 A precombat_main
  turn 1 A: activate "Vivien Reid" ability 2 targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert counters "Vivien Reid" loyalty 2
}

scenario "Vivien Reid emblem" {
  battlefield A: "Vivien Reid" with 8 loyalty, "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Vivien Reid" ability 3
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 4
  assert toughness "Grizzly Bears" 4
  assert has "Grizzly Bears" vigilance
  assert has "Grizzly Bears" trample
  assert has "Grizzly Bears" indestructible
  assert graveyard A contains "Vivien Reid"
}

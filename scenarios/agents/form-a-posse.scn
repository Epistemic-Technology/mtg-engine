scenario "form a posse creates X Mercenaries" {
  battlefield A: 3 "Mountain", 2 "Plains"
  hand A: "Form a Posse"
  turn 1 A: cast "Form a Posse" x 3
  run_to turn 1 postcombat_main
  assert battlefield A contains 3 "Mercenary"
}

scenario "form a posse with X 0 creates nothing" {
  battlefield A: "Mountain", "Plains"
  hand A: "Form a Posse"
  turn 1 A: cast "Form a Posse"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Mercenary"
  assert graveyard A contains "Form a Posse"
}

scenario "Skittering Horror is sacrificed when you cast a creature spell" {
  battlefield A: "Skittering Horror", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Skittering Horror"
  assert battlefield A contains "Grizzly Bears"
}

scenario "Skittering Horror stays for a noncreature spell" {
  battlefield A: "Skittering Horror", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert battlefield A contains "Skittering Horror"
  assert life B 17
}

scenario "Skittering Horror ignores an opponent's creature spell" {
  battlefield A: "Skittering Horror"
  battlefield B: 2 "Forest"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Skittering Horror"
}

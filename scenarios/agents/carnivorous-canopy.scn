scenario "Carnivorous Canopy destroys a cheap flyer and proliferates" {
  battlefield A: 3 "Forest", "Grizzly Bears" with 1 +1/+1
  battlefield B: "Wind Drake"
  hand A: "Carnivorous Canopy"
  start turn 1 A precombat_main
  turn 1 A: cast "Carnivorous Canopy" targeting "Wind Drake"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Wind Drake"
  assert counters "Grizzly Bears" +1/+1 2
}

scenario "Carnivorous Canopy doesn't proliferate for an expensive flyer" {
  battlefield A: 3 "Forest", "Grizzly Bears" with 1 +1/+1
  battlefield B: "Serra Angel"
  hand A: "Carnivorous Canopy"
  start turn 1 A precombat_main
  turn 1 A: cast "Carnivorous Canopy" targeting "Serra Angel"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Serra Angel"
  assert counters "Grizzly Bears" +1/+1 1
}

scenario "Carnivorous Canopy can't target a creature without flying" {
  battlefield A: 3 "Forest"
  battlefield B: "Hill Giant"
  hand A: "Carnivorous Canopy"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Carnivorous Canopy" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield B contains "Hill Giant"
}

scenario "jiang counter then mana" {
  battlefield A: "Jiang Yanggu, Wildcrafter", "Grizzly Bears", "Plains"
  hand A: "Shock"
  turn 1 precombat_main A: activate "Jiang Yanggu, Wildcrafter" targeting "Grizzly Bears"
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Jiang Yanggu, Wildcrafter" loyalty 2
  assert life B 18
  assert tapped "Grizzly Bears"
}
scenario "jiang creature without counter cannot make mana" {
  battlefield A: "Jiang Yanggu, Wildcrafter", "Grizzly Bears"
  hand A: "Shock"
  illegal turn 1 precombat_main A: cast "Shock" targeting player B
  run_to turn 1 postcombat_main
  assert life B 20
}

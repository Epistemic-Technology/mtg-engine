scenario "Soul's Attendant gains 1 life when another creature enters" {
  battlefield A: "Soul's Attendant", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 21
}

scenario "Soul's Attendant triggers on an opponent's creature" {
  battlefield A: "Soul's Attendant"
  battlefield B: 2 "Forest"
  hand B: "Grizzly Bears"
  start turn 2 B precombat_main
  turn 2 B: cast "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life A 21
}

scenario "Soul's Attendant doesn't trigger on itself" {
  battlefield A: "Plains"
  hand A: "Soul's Attendant"
  start turn 1 A precombat_main
  turn 1 A: cast "Soul's Attendant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Soul's Attendant"
  assert life A 20
}

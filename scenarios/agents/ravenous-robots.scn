scenario "ravenous robots: artifact spell makes a Robot; {R},{T} gives tokens haste" {
  battlefield A: "Ravenous Robots", 2 "Mountain"
  hand A: "Ornithopter", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Ornithopter"
  turn 1 A: wait
  turn 1 A: activate "Ravenous Robots"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Robot"
  assert has "Robot" haste
  assert has not "Ornithopter" haste
  assert tapped "Ravenous Robots"
}

scenario "ravenous robots: creature spell makes no Robot" {
  battlefield A: "Ravenous Robots", 2 "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A lacks "Robot"
}

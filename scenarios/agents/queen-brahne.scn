scenario "Queen Brahne makes a Wizard when she attacks; it pings on noncreature spells" {
  battlefield A: "Queen Brahne", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: attack "Queen Brahne"
  turn 1 declare_blockers A: cast "Lightning Bolt" targeting player B
  run_to turn 1 combat_damage
  assert battlefield A contains "Wizard"
  assert power "Queen Brahne" 3
  run_to turn 1 postcombat_main
  assert life B 13
}

scenario "Queen Brahne makes no Wizard without attacking" {
  battlefield A: "Queen Brahne"
  start turn 1 A precombat_main
  run_to turn 2 precombat_main
  assert battlefield A lacks "Wizard"
}

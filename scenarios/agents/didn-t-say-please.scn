scenario "Didn't Say Please counters a spell and its controller mills 3" {
  battlefield A: "Mountain"
  battlefield B: 3 "Island"
  hand A: "Lightning Bolt"
  hand B: "Didn't Say Please"
  library A: "Plains", "Island", "Swamp", "Mountain", "Forest", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting player B
  turn 1 B: cast "Didn't Say Please" targeting "Lightning Bolt" in response to "Lightning Bolt"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard A contains "Lightning Bolt"
  assert graveyard A count 4
  assert library A count 3
  assert graveyard B contains "Didn't Say Please"
}

scenario "Didn't Say Please has no spell to target on an empty stack" {
  battlefield B: 3 "Island"
  hand B: "Didn't Say Please"
  start turn 1 B precombat_main
  illegal turn 1 B: cast "Didn't Say Please" targeting auto
  run_to turn 1 postcombat_main
  assert hand B contains "Didn't Say Please"
}

scenario "Flickering Hound blinks another creature when a creature spell is cast" {
  battlefield A: "Flickering Hound", "Grizzly Bears" with 2 +1/+1, 4 "Mountain"
  hand A: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Hill Giant"
  turn 1 A: trigger "Flickering Hound" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert counters "Grizzly Bears" +1/+1 0
  assert power "Grizzly Bears" 2
  assert battlefield A contains "Hill Giant"
}

scenario "Flickering Hound doesn't trigger on a noncreature spell" {
  battlefield A: "Flickering Hound", "Grizzly Bears" with 2 +1/+1, "Forest"
  hand A: "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Giant Growth" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
  assert power "Grizzly Bears" 7
}

scenario "Flickering Hound doesn't blink itself" {
  battlefield A: "Flickering Hound" with 1 +1/+1, 4 "Mountain"
  hand A: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Flickering Hound" +1/+1 1
  assert battlefield A contains "Hill Giant"
}

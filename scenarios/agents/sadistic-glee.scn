scenario "Sadistic Glee grows on any creature death" {
  battlefield A: "Grizzly Bears", "Sadistic Glee" on "Grizzly Bears", "Mountain"
  battlefield B: "Hill Giant"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert graveyard B contains "Hill Giant"
  assert counters "Grizzly Bears" +1/+1 1
  assert power "Grizzly Bears" 3
}

scenario "sacrifice Wayfarer's Bauble deals 1" {
  battlefield A: "Bosh, Iron Golem", 4 "Mountain", "Wayfarer's Bauble"
  turn 1 precombat_main A: activate "Bosh, Iron Golem" sacrificing "Wayfarer's Bauble" targeting player B
  run_to turn 1 postcombat_main
  assert life B 19
  assert battlefield A lacks "Wayfarer's Bauble"
}
scenario "sacrifice Bosh itself deals 8" {
  battlefield A: "Bosh, Iron Golem", 4 "Mountain"
  turn 1 precombat_main A: activate "Bosh, Iron Golem" sacrificing "Bosh, Iron Golem" targeting player B
  run_to turn 1 postcombat_main
  assert life B 12
}
scenario "sacrifice Sol Ring deals 1 to creature" {
  battlefield A: "Bosh, Iron Golem", 4 "Mountain", "Sol Ring"
  battlefield B: "Grizzly Bears"
  turn 1 precombat_main A: activate "Bosh, Iron Golem" sacrificing "Sol Ring" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert damage "Grizzly Bears" 1
}

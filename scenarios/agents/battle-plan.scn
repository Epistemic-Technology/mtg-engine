scenario "Battle Plan pumps a creature at the beginning of combat" {
  battlefield A: "Battle Plan", "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: attack "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 16
}

scenario "Battle Plan landcycles" {
  battlefield A: 2 "Mountain"
  hand A: "Battle Plan"
  library A: "Island", "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Battle Plan"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Battle Plan"
  assert hand A count 1
}

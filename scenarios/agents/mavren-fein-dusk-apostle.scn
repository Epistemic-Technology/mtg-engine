scenario "Mavren Fein makes one lifelink Vampire when a nontoken Vampire attacks" {
  battlefield A: "Mavren Fein, Dusk Apostle"
  start turn 1 A precombat_main
  turn 1 A: attack "Mavren Fein, Dusk Apostle"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Vampire"
  assert life B 18
}

scenario "Mavren Fein ignores a non-Vampire attacker" {
  battlefield A: "Mavren Fein, Dusk Apostle", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 18
  assert battlefield A lacks "Vampire"
}

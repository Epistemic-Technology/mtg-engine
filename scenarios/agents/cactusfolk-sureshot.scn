scenario "Cactusfolk Sureshot gives big creatures trample and haste" {
  battlefield A: "Cactusfolk Sureshot", "Grizzly Bears", 4 "Forest", 2 "Mountain"
  hand A: "Giant Growth"
  start turn 1 A precombat_main
  turn 1 A: cast "Giant Growth" targeting "Grizzly Bears"
  run_to turn 1 declare_attackers
  assert has "Grizzly Bears" trample
  assert has "Grizzly Bears" haste
  assert has not "Cactusfolk Sureshot" trample
}

scenario "Cactusfolk Sureshot skips small creatures" {
  battlefield A: "Cactusfolk Sureshot", "Grizzly Bears"
  start turn 1 A precombat_main
  run_to turn 1 declare_attackers
  assert has not "Grizzly Bears" trample
  assert has not "Grizzly Bears" haste
}

scenario "Legolas grows when an opponent's creature dies" {
  battlefield A: "Legolas, Counter of Kills", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Legolas, Counter of Kills" +1/+1 1
  assert power "Legolas, Counter of Kills" 3
}

scenario "Legolas does not grow when your own creature dies" {
  battlefield A: "Legolas, Counter of Kills", "Grizzly Bears", "Mountain"
  hand A: "Lightning Bolt"
  start turn 1 A precombat_main
  turn 1 A: cast "Lightning Bolt" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Legolas, Counter of Kills" 2
}

scenario "Legolas untaps once each turn when you scry" {
  battlefield A: "Legolas, Counter of Kills" tapped, 2 "Island"
  hand A: "Opt", "Opt"
  start turn 1 A precombat_main
  turn 1 A: cast "Opt"
  run_to turn 1 postcombat_main
  assert untapped "Legolas, Counter of Kills"
}

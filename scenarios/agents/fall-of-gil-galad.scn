scenario "chapter 2 puts two counters" {
  battlefield A: "Fall of Gil-galad" with 1 lore, "Grizzly Bears"
  turn 1 precombat_main A: trigger "Fall of Gil-galad" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 2
  assert power "Grizzly Bears" 4
}
scenario "chapter 3 grants draw on death and fights" {
  battlefield A: "Fall of Gil-galad" with 2 lore, "Grizzly Bears"
  battlefield B: "Hill Giant"
  library A: "Forest", "Island", "Swamp"
  turn 1 precombat_main A: trigger "Fall of Gil-galad" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert damage "Hill Giant" 2
  assert graveyard A contains "Grizzly Bears"
  assert hand A count 2
  assert battlefield A lacks "Fall of Gil-galad"
}

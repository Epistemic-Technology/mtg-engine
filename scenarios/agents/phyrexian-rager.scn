scenario "Phyrexian Rager draws a card and loses 1 life on entering" {
  battlefield A: 3 "Swamp"
  hand A: "Phyrexian Rager"
  library A: "Hill Giant", "Forest"
  start turn 1 A precombat_main
  turn 1 A: cast "Phyrexian Rager"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Phyrexian Rager"
  assert hand A contains "Hill Giant"
  assert hand A count 1
  assert life A 19
}

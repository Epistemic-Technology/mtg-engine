scenario "heavy fog prevents damage to you from attackers, not to blockers" {
  battlefield A: 2 "Forest", "Grizzly Bears"
  hand A: "Heavy Fog"
  battlefield B: "Hill Giant", "Serra Angel"
  start turn 2 B
  turn 2 B: attack "Hill Giant", "Serra Angel"
  turn 2 declare_attackers A: cast "Heavy Fog"
  turn 2 A: block "Hill Giant" with "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life A 20
  assert graveyard A contains "Heavy Fog"
  assert graveyard A contains "Grizzly Bears"
}

scenario "heavy fog can't be cast without being attacked" {
  battlefield A: 2 "Forest"
  hand A: "Heavy Fog"
  battlefield B: "Hill Giant"
  start turn 2 B
  illegal turn 2 declare_attackers A: cast "Heavy Fog"
  run_to turn 2 postcombat_main
  assert hand A contains "Heavy Fog"
}

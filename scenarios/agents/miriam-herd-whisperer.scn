scenario "Miriam puts a counter on an attacking Mount, not on other attackers" {
  battlefield A: "Miriam, Herd Whisperer", "Alacrian Jaguar", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Alacrian Jaguar", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert counters "Alacrian Jaguar" +1/+1 1
  assert counters "Grizzly Bears" +1/+1 0
  assert life B 13
}

scenario "Miriam gives Mounts hexproof during your turn" {
  battlefield A: "Miriam, Herd Whisperer", "Alacrian Jaguar"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 1 A precombat_main
  illegal turn 1 precombat_main B: cast "Shock" targeting "Alacrian Jaguar"
  run_to turn 1 postcombat_main
  assert has "Alacrian Jaguar" hexproof
}

scenario "Miriam's Mounts lose hexproof on the opponent's turn" {
  battlefield A: "Miriam, Herd Whisperer", "Alacrian Jaguar"
  battlefield B: "Mountain"
  hand B: "Shock"
  start turn 2 B precombat_main
  turn 2 B: cast "Shock" targeting "Alacrian Jaguar"
  run_to turn 2 postcombat_main
  assert damage "Alacrian Jaguar" 2
  assert has not "Alacrian Jaguar" hexproof
}

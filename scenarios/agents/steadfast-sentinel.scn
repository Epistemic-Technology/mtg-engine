scenario "steadfast sentinel attacks without tapping" {
  battlefield A: "Steadfast Sentinel"
  start turn 2 A
  turn 2 A: attack "Steadfast Sentinel"
  run_to turn 2 postcombat_main
  assert life B 18
  assert untapped "Steadfast Sentinel"
}

scenario "steadfast sentinel eternalizes into a 4/4 black Zombie with vigilance" {
  battlefield A: 6 "Plains"
  graveyard A: "Steadfast Sentinel"
  start turn 2 A precombat_main
  turn 2 A: activate "Steadfast Sentinel"
  run_to turn 2 postcombat_main
  assert exile A contains "Steadfast Sentinel"
  assert battlefield A contains "Steadfast Sentinel"
  assert power "Steadfast Sentinel" 4
  assert toughness "Steadfast Sentinel" 4
  assert is "Steadfast Sentinel" black
  assert is not "Steadfast Sentinel" white
  assert is "Steadfast Sentinel" Zombie
  assert is "Steadfast Sentinel" Cleric
  assert has "Steadfast Sentinel" vigilance
}

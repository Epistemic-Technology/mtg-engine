scenario "Hunter's Prowess draws as many cards as combat damage dealt" {
  battlefield A: "Grizzly Bears", 5 "Forest"
  hand A: "Hunter's Prowess"
  turn 1 A: cast "Hunter's Prowess" targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert power "Grizzly Bears" 5
  assert toughness "Grizzly Bears" 5
  assert has "Grizzly Bears" trample
  assert life B 15
  assert hand A count 5
}

scenario "Hunter's Prowess draws for trample damage only" {
  battlefield A: "Grizzly Bears", 5 "Forest"
  battlefield B: "Hill Giant"
  hand A: "Hunter's Prowess"
  turn 1 A: cast "Hunter's Prowess" targeting "Grizzly Bears"
  turn 1 A: attack "Grizzly Bears"
  turn 1 B: block "Grizzly Bears" with "Hill Giant"
  turn 1 A: assign "Grizzly Bears" to "Hill Giant" 3, player B 2
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand A count 2
}

scenario "Neighborhood Guardian pumps when a small creature enters" {
  battlefield A: "Neighborhood Guardian", "Forest", "Forest"
  hand A: "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: trigger "Neighborhood Guardian" targeting "Neighborhood Guardian"
  run_to turn 1 postcombat_main
  assert power "Neighborhood Guardian" 3
  assert toughness "Neighborhood Guardian" 3
}

scenario "Neighborhood Guardian ignores a big creature" {
  battlefield A: "Neighborhood Guardian", 5 "Mountain"
  hand A: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: cast "Hill Giant"
  run_to turn 1 postcombat_main
  assert power "Neighborhood Guardian" 2
  assert power "Hill Giant" 3
}

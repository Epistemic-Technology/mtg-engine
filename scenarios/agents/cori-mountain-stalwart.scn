scenario "cori mountain stalwart flurry on the second spell" {
  battlefield A: "Cori Mountain Stalwart", 2 "Mountain"
  hand A: "Shock", "Lightning Bolt"
  battlefield B: "Grizzly Bears", "Hill Giant"
  start turn 2 A precombat_main
  turn 2 A: cast "Shock" targeting "Grizzly Bears"
  turn 2 A: wait
  turn 2 A: cast "Lightning Bolt" targeting "Hill Giant"
  run_to turn 2 postcombat_main
  assert life B 18
  assert life A 22
}

scenario "cori mountain stalwart nothing on the first spell" {
  battlefield A: "Cori Mountain Stalwart", "Mountain"
  hand A: "Shock"
  battlefield B: "Grizzly Bears"
  start turn 2 A precombat_main
  turn 2 A: cast "Shock" targeting "Grizzly Bears"
  run_to turn 2 postcombat_main
  assert life B 20
  assert life A 20
}

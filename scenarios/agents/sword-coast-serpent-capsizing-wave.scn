scenario "Sword Coast Serpent is unblockable after a noncreature spell" {
  battlefield A: "Sword Coast Serpent", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Shock"
  turn 1 precombat_main A: cast "Shock" targeting player B
  turn 1 declare_attackers A: attack "Sword Coast Serpent"
  illegal turn 1 declare_blockers B: block "Sword Coast Serpent" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 12
}
scenario "Sword Coast Serpent can be blocked without a noncreature spell" {
  battlefield A: "Sword Coast Serpent"
  battlefield B: "Grizzly Bears"
  turn 1 declare_attackers A: attack "Sword Coast Serpent"
  turn 1 declare_blockers B: block "Sword Coast Serpent" with "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life B 20
  assert graveyard B contains "Grizzly Bears"
}
scenario "Capsizing Wave returns a creature" {
  battlefield A: 2 "Island"
  battlefield B: "Hill Giant"
  hand A: "Sword Coast Serpent"
  turn 1 precombat_main A: cast "Capsizing Wave" targeting "Hill Giant"
  run_to turn 1 begin_combat
  assert hand B contains "Hill Giant"
  assert exile A contains "Sword Coast Serpent"
}

scenario "tyvar taps another creature to gain indestructible and taps itself" {
  battlefield A: "Tyvar, the Pummeler", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: activate "Tyvar, the Pummeler" ability 1
  run_to turn 1 begin_combat
  assert tapped "Grizzly Bears"
  assert tapped "Tyvar, the Pummeler"
  assert has "Tyvar, the Pummeler" indestructible
}

scenario "tyvar pumps creatures by the greatest power" {
  battlefield A: "Tyvar, the Pummeler", "Grizzly Bears", 5 "Forest"
  start turn 1 A precombat_main
  turn 1 A: activate "Tyvar, the Pummeler" ability 2
  run_to turn 1 begin_combat
  assert power "Grizzly Bears" 5
  assert toughness "Grizzly Bears" 5
  assert power "Tyvar, the Pummeler" 6
}

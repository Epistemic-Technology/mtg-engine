scenario "villain entering attaches equipment" {
  battlefield A: "Swordsman, Sharp Scoundrel", "Bonesplitter", "Grizzly Bears", "Forest"
  hand A: "Serpent Specialist"
  turn 1 A: cast "Serpent Specialist"
  turn 1 A: trigger "Swordsman, Sharp Scoundrel" targeting "Bonesplitter", "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert attached "Bonesplitter" to "Grizzly Bears"
}

scenario "equipped attacker connives" {
  battlefield A: "Swordsman, Sharp Scoundrel", "Bonesplitter" on "Grizzly Bears", "Grizzly Bears"
  library A: "Shock", "Plains"
  turn 1 A: attack "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Shock"
  assert counters "Grizzly Bears" +1/+1 1
  assert life B 15
}

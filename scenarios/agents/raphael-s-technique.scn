scenario "Raphael's Technique: each player who accepts discards their hand and draws seven" {
  battlefield A: 6 "Mountain"
  hand A: "Raphael's Technique", "Forest"
  hand B: "Island", "Swamp"
  library A: 8 "Plains"
  library B: 8 "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Raphael's Technique"
  turn 1 A: accept "Raphael's Technique"
  turn 1 B: accept "Raphael's Technique"
  run_to turn 1 postcombat_main
  assert hand A count 7
  assert graveyard A contains "Forest"
  assert hand B count 7
  assert graveyard B contains "Swamp"
}

scenario "Raphael's Technique: a player who declines keeps their hand" {
  battlefield A: 6 "Mountain"
  hand A: "Raphael's Technique", "Forest"
  hand B: "Island", "Swamp"
  library A: 8 "Plains"
  library B: 8 "Island"
  start turn 1 A precombat_main
  turn 1 A: cast "Raphael's Technique"
  turn 1 A: accept "Raphael's Technique"
  turn 1 B: decline "Raphael's Technique"
  run_to turn 1 postcombat_main
  assert hand A count 7
  assert hand B count 2
  assert hand B contains "Swamp"
}

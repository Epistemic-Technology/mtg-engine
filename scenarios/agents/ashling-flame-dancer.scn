scenario "Ashling: second resolution deals 2 to opponent and creatures" {
  battlefield A: "Ashling, Flame Dancer", 3 "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Forest", "Forest", "Forest", "Lightning Bolt", "Lightning Bolt"
  library A: "Island", "Island", "Island", "Island"
  start turn 1 A precombat_main
  turn 1 precombat_main A: cast "Lightning Bolt" targeting player B
  turn 1 precombat_main A: wait
  turn 1 precombat_main A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 12
  assert graveyard B contains "Grizzly Bears"
  assert hand A count 3
}

scenario "Ashling: first resolution only loots" {
  battlefield A: "Ashling, Flame Dancer", "Mountain"
  battlefield B: "Grizzly Bears"
  hand A: "Lightning Bolt", "Forest"
  start turn 1 A precombat_main
  turn 1 precombat_main A: cast "Lightning Bolt" targeting player B
  run_to turn 1 postcombat_main
  assert life B 17
  assert battlefield B contains "Grizzly Bears"
}

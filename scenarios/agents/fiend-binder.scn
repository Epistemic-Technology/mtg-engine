scenario "Fiend Binder taps a defending creature when attacking" {
  battlefield A: "Fiend Binder"
  battlefield B: "Hill Giant"
  start turn 1 A precombat_main
  turn 1 A: attack "Fiend Binder"
  turn 1 A: trigger "Fiend Binder" targeting "Hill Giant"
  run_to turn 1 declare_blockers
  assert tapped "Hill Giant"
}

scenario "Fiend Binder does not tap its controller's creatures" {
  battlefield A: "Fiend Binder", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: attack "Fiend Binder"
  run_to turn 1 postcombat_main
  assert untapped "Grizzly Bears"
}

scenario "Haliya gains 1 life per creature entering and draws at end step after 3 life" {
  battlefield A: 3 "Plains", 4 "Forest"
  hand A: "Haliya, Guided by Light", "Grizzly Bears", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Haliya, Guided by Light"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert life A 23
  assert hand A count 0
  run_to turn 2 upkeep
  assert hand A count 1
}

scenario "Haliya doesn't draw with only 2 life gained" {
  battlefield A: 3 "Plains", 2 "Forest"
  hand A: "Haliya, Guided by Light", "Grizzly Bears"
  start turn 1 A precombat_main
  turn 1 A: cast "Haliya, Guided by Light"
  turn 1 A: wait
  turn 1 A: cast "Grizzly Bears"
  run_to turn 2 upkeep
  assert life A 22
  assert hand A count 0
}

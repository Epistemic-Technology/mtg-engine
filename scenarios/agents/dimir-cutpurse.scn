scenario "Dimir Cutpurse: opponent discards and I draw" {
  battlefield A: "Dimir Cutpurse"
  hand B: "Shock", "Lightning Bolt"
  hand A: "Plains"
  library A: "Forest", "Island"
  start turn 1 A
  turn 1 A: attack "Dimir Cutpurse"
  run_to turn 1 postcombat_main
  assert life B 18
  assert hand B count 1
  assert graveyard B count 1
  assert hand A count 2
}

scenario "Dimir Cutpurse: blocked, no trigger" {
  battlefield A: "Dimir Cutpurse"
  battlefield B: "Hill Giant"
  hand B: "Shock"
  start turn 1 A
  turn 1 A: attack "Dimir Cutpurse"
  turn 1 B: block "Dimir Cutpurse" with "Hill Giant"
  run_to turn 1 postcombat_main
  assert hand B count 1
}

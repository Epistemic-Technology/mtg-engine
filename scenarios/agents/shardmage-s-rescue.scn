scenario "Shardmage's Rescue saves a creature from Murder" {
  battlefield A: "Grizzly Bears", "Plains"
  battlefield B: 3 "Swamp"
  hand A: "Shardmage's Rescue"
  hand B: "Murder"
  start turn 2 B precombat_main
  turn 2 B: cast "Murder" targeting "Grizzly Bears"
  turn 2 A: cast "Shardmage's Rescue" targeting "Grizzly Bears" in response to "Murder"
  run_to turn 2 postcombat_main
  assert battlefield A contains "Grizzly Bears"
  assert graveyard B contains "Murder"
  assert attached "Shardmage's Rescue" to "Grizzly Bears"
  assert has "Grizzly Bears" hexproof
  assert power "Grizzly Bears" 3
  assert toughness "Grizzly Bears" 3
}

scenario "Shardmage's Rescue's hexproof ends after the turn it entered" {
  battlefield A: "Grizzly Bears", "Plains"
  hand A: "Shardmage's Rescue"
  start turn 1 A precombat_main
  turn 1 A: cast "Shardmage's Rescue" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert has "Grizzly Bears" hexproof
  run_to turn 2 precombat_main
  assert has not "Grizzly Bears" hexproof
  assert power "Grizzly Bears" 3
}

scenario "Shardmage's Rescue only enchants your creature" {
  battlefield A: "Plains"
  battlefield B: "Grizzly Bears"
  hand A: "Shardmage's Rescue"
  start turn 1 A precombat_main
  illegal turn 1 A: cast "Shardmage's Rescue" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert hand A contains "Shardmage's Rescue"
}

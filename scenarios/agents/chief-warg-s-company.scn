scenario "chief warg's company can't attack with one other wolf" {
  battlefield A: "Chief Warg's Company"
  start turn 2 A
  illegal turn 2 A: attack "Chief Warg's Company"
  run_to turn 2 postcombat_main
  assert battlefield A contains 1 "Wolf"
  assert life B 20
}

scenario "chief warg's company attacks with two other wolves" {
  battlefield A: "Chief Warg's Company"
  start turn 2 A
  turn 4 A: attack "Chief Warg's Company"
  run_to turn 4 postcombat_main
  assert battlefield A contains 2 "Wolf"
  assert life B 15
}

scenario "Gladehart Cavalry supports other creatures" {
  battlefield A: "Grizzly Bears", "Hill Giant", 7 "Forest"
  hand A: "Gladehart Cavalry"
  turn 1 A: cast "Gladehart Cavalry"
  turn 1 A: trigger "Gladehart Cavalry" targeting "Grizzly Bears", "Hill Giant"
  run_to turn 1 postcombat_main
  assert counters "Grizzly Bears" +1/+1 1
  assert counters "Hill Giant" +1/+1 1
  assert counters "Gladehart Cavalry" +1/+1 0
  assert power "Gladehart Cavalry" 6
}
scenario "Gladehart Cavalry gains life when a creature with a counter dies" {
  life A 10
  battlefield A: "Gladehart Cavalry", "Grizzly Bears" with 1 +1/+1, "Hill Giant", 3 "Swamp"
  hand A: "Murder"
  turn 1 A: cast "Murder" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert life A 12
}
scenario "Gladehart Cavalry no life for creature without counter" {
  life A 10
  battlefield A: "Gladehart Cavalry", "Grizzly Bears", 3 "Swamp"
  hand A: "Murder"
  turn 1 A: cast "Murder" targeting "Grizzly Bears"
  run_to turn 1 postcombat_main
  assert graveyard A contains "Grizzly Bears"
  assert life A 10
}

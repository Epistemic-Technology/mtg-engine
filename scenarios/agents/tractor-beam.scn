scenario "Tractor Beam taps, steals, and keeps the creature tapped" {
  battlefield A: 4 "Island"
  battlefield B: "Hill Giant"
  hand A: "Tractor Beam"
  turn 1 A: cast "Tractor Beam" targeting "Hill Giant"
  run_to turn 1 postcombat_main
  assert battlefield A contains "Hill Giant"
  assert battlefield B lacks "Hill Giant"
  assert tapped "Hill Giant"
  assert attached "Tractor Beam" to "Hill Giant"
  run_to turn 3 precombat_main
  assert tapped "Hill Giant"
  assert battlefield A contains "Hill Giant"
}

scenario "SelhoffOccultistTest.testDiesTriggeredAbility" {
  # from cards/triggers/dies/SelhoffOccultistTest.java
  battlefield A: "Mountain"
  hand A: "Lightning Bolt"
  battlefield B: "Selhoff Occultist"
  turn 1 precombat_main A: cast "Lightning Bolt" targeting "Selhoff Occultist"
  run_to turn 1 begin_combat
  assert life A 20
  assert life B 20
  assert graveyard A count 2
  assert graveyard B count 1
}

